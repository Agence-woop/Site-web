</Layout>

<style>
  /* =====================================================================
     PAGE GESTION DES RÉSEAUX SOCIAUX : styles locaux (scopés).
     Même modèle que la page Publicité : classes hp-* et md-* communes aux pages Services, classes
     rs-* propres à cette page.
     Couleurs : uniquement les jetons de global.css, leurs mélanges (color-mix) et des rgba()
     dérivées de #FA6244 et #E62B7F. Aucun bleu, y compris pour LinkedIn et Facebook : logos
     officiels en blanc sur une pastille (Instagram : dégradé, Facebook : orange, LinkedIn : rose).
     Contraste hybride : sur le dégradé, petits textes en --hp-on-grad (--bg-deep), titres en blanc.
     ===================================================================== */

  /* ===== ESPACEMENTS DE RÉFÉRENCE (mêmes valeurs que l'accueil) ===== */
  .hp-hero,
  .hp-block {
    --home-section-gap: 80px;
    --home-head-gap: 16px;
    --home-head-content: 36px;
  }

  @media (min-width: 768px) {
    .hp-hero,
    .hp-block { --home-section-gap: 100px; }
  }

  @media (min-width: 900px) {
    .hp-hero,
    .hp-block {
      --home-head-gap: 20px;
      --home-head-content: 46px;
    }
  }

  @media (min-width: 1024px) {
    .hp-hero,
    .hp-block { --home-section-gap: 120px; }
  }

  /* Pas de mot seul en fin de paragraphe */
  p { text-wrap: pretty; }

  .hp-hero + .hp-block,
  .hp-block + .hp-block { margin-top: var(--home-section-gap); }

  /* Pastille d'icône au trait (formules) */
  .rs-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 8px 20px rgba(230, 43, 127, 0.3);
  }

  .rs-ic :global(svg) { width: 24px; height: 24px; }

  /* Pastille d'un réseau : logo officiel en blanc sur rose, orange ou dégradé */
  .rs-net {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    color: var(--text-primary);
  }

  .rs-net :global(svg) { width: 16px; height: 16px; }

  .rs-net--instagram { background: var(--woop-gradient); }
  .rs-net--facebook { background: var(--woop-orange); }
  .rs-net--linkedin { background: var(--woop-pink); }

  .rs-net--sm {
    width: 24px;
    height: 24px;
    border-radius: 7px;
  }

  .rs-net--sm :global(svg) { width: 12px; height: 12px; }

  .rs-net--lg {
    width: 52px;
    height: 52px;
    border-radius: 15px;
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.3);
  }

  .rs-net--lg :global(svg) { width: 24px; height: 24px; }

  /* ===== 1. HERO : un réseau, un rôle ===== */
  /* Colonne de droite du hero (dès 1024 px), sous le texte sur téléphone et tablette.
     Dès 600 px : les 3 cartes posées en quinconce (Instagram à gauche, LinkedIn en haut à droite,
     Facebook en bas à droite), chacune avec sa pastille de rôle.
     Téléphone : la carte Instagram seule (l'illustration principale). */
  .rs-hv {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 8px auto 0;
  }

  @media (min-width: 1024px) {
    .rs-hv { margin-top: 0; }
  }

  .rs-hv__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    max-width: 120%;
    height: 520px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 43, 127, 0.32), rgba(250, 98, 68, 0.1) 45%, transparent 70%);
    pointer-events: none;
  }

  .rs-x {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    text-align: left;
  }

  .rs-x__card {
    overflow: hidden;
    border-radius: 20px;
    background: var(--hp-light);
    color: var(--bg-deep);
    box-shadow: 0 26px 60px var(--hp-shadow);
  }

  /* Pastille de rôle sous chaque carte */
  .rs-role {
    display: flex;
    align-items: center;
    align-self: flex-start;
    gap: 10px;
    padding: 7px 14px 7px 7px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 90%, transparent);
    box-shadow: inset 0 0 0 1px var(--hp-line), 0 16px 34px var(--hp-shadow);
  }

  .rs-role b {
    display: block;
    font-size: 13px;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .rs-role small {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--md-pink-soft);
  }

  /* Instagram : profil de la clinique */
  .rs-x--ig .rs-x__card {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 14px 14px 0;
  }

  .rs-ig__top {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .rs-ig__ring {
    padding: 3px;
    border-radius: 50%;
    background: var(--woop-gradient);
  }

  .rs-ig__av {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: var(--woop-gradient);
    box-shadow: 0 0 0 3px var(--hp-light);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .rs-ig__st b {
    display: block;
    font-size: 13px;
    line-height: 1.2;
  }

  .rs-ig__st small {
    font-size: 10px;
    color: var(--text-muted);
  }

  .rs-ig__name { font-size: 12px; }

  .rs-ig__hl {
    display: flex;
    gap: 8px;
  }

  .rs-ig__hl span {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--hp-blush);
    box-shadow: 0 0 0 2px var(--hp-light), 0 0 0 3.5px var(--hp-skel);
  }

  .rs-ig__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    margin: 4px -14px 0;
  }

  .rs-ig__grid i {
    position: relative;
    display: block;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .rs-ig__grid .p1 { background: linear-gradient(150deg, var(--hp-pinklight), var(--woop-pink)); }
  .rs-ig__grid .p2 { background: var(--hp-blush); }
  .rs-ig__grid .p3 { background: var(--woop-gradient); }
  .rs-ig__grid .p4 { background: var(--hp-plum); }
  .rs-ig__grid .p5 { background: linear-gradient(150deg, var(--woop-pink), var(--hp-plum)); }
  .rs-ig__grid .p6 { background: color-mix(in srgb, var(--woop-orange) 45%, var(--text-primary)); }

  /* LinkedIn : publication d'expertise */
  .rs-x--li .rs-x__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
  }

  .rs-li__top {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .rs-li__top b {
    display: block;
    font-size: 12px;
    line-height: 1.3;
  }

  .rs-li__top small {
    font-size: 10px;
    color: var(--text-muted);
  }

  .rs-li__av {
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: linear-gradient(150deg, var(--hp-pinklight), var(--woop-pink));
  }

  .rs-li__in {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 22px;
    height: 22px;
    margin-left: auto;
    border-radius: 5px;
    background: var(--woop-pink);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    color: var(--text-primary);
  }

  .rs-li__txt {
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.4;
  }

  .rs-li__doc {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 12px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--woop-pink) 6%, var(--text-primary));
  }

  .rs-li__doc small {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .rs-li__doc b { font-size: 13px; }

  .rs-li__doc i {
    display: block;
    height: 5px;
    margin-top: 3px;
    border-radius: 3px;
    background: var(--hp-skel-2);
  }

  .rs-li__doc i.h { width: 60%; margin-top: 0; }

  .rs-li__re {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 8px;
    border-top: 1px solid var(--hp-skel-2);
  }

  .rs-li__re small {
    font-size: 10px;
    color: var(--text-muted);
  }

  /* Réactions rondes (dessinées pour WOOP) : cœur sur rose, étoile sur orange */
  .rs-react { display: flex; }

  .rs-react__i {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    box-shadow: 0 0 0 2px var(--hp-light);
  }

  .rs-react__i + .rs-react__i { margin-left: -4px; }

  .rs-react__i svg {
    width: 11px;
    height: 11px;
    fill: var(--text-primary);
  }

  .rs-react__i--p { background: var(--woop-pink); }
  .rs-react__i--o { background: var(--woop-orange); }

  /* Facebook : événement de quartier */
  .rs-fb__cover {
    position: relative;
    height: 92px;
    background: var(--woop-gradient);
  }

  .rs-fb__date {
    position: absolute;
    left: 14px;
    bottom: -22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    width: 50px;
    height: 54px;
    border-radius: 12px;
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: 0 8px 18px color-mix(in srgb, var(--bg-deep) 20%, transparent);
  }

  .rs-fb__date small {
    font-size: 9px;
    font-weight: 800;
    line-height: 1;
    text-transform: uppercase;
  }

  .rs-fb__date :global(svg) { width: 20px; height: 20px; }

  .rs-fb__body {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 30px 14px 14px;
  }

  .rs-fb__body small {
    font-size: 10px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .rs-fb__body b {
    font-size: 14px;
    line-height: 1.3;
  }

  .rs-fb__go {
    align-self: flex-start;
    margin-top: 4px;
    padding: 7px 11px;
    border-radius: 8px;
    background: var(--hp-blush);
    font-size: 11px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--md-pink-deep);
  }

  /* Hero seulement : logos des réseaux dans un rond (mêmes couleurs) */
  .rs-hv .rs-net { border-radius: 50%; }

  /* Téléphone : carte Instagram seule (sans sa pastille), centrée */
  @media (max-width: 599px) {
    .rs-x--li,
    .rs-x--fb,
    .rs-x--ig .rs-role { display: none; }

    .rs-x--ig {
      width: 100%;
      max-width: 280px;
      margin: 0 auto;
    }
  }

  /* Dès 600 px : les 3 cartes en quinconce */
  @media (min-width: 600px) {
    .rs-hv { height: 600px; }

    .rs-x { position: absolute; z-index: 2; }

    .rs-x--ig { left: 0; top: 110px; width: 215px; }
    .rs-x--li { right: 0; top: 0; z-index: 3; width: 270px; }
    .rs-x--fb { right: 10px; top: 345px; z-index: 4; width: 255px; }
  }

  /* Ordinateur à colonne étroite (1024 à 1279 px) : cartes un peu plus petites */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .rs-hv { height: 580px; }
    .rs-x--ig { top: 120px; width: 195px; }
    .rs-x--li { width: 245px; }
    .rs-x--fb { right: 0; top: 340px; width: 235px; }
  }

  /* ===== 2. POUR QUI ? ===== */
  .rs-prs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 900px) {
    .rs-prs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .md-pr__vis--rare,
  .md-pr__vis--faces,
  .md-pr__vis--same {
    background:
      radial-gradient(circle at 30% 20%, rgba(230, 43, 127, 0.3), transparent 65%),
      var(--hp-plum);
  }

  /* Publications rares : 2 semaines, 3 jours publiés */
  .rs-av1 {
    display: grid;
    grid-template-columns: repeat(7, 18px);
    gap: 5px;
  }

  .rs-av1 i {
    display: block;
    height: 18px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--text-primary) 12%, transparent);
  }

  .rs-av1 i.is-on { background: var(--woop-gradient); }

  /* Services, jamais les gens : 2 visuels vides, 1 visage */
  .rs-av2 {
    display: flex;
    gap: 10px;
  }

  .rs-av2 span {
    position: relative;
    overflow: hidden;
    width: 58px;
    height: 58px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--text-primary) 14%, transparent);
  }

  .rs-av2 .is-on { background: var(--woop-gradient); }

  /* Le même contenu partout */
  .rs-av3 {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .rs-av3 .rs-net {
    width: 46px;
    height: 46px;
    border-radius: 13px;
    box-shadow: 0 10px 22px var(--hp-shadow);
  }

  .rs-av3 .rs-net :global(svg) { width: 22px; height: 22px; }

  .rs-av3 b {
    font-size: 22px;
    line-height: 1;
    color: var(--text-secondary);
  }

  .rs-av3 b.rs-av3__q {
    margin-left: 4px;
    font-size: 28px;
    color: var(--md-pink-soft);
  }

  /* ===== 3. LA MÉTHODE : le rôle de chaque réseau ===== */
  .rs-nets {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    list-style: none;
  }

  @media (min-width: 900px) {
    .rs-nets {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .rs-rl {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 24px;
    border-radius: 26px;
  }

  @media (min-width: 1024px) {
    .rs-rl { padding: 30px; }
  }

  .rs-rl--hot {
    background: var(--woop-gradient);
    box-shadow: 0 24px 60px rgba(230, 43, 127, 0.28);
  }

  .rs-rl__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .rs-rl h3 {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .rs-rl dl {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-top: 18px;
    border-top: 1px solid var(--hp-line);
  }

  .rs-rl dt {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-pink-soft);
  }

  .rs-rl dd + dt { margin-top: 12px; }

  .rs-rl dd {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.5;
    color: var(--text-primary);
  }

  /* Carte mise en avant, sur le dégradé : titre en blanc, petits textes en --hp-on-grad ;
     pastille Facebook orange cerclée de blanc pour rester lisible sur le dégradé */
  .rs-rl--hot .rs-net {
    box-shadow: inset 0 0 0 2px var(--hp-light), 0 8px 22px color-mix(in srgb, var(--bg-deep) 25%, transparent);
  }

  .rs-rl--hot dt { color: var(--text-primary); }
  .rs-rl--hot dd { color: var(--hp-on-grad); }

  .rs-rl--hot dl { border-top-color: color-mix(in srgb, var(--bg-deep) 22%, transparent); }

  /* ===== 4. LES VISAGES : section ouverte, texte à gauche et 3 portraits à droite ===== */
  @media (min-width: 900px) {
    .rs-face {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: center;
      gap: 50px;
    }
  }

  .rs-face__head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--home-head-gap);
  }


  .rs-face__vis {
