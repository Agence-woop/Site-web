                          <div><i class="pf"><Silhouette name="homme" detail="simple" /></i><span>Équipe</span></div>
                          <div><i class="pt"><b>Aa</b></i><span>Conseil</span></div>
                          <div><i class="pe"><Fragment set:html={icon('calendar')} /></i><span>Nouveauté</span></div>
                        </div>
                        <b>Trois publications différentes</b>
                      </div>
                      <div class="rs-rp__c rs-rp__c--win">
                        <small>Ce qui a fonctionné</small>
                        <div class="rs-rp__top"><i><Silhouette name="femme-chignon" detail="simple" /></i><span><svg viewBox="0 0 24 24"><path d={GLYPH.heart} /></svg></span></div>
                        <b>La présentation de l'équipe</b>
                        <span class="rs-rp__like"><svg viewBox="0 0 24 24"><path d={GLYPH.heart} /></svg>j'aime</span>
                      </div>
                      <div class="rs-rp__c">
                        <small>Ce qu'on ajuste</small>
                        <div class="rs-rp__adj">
                          <div><small>On garde</small><span class="k">Les visages de l'équipe</span></div>
                          <div><small>On fait mieux</small><span class="y">Une courte vidéo de Julie</span></div>
                        </div>
                        <b>Le mois prochain</b>
                      </div>
                    </div>
                  </div>
                )}
              </div>
            </Fragment>
          </ServiceTile>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. 06 · L'ÉCOSYSTÈME (cycle des 5 services), puis le Test de visibilité -->
  <section class="hp-block hp-sec" id="ecosysteme" data-reveal-clip>
