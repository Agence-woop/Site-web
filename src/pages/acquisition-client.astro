  /* ===== CONTENU DE RÉFÉRENCEMENT ===== */
  .acq-seo { padding: 0; }

  .seo-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .seo-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
