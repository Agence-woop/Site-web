---
import Layout from '../layouts/Layout.astro';
import ChevronRight from '../components/ChevronRight.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/acquisition-client/`;

const faq = [
  {
    q: 'Le test de visibilité est-il vraiment gratuit ?',
    a: 'Oui. Il prend environ deux minutes et ne vous engage à rien. Vous recevez votre score sur 100 et trois actions prioritaires adaptées à votre situation.',
  },
  {
    q: 'Comment est calculé le score ?',
    a: "Il combine cinq critères : votre position sur Google, le nombre d'avis, vos publicités actuelles, votre budget média et vos contenus visuels. Votre type d'activité, votre objectif et votre calendrier servent à personnaliser les recommandations.",
  },
  {
    q: "La publicité d'une clinique est-elle encadrée au Québec ?",
    a: 'Oui. Les ordres professionnels encadrent la publicité de leurs membres, et Meta limite certaines options de ciblage liées à la santé. Nous concevons des campagnes qui respectent ces règles, avec un regard clinique sur chaque message.',
  },
  {
    q: 'Combien de temps avant de voir des résultats ?',
    a: "La publicité peut générer des demandes dès les premières semaines. La visibilité naturelle sur Google et la réputation, elles, se construisent sur plusieurs mois. C'est la combinaison des deux qui fait baisser durablement le coût d'un nouveau patient.",
  },
  {
    q: 'Travaillez-vous seulement avec des cliniques ?',
    a: 'Nous accompagnons les cliniques médicales et dentaires, les professionnels de la santé et du bien-être, ainsi que les cabinets de recrutement spécialisés, partout au Québec.',
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Acquisition client', item: PAGE_URL },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Marketing pour cliniques',
    url: PAGE_URL,
    // Renvoie à la fiche de l'organisation publiée sur l'accueil
    provider: { '@id': `${SITE_URL}/#organization`, name: 'Agence WOOP' },
    areaServed: 'Québec',
  },
];
---
<Layout
  title="Marketing clinique : test de visibilité gratuit | WOOP"
  description="Faites le test de visibilité WOOP en 2 minutes : un score sur 100 et 3 actions prioritaires pour attirer plus de patients sur Google et Meta."
  ogImage="/images/og-acquisition-client.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Hero et quiz : jamais animés. -->
  <ScrollReveal />

  <!-- 1. QUIZ : écran d'accueil statique (lu par Google), puis relais JavaScript -->
  <section class="acq acq-quiz" id="score">
    <div class="container">
      <div
        class="quiz"
        data-quiz
        data-base={base}
        data-privacy={`${base}/confidentialite-et-conditions/`}
        aria-live="polite"
      >
        <div class="quiz__intro" data-intro>
          <div class="intro__text">
            <span class="kicker">Acquisition client · Cliniques et cabinets</span>
            <h1 class="intro__title" tabindex="-1" data-intro-title>
              Quel est le score de <span class="gradient-accent intro__kw">visibilité</span> de votre clinique ?
            </h1>
            <p class="intro__subtitle">
              Un test gratuit de 2 minutes pour mesurer votre présence sur Google et Meta, et recevoir 3 actions prioritaires pour attirer plus de patients.
            </p>
            <div class="intro__pills">
              <span class="pill">2 minutes</span>
              <span class="pill">10 étapes</span>
              <span class="pill pill--pink">Sans engagement</span>
            </div>
            <button type="button" class="acq-btn acq-btn--lg acq-btn--cta intro__start" data-start>
              <span class="label-full">Calculer mon score de visibilité</span><span class="label-short">Calculer mon score</span> <ChevronRight size={16} />
            </button>
          </div>
          <div class="intro__visual" aria-hidden="true">
            <div class="score-ring score-ring--intro">
              <svg viewBox="0 0 300 300" focusable="false">
                <defs>
                  <linearGradient id="acq-ring-intro" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" class="stop-orange" />
                    <stop offset="1" class="stop-pink" />
                  </linearGradient>
                </defs>
                <circle cx="150" cy="150" r="126" class="ring-track" stroke-width="20" />
                <circle
                  cx="150" cy="150" r="126"
                  class="ring-value"
                  stroke="url(#acq-ring-intro)"
                  stroke-width="20"
                  stroke-dasharray="520 792"
                  transform="rotate(-90 150 150)"
                />
              </svg>
              <div class="score-ring__label">
                <strong class="score-ring__blur">72</strong>
                <span>sur 100</span>
              </div>
            </div>
          </div>
        </div>

        <div class="quiz__stage" data-stage hidden></div>
      </div>
    </div>
  </section>

  <!-- 2. DES CLIENTS, PAS DES CLICS + SERVICES -->
  <section class="acq acq-services" data-reveal-clip>
    <div class="container">
      <h2 class="acq-h2" data-reveal="left">Des <span class="gradient-accent acq-kw">clients</span>, pas des clics.</h2>

      <div class="bento">
        <article class="tile tile--span2" data-reveal="left">
          <div class="tile__head tile__head--front">
            <span class="tile__lbl">PUBLICITÉ GOOGLE ET META</span>
            <h3 class="tile__title tile__title--lg">Être trouvé en premier.</h3>
          </div>
          <div class="phone" aria-hidden="true">
            <div class="phone__screen">
              <svg class="phone__map" viewBox="0 0 180 112" preserveAspectRatio="xMidYMid slice" focusable="false">
                <defs>
                  <linearGradient id="acq-pin-grad" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0" class="stop-orange" />
                    <stop offset="1" class="stop-pink" />
                  </linearGradient>
                </defs>
                <rect width="180" height="112" class="map-bg" />
                <rect x="112" y="34" width="44" height="30" rx="6" class="map-block" />
                <rect x="14" y="78" width="34" height="24" rx="6" class="map-block" />
                <path class="map-street map-street--main" d="M-6 74 C 40 62, 96 84, 186 56" />
                <path class="map-street" d="M-6 26 L 186 18" />
                <path class="map-street" d="M44 -6 L 62 118" />
                <path class="map-street" d="M104 -6 L 96 118" />
                <path class="map-street" d="M150 -6 L 164 118" />
                <g class="map-pin" transform="translate(30 50)"><path d="M0 0c-4-5-7-8-7-12a7 7 0 0 1 14 0c0 4-3 7-7 12z" /><circle cy="-12" r="2.6" class="map-pin__dot" /></g>
                <g class="map-pin" transform="translate(134 98)"><path d="M0 0c-4-5-7-8-7-12a7 7 0 0 1 14 0c0 4-3 7-7 12z" /><circle cy="-12" r="2.6" class="map-pin__dot" /></g>
                <circle cx="80" cy="54" r="15" class="map-halo" />
                <g transform="translate(80 64) scale(1.35)"><path d="M0 0c-4-5-7-8-7-12a7 7 0 0 1 14 0c0 4-3 7-7 12z" fill="url(#acq-pin-grad)" /><circle cy="-12" r="2.6" class="map-pin__dot--on" /></g>
              </svg>
              <div class="phone__results">
                <div class="res res--on">
                  <span class="res__meta">Sponsorisé</span>
                  <span class="res__name">Votre clinique</span>
                  <span class="res__row">
                    <span class="res__stars">★★★★★</span>
                    <span class="res__cta">Réserver</span>
                  </span>
                </div>
                <div class="res">
                  <span class="res__bar res__bar--name"></span>
                  <span class="res__bar res__bar--line"></span>
                  <span class="res__stars res__stars--dim">★★★★<i>★</i></span>
                </div>
                <div class="res">
                  <span class="res__bar res__bar--name res__bar--short"></span>
                  <span class="res__bar res__bar--line"></span>
                  <span class="res__stars res__stars--dim">★★★<i>★★</i></span>
                </div>
              </div>
            </div>
          </div>
          <div class="tile__pills tile__head--front">
            <span class="pill pill--soft">Google</span>
            <span class="pill pill--soft">Facebook</span>
            <span class="pill pill--soft">Instagram</span>
          </div>
        </article>

        <article class="tile" data-reveal="right">
          <div class="tile__head">
            <span class="tile__lbl">ÉTUDE DE VOS INDICATEURS</span>
            <h3 class="tile__title">Aucun budget dilué.</h3>
          </div>
          <div class="kpis">
            <div class="kpi">Coût par client <span class="kpi__mark" aria-hidden="true">✓</span></div>
            <div class="kpi">Canaux qui rapportent <span class="kpi__mark" aria-hidden="true">✓</span></div>
            <div class="kpi kpi--no"><em>Budget gaspillé</em> <span aria-hidden="true">✕</span></div>
          </div>
        </article>

        <article class="tile tile--pink" data-reveal="left">
          <div class="tile__head">
            <span class="tile__lbl">STRATÉGIE ADAPTÉE</span>
            <h3 class="tile__title">Pour accélérer sans gaspiller.</h3>
          </div>
          <div class="growth" aria-hidden="true">
            <span class="growth__bar growth__bar--1">Tester</span>
            <span class="growth__bar growth__bar--2">Garder</span>
            <span class="growth__bar growth__bar--3">Accélérer</span>
          </div>
        </article>

        <article class="tile" data-reveal="up" data-reveal-step="1">
          <div class="tile__head">
            <span class="tile__lbl">RAPPORTS</span>
            <h3 class="tile__title">Vous voyez tout.</h3>
            <div class="tile__pills tile__pills--under">
              <span class="pill pill--grad">Hebdo</span>
              <span class="pill">Mensuel</span>
            </div>
          </div>
          <div class="dash" aria-hidden="true">
            <svg class="dash__chart" viewBox="0 0 300 104" focusable="false">
              <defs>
                <linearGradient id="acq-dash-line" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" class="stop-orange" />
                  <stop offset="1" class="stop-pink" />
                </linearGradient>
                <linearGradient id="acq-dash-area" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" class="stop-pink-fade" />
                  <stop offset="1" class="stop-pink-clear" />
                </linearGradient>
              </defs>
              <path class="dash__grid" d="M0 26H300M0 56H300M0 86H300" />
              <path d="M8 88 C 40 86, 60 70, 92 72 S 142 56, 172 52 S 232 32, 282 18 L 282 104 L 8 104 Z" fill="url(#acq-dash-area)" />
              <path class="dash__line" d="M8 88 C 40 86, 60 70, 92 72 S 142 56, 172 52 S 232 32, 282 18" stroke="url(#acq-dash-line)" />
              <circle cx="282" cy="18" r="13" class="dash__halo" />
              <circle cx="282" cy="18" r="6" class="dash__point" />
            </svg>
            <div class="dash__kpis">
              <span class="dash__kpi">Coût par patient <b>↓</b></span>
              <span class="dash__kpi">Demandes <b>↑</b></span>
            </div>
          </div>
        </article>

        <article class="tile tile--orange" data-reveal="right" data-reveal-step="2">
          <div class="tile__head">
            <span class="tile__lbl">MISE EN PLACE</span>
            <h3 class="tile__title">En ligne, rapidement.</h3>
          </div>
          <div class="setup" aria-hidden="true">
            <ul class="setup__list">
              <li class="setup__item"><span class="setup__check">✓</span>Suivi des conversions</li>
              <li class="setup__item"><span class="setup__check">✓</span>Pages de conversion</li>
              <li class="setup__item"><span class="setup__check">✓</span>Campagnes prêtes</li>
            </ul>
            <div class="setup__progress">
              <svg class="setup__bolt" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="M13 2L4 14h7l-1 8 9-12h-7z" /></svg>
              <span class="setup__track"><span class="setup__fill"></span></span>
              <span class="setup__label">Prêt à diffuser</span>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- 3. LES 3 ÉTAPES ET LE BOUTON DU MILIEU DE PAGE (un seul bloc) -->
  <section class="acq acq-steps" data-reveal-clip>
    <div class="container">
      <h2 class="acq-h2" data-reveal="left">De votre score à vos premiers <span class="gradient-accent acq-kw">patients</span>.</h2>
      <ol class="steps3">
        <li class="step3" data-reveal="left"><span class="gradient-accent step3__num">01</span>Audit 30 min</li>
        <li class="steps3__arrow" aria-hidden="true" data-reveal="left" data-reveal-step="0.5">›</li>
        <li class="step3" data-reveal="left" data-reveal-step="1"><span class="gradient-accent step3__num">02</span>Plan sur mesure</li>
        <li class="steps3__arrow" aria-hidden="true" data-reveal="left" data-reveal-step="1.5">›</li>
        <li class="step3 step3--hot" data-reveal="left" data-reveal-step="2"><span class="step3__num step3__num--plain">03</span>Lancement</li>
      </ol>

      <!-- Bouton du milieu de page : remonte au quiz -->
      <div class="acq-midcta" data-reveal="up" data-reveal-step="3">
        <button type="button" class="acq-btn acq-btn--lg acq-btn--cta acq-btn--block" data-quiz-cta>
        <span class="label-full">Calculer mon score de visibilité</span><span class="label-short">Calculer mon score</span> <ChevronRight size={16} />
        </button>
      </div>
    </div>
  </section>

  <!-- 4. CONTENU DE RÉFÉRENCEMENT -->
  <div class="acq acq-seo" data-reveal-clip>
    <div class="container seo-grid">
      <section class="seo-block" data-reveal="left">
        <h2 class="seo-block__title">Marketing pour cliniques : être trouvé avant vos concurrents</h2>
        <p class="seo-block__text">Quand un patient cherche un soin près de chez lui, il choisit parmi les premiers résultats de Google, en se fiant à la note et aux avis.</p>
        <p class="seo-block__text">Une clinique bien classée, bien notée et présente sur les réseaux sociaux capte cette demande. Les autres la laissent filer vers la concurrence, souvent sans le savoir.</p>
      </section>
      <section class="seo-block" data-reveal="right">
        <h2 class="seo-block__title">Publicité Google et Meta, pilotée par vos indicateurs</h2>
        <p class="seo-block__text">Nous concevons et gérons vos campagnes sur Google, Facebook et Instagram, avec un objectif clair : des rendez-vous, pas des clics.</p>
        <p class="seo-block__text">Chaque dollar est suivi, du coût par nouveau patient aux canaux qui rapportent vraiment, et le budget se concentre sur ce qui fonctionne.</p>
      </section>
    </div>
  </div>

  <!-- 5. FAQ -->
  <section class="acq acq-faq" data-reveal-clip>
    <div class="container">
      <h2 class="acq-h2 acq-h2--faq" data-reveal="left">Questions <span class="gradient-accent acq-kw">fréquentes</span></h2>
      <div class="faq" data-reveal="up">
        {[faq.slice(0, 3), faq.slice(3)].map((column) => (
          <div class="faq__col">
            {column.map((item) => (
              <details class="faq__item">
                <summary class="faq__question">
                  <span>{item.q}</span>
                  <span class="faq__icon" aria-hidden="true"></span>
                </summary>
                <p class="faq__answer">{item.a}</p>
              </details>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. BANDEAU FINAL -->
  <section class="acq acq-band" id="rdv">
    <div class="container">
      <div class="cta-band" data-reveal="up">
        <h2 class="cta-band__title">Prêt à récupérer vos clients ?</h2>
        <a href={`${base}/contact/`} class="cta-band__btn" data-audit="bandeau_final" data-audit-band>
          Réserver mon audit <ChevronRight size={16} />
        </a>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== JETONS LOCAUX (dérivés de la charte) ===== */
  /* Espacement vertical entre les sections de la page (référence : hero → services) */
  .acq {
    --acq-section-gap: 80px;
  }

  @media (min-width: 768px) {
    .acq { --acq-section-gap: 100px; }
  }

  @media (min-width: 1024px) {
    .acq { --acq-section-gap: 120px; }
  }

  .acq + .acq { margin-top: var(--acq-section-gap); }

  .acq {
    --acq-pink-soft: color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    --acq-line: color-mix(in srgb, var(--text-primary) 12%, transparent);
    --acq-line-strong: color-mix(in srgb, var(--text-primary) 25%, transparent);
    --acq-fill: color-mix(in srgb, var(--text-primary) 7%, transparent);
    --acq-surface: color-mix(in srgb, var(--bg-deep) 60%, transparent);
    --acq-gradient-diag: linear-gradient(135deg, var(--woop-orange), var(--woop-pink));
  }

  [hidden] { display: none !important; }

  /* ===== BOUTONS ===== */
  .acq :global(.acq-btn) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 0;
    cursor: pointer;
    background: var(--woop-gradient);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.2;
    padding: 16px 28px;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition: box-shadow 200ms ease, transform 200ms ease, opacity 200ms ease;
  }

  .acq :global(.acq-btn:hover) {
    color: #fff;
    box-shadow: 0 10px 40px rgba(230, 43, 127, 0.45);
    transform: translateY(-2px);
  }

  .acq :global(.acq-btn:focus-visible) {
    outline: 2px solid var(--acq-pink-soft);
    outline-offset: 3px;
  }

  .quiz :global(.acq-btn[disabled]) {
    cursor: progress;
    opacity: 0.75;
    transform: none;
    box-shadow: none;
  }

  .acq :global(.acq-btn--lg) {
    font-size: 17px;
    padding: 18px 32px;
  }

  @media (min-width: 768px) {
    .acq :global(.acq-btn) { font-size: 17px; padding: 18px 34px; }
    .acq :global(.acq-btn--lg) { font-size: 20px; padding: 22px 40px; }
  }

  /* Boutons « Calculer mon score » (hero et milieu de page) */
  .label-short { display: none; }

  @media (max-width: 599px) {
    .acq .acq-btn--cta {
      font-size: 15px;
      padding: 16px 22px;
      white-space: nowrap;
    }
  }

  @media (max-width: 399px) {
    .acq-btn--cta .label-full { display: none; }
    .acq-btn--cta .label-short { display: inline; }
  }

  .acq-btn--block {
    display: flex;
    width: 100%;
    justify-content: center;
  }

  /* ===== PASTILLES ===== */
  .acq :global(.pill) {
    display: inline-block;
    border: 1.5px solid color-mix(in srgb, var(--text-primary) 35%, transparent);
    border-radius: var(--radius-button);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
  }

  .acq :global(.pill--pink) {
    border-color: var(--woop-pink);
    color: var(--acq-pink-soft);
  }

  .pill--soft {
    border: 0;
    background: color-mix(in srgb, var(--text-primary) 10%, transparent);
  }

  .pill--grad {
    border: 0;
    background: var(--woop-gradient);
    color: #fff;
  }

  /* ===== CARTE DU QUIZ ===== */
  .acq-quiz {
    padding: 32px 0 0;
  }

  @media (min-width: 1024px) {
    .acq-quiz { padding: 40px 0 0; }
  }

  .quiz {
    position: relative;
    overflow: hidden;
    scroll-margin-top: 100px;
    border: 1px solid var(--acq-line);
    border-radius: 28px;
    background:
      linear-gradient(160deg, rgba(230, 43, 127, 0.07), rgba(250, 98, 68, 0.02)),
      var(--acq-surface);
    padding: 32px 22px;
  }

  @media (min-width: 768px) {
    .quiz { padding: 40px 36px; }
  }

  @media (min-width: 1024px) {
    .quiz { padding: 48px 56px; }
  }

  .quiz :global([tabindex="-1"]:focus) { outline: none; }
  .quiz :global([tabindex="-1"]:focus-visible) {
    outline: 2px solid var(--acq-pink-soft);
    outline-offset: 6px;
    border-radius: 6px;
  }

  /* ----- Écran d'accueil (statique) ----- */
  .quiz__intro {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .quiz__intro {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 56px;
    }
  }

  .intro__text {
    display: flex;
    flex-direction: column;
    gap: 24px;
    flex: 1;
    min-width: 0;
  }

  .intro__text .kicker { margin-bottom: 0; }

  .intro__title {
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 34px;
    line-height: 1.08;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .intro__title { font-size: 44px; }
  }

  @media (min-width: 1024px) {
    .intro__title { font-size: 56px; letter-spacing: -1px; }
  }

  .intro__kw,
  .acq-kw {
    letter-spacing: 1px;
  }

  .intro__subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 780px;
    text-wrap: pretty;
  }

  @media (min-width: 1024px) {
    .intro__subtitle { font-size: 19px; }
  }

  .intro__pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .intro__start { align-self: flex-start; }

  .intro__visual { flex: none; width: min(320px, 100%); }

  @media (max-width: 1023px) {
    .intro__visual { width: min(260px, 100%); }
  }

  /* ----- Anneaux de score (accueil, progression, résultat) ----- */
  .quiz :global(.stop-orange),
  .acq-services :global(.stop-orange) { stop-color: var(--woop-orange); }
  .quiz :global(.stop-pink),
  .acq-services :global(.stop-pink) { stop-color: var(--woop-pink); }

  .quiz :global(.ring-track) {
    fill: none;
    stroke: color-mix(in srgb, var(--text-primary) 9%, transparent);
  }

  .quiz :global(.ring-value) {
    fill: none;
    stroke-linecap: round;
    transition: stroke-dasharray 400ms ease;
  }

  .quiz :global(.score-ring) {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
  }

  .quiz :global(.score-ring svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .quiz :global(.score-ring__label) {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    font-size: 15px;
  }

  .quiz :global(.score-ring__label strong) {
    font-size: 64px;
    font-weight: 800;
    line-height: 1;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .quiz :global(.score-ring__label strong) { font-size: 84px; }
  }

  .quiz :global(.score-ring__blur) { filter: blur(11px); }

  /* ----- Étapes du quiz (générées en JavaScript) ----- */
  .quiz :global(.segs) {
    display: flex;
    gap: 6px;
    margin-bottom: 36px;
  }

  .quiz :global(.seg) {
    flex: 1;
    height: 5px;
    border-radius: 3px;
    background: var(--acq-line);
    transition: background 300ms ease;
  }

  .quiz :global(.seg.done) { background: var(--woop-gradient); }

  .quiz :global(.seg.now) {
    background: var(--woop-pink);
    box-shadow: 0 0 12px rgba(230, 43, 127, 0.9);
  }

  .quiz :global(.qbody) {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  @media (min-width: 1024px) {
    .quiz :global(.qbody) { flex-direction: row; }
  }

  .quiz :global(.qmain) {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .quiz :global(.qhead) {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .quiz :global(.eyebrow) {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--text-secondary);
  }

  .quiz :global(.tag) {
    border: 1.5px solid var(--woop-pink);
    color: var(--acq-pink-soft);
    border-radius: var(--radius-button);
    padding: 5px 12px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1.5px;
  }

  .quiz :global(.qtitle) {
    font-family: var(--font-body);
    font-size: 30px;
    line-height: 1.1;
    font-weight: 800;
    letter-spacing: -0.5px;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .quiz :global(.qtitle) { font-size: 36px; }
  }

  @media (min-width: 1024px) {
    .quiz :global(.qtitle) { font-size: 44px; }
  }

  .quiz :global(.grid) {
    display: grid;
    gap: 16px;
    margin-top: 6px;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 600px) {
    .quiz :global(.grid) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1024px) {
    .quiz :global(.g3) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (min-width: 1200px) {
    .quiz :global(.g4) { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .quiz :global(.card) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: flex-start;
    text-align: left;
    font-family: var(--font-body);
    color: var(--text-primary);
    cursor: pointer;
    border-radius: 22px;
    padding: 24px;
    background: var(--bg-elevated);
    border: 2px solid var(--acq-line-strong);
    transition: transform 200ms ease, box-shadow 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  @media (min-width: 600px) {
    .quiz :global(.card) { min-height: 164px; }
  }

  .quiz :global(.card:hover) {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--text-primary) 60%, transparent);
  }

  .quiz :global(.card.on) {
    background: linear-gradient(160deg, rgba(250, 98, 68, 0.22), rgba(230, 43, 127, 0.22)), var(--bg-elevated);
    border-color: var(--woop-pink);
    box-shadow: 0 0 40px rgba(230, 43, 127, 0.5);
    transform: translateY(-4px);
  }

  .quiz :global(.card:focus-visible) {
    outline: 3px solid var(--acq-pink-soft);
    outline-offset: 3px;
  }

  .quiz :global(.card__visual) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    width: 100%;
  }

  .quiz :global(.ic) {
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: linear-gradient(135deg, rgba(250, 98, 68, 0.3), rgba(230, 43, 127, 0.3));
    box-shadow: inset 0 0 0 1px rgba(230, 43, 127, 0.5), 0 8px 24px rgba(230, 43, 127, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--acq-pink-soft);
  }

  .quiz :global(.ic svg) { width: 32px; height: 32px; }

  .quiz :global(.lab) {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.25;
  }

  .quiz :global(.big) {
    font-size: 44px;
    font-weight: 800;
    line-height: 1;
    color: var(--woop-pink);
  }

  .quiz :global(.stars) {
    font-size: 20px;
    letter-spacing: 2px;
    color: var(--acq-pink-soft);
  }

  .quiz :global(.stars i) {
    font-style: normal;
    color: color-mix(in srgb, var(--text-primary) 20%, transparent);
  }

  .quiz :global(.bar-on) { fill: var(--acq-pink-soft); }
  .quiz :global(.bar-off) { fill: rgba(230, 43, 127, 0.22); }

  .quiz :global(.serp) {
    width: 100%;
    background: color-mix(in srgb, var(--bg-deep) 60%, transparent);
    border: 1px solid var(--acq-line);
    border-radius: 12px;
    height: 88px;
    padding: 10px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }

  .quiz :global(.serp b) {
    display: block;
    height: 10px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--text-primary) 18%, transparent);
  }

  .quiz :global(.serp b.me) {
    height: 16px;
    background: var(--woop-gradient);
  }

  .quiz :global(.serp--none b) { background: color-mix(in srgb, var(--text-primary) 12%, transparent); }

  .quiz :global(.serp--unknown) {
    align-items: center;
    justify-content: center;
    font-size: 44px;
    font-weight: 800;
    color: var(--woop-pink);
  }

  .quiz :global(.crea) {
    width: 100%;
    height: 90px;
  }

  .quiz :global(.crea--empty) {
    border-radius: 12px;
    border: 2px dashed var(--acq-line-strong);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    font-size: 34px;
  }

  .quiz :global(.crea--few),
  .quiz :global(.crea--full) {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .quiz :global(.crea--full) { grid-template-rows: repeat(2, 1fr); }

  .quiz :global(.crea i) { border-radius: 10px; }
  .quiz :global(.crea--full i) { border-radius: 8px; }
  .quiz :global(.crea .c-grad) { background: var(--acq-gradient-diag); }
  .quiz :global(.crea .c-pink) { background: rgba(230, 43, 127, 0.6); }
  .quiz :global(.crea .c-soft) { background: color-mix(in srgb, var(--text-primary) 15%, transparent); }
  .quiz :global(.crea .c-mid) { background: color-mix(in srgb, var(--text-primary) 25%, transparent); }
  .quiz :global(.crea .c-dash) { border: 2px dashed color-mix(in srgb, var(--text-primary) 30%, transparent); }

  .quiz :global(.qfoot) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  .quiz :global(.back) {
    background: none;
    border: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 3px;
    cursor: pointer;
    padding: 12px 0;
  }

  .quiz :global(.back:hover) { color: var(--acq-pink-soft); }

  .quiz :global(.back:focus-visible),
  .quiz :global(.restart:focus-visible) {
    outline: 2px solid var(--acq-pink-soft);
    outline-offset: 3px;
    border-radius: 4px;
  }

  .quiz :global(.back[disabled]) { visibility: hidden; }

  .quiz :global(.hint) {
    font-size: 13px;
    color: var(--text-secondary);
  }

  .quiz :global(.aside) { display: none; }

  @media (min-width: 1024px) {
    .quiz :global(.aside) {
      width: 250px;
      flex: none;
      align-self: flex-start;
      border: 1px solid var(--acq-line);
      border-radius: 24px;
      background: var(--acq-surface);
      padding: 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      text-align: center;
    }
  }

  .quiz :global(.aside__eyebrow) {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    color: var(--text-secondary);
  }

  .quiz :global(.aside .score-ring) { width: 160px; }

  .quiz :global(.aside .score-ring__label strong) {
    font-size: 48px;
    filter: blur(6px);
  }

  .quiz :global(.aside__note) {
    font-size: 14px;
    color: var(--text-secondary);
  }

  /* ----- Téléphone (moins de 600 px) : deux tuiles compactes par ligne, étapes 1 à 9 ----- */
  @media (max-width: 599px) {
    /* Titre des étapes à tuiles uniquement (le titre de l'étape 10 ne change pas) */
    .quiz :global(.qtitle:has(+ .grid)) { font-size: 24px; }

    .quiz :global(.grid) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }

    /* Nombre impair de réponses (étapes 4 et 8) : la dernière tuile prend toute la ligne */
    .quiz :global(.grid > .card:last-child:nth-child(odd)) { grid-column: 1 / -1; }

    .quiz :global(.card) {
      gap: 10px;
      min-height: 88px;
      padding: 14px;
      border-radius: 18px;
    }

    .quiz :global(.card__visual) { gap: 8px; }

    .quiz :global(.ic) {
      width: 44px;
      height: 44px;
      border-radius: 13px;
    }

    .quiz :global(.ic svg) { width: 22px; height: 22px; }

    .quiz :global(.lab) {
      font-size: 15px;
      line-height: 1.25;
      overflow-wrap: break-word;
    }

    /* Étape 2 : barres */
    .quiz :global(.card__visual > svg) { width: 84px; height: auto; }

    /* Étapes 4 et 6 : montants et nombre d'avis */
    .quiz :global(.big) { font-size: 28px; }

    /* Étape 6 : étoiles */
    .quiz :global(.stars) { font-size: 14px; letter-spacing: 1px; }

    /* Étape 5 : résultats Google */
    .quiz :global(.serp) {
      height: 62px;
      padding: 7px;
      gap: 4px;
      border-radius: 10px;
    }

    .quiz :global(.serp b) { height: 7px; border-radius: 4px; }
    .quiz :global(.serp b.me) { height: 11px; }
    .quiz :global(.serp--unknown) { font-size: 30px; }

    /* Étape 8 : vignettes */
    .quiz :global(.crea) { height: 60px; }
    .quiz :global(.crea--few),
    .quiz :global(.crea--full) { gap: 4px; }
    .quiz :global(.crea i) { border-radius: 7px; }
    .quiz :global(.crea--full i) { border-radius: 6px; }
    .quiz :global(.crea--empty) { font-size: 26px; border-radius: 10px; }
  }

  /* ----- Formulaire de la dernière étape ----- */
  .quiz :global(.contact-form) {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px 32px;
    max-width: 760px;
  }

  @media (min-width: 600px) {
    .quiz :global(.contact-form) { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .quiz :global(.field) {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 14px;
    color: var(--text-secondary);
  }

  .quiz :global(.field input) {
    background: none;
    border: 0;
    border-bottom: 2px solid color-mix(in srgb, var(--text-primary) 60%, transparent);
    border-radius: 0;
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 20px;
    padding: 10px 0;
    width: 100%;
  }

  @media (min-width: 768px) {
    .quiz :global(.field input) { font-size: 24px; }
  }

  .quiz :global(.field input::placeholder) { color: var(--text-muted); }

  .quiz :global(.field input:focus) {
    outline: none;
    border-bottom-color: var(--woop-pink);
  }

  .quiz :global(.field input[aria-invalid="true"]) { border-bottom-color: var(--woop-orange); }

  .quiz :global(.consent) {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-secondary);
    grid-column: 1 / -1;
  }

  .quiz :global(.consent input) {
    accent-color: var(--woop-pink);
    width: 18px;
    height: 18px;
    margin-top: 2px;
    flex: none;
  }

  .quiz :global(.consent input:focus-visible) {
    outline: 2px solid var(--acq-pink-soft);
    outline-offset: 2px;
  }

  .quiz :global(.consent a) {
    color: var(--acq-pink-soft);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .quiz :global(.consent a:focus-visible) {
    outline: 2px solid var(--acq-pink-soft);
    outline-offset: 2px;
  }

  .quiz :global(.err) {
    color: var(--acq-pink-soft);
    font-size: 14px;
    min-height: 20px;
    grid-column: 1 / -1;
  }

  .quiz :global(.contact-form .acq-btn) { justify-self: start; }

  /* ----- Résultat ----- */
  .quiz :global(.result) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
  }

  @media (min-width: 1024px) {
    .quiz :global(.result) {
      flex-direction: row;
      align-items: center;
      gap: 56px;
    }
  }

  .quiz :global(.result__ring) {
    width: min(300px, 100%);
    flex: none;
  }

  .quiz :global(.result__body) {
    display: flex;
    flex-direction: column;
    gap: 16px;
    flex: 1;
    min-width: 0;
  }

  .quiz :global(.result__eyebrow) { color: var(--acq-pink-soft); }

  .quiz :global(.result__verdict) { font-size: 30px; }

  @media (min-width: 1024px) {
    .quiz :global(.result__verdict) { font-size: 40px; }
  }

  .quiz :global(.result__intro) {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 640px;
  }

  .quiz :global(.actions) {
    display: flex;
    flex-direction: column;
    gap: 12px;
    list-style: none;
  }

  .quiz :global(.action) {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
    border-radius: 14px;
    padding: 14px 20px;
    font-size: 17px;
    font-weight: 600;
    line-height: 1.35;
  }

  .quiz :global(.action__body) {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .quiz :global(.action__title) {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .quiz :global(.action__tip) {
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .quiz :global(.action__num) {
    width: 34px;
    height: 34px;
    flex: none;
    border-radius: 50%;
    background: var(--acq-gradient-diag);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
  }

  .quiz :global(.result__cta) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    margin-top: 8px;
  }

  .quiz :global(.result__cta-note) {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .quiz :global(.restart) {
    background: none;
    border: 0;
    cursor: pointer;
    padding: 6px 0;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .quiz :global(.restart:hover) { color: var(--acq-pink-soft); }

  /* ===== TITRES DE SECTION ===== */
  .acq-h2 {
    font-family: var(--font-body);
    font-size: 34px;
    line-height: 1.05;
    font-weight: 800;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .acq-h2 { font-size: 44px; }
  }

  @media (min-width: 1024px) {
    .acq-h2 { font-size: 56px; }
  }

  /* ===== SERVICES ===== */
  .acq-services { padding: 0; }

  .acq-services .acq-h2,
  .acq-steps .acq-h2 { margin-bottom: 40px; }

  .bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .bento { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .tile {
    position: relative;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--text-primary) 10%, transparent);
    border-radius: 28px;
    background: var(--bg-elevated);
    padding: 28px;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 24px;
    transition: transform 250ms ease, border-color 250ms ease;
  }

  @media (min-width: 768px) {
    .tile { padding: 32px; min-height: 340px; }
  }

  .tile:hover {
    transform: translateY(-4px);
    border-color: rgba(230, 43, 127, 0.6);
  }

  .tile--span2 {
    background:
      linear-gradient(140deg, rgba(230, 43, 127, 0.24), rgba(250, 98, 68, 0.03) 70%),
      var(--bg-elevated);
  }

  @media (min-width: 1024px) {
    .tile--span2 {
      grid-column: span 2;
      min-height: 470px;
    }
  }

  .tile__head--front {
    position: relative;
    z-index: 1;
    max-width: 340px;
  }

  @media (min-width: 1024px) {
    .tile--span2 .tile__head--front { max-width: calc(100% - 330px); }
  }

  .tile__lbl {
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 3px;
    color: var(--acq-pink-soft);
  }

  .tile__title {
    margin-top: 6px;
    font-family: var(--font-body);
    font-size: 28px;
    line-height: 1.08;
    font-weight: 800;
    color: var(--text-primary);
  }

  .tile__title--lg {
    font-size: 40px;
    line-height: 1;
    letter-spacing: -0.5px;
  }

  @media (min-width: 768px) {
    .tile__title { font-size: 32px; }
    .tile__title--lg { font-size: 54px; }
  }

  @media (min-width: 1024px) {
    .tile__title--lg { font-size: clamp(42px, 4.3vw, 62px); }
  }

  .tile__pills {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .tile__pills--under { margin-top: 16px; }

  /* ----- Téléphone : résultats de recherche locale ----- */
  .phone {
    position: relative;
    margin: 8px auto 4px;
    width: 210px;
    height: 390px;
    flex: none;
    border-radius: 36px;
    background: var(--bg-deep);
    border: 2px solid rgba(230, 43, 127, 0.25);
    padding: 10px;
    transform: rotate(6deg);
    box-shadow: 0 30px 70px rgba(10, 10, 15, 0.55), 0 0 80px rgba(230, 43, 127, 0.3);
  }

  @media (min-width: 1024px) {
    .phone {
      position: absolute;
      right: 56px;
      top: 50%;
      margin: 0;
      transform: translateY(-50%) rotate(6deg);
    }
  }

  .phone__screen {
    height: 100%;
    border-radius: 27px;
    overflow: hidden;
    background: var(--bg-elevated);
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 8px;
  }

  .phone__map {
    display: block;
    width: 100%;
    height: 118px;
    flex: none;
    border-radius: 20px;
  }

  .map-bg { fill: color-mix(in srgb, var(--text-primary) 6%, var(--bg-deep)); }
  .map-block { fill: rgba(230, 43, 127, 0.12); }

  .map-street {
    fill: none;
    stroke: color-mix(in srgb, var(--text-primary) 16%, transparent);
    stroke-width: 3;
    stroke-linecap: round;
  }

  .map-street--main {
    stroke: color-mix(in srgb, var(--text-primary) 26%, transparent);
    stroke-width: 6;
