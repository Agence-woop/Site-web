  .faq__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
    border-radius: var(--radius-bento);
  }

  .faq__question::-webkit-details-marker { display: none; }
  .faq__question::marker { content: ''; }

  .faq__question:hover { color: var(--acq-pink-soft); }

  .faq__question:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
  }

  .faq__icon {
    position: relative;
    width: 28px;
    height: 28px;
    flex: none;
    border-radius: 50%;
    background: rgba(230, 43, 127, 0.14);
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 12px;
    height: 2px;
    border-radius: 1px;
    background: var(--woop-pink);
    transform: translate(-50%, -50%);
    transition: transform 200ms ease;
  }

  .faq__icon::after { transform: translate(-50%, -50%) rotate(90deg); }

  .faq__item[open] .faq__icon::after { transform: translate(-50%, -50%) rotate(0deg); }

  .faq__answer {
    padding: 0 24px 22px;
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  /* ===== BANDEAU FINAL ===== */
  .acq-band { padding: 0 0 var(--acq-section-gap); }

  .cta-band {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 28px;
    border-radius: 28px;
    padding: 32px 24px;
    background: var(--woop-gradient);
  }

  @media (min-width: 768px) {
    .cta-band { padding: 40px 40px; }
  }

  @media (min-width: 1024px) {
    .cta-band {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 48px 56px;
    }
  }

  .cta-band__title {
    font-family: var(--font-body);
    font-size: 30px;
    line-height: 1.1;
    font-weight: 800;
    color: #fff;
  }

  @media (min-width: 768px) {
    .cta-band__title { font-size: 44px; }
  }

  .cta-band__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    align-self: flex-start;
    background: var(--bg-deep);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 17px;
    padding: 18px 34px;
    border-radius: var(--radius-button);
    transition: box-shadow 200ms ease, transform 200ms ease;
  }

  @media (min-width: 1024px) {
    .cta-band__btn { align-self: center; }
  }

  .cta-band__btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 40px rgba(10, 10, 15, 0.45);
  }

  .cta-band__btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* ===== MOUVEMENT RÉDUIT ===== */
  @media (prefers-reduced-motion: reduce) {
    .quiz :global(*),
    .acq-midcta :global(.acq-btn),
    .tile,
    .faq__item,
    .faq__icon::before,
    .faq__icon::after,
    .cta-band__btn {
      transition: none !important;
    }

    .quiz :global(.card:hover),
    .quiz :global(.card.on),
    .acq :global(.acq-btn:hover),
    .tile:hover,
    .cta-band__btn:hover {
      transform: none;
    }
  }
</style>

<script>
  type Option = [string, string];
  interface Question {
    key: string;
    tag: string;
    title: string;
    cols: 2 | 3 | 4;
    pts: number[] | null;
    opts: Option[];
  }
  interface Contact {
    prenom: string;
    entreprise: string;
    courriel: string;
    tel: string;
  }

  const ENDPOINT = 'https://formspree.io/f/xdeeyevl';
  const TIMEOUT_MS = 5000;

  const w = window as unknown as {
    gtag?: (...args: unknown[]) => void;
    woopMetaTrack?: (eventName: string, params?: Record<string, unknown>) => void;
  };

  /* Mesure : aucune donnée personnelle ni réponse du quiz n'est transmise. */
  function trackGoogle(eventName: string, params: Record<string, unknown>) {
    if (typeof w.gtag === 'function') w.gtag('event', eventName, params);
  }
  function trackMeta(eventName: string, params: Record<string, unknown>) {
    if (typeof w.woopMetaTrack === 'function') w.woopMetaTrack(eventName, params);
  }

  const escapeHtml = (value: string) =>
    value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c] as string));

  const CHEVRON =
    '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M9 18l6-6-6-6"/></svg>';

  /* ----- Illustrations des cartes ----- */
  const I = (d: string) =>
    '<span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">' + d + '</svg></span>';
  const bars = (n: number) => {
    const h = [6, 14, 22, 30, 38, 44];
    let s = '';
    for (let i = 0; i < 5; i++) {
      const on = i < n;
      s += '<rect x="' + i * 22 + '" y="' + (on ? 44 - h[i + 1] : 38) + '" width="16" height="' + (on ? h[i + 1] : 6) + '" rx="3" class="' + (on ? 'bar-on' : 'bar-off') + '"/>';
    }
    return '<svg width="120" height="44" viewBox="0 0 120 44" aria-hidden="true" focusable="false">' + s + '</svg>';
  };
  const serp = (pos: number) => {
    let s = '';
    for (let i = 0; i < 4; i++) s += '<b class="' + (i === pos ? 'me' : '') + '"></b>';
    return '<span class="serp">' + s + '</span>';
  };
  const big = (t: string) => '<span class="big">' + t + '</span>';
  const stars = (n: number) => '<span class="stars">' + '★'.repeat(n) + '<i>' + '★'.repeat(5 - n) + '</i></span>';

  /* pts : points de chaque réponse pour le score sur 100 (null = question non notée) */
  const Q: Question[] = [
    { key: 'activite', tag: 'VOTRE MÉTIER', title: "Votre activité, c'est plutôt…", cols: 3, pts: null, opts: [
      [I('<path d="M9.5 3h5a1 1 0 0 1 1 1v4.5H20a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1h-4.5V20a1 1 0 0 1-1 1h-5a1 1 0 0 1-1-1v-4.5H4a1 1 0 0 1-1-1v-5a1 1 0 0 1 1-1h4.5V4a1 1 0 0 1 1-1z"/>'), 'Clinique de santé, médicale ou dentaire'],
      [I('<path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z"/><path d="M19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z"/>'), 'Esthétique, spa, massage'],
      [I('<path transform="rotate(-45 12 12)" d="M7.79 10.6H16.21A2.3 2.3 0 1 1 19.34 12A2.3 2.3 0 1 1 16.21 13.4H7.79A2.3 2.3 0 1 1 4.66 12A2.3 2.3 0 1 1 7.79 10.6Z"/>'), 'Physio, ostéo, chiro'],
      [I('<path d="M7.5 12h9"/><rect x="4.5" y="7" width="3" height="10" rx="1"/><rect x="16.5" y="7" width="3" height="10" rx="1"/><rect x="2" y="9" width="2.5" height="6" rx=".8"/><rect x="19.5" y="9" width="2.5" height="6" rx=".8"/>'), 'Pilates, yoga, gym'],
      [I('<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M3 13h18"/>'), 'Cabinet de recrutement'],
      [I('<circle cx="5" cy="12" r="1.5"/><circle cx="12" cy="12" r="1.5"/><circle cx="19" cy="12" r="1.5"/>'), 'Autre']] },
    { key: 'chiffre_affaires', tag: 'TAILLE', title: "Votre chiffre d'affaires mensuel ?", cols: 3, pts: null, opts: [
      [bars(0), 'En lancement'], [bars(1), 'Moins de 20 k$ / mois'], [bars(2), '20 à 50 k$ / mois'],
      [bars(3), '50 à 100 k$ / mois'], [bars(4), '100 à 250 k$ / mois'], [bars(5), 'Plus de 250 k$ / mois']] },
    { key: 'publicite', tag: 'PUBLICITÉ', title: 'Vous diffusez déjà des publicités ?', cols: 4, pts: [0, 8, 14, 10], opts: [
      [I('<circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/>'), 'Pas encore'],
      [I('<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"/>'), 'Oui, en interne'],
      [I('<path d="M3 21V8l9-5 9 5v13"/><path d="M9 21v-6h6v6"/>'), 'Oui, avec une agence'],
      [I('<rect x="4" y="5" width="16" height="11" rx="2"/><path d="M2 19h20"/>'), 'Oui, avec un pigiste']] },
    { key: 'budget_media', tag: 'BUDGET MÉDIA', title: 'Votre budget publicitaire mensuel ?', cols: 3, pts: [0, 4, 10, 14, 15], opts: [
      [big('0 $'), "Rien pour l'instant"], [big('&lt; 500 $'), 'Moins de 500 $ / mois'], [big('500 $+'), '500 à 2 000 $ / mois'],
      [big('2 k$+'), '2 000 à 5 000 $ / mois'], [big('5 k$+'), 'Plus de 5 000 $ / mois']] },
    { key: 'visibilite_google', tag: 'VISIBILITÉ GOOGLE', title: 'Sur Google, avec votre service et votre quartier, vous êtes…', cols: 4, pts: [30, 12, 6, 0], opts: [
      [serp(0), 'Dans les 3 premiers'], [serp(3), 'Plus bas'], ['<span class="serp serp--unknown">?</span>', 'Je ne sais pas'], [serp(-1).replace('class="serp"', 'class="serp serp--none"'), 'Introuvable']] },
    { key: 'avis_google', tag: 'RÉPUTATION', title: "Combien d'avis Google ?", cols: 4, pts: [4, 12, 18, 25], opts: [
      [big('&lt; 20') + stars(1), 'Moins de 20'], [big('20+') + stars(2), '20 à 100'], [big('100+') + stars(4), '100 à 300'], [big('300+') + stars(5), 'Plus de 300']] },
    { key: 'objectif', tag: 'OBJECTIF', title: 'Votre objectif principal ?', cols: 4, pts: null, opts: [
      [I('<circle cx="9" cy="8" r="3.5"/><path d="M3 20c0-3.5 2.7-6 6-6s6 2.5 6 6M19 8v6M16 11h6"/>'), 'Plus de nouveaux clients'],
      [I('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18"/><rect x="7" y="13" width="4" height="4" rx="1" fill="currentColor"/>'), 'Remplir les créneaux creux'],
      [I('<g transform="rotate(45 12 12)"><path d="M12 2.5c2.8 2.2 4.2 5.4 4.2 9.3v4.7H7.8v-4.7c0-3.9 1.4-7.1 4.2-9.3z"/><circle cx="12" cy="9.6" r="1.8"/><path d="M7.8 12.6l-2.6 2.3v3.2l2.6-1.6M16.2 12.6l2.6 2.3v3.2l-2.6-1.6"/><path d="M10.2 19.2c.4 1.1 1 1.9 1.8 2.5.8-.6 1.4-1.4 1.8-2.5"/></g>'), 'Lancer un service'],
      [I('<path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/>'), 'Bâtir ma marque tout en performant']] },
    { key: 'creatif', tag: 'CRÉATIF', title: 'Où en êtes-vous côté créatif ?', cols: 3, pts: [4, 10, 16], opts: [
      ['<span class="crea crea--empty">+</span>', 'Rien, tout est à produire'],
      ['<span class="crea crea--few"><i class="c-grad"></i><i class="c-soft"></i><i class="c-dash"></i></span>', 'Quelques photos et vidéos'],
      ['<span class="crea crea--full"><i class="c-grad"></i><i class="c-pink"></i><i class="c-mid"></i><i class="c-mid"></i><i class="c-grad"></i><i class="c-pink"></i></span>', "Banque d'images prête"]] },
    { key: 'demarrage', tag: 'TIMING', title: 'Quand souhaitez-vous démarrer ?', cols: 4, pts: null, opts: [
      [I('<path d="M13 2L4 14h7l-1 8 9-12h-7z"/>'), 'Dès que possible'],
      [I('<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>'), 'Dans le mois'],
      [I('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>'), 'Ce trimestre'],
      [I('<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z"/>'), "J'explore pour l'instant"]] },
  ];
  const TOTAL = Q.length + 1; /* + coordonnées */
  const C_ASIDE = 2 * Math.PI * 120;
  const C_RESULT = 2 * Math.PI * 126;

  const root = document.querySelector<HTMLElement>('[data-quiz]');
  const intro = root?.querySelector<HTMLElement>('[data-intro]');
  const stage = root?.querySelector<HTMLElement>('[data-stage]');

  if (root && intro && stage) {
    const base = root.dataset.base ?? '';
    const privacyUrl = root.dataset.privacy ?? `${base}/confidentialite-et-conditions/`;
    const auditUrl = (s: number) => `${base}/contact/?source=quiz&score=${s}`;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let state: { step: number; answers: Record<number, number>; contact: Partial<Contact> } = { step: 0, answers: {}, contact: {} };
    let advancing = false;
    let submitting = false;

    const score = () => {
      let s = 0;
      Q.forEach((q, i) => {
        const a = state.answers[i];
        if (q.pts && a != null) s += q.pts[a];
      });
      return s;
    };

    /* Conseils personnalisés : 2 conseils A1 à A8 (dans l'ordre de priorité), puis le conseil lié à l'objectif */
    interface Tip { title: string; tip: string }
    const answer = (key: string) => {
      const i = Q.findIndex((q) => q.key === key);
      const a = state.answers[i];
      return a != null ? Q[i].opts[a][1] : '';
    };
    const actions = (): Tip[] => {
      const recrutement = answer('activite') === 'Cabinet de recrutement';
      const google = answer('visibilite_google');
      const avis = answer('avis_google');
      const pub = answer('publicite');
      const budget = answer('budget_media');
      const creatif = answer('creatif');
      const objectif = answer('objectif');
      const diffuse = pub !== '' && pub !== 'Pas encore';

      const bank: { ok: boolean; title: string; tip: string }[] = [
        { ok: google === 'Plus bas' || google === 'Introuvable',
          title: 'Grimper dans les résultats locaux de Google',
          tip: "Complétez votre fiche d'établissement Google à 100 % (services, heures, photos récentes) et publiez-y une nouvelle chaque semaine." },
        { ok: google === 'Je ne sais pas',
          title: 'Vérifier votre position réelle sur Google',
          tip: 'Cherchez votre service et votre quartier sur Google depuis votre téléphone, en navigation privée : ' +
            (recrutement ? "c'est exactement ce que voient vos futurs clients." : "c'est exactement ce que voient vos futurs patients.") },
        { ok: avis === 'Moins de 20' || avis === '20 à 100',
          title: 'Collecter des avis régulièrement',
          tip: recrutement
            ? 'Invitez chaque client à laisser un avis, avec un lien direct envoyé après chaque mandat, et répondez à chacun.'
            : 'Invitez chaque patient à laisser un avis, avec un lien direct envoyé par texto après sa visite, et répondez à chacun.' },
        { ok: pub === 'Pas encore',
          title: 'Tester la publicité sur un seul service',
          tip: 'Commencez par une campagne, sur votre service le plus demandé, et mesurez le coût ' +
            (recrutement ? "d'un nouveau client" : "d'un nouveau patient") + " avant d'augmenter le budget." },
        { ok: diffuse,
          title: 'Mesurer ce que rapportent vos publicités',
          tip: 'Vérifiez que vous savez combien de rendez-vous chaque campagne génère, pas seulement combien de clics elle obtient.' },
        { ok: diffuse && (budget === 'Moins de 500 $ / mois' || budget === '500 à 2 000 $ / mois'),
          title: 'Concentrer votre budget',
          tip: 'Fixez un budget test sur 4 à 6 semaines et misez-le sur un seul objectif plutôt que de le disperser.' },
        { ok: creatif === 'Rien, tout est à produire' || creatif === 'Quelques photos et vidéos',
          title: recrutement ? 'Montrer votre vrai cabinet' : 'Montrer votre vraie clinique',
          tip: recrutement
            ? 'Organisez une séance photo de votre équipe et de vos bureaux : de vraies images inspirent beaucoup plus confiance que des photos génériques.'
            : 'Organisez une séance photo de votre équipe et de vos lieux : de vraies images inspirent beaucoup plus confiance que des photos génériques.' },
        { ok: true,
          title: 'Créer une page dédiée à votre offre',
          tip: "Envoyez vos visiteurs vers une page qui parle d'une seule offre, avec un seul bouton de prise de rendez-vous, plutôt que vers votre page d'accueil." },
      ];
      const actuels = recrutement ? 'vos clients actuels' : 'vos patients actuels';
      const byGoal: Record<string, Tip> = {
        'Plus de nouveaux clients': {
          title: 'Simplifier la prise de rendez-vous',
          tip: 'Rendez la réservation en ligne accessible en un clic sur votre site et votre fiche Google : chaque étape en moins augmente vos chances de rendez-vous.' },
        'Remplir les créneaux creux': {
          title: 'Mettre vos plages libres en avant',
          tip: 'Repérez vos créneaux les plus creux et faites-les connaître : publication, courriel à ' + actuels + ', réservation en ligne bien visible.' },
        'Lancer un service': {
          title: 'Préparer le lancement de votre service',
          tip: "Donnez-lui sa propre page, avec ses bénéfices concrets, et annoncez-le d'abord à " + actuels + ', vos meilleurs ambassadeurs.' },
        'Bâtir ma marque tout en performant': {
          title: 'Uniformiser votre image',
          tip: 'Utilisez les mêmes couleurs, le même ton et les mêmes photos sur votre site, votre fiche Google et vos réseaux : la cohérence crée la confiance.' },
      };

      const out: Tip[] = bank.filter((t) => t.ok).slice(0, 2).map(({ title, tip }) => ({ title, tip }));
      const goal = byGoal[objectif];
      if (goal && !out.some((t) => t.title === goal.title)) out.push(goal);
      return out;
    };

    const verdict = (s: number) =>
      s < 40
        ? 'Presque invisible. Vos concurrents captent vos clients.'
        : s < 70
          ? 'On vous trouve, mais vos concurrents passent devant.'
          : 'Belle base. On peut accélérer.';

    const segs = (step: number) => {
      let s = '<div class="segs" aria-hidden="true">';
      for (let i = 1; i <= TOTAL; i++) s += '<div class="seg ' + (i < step ? 'done' : i === step ? 'now' : '') + '"></div>';
      return s + '</div>';
    };

    const aside = (step: number) =>
      '<aside class="aside" aria-hidden="true"><span class="aside__eyebrow">VOTRE SCORE SE CONSTRUIT</span>' +
      '<div class="score-ring"><svg viewBox="0 0 300 300" focusable="false"><defs><linearGradient id="acq-ring-aside" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="stop-orange"/><stop offset="1" class="stop-pink"/></linearGradient></defs>' +
      '<circle cx="150" cy="150" r="120" class="ring-track" stroke-width="26"/>' +
      '<circle cx="150" cy="150" r="120" class="ring-value" stroke="url(#acq-ring-aside)" stroke-width="26" stroke-dasharray="' + ((C_ASIDE * (step - 1)) / TOTAL).toFixed(1) + ' ' + C_ASIDE.toFixed(1) + '" transform="rotate(-90 150 150)"/></svg>' +
      '<div class="score-ring__label"><strong>??</strong></div></div>' +
      '<span class="aside__note">Révélé à la fin, avec vos 3 actions prioritaires</span></aside>';

    const frame = (step: number, inner: string) =>
      segs(step) + '<div class="qbody"><div class="qmain">' + inner + '</div>' + aside(step) + '</div>';

    const head = (step: number, tag: string, title: string) =>
      '<div class="qhead"><span class="eyebrow">ÉTAPE ' + step + ' / ' + TOTAL + '</span><span class="tag">' + tag + '</span></div>' +
      '<h2 class="qtitle" tabindex="-1" data-focus>' + title + '</h2>';

    const updateBand = (s: number) => {
      const band = document.querySelector<HTMLAnchorElement>('[data-audit-band]');
      if (band) band.href = auditUrl(s);
    };

    function go(n: number) {
      state.step = Math.max(0, n);
      advancing = false;
      render();
      const target =
        state.step === 0
          ? intro!.querySelector<HTMLElement>('[data-intro-title]')
          : stage!.querySelector<HTMLElement>('[data-focus]');
      target?.focus({ preventScroll: true });
      root!.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' });
    }

    function renderQuestion(st: number) {
      const qi = st - 1;
      const q = Q[qi];
      let cards = '';
      q.opts.forEach((o, oi) => {
        const on = state.answers[qi] === oi;
        cards +=
          '<button type="button" class="card' + (on ? ' on' : '') + '" data-o="' + oi + '" aria-pressed="' + on + '">' +
          '<span class="card__visual" aria-hidden="true">' + o[0] + '</span><span class="lab">' + o[1] + '</span></button>';
      });
      stage!.innerHTML = frame(st,
        head(st, q.tag, q.title) +
        '<div class="grid g' + q.cols + '">' + cards + '</div>' +
        '<div class="qfoot"><button type="button" class="back" data-back>← RETOUR</button><span class="hint">Un clic suffit, on passe à la suite</span></div>');

      stage!.querySelectorAll<HTMLButtonElement>('.card').forEach((b) => {
        b.addEventListener('click', () => {
          if (advancing) return;
          advancing = true;
          state.answers[qi] = Number(b.dataset.o);
          stage!.querySelectorAll<HTMLButtonElement>('.card').forEach((other) => {
            const on = other === b;
            other.classList.toggle('on', on);
            other.setAttribute('aria-pressed', String(on));
          });
          window.setTimeout(() => go(st + 1), 230);
        });
      });
      stage!.querySelector('[data-back]')?.addEventListener('click', () => go(st - 1));
    }

    function renderContact(st: number) {
      const c = state.contact;
      const val = (v?: string) => escapeHtml(v ?? '');
      stage!.innerHTML = frame(st,
        head(st, 'DERNIÈRE ÉTAPE', 'Votre score est prêt. Débloquez-le.') +
        '<form class="contact-form" novalidate>' +
        '<label class="field">Prénom<input name="prenom" autocomplete="given-name" required value="' + val(c.prenom) + '"></label>' +
        '<label class="field">Nom de l\'entreprise<input name="entreprise" autocomplete="organization" placeholder="Clinique, studio…" value="' + val(c.entreprise) + '"></label>' +
        '<label class="field">Courriel<input name="courriel" type="email" autocomplete="email" required placeholder="vous@clinique.ca" value="' + val(c.courriel) + '"></label>' +
        '<label class="field">Téléphone<input name="tel" type="tel" autocomplete="tel" placeholder="514 000 0000" value="' + val(c.tel) + '"></label>' +
        '<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />' +
        '<label class="consent"><input type="checkbox" name="consent" required><span>J\'accepte que WOOP me contacte au sujet de mon score. Vos données sont traitées conformément à notre <a href="' + escapeHtml(privacyUrl) + '">politique de confidentialité</a>.</span></label>' +
        '<p class="err" data-err></p>' +
        '<button type="submit" class="acq-btn acq-btn--lg" data-submit>Débloquer mon score ' + CHEVRON + '</button></form>' +
        '<div class="qfoot"><button type="button" class="back" data-back>← RETOUR</button><span class="hint">Votre score s\'affiche immédiatement.</span></div>');

      const form = stage!.querySelector<HTMLFormElement>('form')!;
      const err = stage!.querySelector<HTMLElement>('[data-err]')!;
      const back = stage!.querySelector<HTMLButtonElement>('[data-back]')!;
      const submit = stage!.querySelector<HTMLButtonElement>('[data-submit]')!;
      const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement;

      back.addEventListener('click', () => {
        if (!submitting) go(st - 1);
      });

      const fail = (input: HTMLInputElement, message: string) => {
        err.textContent = message;
        input.setAttribute('aria-invalid', 'true');
        input.focus();
      };

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        if (submitting) return;
        ['prenom', 'courriel', 'consent'].forEach((n) => field(n).removeAttribute('aria-invalid'));
        err.textContent = '';

        const prenom = field('prenom').value.trim();
        const entreprise = field('entreprise').value.trim();
        const courriel = field('courriel').value.trim();
        const tel = field('tel').value.trim();

        if (!prenom) return fail(field('prenom'), "Votre prénom, s'il vous plaît.");
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(courriel)) return fail(field('courriel'), "Un courriel valide, s'il vous plaît.");
        if (!field('consent').checked) return fail(field('consent'), 'Cochez la case pour débloquer votre score.');

        state.contact = { prenom, entreprise, courriel, tel };
        try {
          window.sessionStorage.setItem('woopQuizContact', JSON.stringify({ prenom, entreprise, courriel, tel }));
        } catch {
          // stockage indisponible : la page contact ne sera simplement pas préremplie
        }

        submitting = true;
        submit.disabled = true;
        back.disabled = true;
        submit.textContent = 'Calcul de votre score…';

        const s = score();
        const ok = await send({ prenom, entreprise, courriel, tel }, s, field('_gotcha').value);
        if (ok) {
          trackGoogle('generate_lead', {
            form_id: 'quiz_visibilite',
            form_destination: 'formspree',
            lead_source: 'quiz-acquisition',
            score: s,
          });
          trackMeta('Lead', { content_name: 'quiz_visibilite' });
        }

        submitting = false;
        updateBand(s);
        go(TOTAL + 1);
      });
    }

    function renderResult() {
      const s = score();
      const prenom = state.contact.prenom;
      let acts = '';
      actions().forEach((t, i) => {
        acts += '<li class="action"><span class="action__num" aria-hidden="true">' + (i + 1) + '</span>' +
          '<span class="action__body"><strong class="action__title">' + t.title + '</strong><span class="action__tip">' + t.tip + '</span></span></li>';
      });
      stage!.innerHTML =
        '<div class="result">' +
        '<div class="score-ring result__ring"><svg viewBox="0 0 300 300" role="img" aria-label="Score de ' + s + ' sur 100" focusable="false"><defs><linearGradient id="acq-ring-result" x1="0" y1="0" x2="1" y2="1"><stop offset="0" class="stop-orange"/><stop offset="1" class="stop-pink"/></linearGradient></defs>' +
        '<circle cx="150" cy="150" r="126" class="ring-track" stroke-width="18"/>' +
        '<circle cx="150" cy="150" r="126" class="ring-value" stroke="url(#acq-ring-result)" stroke-width="18" stroke-dasharray="' + ((C_RESULT * s) / 100).toFixed(1) + ' ' + C_RESULT.toFixed(1) + '" transform="rotate(-90 150 150)"/></svg>' +
        '<div class="score-ring__label" aria-hidden="true"><strong>' + s + '</strong><span>sur 100</span></div></div>' +
        '<div class="result__body">' +
        '<span class="eyebrow result__eyebrow">' + (prenom ? escapeHtml(prenom.toLocaleUpperCase('fr-CA')) + ', ' : '') + 'VOTRE SCORE DE VISIBILITÉ WOOP</span>' +
        '<h2 class="qtitle result__verdict" tabindex="-1" data-focus>' + verdict(s) + '</h2>' +
        '<p class="result__intro">D\'après vos réponses, voici par où commencer. Trois actions simples, que vous pouvez mettre en place vous-même dès maintenant.</p>' +
        '<ol class="actions">' + acts + '</ol>' +
        '<div class="result__cta">' +
        '<a class="acq-btn" href="' + escapeHtml(auditUrl(s)) + '" data-audit="resultat_quiz">Réserver mon audit de 30 minutes ' + CHEVRON + '</a>' +
        '<p class="result__cta-note">30 minutes pour passer vos résultats en revue et bâtir votre plan.</p>' +
        '<button type="button" class="restart" data-restart>Refaire le test</button>' +
        '</div></div></div>';

      stage!.querySelector('[data-restart]')?.addEventListener('click', () => {
        state = { step: 0, answers: {}, contact: {} };
        go(0);
      });
    }

    function render() {
      const st = state.step;
      if (st === 0) {
        stage!.hidden = true;
        stage!.innerHTML = '';
        intro!.hidden = false;
        return;
      }
      intro!.hidden = true;
      stage!.hidden = false;
      if (st <= Q.length) renderQuestion(st);
      else if (st === TOTAL) renderContact(st);
      else renderResult();
    }

    /* Envoi à Formspree : au plus 5 secondes d'attente, jamais bloquant. */
    async function send(contact: Contact, s: number, gotcha: string): Promise<boolean> {
      const payload: Record<string, string> = {
        prenom: contact.prenom,
        entreprise: contact.entreprise,
        courriel: contact.courriel,
        telephone: contact.tel,
        score: `${s}/100`,
      };
      Q.forEach((q, i) => {
        const a = state.answers[i];
        payload[q.key] = a != null ? q.opts[a][1] : '';
      });
      payload.actions_prioritaires = actions().map((t) => t.title).join(' | ');
      payload.source = 'quiz-acquisition';
      payload._subject = `Quiz visibilité : ${contact.entreprise || contact.prenom} (${s}/100)`;
      payload._replyto = contact.courriel;
      payload._gotcha = gotcha;

      const controller = typeof AbortController === 'function' ? new AbortController() : null;
      let timer = 0;
      const timeout = new Promise<boolean>((resolve) => {
        timer = window.setTimeout(() => {
          controller?.abort();
          resolve(false);
        }, TIMEOUT_MS);
      });
      const request = fetch(ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(payload),
        signal: controller?.signal,
      })
        .then((res) => res.ok)
        .catch(() => false);

      try {
        return await Promise.race([request, timeout]);
      } finally {
        window.clearTimeout(timer);
      }
    }

    intro.querySelector('[data-start]')?.addEventListener('click', () => {
      trackGoogle('quiz_start', { quiz_id: 'visibilite' });
      go(1);
    });
  }

  /* Bouton du milieu de page : remonte à la carte du quiz, sans la réinitialiser */
  document.querySelector('[data-quiz-cta]')?.addEventListener('click', () => {
    trackGoogle('quiz_cta_click', { location: 'milieu_page' });
    const quiz = document.querySelector<HTMLElement>('[data-quiz]');
    if (!quiz) return;
    const introEl = quiz.querySelector<HTMLElement>('[data-intro]');
    const target = introEl && !introEl.hidden
      ? introEl.querySelector<HTMLElement>('[data-intro-title]')
      : quiz.querySelector<HTMLElement>('[data-stage] [data-focus]');
    target?.focus({ preventScroll: true });
    const smooth = !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    quiz.scrollIntoView({ behavior: smooth ? 'smooth' : 'auto', block: 'start' });
  });

  /* Clics vers l'audit (écran de résultat et bandeau final) */
  document.addEventListener('click', (e) => {
    const link = (e.target as Element | null)?.closest<HTMLElement>('[data-audit]');
    if (!link) return;
    const location = link.dataset.audit;
    if (location === 'resultat_quiz' || location === 'bandeau_final') {
      trackGoogle('audit_cta_click', { location });
    }
  });
</script>
