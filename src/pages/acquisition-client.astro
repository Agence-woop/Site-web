    color: var(--text-muted);
  }

  .kpi--no em {
    text-decoration: line-through;
    font-style: normal;
  }

  /* ----- Stratégie adaptée (fond rose plein) ----- */
  .tile--pink {
    background: var(--woop-pink);
    border-color: transparent;
  }

  .tile--pink:hover { border-color: rgba(255, 255, 255, 0.5); }

  .tile--pink .tile__title { color: #fff; }
  .tile--pink .tile__lbl { color: var(--bg-deep); }

  .growth {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 110px;
