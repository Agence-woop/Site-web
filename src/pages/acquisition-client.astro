  /* ----- Mise en place (orange plein) ----- */
  .tile--orange {
    background: var(--woop-orange);
    border-color: transparent;
  }

  .tile--orange:hover { border-color: rgba(255, 255, 255, 0.5); }

  .tile--orange .tile__title { color: #fff; }
  .tile--orange .tile__lbl { color: var(--bg-deep); }

  .setup {
    display: flex;
    flex-direction: column;
    gap: 14px;
