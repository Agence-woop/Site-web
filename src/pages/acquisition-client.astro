  .seo-block__title {
    font-family: var(--font-body);
    font-size: 24px;
    line-height: 1.2;
    font-weight: 800;
    color: var(--text-primary);
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .seo-block__title { font-size: 28px; }
  }

  .seo-block__text {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  @media (min-width: 1024px) {
    .seo-block__text { font-size: 17px; }
  }

  .seo-block__text + .seo-block__text { margin-top: 16px; }

  /* ===== FAQ ===== */
  .acq-faq { padding: 0; }

  .acq-h2--faq { margin-bottom: 40px; }

  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  @media (min-width: 1024px) {
    .faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
      gap: 16px;
    }
