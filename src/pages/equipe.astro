---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/equipe/`;
const ORG_ID = `${SITE_URL}/#organization`;
const PAGE_TITLE = 'L’équipe WOOP : Gauthier, Kevin, Emma et Ludo | Montréal';

// Graphe JSON-LD : la page, l'agence (fondateurs et employée), les 4 personnes, le fil d'Ariane.
// Ludo est seulement cité par la page (mentions), sans lien avec l'organisation ni sameAs.
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'AboutPage',
        '@id': `${PAGE_URL}#page`,
        url: PAGE_URL,
        name: PAGE_TITLE,
        inLanguage: 'fr-CA',
        about: { '@id': ORG_ID },
        mentions: [{ '@id': `${PAGE_URL}#ludo-santos` }],
        breadcrumb: { '@id': `${PAGE_URL}#breadcrumb` },
      },
      {
        '@type': 'Organization',
        '@id': ORG_ID,
        name: 'Agence WOOP',
        url: `${SITE_URL}/`,
        founder: [{ '@id': `${PAGE_URL}#gauthier-figueres` }, { '@id': `${PAGE_URL}#kevin-zounias` }],
        employee: [{ '@id': `${PAGE_URL}#emma-despujols` }],
      },
      {
        '@type': 'Person',
        '@id': `${PAGE_URL}#gauthier-figueres`,
        name: 'Gauthier Figueres',
        jobTitle: 'Cofondateur, stratégie',
        image: `${SITE_URL}/images/gauthier.webp`,
        worksFor: { '@id': ORG_ID },
        sameAs: ['https://www.linkedin.com/in/gauthier-f-00561b203/'],
      },
      {
        '@type': 'Person',
        '@id': `${PAGE_URL}#kevin-zounias`,
        name: 'Kevin Zounias',
        jobTitle: 'Cofondateur, création',
        image: `${SITE_URL}/images/kevin.webp`,
        worksFor: { '@id': ORG_ID },
        sameAs: ['https://www.linkedin.com/in/k%C3%A9vin-zounias/'],
      },
      {
        '@type': 'Person',
        '@id': `${PAGE_URL}#emma-despujols`,
        name: 'Emma Despujols',
        jobTitle: 'Spécialiste Paid Media',
        image: `${SITE_URL}/images/emma.webp`,
        worksFor: { '@id': ORG_ID },
        sameAs: ['https://www.linkedin.com/in/emma-despujols-161235211/'],
      },
      {
        '@type': 'Person',
        '@id': `${PAGE_URL}#ludo-santos`,
        name: 'Ludo Santos',
        jobTitle: 'Développeur web',
        image: `${SITE_URL}/images/ludo.webp`,
      },
      {
        '@type': 'BreadcrumbList',
        '@id': `${PAGE_URL}#breadcrumb`,
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
          { '@type': 'ListItem', position: 2, name: 'Équipe', item: PAGE_URL },
        ],
      },
    ],
  },
];

// Espace insécable devant « : » et « ? » (typographie française, sans changer le texte)
const NB = ' ';

// Photos rondes : mêmes données et même cadrage que la page d'accueil (Ludo : cadrage propre).
// - fx / fy : cadrage d'origine (photo calée en haut, agrandie autour de ce point).
// - objectPosition / zoom : cadrage propre à une photo (remplace le cadrage d'origine).
type Framed = {
  fx?: string;
  fy?: string;
  objectPosition?: string;
  zoom?: number;
};

type TeamMember = Framed & { name: string; img: string; w?: number; h?: number };

const team: TeamMember[] = [
  { name: 'Gauthier', img: 'gauthier', objectPosition: '57.8% 30.6%', zoom: 1.7 },
  { name: 'Kevin', img: 'kevin', fx: '50%', fy: '31%' },
  { name: 'Emma', img: 'emma', fx: '55%', fy: '31%' },
  // Ludo : photo plus large (928 × 1137, même format) où le visage est plus petit ; cadrage réglé
  // pour aligner la ligne des yeux et la taille du visage sur Kevin.
  { name: 'Ludo', img: 'ludo', w: 928, h: 1137, objectPosition: '50.4% 21.7%', zoom: 1.9 },
];

const framing = (m: Framed) =>
  m.objectPosition !== undefined || m.zoom !== undefined
    ? `--obj-pos: ${m.objectPosition ?? 'center'}; --zoom: ${m.zoom ?? 1};`
    : `--fx: ${m.fx ?? '50%'}; --fy: ${m.fy ?? '30%'};`;
const isFramed = (m: Framed) => m.objectPosition !== undefined || m.zoom !== undefined;

// 01 · Qui fait quoi ? Une fiche par personne (bio complète, en paragraphes).
// Dans `bio`, un segment { link } devient un lien discret, identique au texte qui l'entoure.
type Segment = string | { text: string; href: string };

type Profile = Framed & {
  key: string;
  expertise: string;
  hub: string;
  first: string;
  name: string;
  role: string;
  img: string;
  width: number;
  height: number;
  /** Cadrage de la photo verticale de la fiche */
  photoPos: string;
  bio: Segment[][];
  linkedin?: string;
  contact?: string;
  hubPos: 'a' | 'b' | 'c' | 'd';
};

const profiles: Profile[] = [
  {
    key: 'gauthier',
    expertise: 'Stratégie',
    hub: 'Stratégie',
    first: 'Gauthier',
    name: 'Gauthier Figueres',
    role: 'Cofondateur · Stratégie',
    img: 'gauthier',
    width: 671,
    height: 822,
    photoPos: '50% 35%',
    objectPosition: '57.8% 30.6%',
    zoom: 1.7,
    bio: [
      ['Infirmier clinicien de formation, Gauthier a basculé vers la gestion médicale il y a plusieurs années. Il dirige aujourd’hui les opérations médicales dans l’aéromédical et il est expert des soins en communauté et en régions éloignées.'],
      ['Ancien directeur de cliniques privées et détenteur d’un MBA, il pilote chez WOOP la stratégie et ', { text: 'les comptes Santé', href: `${base}/services-medical/` }, '.'],
    ],
    linkedin: 'https://www.linkedin.com/in/gauthier-f-00561b203/',
    contact: `${base}/contact?personne=gauthier`,
    hubPos: 'a',
  },
  {
    key: 'kevin',
    expertise: 'Création',
    hub: 'Création',
    first: 'Kevin',
    name: 'Kevin Zounias',
    role: 'Cofondateur · Création',
    img: 'kevin',
    width: 671,
    height: 822,
    photoPos: '50% 30%',
    fx: '50%',
    fy: '31%',
    bio: [
      ['Designer graphique de formation, Kevin a développé son expertise marketing au sein d’un cabinet de recrutement spécialisé en santé. Cette double exposition à la création et au marketing en fait l’œil et la main de WOOP.'],
      ['Il pilote l’identité de marque de chaque projet et accompagne ', { text: 'les comptes Recrutement', href: `${base}/services-recrutement/` }, '.'],
    ],
    linkedin: 'https://www.linkedin.com/in/k%C3%A9vin-zounias/',
    contact: `${base}/contact?personne=kevin`,
    hubPos: 'b',
  },
  {
    key: 'emma',
    expertise: 'Acquisition',
    hub: 'Paid Media',
    first: 'Emma',
    name: 'Emma Despujols',
    role: 'Spécialiste Paid Media',
    img: 'emma',
    width: 671,
    height: 822,
    photoPos: '50% 30%',
    fx: '55%',
    fy: '31%',
    bio: [
      ['Diplômée d’emlyon business school, Emma poursuit une maîtrise en gestion de projet à HEC Montréal, après avoir fait ses classes dans de grands médias français.'],
      ['Chez WOOP, elle pilote la performance publicitaire sur Google Ads et Meta Ads, et conçoit les pages de conversion.'],
    ],
    linkedin: 'https://www.linkedin.com/in/emma-despujols-161235211/',
    contact: `${base}/contact?personne=emma`,
    hubPos: 'c',
  },
  {
    key: 'ludo',
    expertise: 'Site web',
    hub: 'Site web',
    first: 'Ludo',
    name: 'Ludo Santos',
    role: 'Développeur web',
    img: 'ludo',
    width: 928,
    height: 1137,
    photoPos: '50% 30%',
    // Même cadrage que dans le bandeau final et la barre collante
    objectPosition: '50.4% 21.7%',
    zoom: 1.9,
    bio: [
      ['Développeur web de formation, Ludo a construit son expertise au sein d’agences de communication. Sensible aux questions d’écoconception et de sobriété numérique, il développe des sites légers, rapides et respectueux des données.'],
      ['Chez WOOP, il prend en charge le développement et l’intégration, et fait le pont entre la création et la performance.'],
    ],
    hubPos: 'd',
  },
];

// 02 · Notre méthode. `hot` : 4e carte en dégradé.
const steps: {
  n: string;
  title: string;
  icon: 'search' | 'pen' | 'megaphone' | 'trend';
  text: string;
  sub: string;
  reveal: 'left' | 'right' | 'up';
  step?: string;
  hot?: boolean;
}[] = [
  {
    n: '01',
    title: 'Diagnostic',
    icon: 'search',
    text: 'Appel découverte et audit. On comprend votre projet, vos objectifs, et ce qui freine votre développement aujourd’hui.',
    sub: `On observe aussi votre présence en ligne actuelle${NB}: ce qui fonctionne, ce qui manque, ce qui peut être renforcé.`,
    reveal: 'left',
  },
  {
    n: '02',
    title: 'Stratégie & marque',
    icon: 'pen',
    text: 'Positionnement, identité visuelle, ton de marque. On pose les fondations sur lesquelles tout le reste va s’appuyer.',
    sub: 'Une marque solide vous permet de justifier un positionnement premium, et aide à faire baisser le coût pour attirer chaque nouveau patient ou candidat.',
    reveal: 'up',
    step: '1',
  },
  {
    n: '03',
    title: 'Acquisition',
    icon: 'megaphone',
    text: 'Campagnes publicitaires sur Google Ads et Meta Ads, pages de conversion. On va chercher vos prospects là où ils sont déjà.',
    sub: 'Chaque dollar investi est suivi, mesuré, optimisé. Pas de pub à l’aveugle.',
    reveal: 'up',
    step: '2',
  },
  {
    n: '04',
    title: 'Optimisation',
    icon: 'trend',
    text: 'Mesure, itération, ajustements. On observe ce qui fonctionne, on corrige ce qui ne marche pas, et on réinvestit là où ça paie.',
    sub: `Résultat${NB}: votre marque gagne en force, votre coût pour générer un nouveau patient (ou candidat) tend à baisser, et la machine s’amplifie d’elle-même.`,
    reveal: 'right',
    step: '3',
    hot: true,
  },
];

// 03 · Notre promesse
const promises = [
  'Vous parlez directement aux gens qui font le travail.',
  'Une équipe 100 % dédiée, qui connaît votre projet de A à Z.',
  'Un fondateur reste toujours dans la boucle.',
];

// Durée d'affichage de chaque profil du carrousel (lue par le script via data-eq-dur)
const SLIDE_MS = 10000;
---
<Layout
  title={PAGE_TITLE}
  description="Gauthier Figueres, Kevin Zounias, Emma Despujols et Ludo Santos : découvrez l’équipe WOOP, qui fait quoi sur votre projet et comment on travaille ensemble."
  ogImage="/images/og-image.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé par reveal. -->
  <ScrollReveal />

  <!-- 1. HERO (sans data-reveal) -->
  <section class="hp-hero md-hero eq-hero" data-hp-hero>
    <div class="container">
      <div class="eq-hero__grid">
        <div class="eq-hero__text">
          <p class="md-pill"><i aria-hidden="true"></i>L’équipe WOOP</p>
          <h1 class="md-hero__title eq-hero__title">L’équipe WOOP, des experts du terrain. <span class="gradient-accent hp-kw">Vous savez qui fait quoi</span> sur votre projet.</h1>
          <p class="md-hero__sub eq-hero__sub">Une équipe complémentaire et nommée. Vous parlez directement aux gens qui font le travail, du premier appel jusqu’à la livraison.</p>
          <p class="md-hero__strong"><strong>Votre équipe marketing, sans avoir à l’embaucher.</strong></p>
          <div class="hp-acts md-hero__acts">
            <a class="cta" href={`${base}/contact`}>Réserver un appel découverte<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l6-6M6 5h5v5"/></svg></span></a>
            <a class="cta cta--line" href="#qui-fait-quoi">Rencontrer l’équipe<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a>
          </div>
        </div>

        <!-- Schéma décoratif : votre projet au centre, relié aux 4 personnes -->
        <div class="eq-hub" aria-hidden="true">
          <svg class="eq-hub__lines" viewBox="0 0 560 420" preserveAspectRatio="none">
            <path d="M280 210 L110 80 M280 210 L450 80 M280 210 L110 340 M280 210 L450 340" vector-effect="non-scaling-stroke" />
          </svg>
          <div class="eq-hub__core">
            <span class="eq-hub__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 11c0 5.6-7 10-7 10z"/></svg></span>
            <b>Votre projet</b>
            <small>Un fondateur toujours dans la boucle</small>
          </div>
          {profiles.map((p) => (
            <div class:list={['eq-hub__n', `eq-hub__n--${p.hubPos}`]}>
              <span class:list={['eq-hub__ph', { 'is-framed': isFramed(p) }]} style={framing(p)}><img src={`${base}/images/${p.img}.webp`} alt="" width={p.width} height={p.height} decoding="async" /></span>
              <span class="eq-hub__lbl"><b>{p.hub}</b><small>{p.first}</small></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 2. QUI FAIT QUOI ? (carrousel à onglets ; sans JavaScript, les 4 fiches s'affichent l'une sous l'autre) -->
  <section class="hp-block hp-sec eq-sec--sp" id="qui-fait-quoi" data-reveal-clip>
    <div class="container">
      <div class="hp-head">
        <p class="md-over" data-reveal="left">01 · Qui fait quoi{NB}?</p>
        <h2 class="section-title hp-title" data-reveal="left">Chacun son <span class="gradient-accent">expertise</span>.</h2>
        <p class="hp-head__intro" data-reveal="left" data-reveal-step="1">Un rôle, une personne. Voici qui travaille sur votre projet.</p>
      </div>

      <div class="eq-sp md-glass" data-eq-sp data-eq-dur={SLIDE_MS} data-reveal="up">
        <!-- Onglets et bouton Pause : affichés seulement si le script tourne -->
        <div class="eq-sp__bar" data-eq-bar hidden>
          <div class="eq-sp__tabs" role="tablist" aria-label="Qui fait quoi">
            {profiles.map((p, i) => (
              <button
                type="button"
                class="eq-sp__tab"
                role="tab"
                id={`eq-tab-${p.key}`}
                aria-controls={`eq-panel-${p.key}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? '0' : '-1'}
                data-eq-tab
              >
                <span>{p.expertise}</span>
                <i class="eq-sp__prog" aria-hidden="true"></i>
              </button>
            ))}
          </div>
          <button type="button" class="eq-sp__pause" data-eq-pause aria-label="Mettre en pause le défilement automatique">
            <svg class="eq-sp__i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2"/><rect x="13.9" y="5" width="3.6" height="14" rx="1.2"/></svg>
            <svg class="eq-sp__i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 001.5.86l10.2-6.4a1 1 0 000-1.72L9.5 4.74A1 1 0 008 5.6z"/></svg>
          </button>
        </div>

        <div class="eq-sp__stage">
          {profiles.map((p, i) => (
            <div class:list={['eq-sp__panel', { 'is-active': i === 0 }]} id={`eq-panel-${p.key}`} data-eq-panel>
              <div class="eq-sp__role">
                <span class="eq-sp__k">Sur votre projet</span>
                <b class="gradient-accent eq-sp__word">{p.expertise}</b>
              </div>
              <article class="eq-sp__card">
                <div class="eq-sp__ph">
                  <img src={`${base}/images/${p.img}.webp`} alt={p.name} width={p.width} height={p.height} loading="lazy" decoding="async" style={`object-position: ${p.photoPos};`} />
                </div>
                <div class="eq-sp__tx">
                  <p class="eq-sp__rl">{p.role}</p>
                  <h3>{p.name}</h3>
                  {p.bio.map((para) => (
                    <p class="eq-sp__bio">
                      {para.map((seg) => (typeof seg === 'string' ? seg : <a class="md-inl" href={seg.href}>{seg.text}</a>))}
                    </p>
                  ))}
                  {(p.linkedin || p.contact) && (
                    <div class="eq-sp__links">
                      {p.linkedin && (
                        <a class="eq-sp__li" href={p.linkedin} target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn de ${p.name}`}>
                          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 11-.01 5 2.5 2.5 0 01.01-5zM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.6 8.65 21 11.1 21 14.3V21h-4v-6c0-1.45-.03-3.3-2-3.3-2 0-2.3 1.55-2.3 3.2V21H9z"/></svg>
                        </a>
                      )}
                      {p.contact && (
                        <a class="cta cta--line cta--sm" href={p.contact}>Parler à {p.first}<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l6-6M6 5h5v5"/></svg></span></a>
                      )}
                    </div>
                  )}
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 3. NOTRE MÉTHODE -->
  <section class="hp-block hp-sec" id="methode" data-reveal-clip>
    <div class="container">
      <div class="hp-head">
        <p class="md-over" data-reveal="left">02 · Notre méthode</p>
        <h2 class="section-title hp-title" data-reveal="left">Comment on travaille <span class="gradient-accent">ensemble</span>.</h2>
        <p class="hp-head__intro" data-reveal="left" data-reveal-step="1">Quatre étapes, toujours dans le même ordre. Vous savez où on en est à chaque moment.</p>
      </div>

      <ol class="md-steps eq-steps">
        {steps.map((s) => (
          <li class:list={['md-st', 'eq-st', { 'md-glass': !s.hot, 'eq-st--hot': s.hot }]} data-reveal={s.reveal} data-reveal-step={s.step}>
            <span class:list={['md-st__d', { 'is-on': s.hot }]} aria-hidden="true">{s.n}</span>
            <div class="eq-st__head">
              <span class:list={['md-xi', 'eq-st__ico', { 'md-xi--w': s.hot }]} aria-hidden="true">
                {s.icon === 'search' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>)}
                {s.icon === 'pen' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 20l4-1 10-10-3-3L5 16z"/><path d="M14 7l3 3"/></svg>)}
                {s.icon === 'megaphone' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-2a1 1 0 011-1h3l7-4v14l-7-4H5a1 1 0 01-1-1z"/><path d="M19 9.5a4 4 0 010 5"/></svg>)}
                {s.icon === 'trend' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l5-5 4 4 7-8"/><path d="M15 8h5v5"/></svg>)}
              </span>
              <h3><span class="visually-hidden">{s.n} </span>{s.title}</h3>
            </div>
            <p>{s.text}</p>
            <p class="eq-st__sub">{s.sub}</p>
          </li>
        ))}
      </ol>

      <div class="md-svc-cta" data-reveal="up">
        <a class="cta" href={`${base}/contact`}>Discuter de votre projet<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l6-6M6 5h5v5"/></svg></span></a>
      </div>

      <a class="hp-teaser eq-teaser" href={`${base}/acquisition-client/`} data-reveal="up">
        <span class="hp-teaser__dot" aria-hidden="true"></span>
        <span><strong>Nouveau :</strong> testez votre visibilité en 2 minutes</span>
        <span class="hp-go" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
      </a>
    </div>
  </section>

  <!-- 4. NOTRE PROMESSE -->
  <section class="hp-block hp-sec" data-reveal-clip>
    <div class="container">
      <div class="eq-prom" data-reveal="up">
        <div class="eq-prom__head">
          <p class="md-over">03 · Notre promesse</p>
          <h2 class="section-title hp-title">Pas d’agence <span class="gradient-accent">anonyme</span>.</h2>
          <p class="hp-head__intro">Chez WOOP, vous savez toujours qui travaille sur votre projet.</p>
        </div>
        <ul class="eq-prom__list">
          {promises.map((t) => (
            <li><span class="eq-prom__ck" aria-hidden="true">✓</span>{t}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- 5. BANDEAU FINAL (identique à celui de l'accueil) -->
  <section class="hp-block hp-block--last hp-sec--final" data-hp-final>
    <div class="container">
      <div class="hp-final" data-reveal="up">
        <div class="hp-avs hp-avs--final" aria-hidden="true">
          {team.map((m) => (
