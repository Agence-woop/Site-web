  /* Cartes vitrées à filet dégradé (cartes, tuiles, bloc Kevin, étapes) */
  .md-glass {
    position: relative;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--woop-pink) 8%, color-mix(in srgb, var(--bg-elevated) 80%, transparent)),
      color-mix(in srgb, var(--bg-elevated) 75%, transparent)
    );
  }

  .md-glass::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(160deg, rgba(230, 43, 127, 0.4), color-mix(in srgb, var(--text-primary) 6%, transparent) 40%, rgba(250, 98, 68, 0.3));
    -webkit-mask: linear-gradient(var(--bg-deep) 0 0) content-box, linear-gradient(var(--bg-deep) 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    pointer-events: none;
  }

  /* ===== SECTIONS ===== */
  /* Une seule règle d'espacement entre deux sections consécutives (voir --home-section-gap). */
  .hp-hero + .hp-block,
  .hp-block + .hp-block { margin-top: var(--home-section-gap); }

  .hp-block--last { padding-bottom: var(--home-section-gap); }

  /* ===== 1. HERO ===== */
  .hp-hero {
    position: relative;
