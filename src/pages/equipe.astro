  .hp-avs--final > span {
    width: 80px;
    height: 80px;
    margin-left: -18px;
    box-shadow: 0 0 0 4px var(--text-primary);
  }

  @media (max-width: 359px) {
    .hp-avs--final > span {
      width: 68px;
      height: 68px;
      margin-left: -16px;
    }
  }

