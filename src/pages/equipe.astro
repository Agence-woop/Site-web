<script>
  // Carrousel « Chacun son expertise » : onglets accessibles (tablist / tab / tabpanel).
  // - Un profil toutes les 10 s ; la fin de l'animation de la barre déclenche le profil suivant,
  //   donc mettre la barre en pause met aussi le minuteur en pause.
  // - Clic, toucher ou clavier (← →, Début, Fin) sur un onglet : le profil choisi s'affiche,
  //   sa barre repart de zéro, puis le défilement continue.
  // - Pause au survol de la fiche (souris), au focus clavier dans la fiche, avec le bouton
  //   Pause / Lecture (toujours visible), au toucher de la fiche sur mobile (un 2e toucher
  //   relance), hors de l'écran et quand l'onglet du navigateur est masqué.
  // - Démarre seulement quand le carrousel est visible.
  // - prefers-reduced-motion : aucun défilement automatique tant que la personne n'appuie
  //   pas sur Lecture.
  // - Sans JavaScript : onglets cachés, les 4 fiches affichées l'une sous l'autre.
  (function () {
    const root = document.querySelector<HTMLElement>('[data-eq-sp]');
    if (!root) return;
    const bar = root.querySelector<HTMLElement>('[data-eq-bar]');
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-eq-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-eq-panel]'));
    const pauseBtn = root.querySelector<HTMLButtonElement>('[data-eq-pause]');
    const stage = root.querySelector<HTMLElement>('.eq-sp__stage');
    if (!bar || !pauseBtn || !stage || tabs.length !== panels.length || !tabs.length) return;

    const dur = Number(root.dataset.eqDur) || 10000;
    root.style.setProperty('--eq-dur', `${dur}ms`);

    // Mise en place des rôles (les fiches restent lisibles sans JavaScript)
    panels.forEach((panel, k) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[k].id);
      panel.tabIndex = 0;
    });
    bar.hidden = false;
    root.classList.add('is-enhanced');

    let cur = 0;
    // Mouvement réduit : rien ne défile tant que la personne n'a pas appuyé sur Lecture
    let stopped = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reasons = { hover: false, focus: false, user: stopped, offscreen: true, hidden: document.hidden };

    const updatePause = () => {
      const paused = Object.values(reasons).some(Boolean);
      root.classList.toggle('is-paused', paused);
    };

    // Relance la barre de l'onglet actif depuis le début
    const restartBar = () => {
      tabs.forEach((t, k) => {
        t.classList.remove('is-run');
        t.classList.toggle('is-done', !stopped && k < cur);
      });
      if (stopped) return;
      void tabs[cur].offsetWidth;
      tabs[cur].classList.add('is-run');
    };

    const select = (n: number, focus = false) => {
      cur = (n + tabs.length) % tabs.length;
      tabs.forEach((t, k) => {
        const on = k === cur;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        panels[k].classList.toggle('is-active', on);
      });
      if (focus) tabs[cur].focus();
      restartBar();
    };

    // Pause / Lecture choisie par la personne (bouton ou toucher de la fiche)
    const setUserPause = (on: boolean) => {
      reasons.user = on;
      root.classList.toggle('is-user-paused', on);
      pauseBtn.setAttribute('aria-label', on ? 'Reprendre le défilement automatique' : 'Mettre en pause le défilement automatique');
      if (!on && stopped) {
        stopped = false;
        root.classList.remove('is-stopped');
        restartBar();
      }
      updatePause();
    };

    if (stopped) root.classList.add('is-stopped');
    setUserPause(reasons.user);

    // Fin de la barre active : profil suivant
    tabs.forEach((t) => {
      t.querySelector('.eq-sp__prog')?.addEventListener('animationend', () => {
        if (!stopped && t === tabs[cur]) select(cur + 1);
      });
    });

    // Onglets : le profil choisi s'affiche et sa barre repart de zéro
    tabs.forEach((t, k) => {
      t.addEventListener('click', () => select(k));
    });

    // Flèches du clavier, Début et Fin (activation immédiate)
    bar.addEventListener('keydown', (e) => {
      if (!(e.target instanceof HTMLElement) || !e.target.matches('[data-eq-tab]')) return;
      const keys: Record<string, number> = { ArrowRight: cur + 1, ArrowLeft: cur - 1, Home: 0, End: tabs.length - 1 };
      if (!(e.key in keys)) return;
      e.preventDefault();
      select(keys[e.key], true);
    });

    // Fiche : pause au survol de la souris ; sur mobile, un toucher met en pause et un
    // 2e toucher relance (comme le bouton). Le toucher passe par « click », qui ne se
    // déclenche pas quand on fait défiler la page. Les fiches inactives sont masquées
    // (visibility: hidden), donc seule la fiche affichée réagit.
    let lastPointer = '';
    panels.forEach((panel) => {
      const card = panel.querySelector<HTMLElement>('.eq-sp__card');
      if (!card) return;
      card.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { reasons.hover = true; updatePause(); } });
      card.addEventListener('pointerleave', () => { reasons.hover = false; updatePause(); });
      card.addEventListener('pointerdown', (e) => { lastPointer = e.pointerType; });
      card.addEventListener('click', (e) => {
        if (lastPointer !== 'touch' && lastPointer !== 'pen') return;
        if (e.target instanceof Element && e.target.closest('a, button')) return;
        setUserPause(!reasons.user);
      });
    });

    // Pause au focus clavier dans la fiche (pas sur les onglets ni sur le bouton,
    // et pas quand un toucher ou un clic place le focus)
    const keyboardFocus = (el: Element) => {
      try { return el.matches(':focus-visible'); } catch { return true; }
    };
    stage.addEventListener('focusin', (e) => {
      reasons.focus = e.target instanceof Element && keyboardFocus(e.target);
      updatePause();
    });
    stage.addEventListener('focusout', (e) => {
      if (e.relatedTarget instanceof Node && stage.contains(e.relatedTarget)) return;
      reasons.focus = false;
      updatePause();
    });

    // Bouton Pause / Lecture
    pauseBtn.addEventListener('click', () => setUserPause(!reasons.user));

    // Démarrage seulement quand le carrousel est visible (et pause s'il sort de l'écran)
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          reasons.offscreen = !entry.isIntersecting;
          updatePause();
        });
      }, { rootMargin: '-20% 0px -20% 0px', threshold: 0 }).observe(root);
    } else {
      reasons.offscreen = false;
    }

    document.addEventListener('visibilitychange', () => { reasons.hidden = document.hidden; updatePause(); });

    updatePause();
    select(0);
  })();
</script>

<script>
  // Bandeau collant (même script que la page d'accueil) : visible une fois le hero dépassé,
  // masqué dès que le bandeau final entre à l'écran (et au-delà). Il ne recouvre jamais la
  // bannière de consentement CookieYes : il se retire tant qu'elle (ou sa fenêtre de
  // préférences) est affichée, et s'écarte du bouton flottant « préférences » de CookieYes
  // s'il est présent dans le bas de l'écran.
  (function () {
    const pop = document.querySelector<HTMLElement>('[data-hp-pop]');
    const hero = document.querySelector<HTMLElement>('[data-hp-hero]');
    const finalBand = document.querySelector<HTMLElement>('[data-hp-final]');
    if (!pop || !hero || !finalBand) return;

    const isShown = (el: Element | null): el is HTMLElement => {
      if (!el) return false;
      const r = (el as HTMLElement).getBoundingClientRect();
      if (r.width === 0 || r.height === 0) return false;
      const cs = window.getComputedStyle(el);
      return cs.display !== 'none' && cs.visibility !== 'hidden' && Number(cs.opacity) > 0;
    };

    // Bannière ou fenêtre de préférences CookieYes ouverte.
    const consentOpen = () => {
      const banner = document.querySelector('.cky-consent-container');
      if (banner && !banner.classList.contains('cky-hide') && isShown(banner)) return true;
      const modal = document.querySelector('.cky-modal.cky-modal-open');
      if (modal && isShown(modal)) return true;
      return false;
    };

    let lastLeft = 12;
    let lastRight = 12;

    // Bouton flottant CookieYes : on réserve sa place sur le côté où il se trouve.
    const avoidRevisit = () => {
      const btn = document.querySelector('.cky-btn-revisit-wrapper');
      let left = 12;
      let right = 12;
      if (btn && isShown(btn)) {
        const r = btn.getBoundingClientRect();
        if (r.bottom > window.innerHeight - 120) {
          if (r.left + r.width / 2 < window.innerWidth / 2) left = Math.max(left, Math.ceil(r.right) + 10);
          else right = Math.max(right, Math.ceil(window.innerWidth - r.left) + 10);
        }
      }
      if (left !== lastLeft) pop.style.setProperty('--pop-left', `${left}px`);
      if (right !== lastRight) pop.style.setProperty('--pop-right', `${right}px`);
      lastLeft = left;
      lastRight = right;
    };

    let shown = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const pastHero = hero.getBoundingClientRect().bottom < 0;
      const finalReached = finalBand.getBoundingClientRect().top < vh;
      const next = pastHero && !finalReached && !consentOpen();
      avoidRevisit();
      if (next === shown) return;
      shown = next;
      pop.classList.toggle('is-shown', shown);
      if (shown) pop.removeAttribute('inert');
      else pop.setAttribute('inert', '');
    };

    const schedule = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    document.addEventListener('cookieyes_banner_load', schedule);
    document.addEventListener('cookieyes_consent_update', schedule);

    // CookieYes insère et masque ses éléments par classes : on suit ces changements.
    new MutationObserver(schedule).observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
    });

    update();
  })();
</script>
