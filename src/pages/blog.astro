---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/blog/ArticleCard.astro';
import { categoryLabels, categoryDescriptions, type CategoryKey } from '../data/categories';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const allPosts = await getCollection('blog', ({ data }) =>
  import.meta.env.PROD ? !data.brouillon : true,
);

const sortedPosts = allPosts.sort(
  (a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime(),
);

const featured = sortedPosts[0];
const others = sortedPosts.slice(1);

// « Derniers articles » : pagination dans la page. Tous les articles restent dans le HTML
// (lus par Google et visibles sans JavaScript) ; le script n'affiche que ceux de la page active.
const PER_PAGE = 6;
const pageCount = Math.ceil(others.length / PER_PAGE);

// Icônes des pôles : mêmes tracés que sur les pages de services (pouls et palette des tuiles
// de la page Santé, deux personnes du badge de la page RH).
const categoryIcons: Record<CategoryKey, string> = {
  sante: '<path d="M3 12h4l2-5 4 10 2-5h6"/>',
  recrutement: '<circle cx="9" cy="8" r="3.2"/><path d="M3 20c.6-3.4 3-5.5 6-5.5s5.4 2.1 6 5.5"/><circle cx="17" cy="9" r="2.6"/><path d="M16.2 14.6c2.6.1 4.3 2 4.8 4.9"/>',
  'strategie-marque': '<path d="M12 3a9 9 0 000 18c1 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 005-5c0-4-4-7.2-9-7.2z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10" cy="7.5" r="1"/><circle cx="14.5" cy="7.5" r="1"/><circle cx="17.2" cy="11" r="1"/>',
};

const categoryEntries: { key: CategoryKey; label: string; description: string; href: string }[] = [
  { key: 'sante', label: categoryLabels.sante, description: categoryDescriptions.sante, href: `${base}/blog/sante/` },
  { key: 'recrutement', label: categoryLabels.recrutement, description: categoryDescriptions.recrutement, href: `${base}/blog/recrutement/` },
  { key: 'strategie-marque', label: categoryLabels['strategie-marque'], description: categoryDescriptions['strategie-marque'], href: `${base}/blog/strategie-marque/` },
];
---
<Layout
  title="WOOP, le blog | Marketing santé et recrutement"
  description="Des perspectives concrètes sur le marketing en santé et en recrutement, pensées par des praticiens du terrain. Découvrez le blog WOOP."
  ogImage="/images/og-image.jpg"
>

  <!-- Bloc 1 : intro (texte à gauche, illustration « un article, partout » à droite dès 1100 px) -->
  <section class="blog-intro">
    <div class="container blog-intro__grid">
      <div class="blog-intro__text">
        <span class="blog-intro__kicker">Le blog WOOP</span>
        <h1 class="blog-intro__title">Nos analyses <span class="gradient-accent">du terrain</span>.</h1>
        <p class="blog-intro__tagline">
          Des perspectives concr&egrave;tes sur le marketing en sant&eacute; et en recrutement, pens&eacute;es par des praticiens du terrain.
        </p>
      </div>

      <!-- Illustration décorative : un ordinateur et un téléphone affichent le même article -->
      <div class="bh" aria-hidden="true">
        <div class="bh__stage">
          <div class="bh__grid"></div>
          <div class="bh__glow"></div>

          <!-- Tablette, inclinée en perspective (même angle, taille et position que l'ancien ordinateur) -->
          <div class="bh-lap">
            <div class="bh-lap__screen">
              <div class="bh-lap__page">
                <span class="bh-pill"></span>
                <span class="bh-bar bh-bar--title"></span>
                <span class="bh-bar bh-bar--title bh-bar--short"></span>
                <div class="bh-img">
                  <svg viewBox="0 0 320 120" preserveAspectRatio="none">
                    <defs>
                      <linearGradient id="bh-curve" x1="0" y1="0" x2="1" y2="0">
                        <stop class="bh-stop-a" offset="0" />
                        <stop class="bh-stop-b" offset="1" />
                      </linearGradient>
                    </defs>
                    <path class="bh-img__line" d="M24 84C52 84 60 40 92 40S128 76 156 76" />
                    <path class="bh-img__line bh-img__line--dash" d="M156 76C184 76 196 86 220 86" />
                    <path class="bh-img__line" d="M220 86C248 86 262 44 296 44" />
                    <circle class="bh-img__dot" cx="24" cy="84" r="6" />
                    <circle class="bh-img__dot" cx="92" cy="40" r="6" />
                    <circle class="bh-img__dot bh-img__dot--hollow" cx="156" cy="76" r="6" />
                    <circle class="bh-img__dot bh-img__dot--hollow" cx="220" cy="86" r="6" />
                    <circle class="bh-img__dot" cx="296" cy="44" r="6" />
                  </svg>
                </div>
                <span class="bh-bar bh-bar--text"></span>
                <span class="bh-bar bh-bar--text"></span>
                <span class="bh-bar bh-bar--text"></span>
                <span class="bh-bar bh-bar--text bh-bar--w80"></span>
                <span class="bh-bar bh-bar--text bh-bar--w60"></span>
              </div>
            </div>
          </div>

          <!-- Téléphone : un autre article, du pôle Recrutement -->
          <div class="bh-phone">
            <div class="bh-phone__screen">
              <span class="bh-phone__isl"></span>
              <div class="bh-phone__card">
                <div class="bh-img bh-img--sm bh-img--pool">
                  <span class="bh-cand"></span>
                  <span class="bh-cand"></span>
                  <span class="bh-cand bh-cand--on"></span>
                  <span class="bh-cand"></span>
                  <span class="bh-cand"></span>
                </div>
                <span class="bh-bar bh-bar--title"></span>
                <span class="bh-bar bh-bar--title bh-bar--short"></span>
                <span class="bh-bar bh-bar--text bh-bar--para"></span>
                <span class="bh-bar bh-bar--text"></span>
                <span class="bh-bar bh-bar--text"></span>
                <span class="bh-bar bh-bar--text bh-bar--w80"></span>
                <span class="bh-bar bh-bar--text bh-bar--para"></span>
                <span class="bh-bar bh-bar--text"></span>
                <span class="bh-bar bh-bar--text bh-bar--w80"></span>
                <span class="bh-bar bh-bar--text bh-bar--w60"></span>
              </div>
              <span class="bh-phone__home"></span>
            </div>
          </div>

          <!-- Étiquettes flottantes -->
          <div class="bh-float bh-float--time">
            <span class="bh-float__ico">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.5" /><path d="M12 7.5V12l3 2" /></svg>
            </span>
            <b>6 min de lecture</b>
          </div>
          <span class="bh-tag bh-tag--sante">Santé &amp; Médical</span>
          <span class="bh-tag bh-tag--rh">Recrutement &amp; RH</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Bloc 2 : les trois cartes de catégorie, cliquables vers leur pôle -->
  <section class="blog-categories">
    <div class="container">
      <span class="kicker">Explorer par pôle</span>
      <div class="blog-categories__grid">
        {categoryEntries.map((entry) => (
          <a href={entry.href} class:list={['blog-category-card', `blog-category-card--${entry.key}`]}>
            <div class="blog-category-card__head">
              <span class="blog-category-card__ico" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={categoryIcons[entry.key]} />
              </span>
              <h2 class="blog-category-card__title">{entry.label}</h2>
            </div>
            <p class="blog-category-card__text">{entry.description}</p>
            <span class="blog-category-card__link">
              Découvrir les articles
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bloc 3 : article vedette (article le plus récent, en grande carte) -->
  {featured && (
    <section class="blog-featured">
      <div class="container">
        <span class="kicker">À la une</span>
        <ArticleCard post={featured} variant="featured" showCategory={true} />
      </div>
    </section>
  )}

  <!-- Bloc 4 : derniers articles (le reste, en grille). Masqué si vide. -->
  {others.length > 0 && (
    <section class="blog-latest">
      <div class="container">
        <span class="kicker blog-latest__title" id="derniers-articles" tabindex="-1">Derniers articles</span>
        <div class="blog-latest__grid" data-pager-grid data-per-page={PER_PAGE}>
          {others.map((post) => (
            <ArticleCard post={post} showCategory={true} />
          ))}
        </div>
        {pageCount > 1 && (
          <nav class="blog-pager" aria-label="Pagination des articles" data-pager hidden>
            <button type="button" class="blog-pager__btn blog-pager__btn--arrow" data-pager-prev aria-label="Page précédente">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
            </button>
            <ol class="blog-pager__list">
              {Array.from({ length: pageCount }, (_, i) => (
                <li>
                  <button type="button" class="blog-pager__btn" data-pager-page={i + 1} aria-label={`Page ${i + 1}`} aria-current={i === 0 ? 'page' : undefined}>{i + 1}</button>
                </li>
              ))}
            </ol>
            <button type="button" class="blog-pager__btn blog-pager__btn--arrow" data-pager-next aria-label="Page suivante">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </button>
          </nav>
        )}
      </div>
    </section>
  )}

  <!-- Si aucun article : message dédié -->
  {!featured && (
    <section class="blog-empty-section">
      <div class="container">
        <p class="blog-empty">Les premiers articles arrivent bientôt. Revenez nous voir.</p>
      </div>
    </section>
  )}

  <!-- Bloc 5 : capture d'infolettre (placeholder, à venir dans la PR suivante) -->
  <!-- TODO infolettre : un composant de capture d'inscription viendra ici dans une PR ultérieure. -->

</Layout>

<style>
  /* ===== Intro ===== */
  .blog-intro {
    padding: 96px 0 32px;
  }

  @media (min-width: 768px) {
    .blog-intro { padding: 120px 0 48px; }
  }

  .blog-intro__kicker {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--woop-pink);
    background: rgba(230, 43, 127, 0.1);
    border: 1px solid var(--border-accent);
    border-radius: 100px;
    padding: 8px 18px;
    font-weight: 700;
    margin-bottom: 20px;
  }

  .blog-intro__title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 40px;
    line-height: 1;
    margin-bottom: 16px;
    color: var(--text-primary);
    max-width: 900px;
  }

  @media (min-width: 768px) {
    .blog-intro__title { font-size: 64px; }
  }

  @media (min-width: 1024px) {
    .blog-intro__title { font-size: 84px; }
  }

  .blog-intro__tagline {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 720px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .blog-intro__tagline { font-size: 18px; }
  }

  @media (min-width: 1024px) {
    .blog-intro__tagline { font-size: 20px; }
  }

  /* Hero : 2 colonnes dès 1100 px ; illustration sous le texte entre 768 et 1099 px ; masquée en dessous */
  .blog-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: 40px;
  }

  .blog-intro__text { min-width: 0; }

  @media (min-width: 1100px) {
    .blog-intro__grid {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
    }
  }

  /* ===== Illustration « un article, partout » =====
     Scène de 560 × 440 px mise à l'échelle selon la largeur (même principe que l'accueil). */
  .bh {
    --bh-scale: 0.72;
    display: none;
    position: relative;
    width: calc(560px * var(--bh-scale));
    height: calc(440px * var(--bh-scale));
    justify-self: center;
  }

  @media (min-width: 768px) { .bh { display: block; } }
  @media (min-width: 1100px) { .bh { --bh-scale: 0.86; justify-self: end; } }
  @media (min-width: 1280px) { .bh { --bh-scale: 1; } }

  .bh__stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 560px;
    height: 440px;
    transform: scale(var(--bh-scale));
    transform-origin: top left;
  }

  .bh__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text-primary) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text-primary) 6%, transparent) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask: radial-gradient(circle at 50% 50%, var(--bg-deep) 10%, transparent 65%);
    mask: radial-gradient(circle at 50% 50%, var(--bg-deep) 10%, transparent 65%);
  }

  .bh__glow {
    position: absolute;
    left: 90px;
    top: 10px;
    width: 420px;
    height: 420px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 43, 127, 0.34), rgba(250, 98, 68, 0.12) 45%, transparent 70%);
    filter: blur(10px);
  }

  /* Tablette : cadre sombre fin (comme le téléphone de l'accueil), écran blanc */
  .bh-lap {
    position: absolute;
    left: 20px;
    top: 38px;
    width: 400px;
    transform: perspective(1400px) rotateY(16deg) rotateX(6deg) rotate(-3deg);
    /* Même centre de rotation qu'avec l'ancienne base (60 % de 300 px) : même position exacte */
    transform-origin: 50% 180px;
    filter: drop-shadow(0 40px 40px rgba(10, 10, 15, 0.55));
  }

  /* Cadre noir de même épaisseur sur les 4 côtés, coins arrondis, comme une tablette */
  .bh-lap__screen {
    padding: 10px;
    border-radius: 20px;
    background: var(--bg-deep);
    border: 2px solid rgba(230, 43, 127, 0.25);
    box-shadow: 0 0 80px rgba(230, 43, 127, 0.22);
  }

  .bh-lap__page {
    display: flex;
    flex-direction: column;
    gap: 7px;
    height: 262px;
    padding: 16px 18px;
    border-radius: 10px;
    background: var(--text-primary);
    overflow: hidden;
  }

  /* Barres de gabarit de la page d'article */
  .bh-pill {
    flex: none;
    width: 74px;
    height: 12px;
    border-radius: 999px;
    background: var(--woop-gradient);
  }

  .bh-bar {
    display: block;
    flex: none;
    height: 8px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--bg-deep) 18%, var(--text-primary));
  }

  .bh-bar--title {
    width: 88%;
    height: 13px;
    border-radius: 6px;
    background: var(--bg-deep);
  }

  .bh-bar--short { width: 56%; }
  .bh-bar--w80 { width: 80%; }
  .bh-bar--w60 { width: 60%; }

  /* Image d'article : rectangle sombre traversé d'une courbe en dégradé, une partie en pointillés */
  .bh-img {
    flex: none;
    height: 80px;
    margin: 4px 0;
    border-radius: 8px;
    background: var(--bg-deep);
    overflow: hidden;
  }

  .bh-img svg { display: block; width: 100%; height: 100%; }

  .bh-img__line {
    fill: none;
    stroke: url(#bh-curve);
    stroke-width: 4;
    stroke-linecap: round;
    vector-effect: non-scaling-stroke;
  }

  .bh-img__line--dash {
    stroke: color-mix(in srgb, var(--text-primary) 75%, transparent);
    stroke-width: 2.5;
    stroke-dasharray: 5 6;
  }

  .bh-stop-a { stop-color: var(--woop-pink); }
  .bh-stop-b { stop-color: var(--woop-orange); }

  .bh-img__dot { fill: var(--woop-pink); stroke: var(--text-primary); stroke-width: 2; }
  .bh-img__dot--hollow { fill: var(--bg-deep); }

  /* Téléphone devant, en bas à droite (cadre, encoche et ombre comme sur l'accueil) */
  .bh-phone {
    position: absolute;
    right: 34px;
    top: 128px;
    z-index: 2;
    width: 156px;
    height: 300px;
    padding: 6px;
    border-radius: 30px;
    background: var(--bg-deep);
    border: 2px solid rgba(230, 43, 127, 0.25);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 6%, transparent),
      0 0 70px rgba(230, 43, 127, 0.25);
    filter: drop-shadow(0 34px 34px rgba(10, 10, 15, 0.6));
    animation: bh-float-phone 7s ease-in-out infinite;
  }

  .bh-phone__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 30px 8px 8px;
    border-radius: 24px;
    background: var(--bg-elevated);
    overflow: hidden;
  }

  .bh-phone__isl {
    position: absolute;
    left: 50%;
    top: 8px;
    width: 46px;
    height: 13px;
    margin-left: -23px;
    border-radius: 7px;
    background: var(--bg-deep);
  }

  /* Carte de l'article : tout l'écran, de sous l'encoche jusqu'à la barre du bas */
  .bh-phone__card {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    margin-bottom: 8px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 9px;
    border-radius: 14px;
    background: var(--text-primary);
  }

  .bh-phone__card .bh-bar { height: 6px; }
  .bh-phone__card .bh-bar--title { height: 9px; }
  .bh-img--sm { height: 72px; margin: 0 0 4px; border-radius: 7px; }

  /* Début de paragraphe dans la carte du téléphone */
  .bh-phone__card .bh-bar--para { margin-top: 6px; }

  /* Image de l'article Recrutement : rangée de candidats (comme la tuile « Attraction de candidats »
     de la page RH : tête de 37,5 % du rond, épaules de 67,5 %), un seul mis en avant */
  .bh-img--pool {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 3px;
  }

  .bh-cand {
    position: relative;
    box-sizing: border-box;
    flex: none;
    width: 17px;
    height: 17px;
    border-radius: 50%;
    overflow: hidden;
    background: color-mix(in srgb, var(--text-primary) 22%, transparent);
    opacity: 0.75;
  }

  .bh-cand::before,
  .bh-cand::after {
    content: '';
    position: absolute;
    left: 50%;
    background: color-mix(in srgb, var(--text-primary) 60%, transparent);
    transform: translateX(-50%);
  }

  .bh-cand::before { top: 3px; width: 6.4px; height: 6.4px; border-radius: 50%; }
  .bh-cand::after { top: 10.6px; width: 11.5px; height: 3.8px; border-radius: 6px 6px 2px 2px; }

  /* Candidat mis en avant : rond blanc avec un contour en dégradé */
  .bh-cand--on {
    width: 25px;
    height: 25px;
    border: 2px solid transparent;
    background: linear-gradient(var(--text-primary), var(--text-primary)) padding-box, var(--woop-gradient) border-box;
    box-shadow: 0 6px 16px rgba(230, 43, 127, 0.45);
    opacity: 1;
  }

  .bh-cand--on::before { top: 3.4px; width: 7.9px; height: 7.9px; background: var(--woop-pink); }
  .bh-cand--on::after { top: 13.1px; width: 14.2px; height: 4.7px; border-radius: 7px 7px 2px 2px; background: var(--woop-pink); }

  .bh-phone__home {
    display: block;
    flex: none;
    width: 56px;
    height: 3px;
    margin: auto auto 2px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--text-primary) 55%, transparent);
  }

  /* Étiquettes : petite carte vitrée (comme l'accueil) et pastille en dégradé */
  .bh-float {
    position: absolute;
    left: 0;
    top: 334px;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 12px;
    width: max-content;
    padding: 12px 18px 12px 12px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--bg-elevated) 82%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 14%, transparent),
      0 24px 50px color-mix(in srgb, var(--bg-deep) 55%, transparent);
    animation: bh-float-tag 8s ease-in-out infinite;
    animation-delay: -2s;
  }

  .bh-float b { font-size: 14px; line-height: 1.3; color: var(--text-primary); }

  .bh-float__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 36px;
    height: 36px;
    border-radius: 11px;
    background: var(--woop-gradient);
    color: var(--text-primary);
    box-shadow: 0 8px 20px rgba(230, 43, 127, 0.45);
  }

  .bh-float__ico svg { width: 19px; height: 19px; }

  /* Pastille sur dégradé : petit texte en --bg-deep (contraste hybride) */
  .bh-tag {
    position: absolute;
    z-index: 3;
    padding: 9px 14px;
    border-radius: 999px;
    background: var(--woop-gradient);
    box-shadow: 0 14px 34px rgba(230, 43, 127, 0.45);
    color: var(--bg-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    animation: bh-float-tag 8s ease-in-out infinite;
    animation-delay: -5s;
  }

  /* « Santé & Médical » au-dessus de l'ordinateur, « Recrutement & RH » au-dessus du téléphone :
     aucune ne recouvre la page affichée par l'ordinateur ni l'écran du téléphone */
  .bh-tag--sante { left: 40px; top: 0; }
  .bh-tag--rh { right: 0; top: 88px; animation-delay: -1s; }

  @keyframes bh-float-phone {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-10px) rotate(-4deg); }
  }

  @keyframes bh-float-tag {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  /* ===== Categories ===== */
  .blog-categories {
    padding: 32px 0 48px;
  }

  @media (min-width: 768px) {
    .blog-categories { padding: 48px 0 64px; }
  }

  .blog-categories__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 24px;
  }

  /* 3 colonnes seulement quand l'icône et le titre tiennent côte à côte dans chaque carte */
  @media (min-width: 768px) {
    .blog-categories__grid { gap: 20px; }
  }

  @media (min-width: 1024px) {
    .blog-categories__grid { grid-template-columns: repeat(3, 1fr); }
  }

  .blog-category-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-bento);
    padding: 28px 24px;
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
    transition: border-color 200ms ease, transform 200ms ease;
  }

  .blog-category-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--woop-gradient);
  }

  .blog-category-card:hover {
    border-color: var(--border-accent);
    transform: translateY(-2px);
  }

  /* Icône et titre du pôle sur la même ligne (même sur mobile : le titre peut passer sur 2 lignes) */
  .blog-category-card__head {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  /* Même carré en dégradé, même taille et même trait que les icônes des tuiles de la page Santé */
  .blog-category-card__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: var(--woop-gradient);
    color: var(--text-primary);
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.3);
  }

  .blog-category-card__ico svg { width: 26px; height: 26px; }

  .blog-category-card__title {
    min-width: 0;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 24px;
    line-height: 1.05;
    color: var(--text-primary);
    margin: 0;
  }

  @media (min-width: 768px) {
    .blog-category-card__title { font-size: 26px; }
  }

  .blog-category-card__text {
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
    flex: 1;
  }

  @media (min-width: 1024px) {
    .blog-category-card__text { font-size: 15px; }
  }

  .blog-category-card__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--woop-pink);
    margin-top: 8px;
    transition: color 200ms ease, transform 200ms ease;
  }

  .blog-category-card:hover .blog-category-card__link {
    color: var(--woop-orange);
    transform: translateX(2px);
  }

  /* ===== Article vedette ===== */
  .blog-featured {
    padding: 16px 0 48px;
  }

  @media (min-width: 768px) {
    .blog-featured { padding: 32px 0 64px; }
  }

  /* ===== Derniers articles ===== */
  .blog-latest {
    padding: 16px 0 80px;
  }

  @media (min-width: 768px) {
    .blog-latest { padding: 32px 0 96px; }
  }

  .blog-latest__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
    margin-top: 24px;
  }

  @media (min-width: 640px) {
    .blog-latest__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .blog-latest__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Cible du défilement au changement de page (sous l'en-tête fixe) */
  .blog-latest__title { scroll-margin-top: 110px; }
  .blog-latest__title:focus { outline: none; }

  /* Pagination : cartes hors de la page active masquées par le script */
  .blog-latest__grid :global(.article-card[hidden]) { display: none; }

  .blog-pager[hidden] { display: none; }

  .blog-pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 40px;
  }

  .blog-pager__list {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Pastilles rondes ; page active en dégradé WOOP, chiffre en --bg-deep (contraste hybride) */
  .blog-pager__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--bg-card);
    box-shadow: inset 0 0 0 1px var(--border-subtle);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    transition: box-shadow 200ms ease, background 200ms ease, transform 200ms ease;
  }

  .blog-pager__btn svg { width: 16px; height: 16px; }

  .blog-pager__btn:hover:not(:disabled):not([aria-current='page']) {
    box-shadow: inset 0 0 0 1px var(--border-accent);
    transform: translateY(-2px);
  }

  .blog-pager__btn:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
  }

  .blog-pager__btn[aria-current='page'] {
    background: var(--woop-gradient);
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.3);
    color: var(--bg-deep);
    cursor: default;
  }

  .blog-pager__btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* ===== État vide ===== */
  .blog-empty-section {
    padding: 32px 0 96px;
  }

  .blog-empty {
    font-size: 16px;
    color: var(--text-secondary);
