  @media (prefers-reduced-motion: reduce) {
    /* Illustration immobile */
    .bh-phone { animation: none; transform: rotate(-4deg); }
    .bh-float,
    .bh-tag { animation: none; }

    .blog-category-card,
    .blog-category-card__link {
      transition: none;
    }

    .blog-category-card:hover {
      transform: none;
    }

    .blog-category-card:hover .blog-category-card__link {
      transform: none;
    }

    .blog-pager__btn { transition: none; }
    .blog-pager__btn:hover:not(:disabled):not([aria-current='page']) { transform: none; }
  }
</style>

<script>
  // Pagination des « Derniers articles » : tous les articles sont dans le HTML ; on n'affiche
  // que ceux de la page active. Sans JavaScript, tout reste visible et la navigation est cachée.
  (function () {
    const grid = document.querySelector<HTMLElement>('[data-pager-grid]');
    const nav = document.querySelector<HTMLElement>('[data-pager]');
    if (!grid || !nav) return;
    const cards = Array.from(grid.children) as HTMLElement[];
    const perPage = Number(grid.dataset.perPage) || 6;
    const pageCount = Math.ceil(cards.length / perPage);
    if (pageCount < 2) return;

    const title = document.getElementById('derniers-articles');
    const prev = nav.querySelector<HTMLButtonElement>('[data-pager-prev]');
    const next = nav.querySelector<HTMLButtonElement>('[data-pager-next]');
    const pages = Array.from(nav.querySelectorAll<HTMLButtonElement>('[data-pager-page]'));
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let current = 1;

    const render = () => {
      cards.forEach((card, i) => { card.hidden = Math.floor(i / perPage) + 1 !== current; });
      pages.forEach((b) => {
        if (Number(b.dataset.pagerPage) === current) b.setAttribute('aria-current', 'page');
        else b.removeAttribute('aria-current');
      });
      if (prev) prev.disabled = current === 1;
      if (next) next.disabled = current === pageCount;
    };

    const goTo = (n: number) => {
      const target = Math.min(Math.max(n, 1), pageCount);
      if (target === current) return;
      current = target;
      render();
      if (title) {
        // Focus sur le titre de la section (lecteurs d'écran, clavier), puis défilement doux
        // (instantané avec prefers-reduced-motion)
        title.focus({ preventScroll: true });
        title.scrollIntoView({ behavior: reduceMotion.matches ? 'instant' : 'smooth', block: 'start' });
      }
    };

    pages.forEach((b) => b.addEventListener('click', () => goTo(Number(b.dataset.pagerPage))));
    prev?.addEventListener('click', () => goTo(current - 1));
    next?.addEventListener('click', () => goTo(current + 1));

    nav.hidden = false;
    render();
  })();
</script>
