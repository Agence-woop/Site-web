---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import CtaIcon from '../components/CtaIcon.astro';
import SectionHead from '../components/SectionHead.astro';
import VisibilityTeaser from '../components/VisibilityTeaser.astro';
import FinalBand from '../components/FinalBand.astro';
import StickyBar from '../components/StickyBar.astro';
import ServiceHero from '../components/services/ServiceHero.astro';
import AudienceCard from '../components/services/AudienceCard.astro';
import ServiceTile from '../components/services/ServiceTile.astro';
import FounderPortrait from '../components/services/FounderPortrait.astro';
import Steps from '../components/services/Steps.astro';
import { team } from '../data/team';
import { NB } from '../utils/typo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/services-recrutement/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    serviceType: 'Marketing pour cabinets de recrutement',
    // Renvoie à la fiche de l'organisation publiée sur l'accueil
    provider: { '@id': `${SITE_URL}/#organization`, name: 'Agence WOOP' },
    areaServed: 'Québec',
    url: PAGE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'RH & Recrutement', item: PAGE_URL },
    ],
  },
];

// Parcours du prochain mandat (illustration animée du hero)
const journey = [
  { key: 'search', label: '01 · On vous cherche' },
  { key: 'chosen', label: '02 · On vous choisit' },
  { key: 'signed', label: '03 · Mandat signé' },
  { key: 'filled', label: '04 · Poste pourvu' },
];

// 01 · Pour qui ? Le texte de chaque carte est coupé en deux : ce que vous vivez, puis ce qu'on change.
// `wide` : carte sur toute la largeur, illustration à côté du texte (à la verticale sur téléphone).
const profiles: {
  key: 'mandat' | 'cand' | 'niche' | 'grow' | 'solo';
  title: string;
  lived: string;
  change: string;
  reveal: 'left' | 'right' | 'up';
  step?: string;
  wide?: boolean;
}[] = [
  {
    key: 'mandat',
    title: 'Un cabinet qui veut décrocher plus de mandats.',
    lived: 'Les entreprises confient leurs recherches à vos concurrents.',
    change: 'Il faut se faire connaître auprès des bons décideurs RH.',
    reveal: 'left',
  },
  {
    key: 'cand',
    title: 'Un cabinet qui veut attirer plus de candidats qualifiés.',
    lived: 'Vos mandats restent ouverts trop longtemps faute de bons profils.',
    change: 'Il faut construire un bassin actif et engagé.',
    reveal: 'right',
    step: '1',
  },
  {
    key: 'niche',
    title: 'Un cabinet qui veut se différencier dans sa niche.',
    lived: 'Trop de cabinets se ressemblent.',
    change: `Il faut une marque qui dit ce qui vous rend unique${NB}: votre niche, votre méthode, votre fit culturel.`,
    reveal: 'left',
  },
  {
    key: 'grow',
    title: 'Un cabinet en croissance qui veut professionnaliser son image.',
    lived: 'Vous avez les résultats, mais votre marque ne suit plus.',
    change: 'Il faut un branding à la hauteur de vos ambitions.',
    reveal: 'right',
    step: '1',
  },
  {
    key: 'solo',
    title: 'Un consultant RH indépendant qui veut décrocher ses propres mandats.',
    lived: "Vous opérez en solo, votre réseau s'épuise, et votre visibilité en ligne ne suit pas.",
    change: 'Il faut une marque personnelle qui attire les clients à vous.',
    reveal: 'up',
    wide: true,
  },
];

// 02 · Nos services. Comme sur l'accueil : si `href` est défini, toute la tuile devient un lien
// (effet au survol + chevron). Seules « Acquisition de mandats » et « Attraction de candidats » ont
// un lien pour l'instant, vers la page Publicité Google et Meta.
// Ordre de lecture = ordre de la grille. Formats :
// - feat : bandeau dégradé, pleine largeur ;
// - wide : 2 colonnes, en-tête et texte à gauche, illustration à droite ;
// - sq   : 1 colonne.
// `step` : décalage d'apparition (data-reveal-step), recalculé dans l'ordre de lecture de chaque rangée :
// Mandats 0 · Candidats 0, Image de marque 1 · Réseaux sociaux 0, Site web 1, Réputation 2.
const services: {
  key: 'mandats' | 'cand' | 'brand' | 'social' | 'web' | 'rep';
  shape: 'feat' | 'wide' | 'sq';
  title: string;
  text: string[];
  reveal: 'left' | 'right' | 'up';
  step?: string;
  href?: string;
}[] = [
  {
    key: 'mandats',
    shape: 'feat',
    title: 'Acquisition de mandats',
    text: [
      'Décrocher plus de mandats auprès des entreprises clientes. Campagnes Google Ads, LinkedIn Ads et Meta Ads ciblées sur les décideurs RH et dirigeants.',
      'On va chercher les entreprises qui ont besoin de vous, là où elles cherchent déjà.',
    ],
    reveal: 'up',
    href: `${base}/publicite-google-meta/`,
  },
  {
    key: 'cand',
    shape: 'wide',
    title: 'Attraction de candidats',
    text: [
      'Construire un bassin actif et engagé de candidats qualifiés. Campagnes ciblées sur Meta, Google, LinkedIn et autres plateformes selon votre secteur.',
      'On attire vers vous les bons profils, avant même qu\'ils cherchent activement.',
    ],
    reveal: 'up',
    href: `${base}/publicite-google-meta/`,
  },
  {
    key: 'brand',
    shape: 'sq',
    title: 'Image de marque du cabinet',
    text: [
      'Logo, charte visuelle, ton de marque, design system complet. Une identité qui justifie votre positionnement et qui fait de votre cabinet un endroit où les meilleurs candidats veulent postuler.',
    ],
    reveal: 'up',
    step: '1',
    href: `${base}/image-de-marque/`,
  },
  {
    key: 'social',
    shape: 'sq',
    title: 'Stratégie réseaux sociaux',
    text: [
      'Présence soignée sur LinkedIn, Instagram, Facebook et autres plateformes adaptées à votre cible. Calendrier éditorial, publications qui mettent en avant votre expertise auprès des entreprises clientes, et contenu qui parle aux candidats.',
    ],
    reveal: 'up',
    href: `${base}/gestion-reseaux-sociaux/`,
  },
  {
    key: 'web',
    shape: 'sq',
    title: 'Site web et présence en ligne',
    text: [
      'Sites de conversion pensés pour transformer un visiteur en client, ou un candidat en candidature. Pages dédiées aux mandats, pages dédiées aux candidats, articles de blog pour le référencement Google. Le tout conforme aux meilleures pratiques web.',
    ],
    reveal: 'up',
    step: '1',
  },
  {
    key: 'rep',
    shape: 'sq',
    title: 'Gestion de la réputation en ligne',
    text: [
      'Avis Google, témoignages clients et candidats, suivi de votre image sur le web. On vous aide à construire et protéger la réputation de votre cabinet.',
    ],
    reveal: 'up',
    step: '2',
  },
];

// Parcours de la tuile « Acquisition de mandats » : 3 étapes identiques, seul le fond de « Mandat » change
const pipeline = [
  { title: 'Décideur RH', text: 'Vous découvre' },
  { title: 'Rencontre', text: 'Il vous appelle' },
  { title: 'Mandat', text: 'Il vous confie le poste', on: true },
];

// Bassin de candidats (tuile « Attraction de candidats ») : 1 = profil retenu
const pool = [0, 0, 1, 0, 1, 0, 1, 0];

// 04 · Comment ça se passe
const steps = [
  { n: '1', title: 'Un appel de 30 minutes', text: 'On écoute où en est votre cabinet et ce que vous visez.', reveal: 'left' as const },
  { n: '2', title: 'Un plan sur mesure', text: 'Les leviers qui rapportent le plus, côté mandats et côté candidats.', reveal: 'up' as const, step: '1' },
  { n: '3', title: 'On se lance ensemble', text: 'Vous suivez les résultats, on s\'occupe du reste.', reveal: 'right' as const, step: '2', hot: true },
];
---
<Layout
  title="Marketing pour cabinets de recrutement à Montréal | WOOP"
  description="Acquisition de mandats, attraction de candidats et image de marque pour cabinets de recrutement. Pensé par un designer qui a piloté le marketing d'un cabinet."
  ogImage="/images/og-recrutement.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé. -->
  <ScrollReveal />

  <!-- 1. HERO (sans data-reveal) -->
  <ServiceHero
    pill="RH & Recrutement"
    sub="Stratégie, branding, acquisition de mandats et attraction de candidats. Pour les cabinets de recrutement, multisecteurs ou spécialisés (santé, tech, finance, construction, juridique et autres), ainsi que les consultants RH indépendants qui veulent faire grandir leur banque de mandats, et leur bassin de candidats."
    strong="Votre équipe marketing recrutement, sans avoir à l'embaucher."
    primary={{ href: `${base}/contact/`, label: 'Réserver un appel découverte' }}
    secondary={{ href: '#services', label: 'Nos services' }}
  >
    <Fragment slot="title">Le marketing pour cabinets de recrutement, pensé par quelqu'un qui <span class="gradient-accent hp-kw">les a connus de l'intérieur.</span></Fragment>

    <Fragment slot="visual">
    <Fragment set:html={"<!-- Illustration : le parcours de votre prochain mandat, étapes allumées l'une après l'autre -->"} />
    <div class="md-dev-w" aria-hidden="true">
      <div class="md-dev-glow"></div>
      <div class="md-dev">
        <div class="md-dev__bar"><span></span><span></span><span></span><em>Le parcours de votre prochain mandat</em></div>
        <div class="md-dev__cap"><b>Comment les entreprises vous trouvent, avec WOOP</b><span>4 étapes, on s'occupe de chacune.</span></div>
        <div class="md-flow" data-md-flow>
          {journey.map((j, i) => (
            <>
              {i > 0 && <span class="md-flow__link" data-md-flow-link></span>}
              <div class="md-xf" data-md-flow-step>
                <span class="md-xf__label">{j.label}</span>
                {j.key === 'search' && (
                  <>
                    <div class="md-sbar"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg><span>cabinet recrutement Montréal</span></div>
                    <i class="md-xf__ln md-w70"></i>
                    <i class="md-xf__ln md-w50"></i>
                  </>
                )}
                {j.key === 'chosen' && (
                  <>
                    <div class="md-xres"><small>En premier</small><b>Votre cabinet</b><em>Spécialiste de votre niche</em></div>
                    <i class="md-xf__ln md-w60"></i>
                  </>
                )}
                {j.key === 'signed' && (
                  <>
                    <div class="md-slotx"><em>Lun.</em><b>Nouveau mandat</b><i>+</i></div>
                    <div class="md-slotx md-slotx--dim"><em>Mar.</em><b>Candidat qualifié</b><i>✓</i></div>
                  </>
                )}
                {j.key === 'filled' && (
                  <div class="md-xrv"><i class="md-xrv__h"></i><i class="md-xf__ln md-w70"></i><i class="md-xf__ln md-w50"></i></div>
                )}
              </div>
            </>
          ))}
        </div>
      </div>
    </div>
    </Fragment>
  </ServiceHero>

  <!-- 2. POUR QUI ? -->
  <section class="hp-block hp-sec" id="pour-qui" data-reveal-clip>
    <div class="container">
      <SectionHead over={`01 · Pour qui${NB}?`} intro={`Trouvez votre situation${NB}: d'abord ce que vous vivez, puis ce qu'on change pour vous. Vous cochez au moins une case${NB}? La suite est pour vous.`}>Vous vous <span class="gradient-accent">reconnaissez</span>{NB}?</SectionHead>

      <div class="md-prs">
        {profiles.map((p) => (
          <AudienceCard kind={p.key} title={p.title} lived={p.lived} change={p.change} reveal={p.reveal} step={p.step} wide={p.wide}>
            {p.key === 'mandat' && (
              <div class="md-rq">
                <div class="md-rq__card">
                  <div class="md-rq__head"><b>Mandat</b><span>Signé</span></div>
                  <i class="md-rq__ln"></i>
                  <i class="md-rq__ln md-rq__ln--sh"></i>
                  <div class="md-rq__sig"><svg viewBox="0 0 120 30" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M4 22c10-14 16-14 18-4s8 6 14-6 10 8 18 4 12-10 20-2 14 6 30-2"/></svg></div>
                </div>
              </div>
            )}
            {p.key === 'cand' && (
              <div class="md-cl">
                <div class="md-cl__row is-on"><span class="md-cl__av"></span><div><b></b><i></i></div><em>Qualifié</em></div>
                <div class="md-cl__row is-on"><span class="md-cl__av"></span><div><b></b><i></i></div><em>Qualifié</em></div>
                <div class="md-cl__row"><span class="md-cl__av"></span><div><b></b><i></i></div><em>En attente</em></div>
              </div>
            )}
            {p.key === 'niche' && (
              <div class="md-crowd">
                <span></span><span></span><span class="md-crowd__me"><b>Vous</b></span><span></span><span></span><span></span>
                <span class="md-crowd__lens"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg></span>
              </div>
            )}
            {p.key === 'grow' && (
              <div class="md-ba">
                <div class="md-ba__bl md-ba__bl--old"><span></span><small>Avant</small></div>
                <span class="md-ba__arr"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg></span>
                <div class="md-ba__bl md-ba__bl--new"><span></span><small>Après</small></div>
              </div>
            )}
            {p.key === 'solo' && (
              <div class="md-solo">
                <div class="md-pc"><span class="md-pc__av"></span><div><b>Votre nom</b><small>Consultant RH indépendant</small></div><span class="md-pc__ver">✓</span></div>
                <div class="md-nt"><span>+</span><div><b>Nouvelle demande</b><small>Une entreprise vous contacte</small></div></div>
              </div>
            )}
          </AudienceCard>
        ))}
      </div>

      <VisibilityTeaser />
    </div>
  </section>

  <!-- 3. NOS SERVICES (cible du bouton « Nos services ») -->
  <section class="hp-block hp-sec hp-sec--services" id="services" data-reveal-clip>
    <div class="container">
      <SectionHead over="02 · Nos services" intro={`En clair${NB}: tout ce que ferait une équipe marketing dans vos murs, sans avoir à l'embaucher. Côté clients comme côté candidats.`}>Une offre pensée pour le secteur du <span class="gradient-accent">recrutement</span>.</SectionHead>

      <div class="md-svs">
        {services.map((t) => (
          <ServiceTile kind={t.key} shape={t.shape} title={t.title} text={t.text} reveal={t.reveal} step={t.step} href={t.href}>
            <Fragment slot="icon">
              {t.key === 'mandats' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="m18 5-2.414-2.414A2 2 0 0 0 14.172 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2"/><path d="M21.378 12.626a1 1 0 0 0-3.004-3.004l-4.01 4.012a2 2 0 0 0-.506.854l-.837 2.87a.5.5 0 0 0 .62.62l2.87-.837a2 2 0 0 0 .854-.506z"/><path d="M8 18h1"/></svg>)}
              {t.key === 'cand' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>)}
              {t.key === 'brand' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 000 18c1 0 1.7-.8 1.7-1.7 0-.5-.2-.9-.5-1.2-.3-.3-.5-.7-.5-1.2 0-.9.8-1.7 1.7-1.7H16a5 5 0 005-5c0-4-4-7.2-9-7.2z"/><circle cx="7.5" cy="11.5" r="1"/><circle cx="10" cy="7.5" r="1"/><circle cx="14.5" cy="7.5" r="1"/><circle cx="17.2" cy="11" r="1"/></svg>)}
              {t.key === 'social' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="12" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.2 11l7.6-3.8M8.2 13l7.6 3.8"/></svg>)}
              {t.key === 'web' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>)}
              {t.key === 'rep' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.3L20 9l-4.4 3.8L17 18.5 12 15.6 7 18.5l1.4-5.7L4 9l5.8-.7z"/></svg>)}
            </Fragment>
            <Fragment slot="illustration">
              {t.shape === 'feat' ? (
                <div class="md-jy" aria-hidden="true">
                  {pipeline.map((s, i) => (
                    <>
                      {i > 0 && <span class="md-jy__link"></span>}
                      <div class:list={[{ 'is-on': s.on }]}><b>{s.title}</b><small>{s.text}</small></div>
                    </>
                  ))}
                </div>
              ) : (
                <div class:list={['md-mui', `md-mui--${t.key}`]} aria-hidden="true">
                  {t.key === 'cand' && (
                    <div class="md-pool">
                      {pool.map((on) => <span class:list={['md-pool__p', { 'is-on': on }]}></span>)}
                      <em>Votre bassin de candidats</em>
                    </div>
                  )}
                  {t.key === 'brand' && (
                    <>
                      <span class="md-lg"><i></i></span>
                      <span class="md-pal"><span class="md-pal--o"></span><span class="md-pal--p"></span><span class="md-pal--b"></span></span>
                      <b class="md-aa">Aa</b>
                    </>
                  )}
                  {t.key === 'social' && (
                    <>
                      <div class="md-li__h"><span class="md-li__av"></span><div><b>Votre cabinet</b><small>Publication</small></div><span class="md-li__in">in</span></div>
                      <div class="md-li__b"><span>On recrute</span><i></i></div>
                      <div class="md-li__f">
                        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 11v9H4v-9z"/><path d="M7 11l4-7c1.7 0 2.6 1 2.3 2.6L12.8 10H19a2 2 0 012 2.3l-1.2 6A2 2 0 0117.8 20H7"/></svg>J'aime</span>
                        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 01-11.7 7.1L4 20l.9-4.3A8 8 0 1120 12z"/></svg>Commenter</span>
                      </div>
                    </>
                  )}
                  {t.key === 'web' && (
                    <>
                      <div class="md-brw"><span></span><span></span><span></span></div>
                      <div class="md-pg"><i class="md-pg__h"></i><i class="md-pg__t"></i><span class="md-pg__cta">Voir les postes</span></div>
                      <div class="md-phn"><i></i><span></span></div>
                    </>
                  )}
                  {t.key === 'rep' && (
                    <>
                      <div class="md-rc"><span class="md-rc__av"></span><div><span class="md-rc__stars">★★★★★</span><i></i></div></div>
                      <div class="md-rp"><i></i><i></i></div>
                    </>
                  )}
                
                </div>
              )}
            </Fragment>
          </ServiceTile>
        ))}
      </div>

      <div class="md-svc-cta" data-reveal="up">
        <a class="cta" href={`${base}/contact/`}>Échanger 30 minutes avec l'équipe<CtaIcon /></a>
        <p class="hp-team__more">
          <a href={`${base}/blog/recrutement/`}>Lire nos articles sur le marketing recrutement <span aria-hidden="true">›</span></a>
        </p>
      </div>
    </div>
  </section>

  <!-- 4. NOTRE DIFFÉRENCE -->
  <section class="hp-block hp-sec" id="difference" data-reveal-clip>
    <div class="container">
      <SectionHead over="03 · Notre différence" intro="Ce qui nous rend différents de toutes les autres agences.">Conçue par quelqu'un du <span class="gradient-accent">métier</span>.</SectionHead>

      <FounderPortrait member={team.kevin} badge={`Une stratégie pour vos deux marchés${NB}: clients et candidats`}>
        <p class="md-gau__lead">Kevin est designer graphique de formation. Avant de cofonder WOOP, il a passé plusieurs années à piloter le marketing au sein d'un <a class="link-inline" href={`${base}/services-medical/`}>cabinet de recrutement spécialisé en santé</a>.</p>
        <p>Là, il vivait au quotidien les défis que vous connaissez aujourd'hui{NB}: décrocher des mandats, construire une marque qui se distingue, attirer des candidats qualifiés, gérer la réputation du cabinet.</p>
        <p>Cette double expérience, la création graphique et le marketing en cabinet de recrutement, change tout. Quand on conçoit votre stratégie, on ne devine pas vos problèmes{NB}: <strong>on les a déjà vécus.</strong> Aucune autre agence marketing au Québec ne peut en dire autant.</p>
        <Fragment slot="badge-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c.6-3.4 3-5.5 6-5.5s5.4 2.1 6 5.5"/><circle cx="17" cy="9" r="2.6"/><path d="M16.2 14.6c2.6.1 4.3 2 4.8 4.9"/></svg></Fragment>
      </FounderPortrait>
    </div>
  </section>

  <!-- 5. COMMENT ÇA SE PASSE -->
  <section class="hp-block hp-sec" data-reveal-clip>
    <div class="container">
      <SectionHead over="04 · Comment ça se passe" intro="Voici exactement ce qui se passe après votre premier appel.">Simple et <span class="gradient-accent">sans engagement</span>.</SectionHead>

      <Steps steps={steps} />
    </div>
  </section>

  <!-- 6. BANDEAU FINAL (identique à celui de l'accueil) -->
  <FinalBand
    title={`Envie de faire grandir votre activité de recrutement${NB}?`}
    text="Votre équipe marketing recrutement commence par un appel de 30 minutes."
    cta={{ href: `${base}/contact/?personne=kevin`, label: 'Parlons de votre cabinet' }}
  />

  <!-- BANDEAU COLLANT (bas d'écran) : hors data-reveal, piloté par le script du composant StickyBar -->
