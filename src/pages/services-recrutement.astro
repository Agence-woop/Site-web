  }

  @media (min-width: 1101px) {
    .md-flow { flex-wrap: nowrap; gap: 0; }
  }

  .md-xf {
    display: flex;
    flex: 1 1 100%;
    flex-direction: column;
    gap: 9px;
    min-height: 150px;
    padding: 16px;
    border-radius: 20px;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 10px 26px color-mix(in srgb, var(--bg-deep) 30%, transparent);
    transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 500ms, opacity 500ms;
  }

  @media (min-width: 621px) {
    .md-xf { flex-basis: 40%; }
  }

  @media (min-width: 1101px) {
    .md-xf { flex: 1; max-width: 250px; }
  }

  .md-flow__link {
    display: none;
    position: relative;
    flex: none;
    width: 34px;
    height: 2px;
    background: linear-gradient(90deg, var(--woop-orange), var(--woop-pink));
    transition: opacity 400ms;
  }

  .md-flow__link::after {
    content: '';
    position: absolute;
    right: -3px;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--woop-pink);
  }

  @media (min-width: 1101px) {
    .md-flow__link { display: block; }
  }

  /* Allumage progressif : uniquement quand le script tourne (sinon état final, tout allumé) */
  .md-flow.is-live .md-xf { opacity: 0.55; }
  .md-flow.is-live .md-flow__link { opacity: 0.3; }
  .md-flow.is-live .md-xf.is-done,
  .md-flow.is-live .md-flow__link.is-on { opacity: 1; }

  .md-flow.is-live .md-xf.is-act {
    opacity: 1;
    transform: translateY(-10px);
    box-shadow: 0 22px 44px rgba(230, 43, 127, 0.35), 0 0 0 2px rgba(230, 43, 127, 0.6);
  }

  .md-xf__label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .md-xf__ln {
    display: block;
    height: 7px;
    border-radius: 4px;
    background: var(--hp-skel-2);
  }

  .md-w70 { width: 70%; }
  .md-w60 { width: 60%; }
  .md-w50 { width: 50%; }

  .md-sbar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--hp-skel);
    font-size: 12px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .md-sbar svg {
    flex: none;
    width: 15px;
    height: 15px;
    color: var(--woop-pink);
  }

  .md-xres {
    padding: 11px 12px;
    border-radius: 13px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
  }

  .md-xres small {
    display: block;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .md-xres b {
    display: block;
    font-size: 14px;
    line-height: 1.3;
  }

  .md-xres em {
    font-style: normal;
    font-size: 11px;
    font-weight: 600;
  }

  .md-slotx {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 12px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-size: 12px;
  }

  .md-slotx em {
    font-style: normal;
    font-weight: 700;
    font-size: 11px;
  }

  .md-slotx b { flex: 1; }

  .md-slotx i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--hp-light);
    color: var(--md-pink-deep);
    font-style: normal;
    font-weight: 700;
    font-size: 11px;
  }

  .md-slotx--dim {
    background: var(--hp-skel-2);
    color: var(--hp-dark);
  }

  .md-slotx--dim em { color: var(--text-muted); }
  .md-slotx--dim i { background: var(--hp-blush); }

  /* Étape 4 : carte claire en barres de gabarit (pas de témoignage) */
  .md-xrv {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 12px;
    border-radius: 13px;
    background: color-mix(in srgb, var(--woop-pink) 6%, var(--text-primary));
  }

  .md-xrv__h {
    display: block;
    width: 60%;
    height: 9px;
    border-radius: 5px;
    background: var(--hp-plum);
  }

  /* ===== 2. POUR QUI ? ===== */
  .md-prs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
  }

  @media (min-width: 720px) {
    .md-prs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .md-pr {
    overflow: hidden;
    border-radius: 28px;
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .md-pr:hover { transform: translateY(-5px); }

  .md-pr__vis {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 190px;
    overflow: hidden;
  }

  @media (min-width: 621px) {
    .md-pr__vis { height: 210px; }
  }

  .md-pr__vis > * { transition: transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1); }
  .md-pr:hover .md-pr__vis > * { transform: scale(1.06) rotate(-2deg); }

  .md-pr__vis--mandat { background: var(--woop-gradient); }
  .md-pr__vis--cand { background: var(--hp-blush); }
  .md-pr__vis--niche { background: var(--hp-plum); }
  .md-pr__vis--grow { background: linear-gradient(140deg, color-mix(in srgb, var(--woop-orange) 80%, var(--text-primary)), var(--woop-orange)); }
  .md-pr__vis--solo { background: linear-gradient(120deg, var(--hp-plum), var(--woop-pink)); }

  /* 5e carte (consultant indépendant) : sur toute la largeur, illustration à gauche et texte
     à droite dès que la grille passe à 2 colonnes. À la verticale sur téléphone. */
  @media (min-width: 720px) {
    .md-pr--wide {
      grid-column: 1 / -1;
      display: grid;
      /* L'illustration a la largeur d'une carte de la rangée du dessus (gouttière de 22 px comprise) */
      grid-template-columns: minmax(0, calc((100% - 22px) / 2)) minmax(0, 1fr);
    }
    .md-pr--wide .md-pr__vis {
      height: auto;
      min-height: 240px;
    }
    .md-pr--wide .md-pr__body { justify-content: center; }
  }

  .md-pr__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    /* Le titre ouvre la carte : même écart sous l'illustration dans les 5 cartes */
    padding: 28px 24px 30px;
  }

  @media (min-width: 768px) {
    .md-pr__body { padding: 30px 30px 32px; }
  }

  .md-pr__body h3 {
    font-size: 22px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--text-primary);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .md-pr__body h3 { font-size: 24px; }
  }

  .md-pr__body p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Ce qu'on change : coche dégradée, filet au-dessus */
  .md-pr__body p.md-pr__change {
    position: relative;
    align-self: stretch;
    margin-top: 4px;
    padding: 14px 0 0 28px;
    border-top: 1px solid var(--hp-line);
    color: var(--text-primary);
  }

  .md-pr__change::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-size: 10px;
    font-weight: 700;
  }

  /* Illustrations des cartes */
  /* 1. Mandat signé */
  .md-rq__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 220px;
    padding: 16px;
    border-radius: 18px;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 18px 36px var(--hp-shadow);
    transform: rotate(-3deg);
  }

  .md-rq__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .md-rq__head b { font-size: 14px; font-weight: 700; }

  .md-rq__head span {
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .md-rq__ln { display: block; height: 7px; border-radius: 4px; background: var(--hp-skel-2); }
  .md-rq__ln--sh { width: 65%; }

  .md-rq__sig {
    padding-top: 6px;
    border-top: 1.5px dashed var(--hp-skel);
    color: var(--woop-pink);
  }

  .md-rq__sig svg { display: block; width: 120px; height: 30px; }

  /* 2. Candidats qualifiés */
  .md-cl {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 240px;
  }

  .md-cl__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 14px;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 10px 24px rgba(230, 43, 127, 0.15);
  }

  .md-cl__row:not(.is-on) { opacity: 0.7; }

  .md-cl__av { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--hp-skel-2); }
  .md-cl__row.is-on .md-cl__av { background: var(--woop-gradient); }

  .md-cl__row div { flex: 1; display: flex; flex-direction: column; gap: 5px; }
  .md-cl__row b { display: block; width: 75%; height: 7px; border-radius: 4px; background: var(--hp-plum); }
  .md-cl__row i { display: block; width: 50%; height: 6px; border-radius: 3px; background: var(--hp-skel); }

  .md-cl__row em {
    padding: 5px 8px;
    border-radius: 999px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-style: normal;
    font-size: 10px;
    font-weight: 700;
    white-space: nowrap;
  }

  .md-cl__row:not(.is-on) em { background: var(--hp-skel-2); color: var(--hp-dark); }

  /* 3. Se différencier : « Vous » dans la foule */
  .md-crowd {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 64px);
    gap: 10px;
  }

  .md-crowd > span {
    height: 64px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-primary) 12%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 15%, transparent);
  }

  .md-crowd > .md-crowd__me {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--woop-gradient);
    box-shadow: 0 10px 26px rgba(230, 43, 127, 0.5);
    transform: scale(1.08);
  }

  .md-crowd__me b { font-size: 13px; font-weight: 700; color: var(--hp-on-grad); }

  .md-crowd > .md-crowd__lens {
    position: absolute;
    right: -22px;
    bottom: -18px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--hp-light);
    color: var(--woop-pink);
    box-shadow: 0 12px 28px var(--hp-shadow);
  }

  .md-crowd__lens svg { width: 26px; height: 26px; }

  /* 4. Grandir : avant / après */
  /* Alignement en haut : la flèche se centre sur les carrés, pas sur carré + étiquette */
  .md-ba {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    color: var(--hp-on-grad);
  }

  .md-ba__bl {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  .md-ba__bl span { display: block; width: 84px; height: 84px; border-radius: 22px; }

  .md-ba__bl small {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .md-ba__bl--old span {
    background: color-mix(in srgb, var(--text-primary) 35%, transparent);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--text-primary) 50%, transparent);
  }

  .md-ba__bl--new span {
    position: relative;
    background: var(--hp-light);
    box-shadow: 0 14px 30px var(--hp-shadow);
  }

  .md-ba__bl--new span::after {
    content: '';
    position: absolute;
    inset: 20px;
    border-radius: 50%;
    background: var(--woop-gradient);
  }

  /* Flèche SVG (même rendu sur tous les appareils), dans une boîte de la hauteur d'un carré */
  .md-ba__arr {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: 84px;
  }

  .md-ba__arr svg { display: block; width: 26px; height: 26px; }

  /* 5. Consultant indépendant : profil et nouvelle demande */
  .md-solo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .md-pc {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 260px;
    padding: 12px;
    border-radius: 16px;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 18px 36px var(--hp-shadow);
  }

  .md-pc__av {
    position: relative;
    overflow: hidden;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--woop-gradient);
  }

  .md-pc__av::before,
  .md-pc__av::after {
    content: '';
    position: absolute;
    left: 50%;
    border-radius: 50%;
    background: var(--hp-light);
    transform: translateX(-50%);
  }

  .md-pc__av::before { top: 8px; width: 14px; height: 14px; }
  .md-pc__av::after { bottom: -9px; width: 26px; height: 19px; }

  .md-pc div { flex: 1; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .md-pc b { font-size: 13px; font-weight: 700; line-height: 1.3; }
  .md-pc small { font-size: 10.5px; font-weight: 600; line-height: 1.3; color: var(--text-muted); }

  .md-pc__ver {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-size: 11px;
    font-weight: 700;
  }

  .md-nt {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: 40px;
    padding: 12px 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--bg-deep) 85%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 15%, transparent);
    color: var(--text-primary);
  }

  .md-nt > span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-weight: 700;
  }

  .md-nt b { display: block; font-size: 13px; line-height: 1.3; }
  .md-nt small { font-size: 11px; line-height: 1.3; color: var(--text-secondary); }

  /* Bandeau « Nouveau » (identique à l'accueil) */
  .hp-teaser {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding: 14px 14px 14px 22px;
    border-radius: 999px;
    background: var(--woop-gradient);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--hp-on-grad);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .hp-teaser:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(230, 43, 127, 0.4);
  }

  .hp-teaser:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
  }

  .hp-teaser strong { color: var(--hp-on-grad); }

  .hp-teaser__dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hp-on-grad);
  }

  .hp-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--hp-on-grad);
    transition: transform 250ms ease;
  }

  .hp-go svg { width: 18px; height: 18px; }

  .hp-teaser:hover .hp-go { transform: translateX(3px); }

  /* ===== 3. NOS SERVICES ===== */
  /* Grille bento : 1 colonne sur téléphone, 2 sur tablette (600 à 1099 px), 3 sur ordinateur.
     L'ordre du HTML est l'ordre de lecture ; sur ordinateur, chaque tuile est placée explicitement. */
  .md-svs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 600px) {
    .md-svs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .md-sv--feat,
    .md-sv--wide { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .md-svs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
    .md-sv--mandats { grid-column: 1 / -1; grid-row: 1; }
    .md-sv--cand { grid-column: 1 / span 2; grid-row: 2; }
    .md-sv--brand { grid-column: 3; grid-row: 2; }
    .md-sv--social { grid-column: 1; grid-row: 3; }
    .md-sv--web { grid-column: 2; grid-row: 3; }
    .md-sv--rep { grid-column: 3; grid-row: 3; }
  }

  .md-sv {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 28px 24px;
    border-radius: 26px;
    overflow: hidden;
    color: var(--hp-ink);
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 350ms ease;
  }

  @media (min-width: 768px) {
    .md-sv { padding: 30px; }
  }

  .md-sv h3 {
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    text-wrap: balance;
  }

  .md-sv p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  /* Tuiles foncées : icône et titre sur la même ligne (le titre peut passer sur 2 lignes) */
  .md-sv__head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  /* Texte d'une tuile (un ou deux paragraphes) */
  .md-sv__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* En-tête, texte, puis illustration en bas : Branding, Site web */
  .md-sv--brand .md-mui,
  .md-sv--web .md-mui { margin-top: auto; }

  /* En-tête, illustration, puis texte : Réseaux sociaux, Réputation */
  .md-sv--social .md-sv__text,
  .md-sv--rep .md-sv__text { order: 1; }

  /* Tuile large (Attraction de candidats) : en-tête et texte à gauche, illustration à droite,
     centrés verticalement. À la verticale sur téléphone. */
  @media (min-width: 600px) {
    .md-sv--wide {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        '. ill'
        'head ill'
        'text ill'
        '. ill';
      column-gap: 28px;
      row-gap: 0;
    }
    .md-sv--wide .md-sv__head { grid-area: head; }
    .md-sv--wide .md-sv__text { grid-area: text; margin-top: 16px; }
    .md-sv--wide .md-mui {
      grid-area: ill;
      align-self: center;
      height: 150px;
    }
  }

  @media (min-width: 1100px) {
    .md-sv--wide { column-gap: 36px; }
    .md-sv--wide .md-mui { height: 170px; }
  }

  /* Tuile-lien (href défini) : survol, focus et chevron, comme sur l'accueil */
  .hp-tile--link { cursor: pointer; }

  .hp-tile--link:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px var(--hp-shadow), inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 15%, transparent);
  }

  .hp-tile--link:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .hp-tile__go {
    position: absolute;
    top: 28px;
    right: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px currentColor;
    transition: transform 250ms ease, background 250ms ease;
  }

  .hp-tile__go svg { width: 18px; height: 18px; }

  .hp-tile--link:hover .hp-tile__go {
    transform: translateX(4px);
    background: color-mix(in srgb, var(--text-primary) 18%, transparent);
  }

  .md-xi {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 15px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.3);
    transition: transform 350ms ease;
  }

  .md-xi svg { width: 26px; height: 26px; }

  .hp-tile--link:hover .md-xi { transform: rotate(-6deg) scale(1.06); }

  /* Tuile dégradée : Acquisition de mandats, sur toute la largeur.
     À l'horizontale dès la tablette : texte à gauche, étapes à droite. */
  .md-sv--feat {
    gap: 30px;
    background: var(--woop-gradient);
    box-shadow: 0 24px 60px rgba(230, 43, 127, 0.25);
  }

  @media (min-width: 600px) {
    .md-sv--feat {
      flex-direction: row;
      align-items: center;
      gap: 32px;
    }
  }

  @media (min-width: 1100px) {
    .md-sv--feat {
      gap: 40px;
      padding: 40px;
    }
  }

  .md-sv__txt {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
  }

  .md-sv--feat h3 {
    margin-top: 6px;
    font-size: 26px;
    color: var(--text-primary);
  }

  @media (min-width: 768px) {
    .md-sv--feat h3 { font-size: 30px; }
  }

  .md-sv--feat p {
    max-width: 580px;
    font-size: 16px;
    color: var(--hp-on-grad);
  }

  .md-xi--w {
    background: color-mix(in srgb, var(--text-primary) 22%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 40%, transparent);
  }

  /* Décideur RH · Rencontre · Mandat : 3 étapes identiques (même taille, même alignement),
     seul le fond de « Mandat » change. Empilées sur téléphone et tablette, en ligne sur ordinateur. */
  .md-jy {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    width: 100%;
  }

  /* Empilées : rangées de même hauteur, même si un texte passe sur 2 lignes */
  @media (max-width: 1099px) {
    .md-jy {
      display: grid;
      grid-auto-rows: 1fr;
    }
  }

  @media (min-width: 600px) {
    .md-jy { width: 180px; }
  }

  @media (min-width: 1100px) {
    .md-jy {
      flex-direction: row;
      /* Même hauteur pour les 3 étapes, même si un texte passe sur 2 lignes */
      align-items: stretch;
      width: auto;
    }
  }

  .md-jy div {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 16px;
    border-radius: 18px;
    background: color-mix(in srgb, var(--text-primary) 16%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 35%, transparent);
  }

  @media (min-width: 1100px) {
    .md-jy div { width: 130px; }
  }

  .md-jy b {
    font-size: 15px;
    line-height: 1.2;
    color: var(--hp-on-grad);
  }

  .md-jy small {
    font-size: 12.5px;
    font-weight: 500;
    line-height: 1.35;
    color: var(--hp-on-grad);
  }

  .md-jy div.is-on {
    background: var(--hp-light);
    box-shadow: 0 14px 30px color-mix(in srgb, var(--bg-deep) 18%, transparent);
  }

  .md-jy div.is-on b { color: var(--md-pink-deep); }
  .md-jy div.is-on small { color: var(--hp-dark); }

  .md-jy__link {
    display: none;
    flex: none;
    align-self: center;
    width: 14px;
    height: 2px;
    background: color-mix(in srgb, var(--text-primary) 60%, transparent);
  }

  @media (min-width: 1100px) {
    .md-jy__link { display: block; }
  }

  /* Mini-illustrations des tuiles (même dessin, redimensionné selon le format de la tuile) */
  .md-mui {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    gap: 9px;
    align-self: stretch;
    height: 126px;
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  /* Attraction de candidats : bassin de candidats */
  .md-mui--cand {
    height: auto;
    min-height: 126px;
    background: var(--woop-gradient);
    box-shadow: none;
  }

  /* 8 profils sur 2 rangées de 4, quelle que soit la largeur de la tuile */
  .md-pool {
    display: grid;
    grid-template-columns: repeat(4, 40px);
    justify-content: center;
    gap: 10px;
  }

  .md-pool__p {
    position: relative;
    overflow: hidden;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text-primary) 30%, transparent);
  }

  /* Silhouette « utilisateur » : tête de 15 px (37,5 % du rond), épaules arrondies de 27 px
     (67,5 %), 3 px d'écart entre les deux, et de l'air tout autour dans le rond. */
  .md-pool__p::before,
  .md-pool__p::after {
    content: '';
    position: absolute;
    left: 50%;
    background: color-mix(in srgb, var(--text-primary) 70%, transparent);
    transform: translateX(-50%);
  }

  .md-pool__p::before {
    top: 7px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
  }

  .md-pool__p::after {
    top: 25px;
    width: 27px;
    height: 9px;
    border-radius: 14px 14px 4px 4px;
  }

  .md-pool__p.is-on {
    background: var(--hp-light);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--text-primary) 40%, transparent);
  }

  .md-pool__p.is-on::before,
  .md-pool__p.is-on::after { background: var(--woop-pink); }

  .md-pool em {
    grid-column: 1 / -1;
    font-style: normal;
    font-size: 11px;
    font-weight: 700;
    text-align: right;
    color: var(--hp-on-grad);
  }

  /* Branding : logo, palette, « Aa » */
  .md-mui--brand {
    flex-direction: row;
    align-items: center;
    gap: 14px;
    background: linear-gradient(135deg, var(--hp-plum), color-mix(in srgb, var(--woop-pink) 10%, var(--bg-deep)));
  }

  .md-lg {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 54px;
    height: 54px;
    border-radius: 50%;
    background: var(--woop-gradient);
    box-shadow: 0 8px 20px rgba(230, 43, 127, 0.35);
  }

  .md-lg i { width: 22px; height: 22px; border-radius: 50%; box-shadow: inset 0 0 0 4px var(--hp-light); }

  .md-pal { display: flex; flex: none; }

  .md-pal span {
    width: 26px;
    height: 26px;
    margin-left: -6px;
    border-radius: 50%;
    box-shadow: 0 0 0 3px var(--hp-plum);
  }

  .md-pal span:first-child { margin-left: 0; }
  .md-pal--o { background: var(--woop-orange); }
  .md-pal--p { background: var(--woop-pink); }
  .md-pal--b { background: var(--hp-blush); }

  .md-aa {
    margin-left: auto;
    font-family: var(--font-display);
    font-size: 36px;
    font-weight: 400;
    line-height: 1;
    background: var(--woop-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  /* Réseaux sociaux : publication LinkedIn */
  .md-mui--social {
    height: auto;
    min-height: 126px;
    gap: 8px;
    background: var(--hp-light);
    box-shadow: none;
    color: var(--hp-dark);
  }

  .md-li__h {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .md-li__av { flex: none; width: 26px; height: 26px; border-radius: 8px; background: var(--woop-gradient); }

  .md-li__h div { flex: 1; display: flex; flex-direction: column; min-width: 0; }
  .md-li__h b { font-size: 12px; font-weight: 700; line-height: 1.3; }
  .md-li__h small { font-size: 10px; line-height: 1.3; color: var(--text-muted); }

  .md-li__in {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 5px;
    background: var(--bg-deep);
    color: var(--text-primary);
    font-size: 11px;
    font-weight: 700;
  }

  .md-li__b {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 10px;
    border-radius: 10px;
    background: linear-gradient(120deg, color-mix(in srgb, var(--woop-orange) 14%, var(--text-primary)), var(--hp-blush));
  }

  .md-li__b span {
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .md-li__b i { display: block; width: 70%; height: 9px; border-radius: 5px; background: var(--hp-plum); }

  .md-li__f {
    display: flex;
    gap: 12px;
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .md-li__f span { display: inline-flex; align-items: center; gap: 4px; }
  .md-li__f svg { width: 12px; height: 12px; }

  /* Site web : page et téléphone */
  .md-mui--web {
    position: relative;
    overflow: hidden;
    padding: 12px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--woop-orange) 80%, var(--text-primary)), var(--woop-pink));
    box-shadow: none;
  }

  .md-brw { display: flex; gap: 4px; }
  .md-brw span { width: 6px; height: 6px; border-radius: 50%; background: color-mix(in srgb, var(--text-primary) 70%, transparent); }

  .md-pg {
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 72%;
    padding: 10px;
    border-radius: 10px;
    background: var(--hp-light);
  }

  .md-pg__h { display: block; width: 70%; height: 8px; border-radius: 4px; background: var(--hp-plum); }
  .md-pg__t { display: block; width: 90%; height: 6px; border-radius: 3px; background: var(--hp-skel-2); }
  .md-pg__cta {
    align-self: flex-start;
    padding: 5px 9px;
    border-radius: 999px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-size: 9.5px;
    font-weight: 700;
    line-height: 1.2;
  }

  .md-phn {
    position: absolute;
    right: 12px;
    bottom: -14px;
    display: flex;
    flex-direction: column;
    gap: 5px;
    width: 54px;
    height: 96px;
    padding: 8px 6px;
    border-radius: 12px;
    background: var(--bg-deep);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--text-primary) 40%, transparent);
  }

  .md-phn i { display: block; height: 5px; border-radius: 3px; background: color-mix(in srgb, var(--text-primary) 40%, transparent); }
  .md-phn span { display: block; height: 18px; border-radius: 6px; background: var(--woop-gradient); }

  /* Réputation : avis et réponse */
  .md-mui--rep {
    gap: 8px;
    background: var(--hp-blush);
    box-shadow: none;
  }

  .md-rc {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px;
    border-radius: 12px;
    background: var(--hp-light);
  }

  .md-rc__av { flex: none; width: 30px; height: 30px; border-radius: 50%; background: var(--woop-gradient); }
  .md-rc div { display: flex; flex-direction: column; gap: 5px; }
  .md-rc__stars { font-size: 12px; letter-spacing: 1px; line-height: 1; color: var(--woop-orange); }
  .md-rc div i { display: block; width: 90px; height: 6px; border-radius: 3px; background: var(--hp-skel); }

  .md-rp {
    display: flex;
    flex-direction: column;
    gap: 5px;
    align-self: flex-end;
    width: 120px;
    padding: 10px 12px;
    border-radius: 12px 12px 4px 12px;
    background: var(--woop-gradient);
  }

  .md-rp i { display: block; height: 6px; border-radius: 3px; background: color-mix(in srgb, var(--text-primary) 70%, transparent); }
  .md-rp i:last-child { width: 60%; }

  /* Bouton et lien sous les services */
  .md-svc-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 34px;
  }

  .hp-team__more {
    display: flex;
    justify-content: center;
    margin-top: 22px;
  }

  .hp-team__more a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 0 2px;
    font-size: 15px;
    line-height: 1.2;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 200ms ease, text-decoration-color 200ms ease;
  }

  .hp-team__more a:hover,
  .hp-team__more a:focus-visible {
    color: var(--text-primary);
    text-decoration-color: var(--woop-pink);
  }

  .hp-team__more a:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ===== 4. NOTRE DIFFÉRENCE ===== */
  .md-gau {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: 30px;
  }

  @media (min-width: 768px) {
    .md-gau { grid-template-columns: 300px minmax(0, 1fr); }
  }

  @media (min-width: 1024px) {
    .md-gau { grid-template-columns: 360px minmax(0, 1fr); }
  }

  /* Portrait de Kevin : photo non détourée (fond dégradé dans l'image), qui remplit tout le panneau.
     Téléphone et tablette : panneau au-dessus, carré (420 px de haut au plus). */
  .md-gau__ph {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1;
    max-height: 420px;
    background: linear-gradient(160deg, color-mix(in srgb, var(--woop-orange) 80%, var(--text-primary)), var(--woop-orange) 40%, var(--woop-pink));
  }

  .md-gau__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    /* Visage dans le tiers supérieur du panneau carré (la tête de Kevin est haute dans la photo :
       recadrage propre à cette page) */
    object-position: 50% 52%;
  }

  /* Tablette : panneau plus large que haut, recadrage plus haut pour garder la tête entière */
  @media (min-width: 600px) and (max-width: 767px) {
    .md-gau__img { object-position: 50% 45%; }
  }

  /* À partir de 768 px : panneau à gauche, sur toute la hauteur du bloc. Le panneau étant plus
     étroit que la photo, cover la cadre en hauteur ; un léger agrandissement ancré en bas
     (plus faible que pour Gauthier) remonte le visage dans le tiers supérieur. */
  @media (min-width: 768px) {
    .md-gau__ph {
      aspect-ratio: auto;
      max-height: none;
      min-height: 480px;
    }
    .md-gau__img {
      object-position: 49% 100%;
      transform: scale(1.1);
      transform-origin: 49% 100%;
    }
  }

  .md-gau__txt {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 32px 24px;
  }

  @media (min-width: 900px) {
    .md-gau__txt { padding: 46px 50px; }
  }

  .md-gau__txt p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .md-gau__txt .md-gau__lead {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-primary);
  }

  /* « on les a déjà vécus. » : rose et gras */
  .md-gau__txt p strong {
    font-weight: 700;
    color: var(--md-pink-soft);
  }

  /* Lien discret dans le texte (vers la page Santé & Médical) : identique au texte qui l'entoure
     (même couleur, même graisse, sans soulignement). Souligné uniquement au survol et au focus clavier. */
  .md-gau__txt .md-inl {
    color: inherit;
    font-weight: inherit;
    text-decoration: none;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 4px;
  }

  .md-gau__txt .md-inl:hover,
  .md-gau__txt .md-inl:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--woop-pink);
    text-decoration-thickness: 1.5px;
    outline: none;
  }

  /* Badge « deux marchés » : pilule sombre, filet dégradé fin, texte blanc semi-gras */
  .md-gau__txt .md-gau__badge {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    padding: 8px 18px 8px 8px;
    border: 1px solid transparent;
    border-radius: 18px;
    background:
      linear-gradient(var(--bg-deep), var(--bg-deep)) padding-box,
      var(--woop-gradient) border-box;
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 1.35;
    text-align: left;
    color: var(--text-primary);
  }

  @media (min-width: 600px) {
    .md-gau__txt .md-gau__badge { border-radius: 999px; }
  }

  .md-gau__badge-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 9px;
    background: var(--woop-gradient);
    color: var(--text-primary);
    box-shadow: 0 6px 16px rgba(230, 43, 127, 0.3);
  }

  .md-gau__badge-ico svg { width: 17px; height: 17px; }

  /* Badge à gauche, bouton « Parler à Kevin » à droite, centrés verticalement.
     Téléphone : empilés, alignés à gauche. Le badge peut passer sur 2 lignes pour rester
     à côté du bouton ; si la colonne de texte est trop étroite même ainsi (tablette),
     le bouton passe sous le badge, aligné à gauche. */
  .md-gau__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-top: 8px;
  }

  .md-gau__foot .cta { flex: none; }

  @media (min-width: 600px) {
    .md-gau__foot {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }
    /* Base de 308 px (2 lignes) pour le calcul du retour à la ligne, puis le badge
       s'élargit jusqu'à sa largeur naturelle (1 ligne) quand la place le permet. */
    .md-gau__foot .md-gau__badge {
      flex: 1 1 308px;
      max-width: max-content;
    }
  }

  /* ===== 5. COMMENT ÇA SE PASSE ===== */
  .md-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    list-style: none;
  }

  @media (min-width: 768px) {
    .md-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .md-st {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 24px;
    border-radius: 24px;
  }

  @media (min-width: 1024px) {
    .md-st { padding: 30px; }
  }

  .md-st__d {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-weight: 700;
    color: var(--md-pink-soft);
    box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.55);
  }

  .md-st__d.is-on {
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.35);
  }

  .md-st h3 {
    margin-top: 6px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .md-st p {
    line-height: 1.55;
    color: var(--text-secondary);
  }

  /* ===== 6. BANDEAU FINAL (identique à l'accueil) ===== */
  .hp-final {
    padding: 52px 22px;
    border-radius: 28px;
    background: var(--hp-grad-band);
    text-align: center;
  }

  @media (min-width: 768px) {
    .hp-final { padding: 80px 40px; border-radius: 40px; }
  }

  .hp-final h2 {
    max-width: 900px;
    margin: 0 auto;
    font-size: 34px;
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .hp-final h2 { font-size: 46px; }
  }

  @media (min-width: 1280px) {
    .hp-final h2 { font-size: 56px; }
  }

  .hp-final p {
    margin: 18px auto 36px;
    max-width: 620px;
    font-size: 18px;
    line-height: 1.5;
    color: var(--hp-on-grad);
  }

  .hp-avs { display: flex; }

  .hp-avs > span {
    position: relative;
    overflow: hidden;
    flex: none;
    width: 62px;
    height: 62px;
    margin-left: -14px;
    border-radius: 50%;
    background: var(--woop-gradient);
    box-shadow: 0 0 0 4px var(--woop-orange);
  }

  .hp-avs > span:first-child { margin-left: 0; }

  .hp-avs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transform: scale(1.55);
    transform-origin: var(--fx, 50%) var(--fy, 30%);
  }

  .hp-avs .is-framed img {
    object-position: var(--obj-pos, center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--obj-pos, center);
  }

  .hp-avs--final {
    justify-content: center;
    margin-bottom: 26px;
  }

  /* 4 photos : plus petites sur téléphone pour tenir dans le bandeau sans déborder */
  .hp-avs--final > span {
    width: 80px;
    height: 80px;
    margin-left: -18px;
    box-shadow: 0 0 0 4px var(--text-primary);
  }

  @media (max-width: 359px) {
    .hp-avs--final > span {
      width: 68px;
      height: 68px;
      margin-left: -16px;
    }
  }

  @media (min-width: 768px) {
    .hp-avs--final > span {
      width: 104px;
      height: 104px;
      margin-left: -22px;
    }
  }

  .hp-avs--final > span:first-child { margin-left: 0; }

  /* 4 photos : chevauchement de 25 % du diamètre au maximum, pour que chaque visage
     reste visible aux trois quarts (36 px, chevauchement de 9 px) */
  .hp-avs--sm > span {
    width: 36px;
    height: 36px;
    margin-left: -9px;
    box-shadow: 0 0 0 3px var(--bg-elevated);
  }

  /* Vers 360 px : photos un peu plus petites (même proportion de chevauchement)
     pour que le bouton reste entier */
  @media (max-width: 374px) {
    .hp-avs--sm > span { width: 34px; height: 34px; margin-left: -8px; }
  }

  /* Très petits écrans : photos et espacements réduits pour que le bouton reste entier */
  @media (max-width: 359px) {
    .hp-pop[data-hp-pop] { gap: 8px; }
    .hp-avs--sm > span { width: 25px; height: 25px; margin-left: -6px; }
    .hp-pop .cta { padding-left: 14px; }
  }

  /* ===== BANDEAU COLLANT (identique à l'accueil) ===== */
  .hp-pop {
    --pop-left: 12px;
    --pop-right: 12px;
    position: fixed;
    left: var(--pop-left);
    right: var(--pop-right);
    bottom: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 6px 6px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-elevated) 92%, transparent);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow:
      inset 0 0 0 1px rgba(230, 43, 127, 0.45),
      0 20px 50px var(--hp-shadow),
      0 0 40px rgba(230, 43, 127, 0.2);
    transform: translateY(calc(100% + 40px));
    visibility: hidden;
    transition: transform 600ms cubic-bezier(0.2, 0.9, 0.3, 1.2), visibility 0s linear 600ms;
  }

  .hp-pop.is-shown {
    transform: none;
    visibility: visible;
    transition: transform 600ms cubic-bezier(0.2, 0.9, 0.3, 1.2), visibility 0s;
  }

  .hp-pop__txt {
    display: none;
    font-size: 15px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .hp-pop__txt strong { color: var(--text-primary); font-weight: 600; }

  /* Le bouton garde toujours son texte sur une ligne : c'est le texte de la barre qui passe à la ligne */
  .hp-pop .cta { flex: none; white-space: nowrap; }

  @media (min-width: 520px) {
    .hp-pop__txt {
      display: block;
      flex: 1 1 auto;
      min-width: 0;
      font-size: 13px;
      line-height: 1.3;
      white-space: normal;
    }
  }

  @media (min-width: 720px) {
    .hp-pop {
      left: 50%;
      right: auto;
      bottom: 20px;
      gap: 16px;
      /* Largeur du contenu : sans cela, left: 50% limite la barre à la moitié de l'écran
         et le bouton passe sur 2 lignes quand le texte est long */
      width: max-content;
      max-width: calc(100vw - 2 * max(var(--pop-left), var(--pop-right)));
      padding: 8px 8px 8px 12px;
      transform: translate(-50%, calc(100% + 40px));
    }
    .hp-pop.is-shown { transform: translate(-50%, 0); }
    .hp-pop__txt { display: inline; flex: 0 1 auto; min-width: 0; font-size: 15px; white-space: normal; }
  }

  /* ===== MOUVEMENT RÉDUIT ===== */
  @media (prefers-reduced-motion: reduce) {
    /* Parcours du hero : état final, immobile */
    .md-dev { animation: none; }
    .md-xf,
    .md-flow__link { transition: none; }

    .cta,
    .md-pr,
    .md-pr__vis > *,
    .md-sv,
    .md-xi,
    .hp-pop,
    .hp-pop.is-shown { transition: none; }

    .cta:hover,
    .hp-tile--link:hover,
    .hp-tile--link:hover .hp-tile__go,
    .hp-tile--link:hover .md-xi,
    .hp-teaser:hover,
    .hp-teaser:hover .hp-go,
    .md-pr:hover,
    .md-pr:hover .md-pr__vis > * { transform: none; }
  }
</style>

<script>
  // Parcours du hero (reprise de la maquette) : les étapes s'allument l'une après
  // l'autre (étape active soulevée, étapes passées allumées, liaisons allumées), puis tout
  // reste allumé un instant avant de recommencer. Sans JavaScript ou avec moins d'animations :
  // état final, tout est allumé et immobile.
  (function () {
    const flow = document.querySelector<HTMLElement>('[data-md-flow]');
    if (!flow) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const cards = Array.from(flow.querySelectorAll<HTMLElement>('[data-md-flow-step]'));
    const links = Array.from(flow.querySelectorAll<HTMLElement>('[data-md-flow-link]'));
    if (!cards.length) return;

    flow.classList.add('is-live');
    let i = 0;

    const step = () => {
      cards.forEach((el, k) => {
        el.classList.toggle('is-act', k === i);
        el.classList.toggle('is-done', k < i);
      });
      links.forEach((el, k) => el.classList.toggle('is-on', k < i));
      i = (i + 1) % (cards.length + 1);
      window.setTimeout(step, i === 0 ? 1400 : 1300);
    };

    window.setTimeout(step, 1400);
  })();
</script>

<script>
  // Bandeau collant (même script que la page d'accueil) : visible une fois le hero dépassé,
  // masqué dès que le bandeau final entre à l'écran (et au-delà). Il ne recouvre jamais la
  // bannière de consentement CookieYes : il se retire tant qu'elle (ou sa fenêtre de
  // préférences) est affichée, et s'écarte du bouton flottant « préférences » de CookieYes
  // s'il est présent dans le bas de l'écran.
  (function () {
    const pop = document.querySelector<HTMLElement>('[data-hp-pop]');
    const hero = document.querySelector<HTMLElement>('[data-hp-hero]');
    const finalBand = document.querySelector<HTMLElement>('[data-hp-final]');
    if (!pop || !hero || !finalBand) return;

    const isShown = (el: Element | null): el is HTMLElement => {
      if (!el) return false;
      const r = (el as HTMLElement).getBoundingClientRect();
      if (r.width === 0 || r.height === 0) return false;
      const cs = window.getComputedStyle(el);
      return cs.display !== 'none' && cs.visibility !== 'hidden' && Number(cs.opacity) > 0;
    };

    // Bannière ou fenêtre de préférences CookieYes ouverte.
    const consentOpen = () => {
      const banner = document.querySelector('.cky-consent-container');
      if (banner && !banner.classList.contains('cky-hide') && isShown(banner)) return true;
      const modal = document.querySelector('.cky-modal.cky-modal-open');
      if (modal && isShown(modal)) return true;
      return false;
    };

    let lastLeft = 12;
    let lastRight = 12;

    // Bouton flottant CookieYes : on réserve sa place sur le côté où il se trouve.
    const avoidRevisit = () => {
      const btn = document.querySelector('.cky-btn-revisit-wrapper');
      let left = 12;
      let right = 12;
      if (btn && isShown(btn)) {
        const r = btn.getBoundingClientRect();
        if (r.bottom > window.innerHeight - 120) {
          if (r.left + r.width / 2 < window.innerWidth / 2) left = Math.max(left, Math.ceil(r.right) + 10);
          else right = Math.max(right, Math.ceil(window.innerWidth - r.left) + 10);
        }
      }
      if (left !== lastLeft) pop.style.setProperty('--pop-left', `${left}px`);
      if (right !== lastRight) pop.style.setProperty('--pop-right', `${right}px`);
      lastLeft = left;
      lastRight = right;
    };

    let shown = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const pastHero = hero.getBoundingClientRect().bottom < 0;
      const finalReached = finalBand.getBoundingClientRect().top < vh;
      const next = pastHero && !finalReached && !consentOpen();
      avoidRevisit();
      if (next === shown) return;
      shown = next;
      pop.classList.toggle('is-shown', shown);
      if (shown) pop.removeAttribute('inert');
      else pop.setAttribute('inert', '');
    };

    const schedule = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    document.addEventListener('cookieyes_banner_load', schedule);
    document.addEventListener('cookieyes_consent_update', schedule);

    // CookieYes insère et masque ses éléments par classes : on suit ces changements.
    new MutationObserver(schedule).observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
    });

    update();
  })();
</script>
