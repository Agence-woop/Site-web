<script>
  // Carrousel des avis clients (comportement repris de la version précédente) :
  // - Navigation bornée (positions 0..(N-V), sans clonage). Depuis la dernière
  //   position, next() revient à 0 ; prev() depuis 0 va à la dernière position.
  // - Avancement automatique toutes les 6 s, pause au survol et au focus,
  //   respect de prefers-reduced-motion (pas d'auto, pas de transition, flèches OK).
  // - Hauteur fixe calée sur la 2e plus grande carte mesurée. Cartes plus
  //   longues : bouton « Voir plus / Voir moins », sinon le bouton reste caché.
  // - Sans JavaScript : tout le texte est visible et la rangée défile au doigt.
  (function () {
    const carousel = document.querySelector<HTMLElement>('[data-testimonials-carousel]');
    if (!carousel) return;
    const viewport = carousel.querySelector<HTMLElement>('[data-testimonials-viewport]');
    const track = carousel.querySelector<HTMLElement>('[data-testimonials-track]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-testimonials-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-testimonials-next]');
    if (!viewport || !track || !prevBtn || !nextBtn) return;

    // Passage du défilement natif (sans JS) à la navigation par flèches.
    carousel.classList.add('is-ready');
    viewport.scrollLeft = 0;
    prevBtn.hidden = false;
    nextBtn.hidden = false;

    const TRANSITION_MS = 500;
    const AUTO_MS = 6000;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let currentIndex = 0;
    let isHover = false;
    let timerId: number | null = null;

    function getVisibleCount(): number {
      const w = window.innerWidth;
      if (w >= 1024) return 3;
      if (w >= 640) return 2;
      return 1;
    }

    function getSlides(): HTMLElement[] {
      return Array.from(track!.children) as HTMLElement[];
    }

    function getMaxIndex(): number {
      const n = getSlides().length;
      const v = getVisibleCount();
      return Math.max(0, n - v);
    }

    function getStep(): number {
      const slide = track!.children[0] as HTMLElement | undefined;
      if (!slide) return 0;
      const styles = window.getComputedStyle(track!);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return slide.offsetWidth + gap;
    }

    function applyTransform(animate: boolean) {
      track!.style.transition = animate && !reducedMotion ? `transform ${TRANSITION_MS}ms ease` : 'none';
      track!.style.transform = `translateX(${-getStep() * currentIndex}px)`;
    }

    function next() {
      if (isMobile()) collapseAll();
      const max = getMaxIndex();
      currentIndex = currentIndex < max ? currentIndex + 1 : 0;
      applyTransform(true);
    }

    function prev() {
      if (isMobile()) collapseAll();
      const max = getMaxIndex();
      currentIndex = currentIndex > 0 ? currentIndex - 1 : max;
      applyTransform(true);
    }

    function startAuto() {
      stopAuto();
      if (reducedMotion) return;
      timerId = window.setInterval(() => {
        if (!isHover) next();
      }, AUTO_MS);
    }

    function stopAuto() {
      if (timerId !== null) {
        window.clearInterval(timerId);
        timerId = null;
      }
    }

    // Téléphone (moins de 600 px) : troncature à 6 lignes en CSS, ouverture par classe.
    const mobileMq = window.matchMedia('(max-width: 599px)');
    const isMobile = () => mobileMq.matches;

    function setToggle(btn: HTMLButtonElement | null, open: boolean) {
      if (!btn) return;
      btn.setAttribute('aria-expanded', String(open));
      btn.textContent = open ? 'Voir moins' : 'Voir plus';
    }

    // Referme les avis ouverts (téléphone, au changement d'avis).
    function collapseAll() {
      getSlides().forEach((card) => {
        if (!card.classList.contains('is-open')) return;
        card.classList.remove('is-open');
        setToggle(card.querySelector<HTMLButtonElement>('[data-testimonial-toggle]'), false);
      });
      setMobileCardHeight();
    }

    // Hauteur commune des cartes fermées, mesurée sur la version tronquée.
    function setMobileCardHeight() {
      const cards = getSlides();
      track!.style.removeProperty('--tcard-h');
      const open = cards.filter((c) => c.classList.contains('is-open'));
      open.forEach((c) => c.classList.remove('is-open'));
      const h = Math.max(...cards.map((c) => c.offsetHeight));
      open.forEach((c) => c.classList.add('is-open'));
      track!.style.setProperty('--tcard-h', `${h}px`);
    }

    function setupMobileTruncation(containers: HTMLElement[]) {
      containers.forEach((c) => { c.style.maxHeight = ''; });
      containers.forEach((c) => {
        const card = c.closest<HTMLElement>('.hp-tcard');
        if (!card) return;
        const toggle = card.querySelector<HTMLButtonElement>('[data-testimonial-toggle]');
        const open = card.classList.contains('is-open');
        card.classList.remove('is-open');
        const overflows = c.scrollHeight > c.clientHeight + 2;
        if (toggle) toggle.hidden = !overflows;
        const keepOpen = open && overflows;
        card.classList.toggle('is-open', keepOpen);
        setToggle(toggle, keepOpen);
      });
      setMobileCardHeight();
    }

    // Hauteur fixe + bouton « Voir plus / Voir moins » par carte.
    function setupTruncation() {
      const containers = Array.from(carousel!.querySelectorAll<HTMLElement>('[data-testimonial-paragraphs]'));
      if (containers.length === 0) return;
      if (isMobile()) {
        setupMobileTruncation(containers);
        return;
      }
      // Tablette et ordinateur : comportement d'origine.
      track!.style.removeProperty('--tcard-h');
      getSlides().forEach((card) => {
        if (!card.classList.contains('is-open')) return;
        card.classList.remove('is-open');
        setToggle(card.querySelector<HTMLButtonElement>('[data-testimonial-toggle]'), false);
      });
      containers.forEach((c) => { c.style.maxHeight = 'none'; });
      containers.forEach((c) => void c.offsetHeight);
      const heights = containers.map((c) => c.scrollHeight);
      const sortedDesc = [...heights].sort((a, b) => b - a);
      const target = sortedDesc.length >= 2 ? sortedDesc[1] : sortedDesc[0];
      containers.forEach((c, i) => {
        c.dataset.maxHeight = String(target);
        const card = c.closest('.hp-tcard');
        const toggle = card?.querySelector<HTMLButtonElement>('[data-testimonial-toggle]') ?? null;
        const overflows = heights[i] > target + 2;
        const isExpanded = toggle?.getAttribute('aria-expanded') === 'true';
        if (overflows) {
          if (toggle) toggle.hidden = false;
          if (!isExpanded) c.style.maxHeight = target + 'px';
        } else {
          if (toggle) {
            toggle.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.textContent = 'Voir plus';
          }
          c.style.maxHeight = target + 'px';
        }
      });
    }

    function bindToggles() {
      carousel!.querySelectorAll<HTMLButtonElement>('[data-testimonial-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.hp-tcard');
          const container = card?.querySelector<HTMLElement>('[data-testimonial-paragraphs]');
          if (!container) return;
          if (isMobile()) {
            const open = !card!.classList.contains('is-open');
            card!.classList.toggle('is-open', open);
            setToggle(btn, open);
            return;
          }
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          if (expanded) {
            container.style.maxHeight = (container.dataset.maxHeight ?? '0') + 'px';
            btn.setAttribute('aria-expanded', 'false');
            btn.textContent = 'Voir plus';
          } else {
            container.style.maxHeight = container.scrollHeight + 'px';
            btn.setAttribute('aria-expanded', 'true');
            btn.textContent = 'Voir moins';
          }
        });
      });
    }

    prevBtn.addEventListener('click', () => { prev(); startAuto(); });
    nextBtn.addEventListener('click', () => { next(); startAuto(); });
    carousel.addEventListener('mouseenter', () => { isHover = true; });
    carousel.addEventListener('mouseleave', () => { isHover = false; });
    carousel.addEventListener('focusin', () => { isHover = true; });
    carousel.addEventListener('focusout', () => { isHover = false; });

    let resizeTimer: number | null = null;
    window.addEventListener('resize', () => {
      if (resizeTimer !== null) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        setupTruncation();
        const max = getMaxIndex();
        if (currentIndex > max) currentIndex = max;
        applyTransform(false);
      }, 150);
    });

    bindToggles();
    setupTruncation();
    applyTransform(false);
    startAuto();
  })();
</script>

<script>
  // Bandeau collant : visible une fois le hero dépassé, masqué dès que le
  // bandeau final entre à l'écran (et au-delà). Il ne recouvre jamais la
  // bannière de consentement CookieYes : il se retire tant qu'elle (ou sa
  // fenêtre de préférences) est affichée, et s'écarte du bouton flottant
  // « préférences » de CookieYes s'il est présent dans le bas de l'écran.
  (function () {
    const pop = document.querySelector<HTMLElement>('[data-hp-pop]');
    const hero = document.querySelector<HTMLElement>('[data-hp-hero]');
    const finalBand = document.querySelector<HTMLElement>('[data-hp-final]');
    if (!pop || !hero || !finalBand) return;

    const isShown = (el: Element | null): el is HTMLElement => {
      if (!el) return false;
      const r = (el as HTMLElement).getBoundingClientRect();
      if (r.width === 0 || r.height === 0) return false;
      const cs = window.getComputedStyle(el);
      return cs.display !== 'none' && cs.visibility !== 'hidden' && Number(cs.opacity) > 0;
    };

    // Bannière ou fenêtre de préférences CookieYes ouverte.
    const consentOpen = () => {
      const banner = document.querySelector('.cky-consent-container');
      if (banner && !banner.classList.contains('cky-hide') && isShown(banner)) return true;
      const modal = document.querySelector('.cky-modal.cky-modal-open');
      if (modal && isShown(modal)) return true;
      return false;
    };

    let lastLeft = 12;
    let lastRight = 12;

    // Bouton flottant CookieYes : on réserve sa place sur le côté où il se trouve.
    const avoidRevisit = () => {
      const btn = document.querySelector('.cky-btn-revisit-wrapper');
      let left = 12;
      let right = 12;
      if (btn && isShown(btn)) {
        const r = btn.getBoundingClientRect();
        if (r.bottom > window.innerHeight - 120) {
          if (r.left + r.width / 2 < window.innerWidth / 2) left = Math.max(left, Math.ceil(r.right) + 10);
          else right = Math.max(right, Math.ceil(window.innerWidth - r.left) + 10);
        }
      }
      if (left !== lastLeft) pop.style.setProperty('--pop-left', `${left}px`);
      if (right !== lastRight) pop.style.setProperty('--pop-right', `${right}px`);
      lastLeft = left;
      lastRight = right;
    };

    let shown = false;
    let ticking = false;

    const update = () => {
      ticking = false;
      const vh = window.innerHeight;
      const pastHero = hero.getBoundingClientRect().bottom < 0;
      const finalReached = finalBand.getBoundingClientRect().top < vh;
      const next = pastHero && !finalReached && !consentOpen();
      avoidRevisit();
      if (next === shown) return;
      shown = next;
      pop.classList.toggle('is-shown', shown);
      if (shown) pop.removeAttribute('inert');
      else pop.setAttribute('inert', '');
    };

    const schedule = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    document.addEventListener('cookieyes_banner_load', schedule);
    document.addEventListener('cookieyes_consent_update', schedule);

    // CookieYes insère et masque ses éléments par classes : on suit ces changements.
    new MutationObserver(schedule).observe(document.body, {
      childList: true,
      subtree: true,
      attributes: true,
      attributeFilter: ['class'],
    });

    update();
  })();
</script>
