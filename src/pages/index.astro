    .hp-pop.is-shown { transform: translate(-50%, 0); }
    .hp-pop__txt { display: inline; flex: none; font-size: 15px; white-space: nowrap; }
  }

  /* ===== MOUVEMENT RÉDUIT ===== */
  @media (prefers-reduced-motion: reduce) {
    .hp-mq__track { animation: none; width: auto; }
    .hp-mq__list { flex-wrap: wrap; justify-content: center; row-gap: 10px; padding: 0 20px; }
    .hp-mq__list--dup { display: none; }
    .hp-mq { -webkit-mask: none; mask: none; }

    .cta,
    .hp-tile,
    .hp-ico,
    .hp-s,
    .hp-m,
    .hp-tcar__track,
    .hp-tcar__nav,
    .hp-tcard__paragraphs,
    .hp-pop,
    .hp-pop.is-shown { transition: none; }

    .cta:hover,
    .hp-tile--link:hover,
    .hp-tile--link:hover .hp-tile__go,
    .hp-teaser:hover,
    .hp-teaser:hover .hp-go,
    .hp-s:hover,
