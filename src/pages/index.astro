---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    name: 'Agence WOOP',
    url: `${SITE_URL}/`,
    logo: `${SITE_URL}/images/logo-woop.png`,
    image: `${SITE_URL}/images/og-image.jpg`,
    telephone: '+1-438-815-2295',
    email: 'contact@agence-woop.ca',
    address: {
      '@type': 'PostalAddress',
      addressLocality: 'Montréal',
      addressRegion: 'QC',
      addressCountry: 'CA',
    },
    areaServed: 'Québec',
    sameAs: [
      'https://www.linkedin.com/company/agence-woop/',
      'https://www.facebook.com/agencewoop',
      'https://www.instagram.com/agencewoop/',
    ],
  },
];

const sectors = [
  'Cliniques',
  'Pharmacies',
  'Cabinets dentaires',
  'Physiothérapie',
  'Médico-esthétique',
  'Bien-être',
  'Recrutement spécialisé',
];

const agenda = [
  { time: '9:00', title: 'Physiothérapie', note: 'Réservé en ligne' },
  { time: '10:30', title: 'Ostéopathie', note: 'Réservé en ligne' },
  { time: '13:00', title: 'Consultation', note: 'Réservé en ligne' },
  { time: '15:30', title: 'Nouveau patient', note: 'Via Google', hot: true },
  { time: '17:00', title: 'Massothérapie', note: 'Réservé en ligne' },
];

// Photos rondes de l'équipe.
// - fx / fy : cadrage d'origine (photo calée en haut, agrandie autour de ce point).
// - objectPosition / zoom (optionnels, photos rondes seulement) : réglage de cadrage propre
//   à une photo. Dès que l'un des deux est défini, il remplace le cadrage d'origine :
//   la photo est positionnée sur ce point (object-position, « center » par défaut) puis
//   agrandie autour de lui (facteur d'échelle, 1 par défaut).
type TeamMember = {
  name: string;
  role: string;
  img: string;
  fx?: string;
  fy?: string;
  objectPosition?: string;
  zoom?: number;
};

const team: TeamMember[] = [
  // Aligné sur Kevin (ligne des yeux, haut de la tête, taille du visage).
  { name: 'Gauthier', role: 'Cofondateur · Stratégie · Infirmier clinicien', img: 'gauthier', objectPosition: '57.8% 30.6%', zoom: 1.7 },
  { name: 'Kevin', role: 'Cofondateur · Création', img: 'kevin', fx: '50%', fy: '31%' },
  { name: 'Emma', role: 'Spécialiste Paid Media', img: 'emma', fx: '55%', fy: '31%' },
];

// Variables CSS de cadrage d'une photo ronde.
const framing = (m: TeamMember) =>
  m.objectPosition !== undefined || m.zoom !== undefined
    ? `--obj-pos: ${m.objectPosition ?? 'center'}; --zoom: ${m.zoom ?? 1};`
    : `--fx: ${m.fx ?? '50%'}; --fy: ${m.fy ?? '30%'};`;
const isFramed = (m: TeamMember) => m.objectPosition !== undefined || m.zoom !== undefined;

const roles = ['Stratège', 'Créatif', 'Spécialiste Paid Media', 'Analyste'];

// Tuiles de Nos services. Si `href` est défini, toute la tuile devient un lien
// (effet au survol + chevron). Aucune tuile n'a de lien pour l'instant.
const services: {
  key: 'ads' | 'cx' | 'brand' | 'web' | 'social';
  title: string;
  text: string | string[];
  variant: 'grad' | 'blush' | 'plum' | 'orange' | 'rose';
  layout: 'ads' | 'cx' | 'sq' | 'social';
  reveal: 'left' | 'right' | 'up';
  step?: string;
  icoGrad?: boolean;
  href?: string;
}[] = [
  { key: 'ads', title: 'Publicité Google et Meta', text: 'Être trouvé en premier, là où vos clients cherchent.', variant: 'grad', layout: 'ads', reveal: 'left' },
  { key: 'cx', title: 'Conseil en expérience client', text: 'Du premier clic au rendez-vous, on rend chaque étape plus simple pour vos patients.', variant: 'blush', layout: 'cx', reveal: 'right' },
  { key: 'brand', title: 'Image de marque', text: 'Logo, charte, système complet. Une identité cohérente qui inspire confiance dès le premier regard.', variant: 'plum', layout: 'sq', reveal: 'up', step: '1', icoGrad: true },
  { key: 'web', title: 'Sites web & pages de conversion', text: 'Un site clair et rapide, conçu pour inspirer confiance et donner envie de prendre rendez-vous.', variant: 'orange', layout: 'sq', reveal: 'right', step: '2' },
  { key: 'social', title: 'Gestion des réseaux sociaux', text: ['Instagram, Facebook, LinkedIn.', 'On crée, on publie, on anime votre communauté.'], variant: 'rose', layout: 'social', reveal: 'up' },
];

const testimonials: { paragraphs: string[]; name: string; role?: string }[] = [
  {
    paragraphs: [
      "« Kévin a su comprendre dès le début les subtilités de ma vision marketing.",
      "Son audace, son agilité et sa passion pour l'image de marque m'ont convaincu dès les premiers instants.",
      "Je recommande les services de l'Agence WOOP. »",
    ],
    name: 'David Caron',
    role: 'PDG, Expoze Recrutement',
  },
  {
    paragraphs: [
      "« Kevin et l'agence marketing WOOP ont su capter l'essence de mon projet et la traduire en un visuel à la fois clair et impactant.",
      "Son approche méticuleuse et sa recherche approfondie permettent d'obtenir un résultat à la hauteur des attentes. »",
    ],
    name: 'Marie-Josée Bélanger',
    role: 'PDG, ZoneRH',
  },
  {
    paragraphs: [
      "« Nous travaillons avec WOOP depuis décembre 2025. Dès le début de la relation d'affaires, j'ai senti que je travaillais avec des professionnels compétents et très attentifs aux détails.",
      "Ça m'a plu immédiatement et surtout, je me suis senti en confiance. Leur démarche est très structurée et professionnelle. Ils ont rapidement mis en place les bases d'une campagne efficace de reconnaissance de notre marque sur LinkedIn.",
      "Nous allons passer à la prochaine étape avec eux : convertir en opportunités d'affaires. »",
    ],
    name: 'Luc Lacroix',
    role: 'PDG, Santé au travail Konsil Inc.',
  },
  {
    paragraphs: [
      "« C'est un réel plaisir de collaborer avec WOOP depuis plusieurs mois déjà. Leur équipe nous accompagne au quotidien avec professionnalisme, créativité et réactivité.",
      "Leur compréhension de nos besoins, la pertinence de leurs conseils et la qualité de leur travail contribuent directement à l'atteinte de nos objectifs.",
      "L'équipe est toujours disponible, à l'écoute et proactive dans la recherche de solutions adaptées à nos besoins, tout en tenant compte de nos contraintes et de notre réalité. Nous apprécions particulièrement leur approche humaine, leur transparence ainsi que leur capacité à livrer des résultats concrets, et ce, toujours dans les délais convenus.",
      "WOOP est un partenaire de confiance que nous recommandons sans hésitation à toute entreprise à la recherche d'une agence marketing compétente, engagée et axée sur les résultats. »",
    ],
    name: 'AlliancePharma',
  },
  {
    paragraphs: [
      "« Notre expérience avec Agence WOOP est tout simplement sublime. Nous utilisons leur service depuis maintenant 1 an et que dire du service personnalisé, de la qualité du travail et de la collaboration qui se fait dans une parfaite harmonie, et ce depuis le tout début.",
      "5 étoiles pour leur service est le moins qu'on puisse donner !",
      "Quelle belle expérience que de travailler avec eux au quotidien. Je réfère cette agence à tous ceux qui souhaitent augmenter leur notoriété, leur visibilité ou gérer leurs médias sociaux. »",
    ],
    name: 'Clémence Rachiele',
    role: 'Fondatrice, PurRH',
  },
  {
    paragraphs: [
      "« Une agence exceptionnelle ! Un merci tout particulier à Kevin pour son écoute et sa grande capacité d'analyse.",
      "Il a su comprendre notre secteur d'activité en un temps record et traduire notre vision en publications LinkedIn percutantes et professionnelles.",
      "Je recommande à 100 % ! »",
    ],
    name: 'André Garceau',
    role: 'Santé au travail Konsil Inc.',
  },
  {
    paragraphs: [
      "« Service exceptionnel ! Une équipe à l'écoute, efficace et attentive à nos besoins.",
      "L'approche est personnalisée et les résultats sont concrets.",
      "Je recommande fortement leurs services à toute entreprise qui souhaite faire évoluer son marketing. »",
    ],
    name: 'Geneviève Decelles',
    role: 'Directrice des opérations, EXPOZE Recrutement',
  },
];
---
<Layout
  title="WOOP | Agence marketing santé et recrutement à Montréal"
  description="L'agence d'acquisition et d'identité de marque dédiée à la santé, au bien-être et au recrutement spécialisé au Québec."
  ogImage="/images/og-image.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé. -->
  <ScrollReveal />

  <!-- 1. HERO (non animé) -->
  <section class="hp-hero" data-hp-hero>
    <div class="container hp-hero__grid">
      <div class="hp-hero__text">
        <p class="kicker hp-hero__kicker">Agence marketing santé · Montréal</p>
        <h1 class="hp-hero__title">Le marketing <span class="gradient-accent hp-kw">santé</span> qui remplit votre agenda.</h1>
        <p class="hp-hero__sub">Une équipe marketing complète, <strong>sans avoir à en embaucher une.</strong> Un clinicien, un créatif et une experte en acquisition, dédiés aux cliniques, pharmacies, professionnels de la santé et cabinets de recrutement au Québec.</p>
        <div class="hp-acts">
          <a class="cta" href={`${base}/contact`}>Réserver un appel découverte<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l6-6M6 5h5v5"/></svg></span></a>
          <a class="cta cta--line" href="#services">Voir nos services<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span></a>
        </div>
      </div>

      <div class="hp-hv" aria-hidden="true">
        <div class="hp-hv__stage">
          <div class="hp-hv__grid"></div>
          <div class="hp-hv__glow"></div>
          <div class="hp-hv__cross"><span class="hp-hv__cross-shape"></span></div>

          <div class="hp-phone">
            <span class="hp-phone__btn hp-phone__btn--vol1"></span>
            <span class="hp-phone__btn hp-phone__btn--vol2"></span>
            <div class="hp-phone__screen">
            <div class="hp-phone__bar"><span class="hp-phone__isl"></span></div>
            <div class="hp-phone__top">
              <b>Agenda</b>
              <em class="hp-phone__live"><i></i>Complet</em>
            </div>
            {agenda.map((slot) => (
              <div class:list={['hp-slot', { 'hp-slot--hot': slot.hot }]}>
                <em>{slot.time}</em>
                <div><b>{slot.title}</b><small>{slot.note}</small></div>
                <i>
                  {slot.hot
                    ? <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M8 3.5v9M3.5 8h9"/></svg>
                    : <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l3 3 6-7"/></svg>}
                </i>
              </div>
            ))}
            <span class="hp-phone__home"></span>
            </div>
          </div>

          <div class="hp-float hp-float--rdv">
            <span class="hp-float__ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg></span>
            <div><b>Nouveau rendez-vous</b><small>Il y a 2 min</small></div>
          </div>

          <div class="hp-float hp-float--avis">
            <span class="hp-stars"><svg viewBox="0 0 100 20"><use href="#hp-star" x="0" y="0" width="20" height="20" /><use href="#hp-star" x="20" y="0" width="20" height="20" /><use href="#hp-star" x="40" y="0" width="20" height="20" /><use href="#hp-star" x="60" y="0" width="20" height="20" /><use href="#hp-star" x="80" y="0" width="20" height="20" /></svg></span>
            <b>« Accueil impeccable »</b>
            <small>Nouvel avis Google</small>
          </div>
        </div>
      </div>
    </div>

    <!-- Symbole étoile réutilisé (avis du hero et témoignages) -->
    <svg class="hp-sprite" aria-hidden="true" focusable="false">
      <symbol id="hp-star" viewBox="0 0 20 20"><path d="M10 1.8l2.5 5.2 5.7.8-4.1 4 1 5.6L10 14.7l-5.1 2.7 1-5.6-4.1-4 5.7-.8z" fill="currentColor" /></symbol>
    </svg>
  </section>

  <!-- 2. BANDEAU DÉFILANT -->
  <div class="hp-mq">
    <div class="hp-mq__track">
      <ul class="hp-mq__list">
        {sectors.map((s) => (
          <li><span>{s}</span><b aria-hidden="true">✚</b></li>
        ))}
      </ul>
      <ul class="hp-mq__list hp-mq__list--dup" aria-hidden="true">
        {sectors.map((s) => (
          <li><span>{s}</span><b>✚</b></li>
        ))}
      </ul>
    </div>
  </div>

  <!-- 3. NOS SERVICES -->
  <section class="hp-block hp-sec hp-sec--services" id="services" data-reveal-clip>
    <div class="container">
      <div class="hp-head">
        <h2 class="section-title hp-title" data-reveal="left">Nos <span class="gradient-accent">services</span></h2>
        <p class="hp-head__intro" data-reveal="left" data-reveal-step="1">Tout ce que ferait une équipe marketing interne. Sans recruter, sans former, sans gérer.</p>
      </div>

      <div class="hp-bento">
        {services.map((t) => {
          const Tag = t.href ? 'a' : 'article';
          return (
            <Tag
              href={t.href}
              class:list={['hp-tile', `hp-tile--${t.variant}`, `hp-tile--${t.layout}`, { 'hp-tile--link': t.href }]}
              data-reveal={t.reveal}
              data-reveal-step={t.step}
            >
              <span class:list={['hp-ico', { 'hp-ico--grad': t.icoGrad }]} aria-hidden="true">
                {t.key === 'ads' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-2a1 1 0 011-1h3l7-4v14l-7-4H5a1 1 0 01-1-1z"/><path d="M8 16l1.5 4.5"/><path d="M19 9.5a4 4 0 010 5"/></svg>)}
                {t.key === 'cx' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 01-11.6 7.1L4 20l1-4.2A8 8 0 1120 12z"/><path d="M12 15.5s-3.5-2-3.5-4.3a2 2 0 013.5-1.3 2 2 0 013.5 1.3c0 2.3-3.5 4.3-3.5 4.3z"/></svg>)}
                {t.key === 'brand' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l2.2 5.3L20 9l-4.4 3.8L17 18.5 12 15.6 7 18.5l1.4-5.7L4 9l5.8-.7z"/></svg>)}
                {t.key === 'web' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M3 8h18"/><path d="M12 12l6 2.5-2.6 1-1 2.6z"/></svg>)}
                {t.key === 'social' && (<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1"/></svg>)}
              </span>
              {t.href && (
                <span class="hp-tile__go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg></span>
              )}
              {t.key === 'ads' && (
                <div class="hp-ad" aria-hidden="true">
                  <div class="hp-ad__search">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/></svg>
                    <i></i>
                  </div>
                  <div class="hp-ad__res hp-ad__res--top">
                    <span class="hp-ad__badge"></span>
                    <span class="hp-ad__line hp-ad__line--lg"></span>
                    <span class="hp-stars hp-stars--sm"><svg viewBox="0 0 100 20"><use href="#hp-star" x="0" y="0" width="20" height="20" /><use href="#hp-star" x="20" y="0" width="20" height="20" /><use href="#hp-star" x="40" y="0" width="20" height="20" /><use href="#hp-star" x="60" y="0" width="20" height="20" /><use href="#hp-star" x="80" y="0" width="20" height="20" /></svg></span>
                    <span class="hp-ad__line"></span>
                  </div>
                  <div class="hp-ad__res"><span class="hp-ad__line hp-ad__line--md"></span><span class="hp-ad__line"></span></div>
                  <div class="hp-ad__res"><span class="hp-ad__line hp-ad__line--md"></span><span class="hp-ad__line"></span></div>
                </div>
              )}
              <div class="hp-tile__txt">
                <h3>{t.title}</h3>
                <p>{Array.isArray(t.text) ? t.text.map((line, i) => <>{i > 0 && <br />}{line}</>) : t.text}</p>
              </div>
              {t.key === 'social' && (
                <div class="hp-posts" aria-hidden="true">
                  {[1, 2, 3].map((n) => (
                    <div class:list={['hp-post', `hp-post--${n}`]}>
                      <div class="hp-post__head"><span class="hp-post__av"></span><span class="hp-post__lines"><i></i><i></i></span></div>
                      <div class="hp-post__img">
                        {n === 1 && (
                          <svg viewBox="0 0 120 80"><rect width="120" height="80" class="f-blush" /><circle cx="60" cy="34" r="16" class="f-pink" /><rect x="40" y="56" width="40" height="8" rx="4" class="f-plum" /><path d="M54 34h12M60 28v12" class="s-light" stroke-width="4" stroke-linecap="round" /></svg>
                        )}
                        {n === 2 && (
                          <svg viewBox="0 0 120 80"><rect width="120" height="80" class="f-plum" /><circle cx="40" cy="36" r="11" class="f-pinklight" /><path d="M22 70c2-12 10-18 18-18s16 6 18 18" class="f-pinklight" /><circle cx="80" cy="36" r="11" class="f-orange" /><path d="M62 70c2-12 10-18 18-18s16 6 18 18" class="f-orange" /></svg>
                        )}
                        {n === 3 && (
                          <svg viewBox="0 0 120 80"><rect width="60" height="80" class="f-orange" /><rect x="60" width="60" height="80" class="f-pink" /><path d="M14 56l12-14 10 10 10-16" class="s-light" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" /><path d="M74 60l10-10 8 6 16-24" class="s-light" stroke-width="4" fill="none" stroke-linecap="round" stroke-linejoin="round" /><rect x="58" width="4" height="80" class="f-light" /></svg>
                        )}
                      </div>
                      <div class="hp-post__foot">
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 20s-7-4.4-7-10a4 4 0 017-2.6A4 4 0 0119 10c0 5.6-7 10-7 10z"/></svg>
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M20 12a8 8 0 01-11.6 7.1L4 20l1-4.2A8 8 0 1120 12z"/></svg>
                      </div>
                      <div class="hp-post__cap"><i></i><i></i></div>
                    </div>
                  ))}
                </div>
              )}
            </Tag>
          );
        })}
      </div>

      <div class="hp-inl" data-reveal="up">
        <p>Vous avez besoin de tout ça ? <strong>C'est exactement ce que fait WOOP.</strong></p>
        <a class="cta" href={`${base}/contact`}>Réserver un appel découverte<span class="cta__ico" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 11l6-6M6 5h5v5"/></svg></span></a>
      </div>
    </div>
  </section>

  <!-- 4. MARQUE + PERFORMANCE -->
  <section class="hp-block hp-sec" id="approche" data-reveal-clip>
    <div class="container">
      <div class="hp-head">
        <h2 class="section-title hp-title hp-title--plus" data-reveal="left"><span class="gradient-accent">Marque</span> <span class="hp-plus"><span class="gradient-accent">+</span></span> <span class="gradient-accent">performance</span></h2>
        <p class="hp-head__intro" data-reveal="left" data-reveal-step="1">Une marque solide fait baisser le coût d'acquisition. L'un ne va pas sans l'autre.</p>
      </div>

      <ol class="hp-spi">
        <li class="hp-st" data-reveal="left">
          <span class="hp-st__idx" aria-hidden="true">01</span>
          <h3><span class="visually-hidden">01 </span>Image de marque</h3>
          <p>On construit une marque qui inspire confiance.</p>
        </li>
        <li class="hp-st hp-st--hot" data-reveal="up" data-reveal-step="1">
          <span class="hp-st__idx" aria-hidden="true">02</span>
          <h3><span class="visually-hidden">02 </span>Performance</h3>
          <p>On la diffuse là où vos clients cherchent.</p>
        </li>
        <li class="hp-st" data-reveal="right" data-reveal-step="2">
          <span class="hp-st__idx" aria-hidden="true">03</span>
          <h3><span class="visually-hidden">03 </span>Optimisation</h3>
          <p>On mesure, on ajuste, vous performez. On recommence.</p>
        </li>
      </ol>

      <a class="hp-teaser" href={`${base}/acquisition-client`} data-reveal="up">
        <span class="hp-teaser__dot" aria-hidden="true"></span>
        <span><strong>Nouveau :</strong> testez votre visibilité en 2 minutes</span>
        <span class="hp-go" aria-hidden="true"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg></span>
      </a>
    </div>
  </section>

  <!-- 5. UNE ÉQUIPE, SANS EMBAUCHE -->
  <section class="hp-block hp-sec" data-reveal-clip>
    <div class="container">
      <div class="hp-head">
        <h2 class="section-title hp-title" data-reveal="left"><span class="gradient-accent">Une équipe</span>, sans embauche</h2>
        <p class="hp-head__intro" data-reveal="left" data-reveal-step="1">Tout le savoir-faire d'un service marketing, sans les postes à pourvoir.</p>
      </div>

      <div class="hp-cmp">
