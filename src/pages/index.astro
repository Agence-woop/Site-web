  /* Conteneur des paragraphes : hauteur plafonnée en JS (2e plus grande carte) */
  .hp-tcard__paragraphs {
    width: 100%;
    overflow: hidden;
    transition: max-height 250ms ease;
  }

  /* Téléphone : texte limité à 6 lignes en CSS (le texte complet reste dans le HTML),
     cartes fermées de même hauteur (--tcard-h, calculée en JS sur la version tronquée).
     Uniquement quand le carrousel est actif : sans JavaScript, tout le texte reste visible. */
  @media (max-width: 599px) {
    .hp-tcar.is-ready .hp-tcar__track { align-items: flex-start; }
    .hp-tcar.is-ready .hp-tcard { min-height: var(--tcard-h, 0); }
    .hp-tcar.is-ready .hp-tcard__paragraphs {
      display: -webkit-box;
