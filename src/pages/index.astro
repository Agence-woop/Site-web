<script>
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px',
  };

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const animatedElements = document.querySelectorAll(
      '.bento-grid--approche > *, .personas > *, .testimonials > *, .proof, .team-strip'
    );

    animatedElements.forEach((el) => {
      (el as HTMLElement).style.opacity = '0';
      (el as HTMLElement).style.transform = 'translateY(24px)';
    });

    let staggerIndex = 0;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const el = entry.target as HTMLElement;
          const delay = staggerIndex * 80;
          staggerIndex++;

          setTimeout(() => {
            el.style.transition = 'opacity 600ms ease, transform 600ms ease';
            el.style.opacity = '1';
            el.style.transform = 'translateY(0)';
          }, delay);

          observer.unobserve(el);

          setTimeout(() => { staggerIndex = 0; }, 400);
        }
      });
    }, observerOptions);

    animatedElements.forEach((el) => observer.observe(el));
  }
</script>

<script>
  // Carrousel des avis clients :
  // - Navigation BORNÉE (positions 0..(N-V), pas de clonage). Depuis la
  //   dernière position, next() revient à 0 avec une transition douce ; idem
  //   prev() depuis 0 vers la dernière position. Avec V cartes visibles et
  //   N=7 au total, chaque vue contient toujours des avis aux index croissants
  //   contigus, donc l'alternance translucide/dégradé est garantie à toutes
  //   les vues, sans collage 7↔1.
  // - Auto-défilement 6 s, pause au survol et au focus, respect de
  //   prefers-reduced-motion (pas d'auto, pas de transition, flèches OK).
  // - Hauteur fixe calée sur la 2e plus grande carte mesurée. Cartes plus
  //   longues : bouton « Voir plus / Voir moins », sinon le bouton reste caché.
  (function () {
    const carousel = document.querySelector<HTMLElement>('[data-testimonials-carousel]');
    if (!carousel) return;
    const track = carousel.querySelector<HTMLElement>('[data-testimonials-track]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-testimonials-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-testimonials-next]');
    if (!track || !prevBtn || !nextBtn) return;

    const TRANSITION_MS = 500;
    const AUTO_MS = 6000;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let currentIndex = 0;
    let isHover = false;
    let timerId: number | null = null;

    function getVisibleCount(): number {
      const w = window.innerWidth;
      if (w >= 1024) return 3;
      if (w >= 640) return 2;
      return 1;
    }

    function getSlides(): HTMLElement[] {
      return Array.from(track!.children) as HTMLElement[];
    }

    function getMaxIndex(): number {
      // Plus grand index de départ : N - V (positions bornées).
      const n = getSlides().length;
      const v = getVisibleCount();
      return Math.max(0, n - v);
    }

    function getStep(): number {
      const slide = track!.children[0] as HTMLElement | undefined;
      if (!slide) return 0;
      const styles = window.getComputedStyle(track!);
      const gap = parseFloat(styles.columnGap || styles.gap || '0') || 0;
      return slide.offsetWidth + gap;
    }

    function applyTransform(animate: boolean) {
      track!.style.transition = animate && !reducedMotion ? `transform ${TRANSITION_MS}ms ease` : 'none';
      track!.style.transform = `translateX(${-getStep() * currentIndex}px)`;
    }

    function next() {
      const max = getMaxIndex();
      currentIndex = currentIndex < max ? currentIndex + 1 : 0;
      applyTransform(true);
    }

    function prev() {
      const max = getMaxIndex();
      currentIndex = currentIndex > 0 ? currentIndex - 1 : max;
      applyTransform(true);
    }

    function startAuto() {
      stopAuto();
      if (reducedMotion) return;
      timerId = window.setInterval(() => {
        if (!isHover) next();
      }, AUTO_MS);
    }

    function stopAuto() {
      if (timerId !== null) {
        window.clearInterval(timerId);
        timerId = null;
      }
    }

    // === Hauteur fixe + bouton « Voir plus / Voir moins » par carte =========
    // On mesure la hauteur naturelle de chaque conteneur de paragraphes, on
    // prend la 2e plus grande, on la pose comme max-height sur tous. Seules
    // les cartes qui débordent (typiquement AlliancePharma) reçoivent un
    // bouton actif.
    function setupTruncation() {
      const containers = Array.from(carousel!.querySelectorAll<HTMLElement>('[data-testimonial-paragraphs]'));
      if (containers.length === 0) return;
      // Laisser les conteneurs s'étendre librement pour mesurer.
      containers.forEach((c) => { c.style.maxHeight = 'none'; });
      // Forcer un reflow.
      containers.forEach((c) => void c.offsetHeight);
      const heights = containers.map((c) => c.scrollHeight);
      const sortedDesc = [...heights].sort((a, b) => b - a);
      // 2e plus grand (si 7 cartes), sinon le plus grand.
      const target = sortedDesc.length >= 2 ? sortedDesc[1] : sortedDesc[0];
      containers.forEach((c, i) => {
        c.dataset.maxHeight = String(target);
        const card = c.closest('.testimonial-card');
        const toggle = card?.querySelector<HTMLButtonElement>('[data-testimonial-toggle]') ?? null;
        const overflows = heights[i] > target + 2; // tolérance
        const isExpanded = toggle?.getAttribute('aria-expanded') === 'true';
        if (overflows) {
          if (toggle) {
            toggle.hidden = false;
          }
          if (!isExpanded) c.style.maxHeight = target + 'px';
        } else {
          if (toggle) {
            toggle.hidden = true;
            toggle.setAttribute('aria-expanded', 'false');
            toggle.textContent = 'Voir plus';
          }
          c.style.maxHeight = target + 'px';
        }
      });
    }

    function bindToggles() {
      carousel!.querySelectorAll<HTMLButtonElement>('[data-testimonial-toggle]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const card = btn.closest('.testimonial-card');
          const container = card?.querySelector<HTMLElement>('[data-testimonial-paragraphs]');
          if (!container) return;
          const expanded = btn.getAttribute('aria-expanded') === 'true';
          if (expanded) {
            // Recapper à la hauteur cible.
            container.style.maxHeight = (container.dataset.maxHeight ?? '0') + 'px';
            btn.setAttribute('aria-expanded', 'false');
            btn.textContent = 'Voir plus';
          } else {
            // Lever le cap.
            container.style.maxHeight = container.scrollHeight + 'px';
            btn.setAttribute('aria-expanded', 'true');
            btn.textContent = 'Voir moins';
          }
        });
      });
    }
    // ========================================================================

    prevBtn.addEventListener('click', () => { prev(); startAuto(); });
    nextBtn.addEventListener('click', () => { next(); startAuto(); });
    carousel.addEventListener('mouseenter', () => { isHover = true; });
    carousel.addEventListener('mouseleave', () => { isHover = false; });
    carousel.addEventListener('focusin', () => { isHover = true; });
    carousel.addEventListener('focusout', () => { isHover = false; });

    let resizeTimer: number | null = null;
    window.addEventListener('resize', () => {
      if (resizeTimer !== null) window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        // Recalculer max-height (la largeur des cartes a pu changer) et borner l'index.
        setupTruncation();
        const max = getMaxIndex();
        if (currentIndex > max) currentIndex = max;
        applyTransform(false);
      }, 150);
    });

    bindToggles();
    setupTruncation();
    applyTransform(false);
    startAuto();
  })();
</script>
