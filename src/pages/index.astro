<style>
  /* =====================================================================
     PAGE D'ACCUEIL : styles locaux (scopés).
     Couleurs : uniquement les jetons de global.css, leurs mélanges
     (color-mix) et des rgba() dérivées de #FA6244 et #E62B7F.
     ===================================================================== */

  /* ===== ESPACEMENTS DE RÉFÉRENCE (mêmes valeurs que /acquisition-client) ===== */
  .hp-hero,
  .hp-mq,
  .hp-block {
    /* entre deux sections : 80 px mobile, 100 px tablette, 120 px ordinateur */
    --home-section-gap: 80px;
    /* dans une section : titre → sous-texte, puis titre ou sous-texte → contenu */
    --home-head-gap: 16px;
    --home-head-content: 36px;
  }

  @media (min-width: 768px) {
    .hp-hero,
    .hp-mq,
    .hp-block { --home-section-gap: 100px; }
  }

  @media (min-width: 900px) {
    .hp-hero,
    .hp-mq,
    .hp-block {
      --home-head-gap: 20px;
      --home-head-content: 46px;
    }
  }

  @media (min-width: 1024px) {
    .hp-hero,
    .hp-mq,
    .hp-block { --home-section-gap: 120px; }
  }

  /* Jetons locaux, dérivés de la charte */
  .hp-hero,
  .hp-mq,
  .hp-block,
  .hp-pop {
    --hp-ink: var(--text-primary);
    --hp-dark: var(--bg-deep);
    /* Petits textes, libellés et flèches posés sur le dégradé ou l'orange de la charte */
    --hp-on-grad: var(--bg-deep);
    --hp-light: var(--text-primary);
    --hp-blush: color-mix(in srgb, var(--woop-pink) 16%, var(--text-primary));
    --hp-pinklight: color-mix(in srgb, var(--woop-pink) 45%, var(--text-primary));
    --hp-plum: color-mix(in srgb, var(--woop-pink) 20%, var(--bg-deep));
    --hp-card: var(--bg-elevated);
    --hp-line: color-mix(in srgb, var(--text-primary) 14%, transparent);
    --hp-skel: color-mix(in srgb, var(--text-muted) 22%, var(--text-primary));
    --hp-skel-2: color-mix(in srgb, var(--text-muted) 12%, var(--text-primary));
    --hp-shadow: color-mix(in srgb, var(--bg-deep) 55%, transparent);
    --hp-grad-band: linear-gradient(120deg, var(--woop-orange) 25%, var(--woop-pink));
  }

  /* Remplissages et traits SVG */
  .stop-orange { stop-color: var(--woop-orange); }
  .stop-pink { stop-color: var(--woop-pink); }
  .f-blush { fill: var(--hp-blush); }
  .f-pink { fill: var(--woop-pink); }
  .f-pinklight { fill: var(--hp-pinklight); }
  .f-orange { fill: var(--woop-orange); }
  .f-plum { fill: var(--hp-plum); }
  .f-light { fill: var(--hp-light); }
  .s-light { stroke: var(--hp-light); }
  .s-pink { stroke: var(--woop-pink); }

  .hp-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .hp-stars {
    display: inline-flex;
    color: var(--woop-orange);
  }

  .hp-stars svg {
    width: 84px;
    height: 17px;
    display: block;
  }

  .hp-stars--sm svg {
    width: 56px;
    height: 11px;
  }

  /* ===== BOUTONS ===== */
  .hp-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hp-acts--center { justify-content: center; }

  /* Boutons : même comportement que ceux de /acquisition-client
     (repos sans ombre, survol = soulèvement de 2 px + halo, transition 200 ms,
     pas d'état :active particulier, contour au focus clavier). */
  .cta {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    max-width: 100%;
    padding: 7px 7px 7px 24px;
    border-radius: var(--radius-button);
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 15px;
    line-height: 1.2;
    text-decoration: none;
    transition: box-shadow 200ms ease, transform 200ms ease;
  }

  .cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 40px rgba(230, 43, 127, 0.45);
  }

  .cta:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 3px;
  }

  /* Boutons posés sur un fond dégradé : halo et contour de focus du bandeau final de /acquisition-client */
  .cta--light:hover {
    box-shadow: 0 10px 40px color-mix(in srgb, var(--bg-deep) 45%, transparent);
  }

  .cta--light:focus-visible,
  .cta--on-grad:focus-visible {
    outline-color: var(--text-primary);
  }

  .cta__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--hp-light);
    color: var(--hp-on-grad);
  }

  .cta__ico svg {
    width: 17px;
    height: 17px;
  }

  .cta--light {
    background: var(--hp-light);
    color: var(--hp-dark);
  }

  .cta--light .cta__ico,
  .cta--line .cta__ico {
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
  }

  .cta--line {
    color: var(--text-primary);
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
  }

  .cta--line:hover {
    box-shadow: inset 0 0 0 1.5px var(--hp-line), 0 10px 40px rgba(230, 43, 127, 0.45);
  }

  .cta--on-grad {
    color: var(--hp-on-grad);
    box-shadow: inset 0 0 0 1.5px var(--hp-light);
  }

  .cta--on-grad:hover {
    box-shadow: inset 0 0 0 1.5px var(--hp-light), 0 10px 40px color-mix(in srgb, var(--bg-deep) 45%, transparent);
  }

  .cta--on-grad .cta__ico {
    background: var(--hp-light);
    color: var(--hp-on-grad);
  }

  .cta--sm {
    gap: 10px;
    padding: 5px 5px 5px 18px;
    font-size: 14px;
  }

  .cta--sm .cta__ico {
    width: 34px;
    height: 34px;
  }

  /* ===== TITRES DE SECTION ===== */
  /* Titre puis sous-texte, l'un sous l'autre, alignés à gauche */
  .hp-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--home-head-gap);
    margin-bottom: var(--home-head-content);
  }

  /* Titres Ganky : blanc, un ou deux mots en dégradé (.gradient-accent) */
  .hp-title {
    margin-bottom: 0;
    line-height: 1.02;
    color: var(--text-primary);
    text-wrap: balance;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  /* « Marque + performance » : le + dans un cercle blanc plein, centré sur la hauteur du titre */
  .hp-title--plus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.28em;
    row-gap: 0.08em;
  }

  .hp-plus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 0.84em;
    height: 0.84em;
    border-radius: 50%;
    background: var(--text-primary);
    line-height: 1;
  }

  .hp-plus .gradient-accent {
    display: block;
    font-size: 1.05em;
    line-height: 1;
    letter-spacing: 0;
  }

  .hp-head__intro {
    max-width: 760px;
    color: var(--text-secondary);
    font-size: 17px;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .hp-head__intro { font-size: 19px; }
  }

  /* Pas de mot seul en fin de paragraphe */
  p,
  .hp-m__role,
  .hp-pgrid span,
  .hp-pop__txt {
    text-wrap: pretty;
  }

  .hp-over {
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  /* ===== SECTIONS ===== */
  /* Une seule règle d'espacement entre deux sections consécutives (voir --home-section-gap).
     Le bandeau défilant fait bloc avec le hero ; le bandeau final garde l'écart avant le footer. */
  .hp-mq + .hp-block,
  .hp-block + .hp-block { margin-top: var(--home-section-gap); }

  .hp-block--last { padding-bottom: var(--home-section-gap); }

  .hp-sec--services { scroll-margin-top: 90px; }

  /* ===== 1. HERO ===== */
  .hp-hero {
    position: relative;
    padding: 40px 0 48px;
    overflow-x: clip;
  }

  @media (min-width: 768px) {
    .hp-hero { padding: 64px 0 72px; }
  }

  .hp-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 32px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hp-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
      gap: 48px;
    }
  }

  /* Rose éclairci pour atteindre 4,5:1 sur le fond sombre du hero */
  .hp-hero__kicker {
    margin-bottom: 20px;
    color: color-mix(in srgb, var(--woop-pink) 70%, var(--text-primary));
  }

  .hp-hero__title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 40px;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--text-primary);
    text-wrap: balance;
  }

  @media (min-width: 600px) {
    .hp-hero__title { font-size: 54px; }
  }

  @media (min-width: 1024px) {
    .hp-hero__title { font-size: 62px; }
  }

  @media (min-width: 1280px) {
    .hp-hero__title { font-size: 74px; }
  }

  .hp-kw {
    letter-spacing: 1px;
    padding: 0 0.04em;
  }

  .hp-hero__sub {
    margin: 24px 0 34px;
    max-width: 540px;
    font-size: 17px;
    line-height: 1.6;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .hp-hero__sub strong {
    color: var(--text-primary);
    font-weight: 600;
  }

  @media (min-width: 1024px) {
    .hp-hero__sub { font-size: 18px; }
  }

  /* Illustration : scène de 580 × 560 px mise à l'échelle selon la largeur */
  .hp-hv {
    --hv-scale: 0.58;
    position: relative;
    width: calc(580px * var(--hv-scale));
    height: calc(560px * var(--hv-scale));
    justify-self: center;
  }

  @media (min-width: 420px) { .hp-hv { --hv-scale: 0.64; } }
  @media (min-width: 600px) { .hp-hv { --hv-scale: 0.9; } }
  @media (min-width: 768px) { .hp-hv { --hv-scale: 1; } }
  @media (min-width: 1024px) { .hp-hv { --hv-scale: 0.8; justify-self: end; } }
  @media (min-width: 1280px) { .hp-hv { --hv-scale: 0.96; } }

  .hp-hv__stage {
    position: absolute;
    left: 0;
    top: 0;
    width: 580px;
    height: 560px;
    transform: scale(var(--hv-scale));
    transform-origin: top left;
  }

  .hp-hv__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(color-mix(in srgb, var(--text-primary) 6%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--text-primary) 6%, transparent) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask: radial-gradient(circle at 55% 50%, var(--bg-deep) 10%, transparent 65%);
    mask: radial-gradient(circle at 55% 50%, var(--bg-deep) 10%, transparent 65%);
  }

  .hp-hv__glow {
    position: absolute;
    right: 0;
    top: 0;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 43, 127, 0.36), rgba(250, 98, 68, 0.12) 45%, transparent 70%);
    filter: blur(10px);
  }

  /* Croix de santé : une seule forme (clip-path), un seul dégradé continu.
     L'ombre est portée par le conteneur, pour suivre le contour de la croix. */
  .hp-hv__cross {
    position: absolute;
    /* Décalée vers la gauche : la branche verticale passe derrière le bord droit du téléphone */
    right: 38px;
    top: 10px;
    width: 250px;
    height: 250px;
    filter: drop-shadow(0 30px 60px rgba(230, 43, 127, 0.45));
  }

  .hp-hv__cross-shape {
    position: absolute;
    inset: 0;
    background: var(--woop-gradient);
    clip-path: path('M105 0H145A20 20 0 0 1 165 20V85H230A20 20 0 0 1 250 105V145A20 20 0 0 1 230 165H165V230A20 20 0 0 1 145 250H105A20 20 0 0 1 85 230V165H20A20 20 0 0 1 0 145V105A20 20 0 0 1 20 85H85V20A20 20 0 0 1 105 0Z');
  }

  /* Smartphone : cadre fin, coins très arrondis, encoche, boutons latéraux
     (d'après le téléphone de /acquisition-client) */
  .hp-phone {
    position: absolute;
    left: 172px;
    top: 30px;
    z-index: 2;
    width: 256px;
    height: 500px;
    padding: 8px;
    border-radius: 46px;
    background: var(--bg-deep);
    border: 2px solid rgba(230, 43, 127, 0.25);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 6%, transparent),
      0 0 90px rgba(230, 43, 127, 0.25);
    /* Ombre sombre en drop-shadow (même rendu que box-shadow 0 50px 90px) :
       le flou de box-shadow s'arrête net et dessinait une ligne sur la croix. */
    filter: drop-shadow(0 50px 45px var(--hp-shadow));
    transform: rotate(-5deg);
  }

  .hp-phone__btn {
    position: absolute;
    width: 3px;
    border-radius: 2px;
    background: color-mix(in srgb, var(--woop-pink) 30%, var(--bg-elevated));
  }

  .hp-phone__btn--vol1 { left: -5px; top: 110px; height: 40px; }
  .hp-phone__btn--vol2 { left: -5px; top: 160px; height: 40px; }

  .hp-phone__screen {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 0 10px 10px;
    border-radius: 37px;
    background: var(--bg-elevated);
  }

  /* Barre d'état avec l'encoche (îlot) au centre */
  .hp-phone__bar {
    display: flex;
    justify-content: center;
    flex: none;
    padding: 11px 0 14px;
  }

  .hp-phone__isl {
    width: 78px;
    height: 23px;
    border-radius: 12px;
    background: var(--bg-deep);
  }

  .hp-phone__home {
    display: block;
    flex: none;
    width: 92px;
    height: 4px;
    margin: auto auto 0;
    border-radius: 2px;
    background: color-mix(in srgb, var(--text-primary) 55%, transparent);
  }

  .hp-phone__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 14px;
    border-radius: 22px 22px 10px 10px;
    background: var(--hp-light);
  }

  .hp-phone__top b {
    font-family: var(--font-display);
    font-weight: 400;
    text-transform: uppercase;
    font-size: 26px;
    line-height: 1;
    color: var(--woop-pink);
  }

  .hp-phone__live {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 9px;
    border-radius: 999px;
    background: var(--hp-blush);
    color: var(--woop-pink);
    font-style: normal;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hp-phone__live i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--woop-pink);
  }

  .hp-slot {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 9px;
    padding: 12px;
    border-radius: 14px;
    background: var(--hp-light);
    color: var(--hp-dark);
  }

  .hp-slot em {
    width: 36px;
    font-style: normal;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .hp-slot div { flex: 1; min-width: 0; }

  .hp-slot b {
    display: block;
    font-size: 13px;
    line-height: 1.3;
  }

  .hp-slot small {
    display: block;
    font-size: 10.5px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .hp-slot i {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--hp-blush);
    color: var(--woop-pink);
  }

  .hp-slot i svg { width: 12px; height: 12px; }

  .hp-slot--hot {
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 14px 34px rgba(230, 43, 127, 0.5);
    transform: scale(1.06);
  }

  .hp-slot--hot em,
  .hp-slot--hot small { color: color-mix(in srgb, var(--text-primary) 88%, transparent); }
  .hp-slot--hot i { background: var(--hp-light); }

  .hp-float {
    position: absolute;
    z-index: 3;
    display: flex;
    gap: 12px;
    align-items: center;
    width: max-content;
    padding: 16px 18px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--bg-elevated) 82%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px var(--hp-line), 0 24px 50px var(--hp-shadow);
  }

  .hp-float b { display: block; font-size: 14px; line-height: 1.3; color: var(--text-primary); }
  .hp-float small { display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); }

  .hp-float__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 8px 20px rgba(230, 43, 127, 0.45);
  }

  .hp-float__ico svg { width: 20px; height: 20px; }

  .hp-float--rdv { left: 0; top: 262px; }

  .hp-float--avis {
    right: 0;
    top: 404px;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
  }

  /* ===== 2. BANDEAU DÉFILANT ===== */
  .hp-mq {
    overflow: hidden;
    border-top: 1px solid var(--hp-line);
    border-bottom: 1px solid var(--hp-line);
    padding: 20px 0;
    -webkit-mask: linear-gradient(90deg, transparent, var(--bg-deep) 10%, var(--bg-deep) 90%, transparent);
    mask: linear-gradient(90deg, transparent, var(--bg-deep) 10%, var(--bg-deep) 90%, transparent);
  }

  .hp-mq__track {
    display: flex;
    width: max-content;
    animation: hp-mq 40s linear infinite;
  }

  .hp-mq__list {
    display: flex;
    align-items: center;
    gap: 30px;
    padding-right: 30px;
    list-style: none;
  }

  .hp-mq__list li {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  .hp-mq__list span {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 24px;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--text-primary);
  }

  .hp-mq__list li:nth-child(3n + 2) span {
    color: var(--woop-pink);
  }

  .hp-mq__list b {
    color: var(--woop-pink);
    font-size: 16px;
  }

  @media (min-width: 768px) {
    .hp-mq { padding: 22px 0; }
    .hp-mq__list span { font-size: 34px; }
    .hp-mq__list b { font-size: 18px; }
  }

  @keyframes hp-mq {
    to { transform: translateX(-50%); }
  }

  /* ===== 3. SERVICES ===== */
  .hp-bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 640px) {
    .hp-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .hp-tile--ads,
    .hp-tile--cx,
    .hp-tile--social { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .hp-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
    .hp-tile--ads { grid-column: span 2; grid-row: span 2; }
    .hp-tile--cx { grid-column: span 2; }
    .hp-tile--sq { grid-column: span 1; }
    .hp-tile--social { grid-column: span 4; }
  }

  .hp-tile {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 22px;
    min-height: 260px;
    padding: 28px 26px;
    border-radius: 30px;
    color: var(--hp-ink);
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 350ms ease;
  }

  @media (min-width: 768px) {
    .hp-tile { padding: 34px 32px; min-height: 280px; }
  }

  /* Tuile-lien (href défini) : survol, focus et chevron */
  .hp-tile--link { cursor: pointer; }

  .hp-tile--link:hover {
    transform: translateY(-5px);
    box-shadow: 0 30px 60px var(--hp-shadow), inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 15%, transparent);
  }

  .hp-tile--link:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 3px;
  }

  .hp-tile__go {
    position: absolute;
    top: 28px;
    right: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px currentColor;
    transition: transform 250ms ease, background 250ms ease;
  }

  .hp-tile__go svg { width: 18px; height: 18px; }

  @media (min-width: 768px) {
    .hp-tile__go { top: 34px; right: 32px; }
  }

  .hp-tile--link:hover .hp-tile__go {
    transform: translateX(4px);
    background: color-mix(in srgb, var(--text-primary) 18%, transparent);
  }

  .hp-tile h3 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .hp-tile h3 { font-size: 27px; }
  }

  .hp-tile p {
    margin-top: 10px;
    max-width: 340px;
    font-size: 15px;
    line-height: 1.55;
  }

  .hp-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 58px;
    height: 58px;
    flex: none;
    border-radius: 18px;
    background: color-mix(in srgb, var(--text-primary) 18%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 35%, transparent);
    transition: transform 350ms ease;
  }

  .hp-ico svg { width: 28px; height: 28px; }

  .hp-tile--link:hover .hp-ico { transform: rotate(-6deg) scale(1.06); }

  .hp-ico--grad {
    background: var(--woop-gradient);
    box-shadow: 0 8px 24px rgba(230, 43, 127, 0.35);
  }

  .hp-tile--grad { background: var(--woop-gradient); }
  .hp-tile--grad p,
  .hp-tile--rose p { color: var(--hp-on-grad); }

  .hp-tile--blush {
    background: var(--hp-blush);
    color: var(--hp-dark);
  }

  .hp-tile--blush p { color: color-mix(in srgb, var(--woop-pink) 30%, var(--bg-deep)); }

  .hp-tile--blush .hp-ico {
    background: var(--hp-plum);
    color: var(--hp-blush);
    box-shadow: none;
  }

  /* Prune plus foncé (davantage de --bg-deep) pour se détacher du fond de la page */
  .hp-tile--plum { background: color-mix(in srgb, var(--woop-pink) 12%, var(--bg-deep)); }
  .hp-tile--plum p { color: var(--text-secondary); }

  .hp-tile--orange { background: var(--woop-orange); }
  .hp-tile--orange p { color: var(--hp-dark); }

  .hp-tile--rose {
    background: linear-gradient(150deg, color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary)), var(--woop-pink));
  }

  /* Téléphone : Conseil en expérience client et Image de marque côte à côte, en version compacte */
  @media (max-width: 599px) {
    .hp-bento {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 12px;
    }
    .hp-tile--ads,
    .hp-tile--orange,
    .hp-tile--social { grid-column: span 2; }
    .hp-tile--cx,
    .hp-tile--plum {
      min-height: 0;
      gap: 16px;
      padding: 18px 16px;
      border-radius: 24px;
    }
    .hp-tile--cx h3,
    .hp-tile--plum h3 {
      font-size: 17px;
      line-height: 1.15;
      letter-spacing: 0;
      hyphens: manual;
    }
    .hp-tile--cx p,
    .hp-tile--plum p {
      margin-top: 8px;
      font-size: 13.5px;
      line-height: 1.5;
    }
    .hp-tile--cx .hp-ico,
    .hp-tile--plum .hp-ico {
      width: 40px;
      height: 40px;
      border-radius: 13px;
    }
    .hp-tile--cx .hp-ico svg,
    .hp-tile--plum .hp-ico svg { width: 20px; height: 20px; }
  }

  /* Fausse annonce */
  .hp-ad {
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    max-width: 420px;
    padding: 18px;
    border-radius: 22px;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 24px 50px var(--hp-shadow);
    transform: rotate(-2deg);
    align-self: center;
  }

  .hp-ad__search {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    border-radius: 999px;
    border: 1.5px solid var(--hp-skel);
    color: var(--woop-pink);
  }

  .hp-ad__search svg { width: 18px; height: 18px; flex: none; }

  .hp-ad__search i {
    display: block;
    height: 8px;
    width: 62%;
    border-radius: 5px;
    background: var(--hp-skel);
  }

  .hp-ad__res {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 13px 14px;
    border-radius: 14px;
    background: var(--hp-skel-2);
  }

  .hp-ad__line {
    display: block;
    height: 7px;
    width: 82%;
    border-radius: 4px;
    background: var(--hp-skel);
  }

  .hp-ad__line--md { height: 9px; width: 52%; }

  .hp-ad__res--top {
    background: var(--woop-gradient);
    box-shadow: 0 12px 28px rgba(230, 43, 127, 0.35);
  }

  .hp-ad__res--top .hp-ad__line { background: color-mix(in srgb, var(--text-primary) 45%, transparent); }
  .hp-ad__res--top .hp-ad__line--lg { height: 11px; width: 58%; background: var(--hp-light); }
  .hp-ad__res--top .hp-stars { color: var(--hp-light); }

  .hp-ad__badge {
    display: block;
    width: 64px;
    height: 7px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--text-primary) 70%, transparent);
  }

  /* Publications réseaux sociaux */
  .hp-tile--social {
    justify-content: flex-start;
  }

  .hp-posts {
    display: flex;
    gap: 10px;
    justify-content: center;
    align-items: flex-end;
    padding-top: 10px;
  }

  @media (min-width: 1100px) {
    .hp-tile--social {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-rows: auto 1fr;
      column-gap: 32px;
      align-items: end;
      min-height: 300px;
    }
    .hp-tile--social .hp-ico { grid-column: 1; grid-row: 1; align-self: start; }
    .hp-tile--social .hp-tile__txt { grid-column: 1 / 3; grid-row: 2; max-width: 380px; }
    .hp-posts { grid-column: 3; grid-row: 1 / 3; gap: 16px; padding-top: 0; }
  }

  /* Téléphone : tuiles pleine largeur compactes. Icône et titre sur une ligne,
     puis le sous-texte sur toute la largeur, puis l'illustration éventuelle. */
  @media (max-width: 599px) {
    .hp-tile--ads,
    .hp-tile--orange,
    .hp-tile--social {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      grid-template-areas:
        'ico title'
        'text text'
        'ill ill';
      align-items: center;
      column-gap: 14px;
      row-gap: 0;
      min-height: 0;
    }
    .hp-tile--ads .hp-tile__txt,
    .hp-tile--orange .hp-tile__txt,
    .hp-tile--social .hp-tile__txt { display: contents; }
    .hp-tile--ads .hp-ico,
    .hp-tile--orange .hp-ico,
    .hp-tile--social .hp-ico {
      grid-area: ico;
      width: 48px;
      height: 48px;
      border-radius: 15px;
    }
    .hp-tile--ads .hp-ico svg,
    .hp-tile--orange .hp-ico svg,
    .hp-tile--social .hp-ico svg { width: 24px; height: 24px; }
    .hp-tile--ads h3,
    .hp-tile--orange h3,
    .hp-tile--social h3 {
      grid-area: title;
      font-size: 21px;
    }
    .hp-tile--ads p,
    .hp-tile--orange p,
    .hp-tile--social p {
      grid-area: text;
      max-width: none;
      margin-top: 14px;
    }
    /* Illustrations à 75 % (proportions, inclinaison et ombres conservées) :
       zoom réduit le rendu et la place occupée ; la largeur de 75 % redonne la mise
       en page d'origine ; l'espace au-dessus est compensé pour rester identique. */
    .hp-tile--ads .hp-ad {
      grid-area: ill;
      justify-self: center;
      width: 75%;
      zoom: 0.75;
      margin-top: 32px; /* 24 px une fois réduit */
    }
    .hp-tile--social .hp-posts {
      grid-area: ill;
      justify-self: center;
      width: 75%;
      zoom: 0.75;
      padding-top: 37.333px; /* 28 px une fois réduit */
    }
  }

  .hp-post {
    flex: 0 1 190px;
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    background: var(--hp-light);
    color: var(--woop-pink);
    box-shadow: 0 18px 40px var(--hp-shadow);
  }

  .hp-post--1 { transform: rotate(-4deg) translateY(6px); }
  .hp-post--2 { transform: translateY(-14px); }
  .hp-post--3 { transform: rotate(4deg) translateY(6px); }

  .hp-post__head {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 10px;
  }

  .hp-post__av {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--woop-gradient);
    box-shadow: 0 0 0 2px var(--hp-light), 0 0 0 3.5px var(--woop-pink);
  }

  .hp-post__lines,
  .hp-post__cap {
    display: flex;
    flex-direction: column;
    gap: 5px;
    flex: 1;
  }

  .hp-post__lines i,
  .hp-post__cap i {
    display: block;
    height: 6px;
    width: 70%;
    border-radius: 3px;
    background: var(--hp-skel);
  }

  .hp-post__lines i:last-child,
  .hp-post__cap i:last-child { width: 45%; background: var(--hp-skel-2); }

  .hp-post__img svg { display: block; width: 100%; height: auto; }

  .hp-post__foot {
    display: flex;
    gap: 8px;
    padding: 8px 10px 4px;
  }

  .hp-post__foot svg { width: 14px; height: 14px; }

  .hp-post__cap { padding: 2px 10px 12px; }

  @media (max-width: 639px) {
    .hp-post__head .hp-post__lines i:last-child,
    .hp-post__cap i:last-child { display: none; }
  }

  /* Bandeau « Vous avez besoin de tout ça ? » */
  .hp-inl {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 18px;
    margin-top: 26px;
    padding: 22px;
    border-radius: 26px;
    background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
    box-shadow: inset 0 0 0 1px var(--hp-line);
  }

  .hp-inl p {
    color: var(--text-secondary);
    font-size: 17px;
    line-height: 1.5;
  }

  .hp-inl strong { color: var(--text-primary); font-weight: 600; }

  @media (min-width: 980px) {
    .hp-inl {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 14px 14px 14px 30px;
      border-radius: 999px;
    }
  }

  /* ===== 4. MARQUE + PERFORMANCE ===== */
  .hp-spi {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    list-style: none;
    border-radius: 30px;
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
  }

  @media (min-width: 900px) {
    .hp-spi { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .hp-st {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 32px 28px;
    border-top: 1px solid var(--hp-line);
  }

  .hp-st:first-child { border-top: 0; }

  @media (min-width: 900px) {
    .hp-st {
      padding: 40px 36px;
      border-top: 0;
      border-left: 1px solid var(--hp-line);
    }
    .hp-st:first-child { border-left: 0; }
  }

  .hp-st__idx {
    font-family: var(--font-display);
    font-size: 34px;
    line-height: 1;
    color: var(--text-secondary);
  }

  .hp-st h3 {
    font-size: 26px;
    font-weight: 700;
    line-height: 1.15;
  }

  .hp-st p {
    color: var(--text-secondary);
    line-height: 1.55;
  }

  .hp-st--hot {
    background: var(--woop-gradient);
    border-color: transparent;
    border-radius: 30px;
    box-shadow: 0 20px 50px rgba(230, 43, 127, 0.28);
  }

  .hp-st--hot + .hp-st { border-color: transparent; }
  .hp-st--hot .hp-st__idx,
  .hp-st--hot p { color: var(--hp-on-grad); }

  /* Bandeau « Nouveau » : fond dégradé de la charte, texte et pastille foncés */
  .hp-teaser {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 22px;
    padding: 14px 14px 14px 22px;
    border-radius: 999px;
    background: var(--woop-gradient);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.4;
    color: var(--hp-on-grad);
    transition: transform 250ms ease, box-shadow 250ms ease;
  }

  .hp-teaser:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgba(230, 43, 127, 0.4);
  }

  .hp-teaser:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
  }

  .hp-teaser strong { color: var(--hp-on-grad); }

  .hp-teaser__dot {
    flex: none;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--hp-on-grad);
  }

  .hp-go {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-left: auto;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--hp-on-grad);
    transition: transform 250ms ease;
  }

  .hp-go svg { width: 18px; height: 18px; }

  .hp-teaser:hover .hp-go { transform: translateX(3px); }

  /* ===== 5. UNE ÉQUIPE, SANS EMBAUCHE ===== */
  .hp-cmp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    align-items: stretch;
  }

  @media (min-width: 980px) {
    .hp-cmp {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 22px;
    }
  }

  .hp-cx {
    display: flex;
    flex-direction: column;
    gap: 22px;
    padding: 28px 22px;
    border-radius: 32px;
  }

  @media (min-width: 768px) {
    .hp-cx { padding: 36px; }
  }

  .hp-cx--off {
    background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
  }

  .hp-cx--on {
    background: var(--woop-gradient);
    box-shadow: 0 30px 70px rgba(230, 43, 127, 0.3);
  }

  .hp-cx--on .hp-over { color: var(--hp-on-grad); }
  .hp-cx .cta { align-self: flex-start; }

  .hp-vs {
    align-self: center;
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 24px;
    color: var(--text-primary);
    background: var(--hp-card);
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
  }

  .hp-rts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    list-style: none;
  }

  @media (min-width: 480px) {
    .hp-rts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Colonnes côte à côte encore étroites : une tuile par ligne */
  @media (min-width: 980px) and (max-width: 1279px) {
    .hp-rts { grid-template-columns: minmax(0, 1fr); }
  }

  .hp-rt {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 74px;
    padding: 14px 40px 14px 14px;
    border-radius: 18px;
    border: 1.5px dashed color-mix(in srgb, var(--text-primary) 25%, transparent);
    color: var(--text-secondary);
  }

  .hp-rt b {
    font-size: 15px;
    line-height: 1.25;
    overflow-wrap: break-word;
  }

  .hp-rt em {
    position: absolute;
    right: 12px;
    top: 12px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    font-style: normal;
    font-size: 12px;
    font-weight: 700;
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
  }

  .hp-rt__ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
  }

  .hp-rt__ico svg { width: 22px; height: 22px; }

  .hp-rt--on {
    border: 1.5px solid transparent;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 12px 28px var(--hp-shadow);
  }

  .hp-rt--on .hp-rt__ico {
    background: var(--woop-gradient);
    color: var(--hp-ink);
  }

  .hp-rt--on em {
    background: var(--hp-blush);
    color: var(--woop-pink);
  }

  .hp-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    list-style: none;
  }

  .hp-chips li {
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
  }

  .hp-chips--off li {
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
    color: var(--text-secondary);
    text-decoration: line-through;
  }

  .hp-chips--on li {
    background: color-mix(in srgb, var(--text-primary) 20%, transparent);
    color: var(--hp-on-grad);
  }

  /* ===== 6. DEUX SECTEURS ===== */
  .hp-sect {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
  }

  @media (min-width: 980px) {
    .hp-sect { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  .hp-s {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: 30px;
    padding: 30px 24px;
    border-radius: 30px;
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp-s:hover { transform: translateY(-5px); }

  @media (min-width: 768px) {
    .hp-s { padding: 44px 40px; }
  }

  .hp-s--sante { background: var(--woop-gradient); }
  .hp-s--sante .hp-over { color: var(--hp-on-grad); }

  .hp-s--rh {
    background: var(--hp-card);
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
  }

  /* Surtitre et texte en haut de la carte, boutons ancrés en bas */
  .hp-s__body {
    order: -1;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .hp-s__acts { margin-top: auto; }

  .hp-s h3 {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.22;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .hp-s h3 { font-size: 28px; }
  }


  .hp-ill {
    position: relative;
    flex: none;
    align-self: flex-start;
  }

  /* Croix de santé (carte Santé & Médical) */
  .hp-ill--cross {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 124px;
    height: 124px;
    margin-left: 6px;
    border-radius: 32px;
    background: var(--woop-gradient);
    box-shadow:
      inset 0 0 0 1.5px color-mix(in srgb, var(--text-primary) 45%, transparent),
      0 20px 40px var(--hp-shadow);
    transform: rotate(4deg);
  }

  .hp-ill--cross svg {
    width: 64px;
    height: 64px;
    filter: drop-shadow(0 4px 10px rgba(230, 43, 127, 0.45));
  }

  /* Illustration CV (recrutement) */
  .hp-ill--cv {
    width: 210px;
    height: 160px;
    margin: 6px 0 8px 6px;
  }

  .hp-cv {
    position: absolute;
    inset: 0;
    border-radius: 18px;
  }

  .hp-cv--3 {
    background: rgba(230, 43, 127, 0.25);
    transform: rotate(10deg) translate(14px, 6px);
  }

  .hp-cv--2 {
    background: rgba(250, 98, 68, 0.35);
    transform: rotate(5deg) translate(7px, 3px);
  }

  .hp-cv--1 {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
    background: var(--hp-light);
    color: var(--hp-dark);
    box-shadow: 0 20px 40px var(--hp-shadow);
    transform: rotate(-3deg);
  }

  .hp-cv__head { display: flex; gap: 10px; align-items: center; }

  .hp-cv__pp {
    position: relative;
    overflow: hidden;
    flex: none;
    width: 38px;
    height: 38px;
    border-radius: 12px;
    background: var(--woop-gradient);
  }

  .hp-cv__pp::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 7px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--hp-light);
    transform: translateX(-50%);
  }

  .hp-cv__pp::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -8px;
    width: 26px;
    height: 18px;
    border-radius: 50%;
    background: var(--hp-light);
    transform: translateX(-50%);
  }

  .hp-cv__head div { flex: 1; display: flex; flex-direction: column; gap: 5px; }
  .hp-cv__head b { display: block; height: 8px; width: 80%; border-radius: 4px; background: var(--hp-plum); }
  .hp-cv__head i { display: block; height: 6px; width: 55%; border-radius: 4px; background: var(--hp-skel); }

  .hp-cv__tags { display: flex; gap: 5px; flex-wrap: wrap; }

  .hp-cv__tags span {
    padding: 4px 8px;
    border-radius: 999px;
    font-size: 9.5px;
    font-weight: 700;
    background: var(--hp-blush);
    color: var(--woop-pink);
  }

  .hp-cv__ln { display: block; width: 100%; height: 6px; border-radius: 3px; background: var(--hp-skel-2); }
  .hp-cv__ln--sh { width: 60%; }

  .hp-cv__stamp {
    position: absolute;
    right: -14px;
    bottom: -12px;
    padding: 8px 12px;
    border-radius: 12px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    transform: rotate(-8deg);
    box-shadow: 0 10px 24px rgba(230, 43, 127, 0.45);
  }

  @media (min-width: 1180px) {
    .hp-s {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-rows: 1fr auto;
      grid-template-areas:
        'body ill'
        'acts acts';
      gap: 34px 28px;
      min-height: 440px;
    }
    .hp-s__body { grid-area: body; align-self: start; }
    .hp-ill { grid-area: ill; align-self: start; margin-top: -6px; margin-right: 4px; }
    .hp-s__acts { grid-area: acts; align-self: end; margin-top: 0; }
  }

  /* ===== 7. LA PREUVE ===== */
  .hp-proof__inner {
    padding: 56px 0;
    border-top: 1px solid var(--hp-line);
    border-bottom: 1px solid var(--hp-line);
  }

  .hp-pgrid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 30px 20px;
    margin-top: var(--home-head-content);
    list-style: none;
  }

  @media (min-width: 980px) {
    .hp-pgrid { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; }
    .hp-pgrid li { padding: 0 30px; border-left: 1px solid var(--hp-line); }
    .hp-pgrid li:first-child { padding-left: 0; border-left: 0; }
  }

  .hp-pgrid strong {
    display: block;
    font-size: 48px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-primary);
  }

  .hp-pgrid strong small {
    font-size: 0.42em;
    letter-spacing: 0;
  }

  @media (min-width: 768px) {
    .hp-pgrid strong { font-size: 64px; }
  }

  .hp-gt {
    background: var(--woop-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hp-pgrid span {
    display: block;
    margin-top: 4px;
    color: var(--text-secondary);
    font-weight: 600;
    line-height: 1.4;
  }

  /* ===== 8. L'ÉQUIPE ===== */
  .hp-team {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    list-style: none;
  }

  @media (min-width: 640px) {
    .hp-team { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .hp-m {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 30px 20px 28px;
    border-radius: 30px;
    background: color-mix(in srgb, var(--bg-elevated) 75%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
    text-align: center;
    transition: transform 350ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .hp-m:hover { transform: translateY(-5px); }

  .hp-m__ph,
  .hp-avs > span {
    position: relative;
    overflow: hidden;
    flex: none;
    border-radius: 50%;
    background: var(--woop-gradient);
  }

  .hp-m__ph {
    width: 168px;
    height: 168px;
    margin-bottom: 14px;
    box-shadow: 0 0 0 4px var(--bg-elevated), 0 0 0 6px rgba(230, 43, 127, 0.55), 0 24px 50px rgba(230, 43, 127, 0.22);
  }

  @media (min-width: 1024px) {
    .hp-m__ph { width: 200px; height: 200px; }
  }

  .hp-m__ph img,
  .hp-avs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 0;
    transform: scale(1.55);
    transform-origin: var(--fx, 50%) var(--fy, 30%);
  }

  /* Cadrage propre à une photo (objectPosition / zoom dans les données de l'équipe) */
  .hp-m__ph.is-framed img,
  .hp-avs .is-framed img {
    object-position: var(--obj-pos, center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--obj-pos, center);
  }

  /* Nom et rôle : groupés seulement sur téléphone (sans effet sur la mise en page ailleurs) */
  .hp-m__txt { display: contents; }

  @media (max-width: 599px) {
    .hp-team { gap: 12px; }
    .hp-m {
      flex-direction: row;
      align-items: center;
      gap: 16px;
      padding: 14px 18px;
      border-radius: 22px;
      text-align: left;
    }
    .hp-m__ph {
      width: 72px;
      height: 72px;
      margin-bottom: 0;
      box-shadow: 0 0 0 3px var(--bg-elevated), 0 0 0 4.5px rgba(230, 43, 127, 0.55), 0 10px 24px rgba(230, 43, 127, 0.18);
    }
    .hp-m__txt {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }
  }

  .hp-m__name {
    font-size: 22px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .hp-m__role {
    font-size: 14px;
    line-height: 1.45;
    color: var(--text-secondary);
  }

  @media (max-width: 599px) {
    .hp-m__name { font-size: 18px; }
    .hp-m__role { font-size: 13.5px; }
  }

  /* ===== 9. BANDEAU INTERMÉDIAIRE ===== */
  .hp-band {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 22px;
    align-items: center;
    padding: 34px 24px;
    border-radius: 36px;
    background: var(--hp-grad-band);
  }

  @media (min-width: 1100px) {
    .hp-band {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 30px;
      padding: 44px 48px;
    }
  }

  .hp-band h2 {
    font-size: 28px;
    font-weight: 700;
    line-height: 1.12;
    color: var(--text-primary);
    text-wrap: balance;
  }

  @media (min-width: 768px) {
    .hp-band h2 { font-size: 34px; }
  }

  .hp-band p {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.5;
    color: var(--hp-on-grad);
  }

  .hp-avs {
    display: flex;
  }

  .hp-avs > span {
    width: 62px;
    height: 62px;
