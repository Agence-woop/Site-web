---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import BentoCard from '../components/BentoCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const testimonials: { paragraphs: string[]; name: string; role?: string }[] = [
  {
    paragraphs: [
      "« Kévin a su comprendre dès le début les subtilités de ma vision marketing.",
      "Son audace, son agilité et sa passion pour l'image de marque m'ont convaincu dès les premiers instants.",
      "Je recommande les services de l'Agence WOOP. »",
    ],
    name: 'David Caron',
    role: 'PDG, Expoze Recrutement',
  },
  {
    paragraphs: [
      "« Kevin et l'agence marketing WOOP ont su capter l'essence de mon projet et la traduire en un visuel à la fois clair et impactant.",
      "Son approche méticuleuse et sa recherche approfondie permettent d'obtenir un résultat à la hauteur des attentes. »",
    ],
    name: 'Marie-Josée Bélanger',
    role: 'PDG, ZoneRH',
  },
  {
    paragraphs: [
      "« Nous travaillons avec WOOP depuis décembre 2025. Dès le début de la relation d'affaires, j'ai senti que je travaillais avec des professionnels compétents et très attentifs aux détails.",
      "Ça m'a plu immédiatement et surtout, je me suis senti en confiance. Leur démarche est très structurée et professionnelle. Ils ont rapidement mis en place les bases d'une campagne efficace de reconnaissance de notre marque sur LinkedIn.",
      "Nous allons passer à la prochaine étape avec eux : convertir en opportunités d'affaires. »",
    ],
    name: 'Luc Lacroix',
    role: 'PDG, Santé au travail Konsil Inc.',
  },
  {
    paragraphs: [
      "« C'est un réel plaisir de collaborer avec WOOP depuis plusieurs mois déjà. Leur équipe nous accompagne au quotidien avec professionnalisme, créativité et réactivité.",
      "Leur compréhension de nos besoins, la pertinence de leurs conseils et la qualité de leur travail contribuent directement à l'atteinte de nos objectifs.",
      "L'équipe est toujours disponible, à l'écoute et proactive dans la recherche de solutions adaptées à nos besoins, tout en tenant compte de nos contraintes et de notre réalité. Nous apprécions particulièrement leur approche humaine, leur transparence ainsi que leur capacité à livrer des résultats concrets, et ce, toujours dans les délais convenus.",
      "WOOP est un partenaire de confiance que nous recommandons sans hésitation à toute entreprise à la recherche d'une agence marketing compétente, engagée et axée sur les résultats. »",
    ],
    name: 'AlliancePharma',
  },
  {
    paragraphs: [
      "« Notre expérience avec Agence WOOP est tout simplement sublime. Nous utilisons leur service depuis maintenant 1 an et que dire du service personnalisé, de la qualité du travail et de la collaboration qui se fait dans une parfaite harmonie, et ce depuis le tout début.",
      "5 étoiles pour leur service est le moins qu'on puisse donner !",
      "Quelle belle expérience que de travailler avec eux au quotidien. Je réfère cette agence à tous ceux qui souhaitent augmenter leur notoriété, leur visibilité ou gérer leurs médias sociaux. »",
    ],
    name: 'Clémence Rachiele',
    role: 'Fondatrice, PurRH',
  },
  {
    paragraphs: [
      "« Une agence exceptionnelle ! Un merci tout particulier à Kevin pour son écoute et sa grande capacité d'analyse.",
      "Il a su comprendre notre secteur d'activité en un temps record et traduire notre vision en publications LinkedIn percutantes et professionnelles.",
      "Je recommande à 100 % ! »",
    ],
    name: 'André Garceau',
    role: 'Santé au travail Konsil Inc.',
  },
  {
    paragraphs: [
      "« Service exceptionnel ! Une équipe à l'écoute, efficace et attentive à nos besoins.",
      "L'approche est personnalisée et les résultats sont concrets.",
      "Je recommande fortement leurs services à toute entreprise qui souhaite faire évoluer son marketing. »",
    ],
    name: 'Geneviève Decelles',
    role: 'Directrice des opérations, EXPOZE Recrutement',
  },
];
---
<Layout
  title="WOOP — Agence marketing santé & recrutement | Montréal"
  description="L'agence d'acquisition et d'identité de marque dédiée à la santé, au bien-être et au recrutement spécialisé au Québec."
  ogImage="/images/og-image.jpg"
>

  <!-- ===== SECTION 1 — HERO ===== -->
  <section class="hero section">
    <div class="container">
      <div class="hero__watermark" aria-hidden="true">WOOP</div>
      <span class="hero__eyebrow">Agence marketing &middot; Montr&eacute;al</span>
      <h1 class="hero__title">
        Une agence pens&eacute;e par un <span class="gradient-accent">CLINICIEN</span>, con&ccedil;ue par un <span class="gradient-accent">CR&Eacute;ATIF</span>, activ&eacute;e par une <span class="gradient-accent">EXPERTE</span> en acquisition.
      </h1>
      <p class="hero__subtitle">
        L'agence d&eacute;di&eacute;e &agrave; la sant&eacute;, au bien-&ecirc;tre et aux cabinets de recrutement sp&eacute;cialis&eacute;s au Qu&eacute;bec. Nous b&acirc;tissons des marques qui attirent et des campagnes qui convertissent.
      </p>
      <div class="hero__ctas">
        <Button variant="primary" href={`${base}/contact`}>R&eacute;server un appel d&eacute;couverte</Button>
        <Button variant="secondary" href="#approche">Voir nos services</Button>
      </div>
    </div>
  </section>

  <!-- ===== SECTION 2 — NOTRE APPROCHE (BENTO) ===== -->
  <section class="section" id="approche">
    <div class="container">
      <span class="kicker">01 — Notre approche</span>
      <h2 class="section-title">Marque + Performance</h2>
      <div class="bento-grid bento-grid--approche">
        <BentoCard variant="pink" size="large" class="bento--dominant">
          <div>
            <span class="bento__label">Conviction n&deg;1</span>
            <div class="bento__title-xl">Marque forte<br>= Acquisition rentable.</div>
          </div>
          <p class="bento__text">Une marque solide fait baisser le co&ucirc;t d'acquisition. Pas d'image de marque sans performance, pas de performance sans image de marque.</p>
        </BentoCard>
        <BentoCard variant="outline" class="bento--ads">
          <span class="bento__label">Acquisition</span>
          <div class="bento__title">Publicit&eacute; en ligne</div>
          <p class="bento__text">Google Ads & Meta Ads. Campagnes cibl&eacute;es pour g&eacute;n&eacute;rer des demandes qualifi&eacute;es.</p>
        </BentoCard>
        <BentoCard variant="orange" class="bento--branding">
          <span class="bento__label">Identit&eacute;</span>
          <div class="bento__title bento__title--bento-lg">Image de marque</div>
          <p class="bento__text">Logo, charte visuelle, syst&egrave;me de marque complet.</p>
        </BentoCard>
        <div class="bento-photo bento-photo--medical">
          <img src={`${base}/images/clinique-medicale.webp`} alt="Clinique m&eacute;dicale" loading="lazy" width="1000" height="667" />
        </div>
        <BentoCard variant="gradient" class="bento--flywheel">
          <span class="bento__label">M&eacute;thode</span>
          <div class="bento__title bento__title--bento-lg">La spirale WOOP</div>
          <p class="bento__text">Image de marque &rarr; Performance &rarr; Optimisation. La spirale qui fait grandir votre clinique ou votre cabinet.</p>
        </BentoCard>
        <div class="bento-photo bento-photo--dentaire">
          <img src={`${base}/images/clinique-dentaire.webp`} alt="Clinique dentaire" loading="lazy" width="800" height="1200" />
        </div>
        <BentoCard variant="outline" class="bento--landing">
          <span class="bento__label">Conversion</span>
          <div class="bento__title">Site & page de conversion</div>
          <p class="bento__text">Sites et pages de conversion con&ccedil;us pour transformer le trafic en RDV qualifi&eacute;s.</p>
        </BentoCard>
        <div class="bento-photo bento-photo--rh">
          <img src={`${base}/images/recrutement-rh.webp`} alt="Recrutement RH" loading="lazy" width="1000" height="667" />
        </div>
      </div>
      <div class="approche-cta">
        <Button variant="primary" href={`${base}/contact`}>R&eacute;server un appel d&eacute;couverte</Button>
      </div>
    </div>
  </section>

  <!-- ===== SECTION 3 — SEGMENTATION PERSONAS ===== -->
  <section class="section">
    <div class="container">
      <span class="kicker">02 — Pour qui ?</span>
      <h2 class="section-title">Deux secteurs. Deux expertises.</h2>
      <div class="personas">
        <div class="persona-card">
          <div class="persona-card__image">
            <img src={`${base}/images/persona-sante.webp`} alt="Professionnels de la sant&eacute;" loading="lazy" />
          </div>
          <div class="persona-card__content">
            <h3 class="persona-card__title">Vous dirigez une <span class="gradient-text">clinique sant&eacute; ou m&eacute;dicale</span></h3>
            <p class="persona-card__desc">Pharmaciens propri&eacute;taires &middot; Directeurs de clinique &middot; Cabinets dentaires &middot; Cliniques m&eacute;dico-esth&eacute;tiques &middot; Centres de bien-&ecirc;tre</p>
            <div class="persona-card__actions">
              <Button variant="primary" href={`${base}/services-medical`}>D&eacute;couvrir nos services sant&eacute;</Button>
              <Button variant="secondary" href={`${base}/contact?personne=gauthier`}>Parler &agrave; Gauthier</Button>
            </div>
          </div>
        </div>
        <div class="persona-card">
          <div class="persona-card__image">
            <img src={`${base}/images/persona-recrutement.webp`} alt="Professionnels du recrutement" loading="lazy" />
          </div>
          <div class="persona-card__content">
            <h3 class="persona-card__title">Vous dirigez un <span class="gradient-text">cabinet de recrutement</span></h3>
            <p class="persona-card__desc">Cabinets de recrutement sp&eacute;cialis&eacute;s &middot; Firmes de recrutement &middot; Consultants RH ind&eacute;pendants &middot; DRH d'entreprise</p>
            <div class="persona-card__actions">
              <Button variant="primary" href={`${base}/services-recrutement`}>D&eacute;couvrir nos services recrutement</Button>
              <Button variant="secondary" href={`${base}/contact?personne=kevin`}>Parler &agrave; Kevin</Button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SECTION 4 — PREUVE & ÉQUIPE ===== -->
  <section class="section">
    <div class="container">
      <span class="kicker">03 — La preuve</span>

      <div class="proof">
        <div class="proof__stat">
          <div class="proof__stat-inner">
            <span class="proof__number">16</span>
            <span class="proof__unit">ans</span>
          </div>
          <span class="proof__cumul">d'exp&eacute;rience cumul&eacute;e</span>
        </div>
        <div class="proof__detail">
          <p class="proof__breakdown">
            <strong>8 ans</strong> en milieu clinique &middot; <strong>4 ans</strong> en marketing &middot; <strong>4 ans</strong> en marketing publicitaire
          </p>
          <p class="proof__text">
            Gauthier est infirmier clinicien et ancien directeur de clinique priv&eacute;e. Toute l'&eacute;quipe est internalis&eacute;e&nbsp;: vous parlez directement aux fondateurs.
          </p>
        </div>
      </div>

      <div class="team-strip">
        <div class="team-strip__header">
          <h3 class="team-strip__title">L'&eacute;quipe WOOP</h3>
          <p class="team-strip__text">Des experts du terrain. Vous savez qui fait quoi sur votre projet.</p>
          <Button variant="tertiary" href={`${base}/equipe`}>Rencontrer l'&eacute;quipe</Button>
        </div>
        <div class="team-strip__cards">
          <div class="team-card">
            <div class="team-card__photo-wrap">
              <img src={`${base}/images/gauthier.webp`} alt="Gauthier Figueres" class="team-card__photo" loading="lazy" width="800" height="822" />
            </div>
            <div class="team-card__info">
              <span class="team-card__name">Gauthier</span>
              <span class="team-card__role">Co-fondateur &middot; Strat&eacute;gie</span>
            </div>
          </div>
          <div class="team-card">
            <div class="team-card__photo-wrap">
              <img src={`${base}/images/kevin.webp`} alt="Kevin" class="team-card__photo" loading="lazy" width="800" height="822" />
            </div>
            <div class="team-card__info">
              <span class="team-card__name">Kevin</span>
              <span class="team-card__role">Co-fondateur &middot; Cr&eacute;ation</span>
            </div>
          </div>
          <div class="team-card">
            <div class="team-card__photo-wrap">
              <img src={`${base}/images/emma.webp`} alt="Emma" class="team-card__photo" loading="lazy" width="800" height="822" />
            </div>
            <div class="team-card__info">
              <span class="team-card__name">Emma</span>
              <span class="team-card__role">Paid media</span>
            </div>
          </div>
        </div>
      </div>

      <h3 class="testimonials__heading">Ce qu'en disent nos clients</h3>
      <div
        class="testimonials-carousel"
        role="region"
        aria-label="Avis de nos clients"
        data-testimonials-carousel
      >
        <button
          type="button"
          class="testimonials-carousel__nav testimonials-carousel__nav--prev"
          aria-label="Avis précédent"
          data-testimonials-prev
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6" />
          </svg>
        </button>
        <div class="testimonials-carousel__viewport">
          <ul class="testimonials-carousel__track" data-testimonials-track>
            {testimonials.map((t, i) => (
              <li class:list={['testimonial-card', i % 2 === 0 ? 'testimonial-card--outline' : 'testimonial-card--gradient']}>
                <div class="testimonial-card__body">
                  <div class="testimonial-card__paragraphs" data-testimonial-paragraphs>
                    {t.paragraphs.map((p) => (
                      <p class="testimonial-card__paragraph">{p}</p>
                    ))}
                  </div>
                  <button
                    type="button"
                    class="testimonial-card__toggle"
                    aria-expanded="false"
                    data-testimonial-toggle
                    hidden
                  >Voir plus</button>
                </div>
                <div class="testimonial-card__author">
                  <strong class="testimonial-card__name">{t.name}</strong>
                  {t.role && <span class="testimonial-card__role">{t.role}</span>}
                </div>
              </li>
            ))}
          </ul>
        </div>
        <button
          type="button"
          class="testimonials-carousel__nav testimonials-carousel__nav--next"
          aria-label="Avis suivant"
          data-testimonials-next
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6" />
          </svg>
        </button>
      </div>
    </div>
  </section>

  <!-- ===== SECTION 5 — CTA FINAL ===== -->
  <section class="section cta-final-section">
    <div class="container">
      <div class="cta-final">
        <h2 class="cta-final__title">Parlons de votre projet.</h2>
        <Button variant="primary" href={`${base}/contact`}>R&eacute;server un appel d&eacute;couverte</Button>
      </div>
    </div>
  </section>

</Layout>

<style>
  /* ===== HERO ===== */
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 120px;
    padding-bottom: 80px;
    overflow: hidden;
  }

  .hero__watermark {
    position: absolute;
    font-family: var(--font-display);
    font-size: 42vw;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.12);
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    pointer-events: none;
    white-space: nowrap;
    z-index: -1;
    letter-spacing: -0.02em;
  }

  .hero__eyebrow {
    display: inline-block;
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--woop-pink);
    background: rgba(230, 43, 127, 0.1);
    border: 1px solid var(--border-accent);
    border-radius: 100px;
    padding: 8px 18px;
    font-weight: 700;
    margin-bottom: 32px;
  }

  .hero__title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.15;
    color: var(--text-primary);
    max-width: 900px;
    margin-bottom: 24px;
  }

  @media (min-width: 768px) {
    .hero__title { font-size: 42px; }
  }

  @media (min-width: 1024px) {
    .hero__title { font-size: 56px; line-height: 1.08; }
  }

  .hero__subtitle {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 40px;
  }

  @media (min-width: 768px) {
    .hero__subtitle { font-size: 18px; }
  }

  @media (min-width: 1024px) {
    .hero__subtitle { font-size: 20px; }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* ===== BENTO GRID — APPROCHE ===== */
  .bento-grid--approche {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-bento);
    margin-top: 40px;
  }

  @media (min-width: 600px) {
    .bento-grid--approche {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .bento-grid--approche {
      grid-template-columns: repeat(4, 1fr);
      grid-template-rows: repeat(4, minmax(0, 1fr));
      min-height: 880px;
    }

    .bento-grid--approche > :global(.bento--dominant) {
      grid-column: 1 / 3;
      grid-row: 1 / 3;
    }
    .bento-grid--approche > :global(.bento--ads) {
      grid-column: 3 / 4;
      grid-row: 1 / 2;
    }
    .bento-grid--approche > :global(.bento--branding) {
      grid-column: 4 / 5;
      grid-row: 1 / 2;
    }
    .bento-photo--medical {
      grid-column: 3 / 5;
      grid-row: 2 / 3;
    }
    .bento-grid--approche > :global(.bento--flywheel) {
      grid-column: 1 / 2;
      grid-row: 3 / 5;
    }
    .bento-photo--dentaire {
      grid-column: 2 / 3;
      grid-row: 3 / 5;
    }
    .bento-grid--approche > :global(.bento--landing) {
      grid-column: 3 / 5;
      grid-row: 3 / 4;
    }
    .bento-photo--rh {
      grid-column: 3 / 5;
      grid-row: 4 / 5;
    }
  }

  .bento__title--bento-lg {
    font-size: 34px !important;
  }

  @media (min-width: 768px) {
    .bento__title--bento-lg {
      font-size: 42px !important;
    }
  }

  .bento-photo {
    border-radius: var(--radius-bento);
    overflow: hidden;
    min-height: 180px;
    position: relative;
  }

  .bento-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    position: absolute;
    inset: 0;
  }

  .bento-photo--dentaire {
    aspect-ratio: 2 / 3;
  }

  @media (min-width: 900px) {
    .bento-photo--dentaire {
      aspect-ratio: auto;
    }
  }

  .approche-cta {
    margin-top: 40px;
    text-align: center;
  }

  /* ===== PERSONAS ===== */
  .personas {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-bento);
    margin-top: 40px;
  }

  @media (min-width: 768px) {
    .personas {
      grid-template-columns: 1fr 1fr;
    }
  }

  .persona-card {
    display: flex;
    flex-direction: column;
    background: transparent;
    border: 1px solid var(--border-accent);
    border-radius: var(--radius-bento);
    overflow: hidden;
    text-decoration: none;
    transition: transform 300ms ease, border-color 300ms ease;
    position: relative;
    min-height: 420px;
  }

  @media (min-width: 768px) {
    .persona-card { min-height: 500px; }
  }

  .persona-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--woop-gradient);
    z-index: 1;
  }

  .persona-card:hover {
    transform: translateY(-4px);
    border-color: var(--woop-pink);
  }

  .persona-card__image {
    height: 200px;
    overflow: hidden;
    position: relative;
  }

  @media (min-width: 768px) {
    .persona-card__image { height: 240px; }
  }

  @media (min-width: 1024px) {
    .persona-card__image { height: 320px; }
  }

  .persona-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  .persona-card__image::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 60px;
    background: linear-gradient(to top, var(--bg-deep), transparent);
  }

  .persona-card__content {
    padding: 24px 28px 28px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .persona-card__title {
    font-family: var(--font-display);
    font-size: 24px;
    text-transform: uppercase;
    line-height: 1.05;
    margin-bottom: 14px;
  }

  @media (min-width: 768px) {
    .persona-card__title { font-size: 28px; }
  }

  .persona-card__desc {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-secondary);
    flex: 1;
    margin-bottom: 24px;
  }

  @media (min-width: 1024px) {
    .persona-card__desc { font-size: 16px; }
  }

  .persona-card__actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }

  @media (prefers-reduced-motion: reduce) {
    .persona-card { transition: none; }
    .persona-card:hover { transform: none; }
  }

  /* ===== PREUVE ===== */
  .proof {
    display: flex;
    flex-direction: column;
    gap: 24px;
    margin-top: 32px;
    margin-bottom: 48px;
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .proof {
      flex-direction: row;
      align-items: center;
      gap: 48px;
    }
  }

  .proof__stat {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
  }

  .proof__stat-inner {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .proof__number {
    font-family: var(--font-display);
    font-size: 100px;
    line-height: 0.85;
    text-transform: uppercase;
    background: var(--woop-gradient);
