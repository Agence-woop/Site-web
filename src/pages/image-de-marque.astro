<script>
  // 02 · Partout où l'on vous rencontre : alternance « Sans système » / « Avec WOOP ».
  // - Un état toutes les 5 s (les 4 cartes, la pastille du haut et la phrase), sans bouton pause.
  // - Démarre seulement quand le bloc est à l'écran, s'arrête dès qu'il n'y est plus.
  // - Pause au survol de la section (souris) et au focus clavier dans la section ; le temps
  //   restant est conservé et la rotation reprend ensuite.
  // - Pastille cliquable : un clic affiche l'état choisi, le minuteur repart de zéro et la
  //   rotation continue (même logique que les onglets du carrousel de la page Équipe).
  // - prefers-reduced-motion : aucune alternance, « Avec WOOP » affiché (la pastille reste
  //   cliquable). Sans JavaScript : « Avec WOOP ».
  // - La phrase est dans une zone aria-live="polite" : son texte est remplacé à chaque état.
  (function () {
    const zone = document.querySelector<HTMLElement>('[data-im-zone]');
    const sw = document.querySelector<HTMLElement>('[data-im-sw]');
    const cap = sw?.querySelector<HTMLElement>('[data-im-cap]');
    const capBox = cap?.parentElement;
    if (!zone || !sw || !cap || !capBox) return;
    const btns = Array.from(sw.querySelectorAll<HTMLButtonElement>('[data-im-mode]'));
    const DUR = 5000;
    const FADE = 220;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    type Mode = 'on' | 'off';
    let mode: Mode = 'on';
    let fadeTimer = 0;

    const set = (m: Mode) => {
      mode = m;
      sw.classList.toggle('is-on', m === 'on');
      sw.classList.toggle('is-off', m === 'off');
      sw.dataset.imState = m;
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.imMode === m)));
      const next = (m === 'on' ? capBox.dataset.capOn : capBox.dataset.capOff) || '';
      window.clearTimeout(fadeTimer);
      if (reduced) { cap.textContent = next; return; }
      // Fondu court de la phrase : disparition, nouveau texte, réapparition
      capBox.classList.add('is-fading');
      fadeTimer = window.setTimeout(() => { cap.textContent = next; capBox.classList.remove('is-fading'); }, FADE);
    };

    btns.forEach((b) => b.addEventListener('click', () => {
      set(b.dataset.imMode === 'off' ? 'off' : 'on');
      restart();
    }));

    // Mouvement réduit : « Avec WOOP », sans alternance automatique
    if (reduced) return;

    // Minuteur pausable : temps restant conservé pendant les pauses
    const reasons = { offscreen: true, hover: false, focus: false, hidden: document.hidden };
    let remaining = DUR;
    let startedAt = 0;
    let timer = 0;
    const running = () => !Object.values(reasons).some(Boolean);

    const stopClock = () => {
      if (!timer) return;
      window.clearTimeout(timer);
      timer = 0;
      remaining = Math.max(0, remaining - (performance.now() - startedAt));
    };
    const tick = () => {
      timer = 0;
      remaining = DUR;
      set(mode === 'on' ? 'off' : 'on');
      update();
    };
    const update = () => {
      sw.classList.toggle('is-paused', !running());
      if (running() && !timer) {
        startedAt = performance.now();
        timer = window.setTimeout(tick, remaining);
      } else if (!running()) {
        stopClock();
      }
    };
    function restart() {
      if (reduced) return;
      window.clearTimeout(timer);
      timer = 0;
      remaining = DUR;
      update();
    }

    // Avant le premier passage à l'écran : « Sans système », puis « Avec WOOP » 5 s plus tard
    set('off');
    cap.textContent = capBox.dataset.capOff || '';
    capBox.classList.remove('is-fading');
    window.clearTimeout(fadeTimer);

    // Survol de la section (souris seulement : un toucher ne met pas en pause)
    zone.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') { reasons.hover = true; update(); } });
    zone.addEventListener('pointerleave', () => { reasons.hover = false; update(); });

    // Focus clavier dans la section (pas le focus posé par un clic)
    const keyboardFocus = (el: Element) => {
      try { return el.matches(':focus-visible'); } catch { return true; }
    };
    zone.addEventListener('focusin', (e) => {
      reasons.focus = e.target instanceof Element && keyboardFocus(e.target);
      update();
    });
    zone.addEventListener('focusout', (e) => {
      if (e.relatedTarget instanceof Node && zone.contains(e.relatedTarget)) return;
      reasons.focus = false;
      update();
    });

    // À l'écran seulement
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          reasons.offscreen = !entry.isIntersecting;
          update();
        });
      }, { threshold: 0.35 }).observe(sw);
    } else {
      reasons.offscreen = false;
    }

    document.addEventListener('visibilitychange', () => { reasons.hidden = document.hidden; update(); });
    update();
  })();
</script>

