---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SectionHead from '../components/SectionHead.astro';
import VisibilityTeaser from '../components/VisibilityTeaser.astro';
import FinalBand from '../components/FinalBand.astro';
import StickyBar from '../components/StickyBar.astro';
import CtaIcon from '../components/CtaIcon.astro';
import ServiceHero from '../components/services/ServiceHero.astro';
import AudienceCard from '../components/services/AudienceCard.astro';
import ServiceTile from '../components/services/ServiceTile.astro';
import SpecialistCard from '../components/services/SpecialistCard.astro';
import Faq from '../components/services/Faq.astro';
import FurtherReading from '../components/services/FurtherReading.astro';
import ServiceCycle from '../components/services/ServiceCycle.astro';
import { team } from '../data/team';
import { service } from '../data/services';
import { NB } from '../utils/typo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/image-de-marque/`;

// Vos questions (accordéon et données structurées FAQPage) : 3 questions par colonne
const faq = [
  {
    q: `Vous partez de zéro, ou de ma marque actuelle${NB}?`,
    a: "Les deux sont possibles. On commence par regarder ce que votre marque dit aujourd'hui, et on garde ce qui fonctionne.",
  },
  {
    q: `Qu'est-ce que je reçois à la fin${NB}?`,
    a: 'Votre positionnement, votre identité visuelle, votre ton de marque, un système de design et les déclinaisons dont vous avez besoin, avec des fichiers prêts à utiliser.',
  },
  {
    q: `Est-ce que la marque m'appartient${NB}?`,
    a: "Oui. Votre marque vous appartient, et vous l'utilisez comme vous le souhaitez. On vous remet des fichiers prêts à utiliser, en PNG, JPG ou PDF selon les livrables. Les fichiers sources vectoriels, utiles pour faire évoluer la marque vous-même ou avec un autre fournisseur, sont offerts en option.",
  },
  {
    q: `Combien de temps ça prend${NB}?`,
    a: "Comptez de 4 à 8 semaines, selon l'ampleur des livrables et la réflexion de départ sur votre future identité.",
  },
  {
    q: `Qui s'occupe de ma marque${NB}?`,
    a: "Kevin, designer graphique de formation et cofondateur de WOOP. Il pilote l'identité de marque de chaque projet.",
  },
  {
    q: `Ça marche aussi pour un cabinet de recrutement${NB}?`,
    a: "Oui. Une marque claire aide autant à décrocher des mandats qu'à attirer les meilleurs candidats.",
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Image de marque pour cliniques et cabinets',
    serviceType: 'Image de marque pour cliniques et cabinets',
    // Renvoie à la fiche de l'organisation publiée sur l'accueil
    provider: { '@id': `${SITE_URL}/#organization`, name: 'Agence WOOP' },
    areaServed: 'Québec',
    url: PAGE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Image de marque', item: PAGE_URL },
    ],
  },
];

// Icônes au trait (même style que le reste du site). Palette : l'icône de l'image de marque
// (src/data/services.ts), reprise ici pour la tuile « Identité visuelle ».
const ICONS = {
  target: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>',
  lines: '<path d="M4 6h16M4 12h10M4 18h13"/>',
  grid: '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  pen: '<path d="M4 20l4-1 10-10-3-3L5 16z"/><path d="M14 7l3 3"/>',
  // Clinique : bâtiment, croix médicale (blanche dans sa pastille, jamais rouge) et porte
  clinic: '<path d="M5 21V7a1 1 0 011-1h12a1 1 0 011 1v14"/><path d="M3 21h18"/><path d="M10.5 8.5h3v2h2v3h-2v2h-3v-2h-2v-3h2z"/><path d="M10 21v-3.5h4V21"/>',
  case: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
} as const;
type IconKey = keyof typeof ICONS;
const icon = (k: IconKey) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[k]}</svg>`;
const palette = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${service('marque').icon}</svg>`;

// 01 · Pour qui ?
const profiles: { key: 'old' | 'value' | 'mixed'; title: string; lived: string; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'old',
    title: 'Votre logo date, et il ne vous ressemble plus.',
    lived: 'Votre clinique ou votre cabinet a grandi. Votre image est restée là où vous avez commencé.',
    reveal: 'left',
  },
  {
    key: 'value',
    title: 'Vos services valent plus que ce que votre image laisse croire.',
    lived: 'Une image négligée ne reflète pas la qualité de votre travail.',
    reveal: 'up',
    step: '1',
  },
  {
    key: 'mixed',
    title: "Chaque support semble venir d'une organisation différente.",
    lived: `Le site, la fiche Google, les affiches${NB}: rien ne se répond.`,
    reveal: 'right',
    step: '2',
  },
];

// 02 · Partout où l'on vous rencontre : les 4 supports, et la phrase de chaque état
const touchpoints: { key: 'google' | 'site' | 'desk' | 'mail'; title: string; sub: string }[] = [
  { key: 'google', title: 'La fiche Google', sub: 'Le premier regard' },
  { key: 'site', title: 'Le site', sub: "Là où l'on vous choisit" },
  { key: 'desk', title: "L'accueil", sub: "À l'arrivée" },
  { key: 'mail', title: 'Le courriel', sub: 'Après le rendez-vous' },
];
const captions = {
  off: `Quatre supports, quatre styles${NB}: personne ne fait le lien.`,
  on: `La même marque à chaque étape${NB}: on vous reconnaît, et on se souvient de vous.`,
};

// 03 · Les livrables (grille : 1 colonne sur téléphone, 2 sur tablette, 4 sur ordinateur)
const deliverables: { key: 'id' | 'pos' | 'tone' | 'ds' | 'decl'; shape: 'sq' | 'wide'; ic?: IconKey; title: string; text: string; accent?: boolean; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'id',
    shape: 'sq',
    accent: true,
    title: 'Identité visuelle',
    text: `Logo, couleurs, typographie, iconographie${NB}: une identité qu'on reconnaît du premier coup d'œil.`,
    reveal: 'left',
  },
  { key: 'pos', shape: 'sq', ic: 'target', title: 'Positionnement', text: "Ce que vous êtes, pour qui, et pourquoi vous plutôt qu'un autre. La base de tout le reste.", reveal: 'right', step: '1' },
  { key: 'tone', shape: 'sq', ic: 'lines', title: 'Ton de marque', text: 'Votre façon de parler, partout.', reveal: 'up', step: '1' },
  { key: 'ds', shape: 'sq', ic: 'grid', title: 'Système de design', text: 'Des règles simples, pour que tout reste cohérent.', reveal: 'up', step: '2' },
  {
    key: 'decl',
    shape: 'wide',
    ic: 'pen',
    title: 'Les déclinaisons',
    text: `Votre marque appliquée là où elle vit${NB}: site, réseaux sociaux, documents, cartes, signalétique de votre clinique ou de votre cabinet.`,
    reveal: 'up',
  },
];

// Les 5 déclinaisons (mini maquettes de la tuile, avec leur nom en petit dessous)
const variants: { key: 'web' | 'post' | 'doc' | 'card' | 'sign'; name: string }[] = [
  { key: 'web', name: 'Page de site' },
  { key: 'post', name: 'Publication Instagram' },
  { key: 'doc', name: 'Document à en-tête' },
  { key: 'card', name: 'Carte de visite' },
  { key: 'sign', name: "Panneau d'accueil" },
];
---
<Layout
  title="Image de marque pour cliniques et cabinets | WOOP"
  description="Positionnement, identité visuelle et système de design pour cliniques et cabinets de recrutement. Une marque reconnue, appliquée partout."
  ogImage="/images/og-image.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé. -->
  <ScrollReveal />

  <!-- 1. HERO (sans data-reveal) -->
  <ServiceHero
    layout="split"
    pill="Image de marque"
    sub={`Pour les cliniques et les cabinets de recrutement${NB}: positionnement, identité visuelle, ton et système de design complet. On construit votre marque, puis on l'applique partout où l'on vous rencontre, de Google à votre accueil.`}
    strong="Une image à la hauteur de vos services."
    primary={{ href: `${base}/contact/`, label: 'Réserver un appel découverte' }}
    secondary={{ href: `${base}/acquisition-client/`, label: 'Testez votre visibilité' }}
  >
    <Fragment slot="title">Image de marque{NB}: votre marque commence avant votre logo, <span class="gradient-accent hp-kw">au premier regard, au premier appel.</span></Fragment>

    <Fragment slot="visual">
    <Fragment set:html={"<!-- Illustration : le livre de marque et ses déclinaisons (immobile) -->"} />
    <div class="im-hv" aria-hidden="true">
      <div class="im-hv__glow"></div>

      <!-- Couleurs de la marque -->
      <div class="im-hv__sw">
        <span class="im-dot im-dot--o"></span><span class="im-dot im-dot--p"></span><span class="im-dot im-dot--pl"></span><span class="im-dot im-dot--b"></span>
        <small>Couleurs</small>
      </div>

      <!-- Typographie -->
      <div class="im-hv__ty"><b>Aa</b><div><small>Typographie</small><i></i><i class="s"></i></div></div>

      <!-- Cartes de visite (verso blanc, recto en dégradé) -->
      <div class="im-hv__back"><span class="im-vc im-vc--sm"><b>VM</b></span><b>Votre nom</b><small>Physiothérapeute</small><i></i><i class="s"></i></div>
      <div class="im-hv__front"><span class="im-vc im-vc--w"><b>VM</b></span><b>Votre marque</b><small>Santé &amp; mouvement</small></div>

      <!-- Livre de marque -->
      <div class="im-hv__book">
        <div class="im-bk__h"><small>Livre de marque</small><small>p. 04</small></div>
        <div class="im-bk__main"><span class="im-bk__cs"></span><span class="im-vc im-vc--xl"><b>VM</b></span><b>Votre marque</b></div>
        <small class="im-bk__l">Déclinaisons</small>
        <div class="im-bk__var">
          <span class="v1"><span class="im-vc im-vc--xs im-vc--w"><b>VM</b></span></span>
          <span class="v2"><span class="im-vc im-vc--xs"><b>VM</b></span></span>
          <span class="v3"><span class="im-vc im-vc--xs im-vc--dk"><b>VM</b></span></span>
        </div>
      </div>

      <!-- Signalétique de l'accueil -->
      <div class="im-hv__sign"><span class="im-vc im-vc--sm"><b>VM</b></span><div><b>Votre marque</b><small>Accueil, 1er étage</small></div></div>
    </div>
    </Fragment>
  </ServiceHero>

  <!-- 2. 01 · POUR QUI ? -->
  <section class="hp-block hp-sec" id="pour-qui" data-reveal-clip>
    <div class="container">
      <SectionHead over={`01 · Pour qui${NB}?`}>Vous vous <span class="gradient-accent">reconnaissez</span>{NB}?</SectionHead>

      <div class="im-prs">
        {profiles.map((p) => (
          <AudienceCard kind={p.key} title={p.title} lived={p.lived} reveal={p.reveal} step={p.step}>
            {p.key === 'old' && (
              <div class="im-a1">
                <span class="im-a1__old">Logo<br />2014</span>
                <span class="im-a1__go"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4" /></svg></span>
                <span class="im-vc im-vc--lg"><b>VM</b></span>
              </div>
            )}
            {p.key === 'value' && (
              <div class="im-a2">
                <div class="im-a2__col"><span class="im-a2__bar"></span><small>Votre image</small></div>
                <div class="im-a2__col im-a2__col--hi"><span class="im-a2__bar im-a2__bar--hi"></span><small>Vos services</small></div>
              </div>
            )}
            {p.key === 'mixed' && (
              <div class="im-a3"><span class="g1"></span><span class="g2"></span><span class="g3"></span></div>
            )}
          </AudienceCard>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 02 · PARTOUT OÙ L'ON VOUS RENCONTRE : « Sans système » et « Avec WOOP » en alternance
       (toutes les 5 s, seulement à l'écran ; pause au survol et au focus clavier de la section ;
       mouvement réduit ou sans JavaScript : « Avec WOOP », sans alternance) -->
  <section class="hp-block hp-sec" id="partout" data-reveal-clip data-im-zone>
    <div class="container">
      <SectionHead over="02 · Partout où l'on vous rencontre" intro="Ce que votre marque dit avant vous.">Une seule marque, <span class="gradient-accent">partout</span>.</SectionHead>

      <div class="im-sw is-on" data-im-sw data-reveal="up">
        <div class="im-tg" role="group" aria-label="Comparer les supports">
          <button type="button" class="im-tg__btn" data-im-mode="off" aria-pressed="false">Sans système</button>
          <button type="button" class="im-tg__btn" data-im-mode="on" aria-pressed="true">Avec WOOP</button>
          <span class="im-tg__knob" aria-hidden="true"></span>
        </div>

        <ul class="im-grid">
          {touchpoints.map((t) => (
            <li class="im-tile">
              <div class="im-mw" aria-hidden="true">
                <div class:list={['im-mk', `im-mk--${t.key}`]}>
                  {t.key === 'google' && (
                    <>
                      <small class="im-mk__k">Fiche Google</small>
                      <div class="im-mk__row"><span class="im-mk__lg"><b>VM</b></span><b class="im-mk__nm">Votre marque</b></div>
                      <i class="im-mk__ln"></i>
                      <div class="im-mk__ph"><i></i><i></i><i></i></div>
                    </>
                  )}
                  {t.key === 'site' && (
                    <>
                      <div class="im-mk__bar"><i></i><i></i><i></i></div>
                      <b class="im-mk__nm">Votre marque</b>
                      <i class="im-mk__ln"></i>
                      <span class="im-mk__cta">Réserver</span>
                    </>
                  )}
                  {t.key === 'desk' && (
                    <>
                      <span class="im-mk__lg"><b>VM</b></span>
                      <b class="im-mk__nm">Votre marque</b>
                      <small>Accueil, 1er étage</small>
                    </>
                  )}
                  {t.key === 'mail' && (
                    <>
                      <div class="im-mk__row"><span class="im-mk__lg"><b>VM</b></span><b class="im-mk__nm">Votre marque</b></div>
                      <small>Rendez-vous confirmé</small>
                      <span class="im-mk__cta">Ajouter au calendrier</span>
                    </>
                  )}
                </div>
              </div>
              <b class="im-tile__t">{t.title}</b>
              <small class="im-tile__s">{t.sub}</small>
            </li>
          ))}
        </ul>

        <div class="im-cap-box">
          <span class="im-cap__size" aria-hidden="true">{captions.off}</span>
          <span class="im-cap__size" aria-hidden="true">{captions.on}</span>
          <p class="im-cap" aria-live="polite" data-cap-off={captions.off} data-cap-on={captions.on}><span data-im-cap>{captions.on}</span></p>
        </div>
      </div>

      <div class="md-svc-cta" data-reveal="up">
        <a class="cta" href={`${base}/contact/`}>Faire le point sur votre marque<CtaIcon /></a>
      </div>
    </div>
  </section>

  <!-- 4. 03 · LES LIVRABLES -->
  <section class="hp-block hp-sec" id="livrables" data-reveal-clip>
    <div class="container">
      <SectionHead over="03 · Les livrables" intro={`Pas seulement un logo${NB}: un système complet, pensé par un designer.`}>Ce que vous <span class="gradient-accent">recevez</span>.</SectionHead>

      <div class="im-bento">
        {deliverables.map((t) => (
          <ServiceTile kind={t.key} shape={t.shape} title={t.title} text={t.text} accent={t.accent} reveal={t.reveal} step={t.step}>
            <Fragment slot="icon"><Fragment set:html={t.ic ? icon(t.ic) : palette} /></Fragment>
            <Fragment slot="illustration">
              <div class:list={['md-mui', `im-mui--${t.key}`]} aria-hidden="true">
                {t.key === 'id' && (
                  <>
                    <div class="im-id__lg"><span class="im-vc im-vc--md"><b>VM</b></span><b>Votre marque</b></div>
                    <div class="im-id__row"><span class="o"></span><span class="p"></span><span class="pl"></span><span class="b"></span><span class="w"></span></div>
                    <div class="im-id__ty"><b>Aa</b><div><i></i><i class="s"></i></div></div>
                  </>
                )}
                {t.key === 'pos' && (
                  <ol class="im-pos">
                    <li><span>Pour qui</span></li>
                    <li><span>Ce qui vous distingue</span></li>
                    <li class="is-on"><span>Votre promesse</span></li>
                  </ol>
                )}
                {t.key === 'tone' && (
                  <div class="im-tone">
                    <span class="im-tone__no">«{NB}Nous offrons des services de qualité{NB}»</span>
                    <span class="im-tone__yes">«{NB}On vous rappelle dans l'heure{NB}»</span>
                  </div>
                )}
                {t.key === 'ds' && (
                  <div class="im-ds"><i></i><i class="g"></i><i></i><i class="g"></i></div>
                )}
                {t.key === 'decl' && (
                  <div class="im-dc">
                    {variants.map((v) => (
                      <div class:list={['im-dc__it', `im-dc__it--${v.key}`]}>
                        <div class="im-dc__stage">
                          {v.key === 'web' && (
                            <div class="im-dc__mk im-dc__web">
                              <div class="im-dc__web-bar"><i></i><i></i><i></i></div>
                              <div class="im-dc__web-hero"><span class="im-vc im-vc--xs im-vc--w"><b>VM</b></span><i></i><span class="im-dc__pill"></span></div>
                              <div class="im-dc__web-row"><i></i><i></i></div>
                            </div>
                          )}
                          {v.key === 'post' && (
                            <div class="im-dc__mk im-dc__post">
                              <div class="im-dc__post-top"><span class="im-dc__av"></span><i></i></div>
                              <div class="im-dc__post-img"><span class="im-vc im-vc--xs im-vc--w"><b>VM</b></span></div>
                              <div class="im-dc__post-foot"><svg viewBox="0 0 24 24"><path d="M12 20.5s-7.5-4.6-7.5-10.1A4.3 4.3 0 0112 7.6a4.3 4.3 0 017.5 2.8c0 5.5-7.5 10.1-7.5 10.1z" /></svg><i></i></div>
                            </div>
                          )}
                          {v.key === 'doc' && (
                            <div class="im-dc__mk im-dc__doc">
                              <div class="im-dc__doc-h"><span class="im-vc im-vc--xs"><b>VM</b></span><i></i></div>
                              <i></i><i></i><i class="s"></i><i></i><i class="s"></i>
                            </div>
                          )}
                          {v.key === 'card' && (
                            <div class="im-dc__mk im-dc__card">
                              <span class="im-vc im-vc--xs im-vc--w"><b>VM</b></span>
                              <div><b>Votre nom</b><i></i></div>
                            </div>
                          )}
                          {v.key === 'sign' && (
                            <div class="im-dc__mk im-dc__sign">
                              <span class="im-vc im-vc--xs"><b>VM</b></span>
                              <small>Accueil · 1er étage</small>
                            </div>
                          )}
                        </div>
                        <small class="im-dc__name" set:html={v.name.replace('en-tête', '<span class="im-nw">en-tête</span>')} />
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </Fragment>
          </ServiceTile>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. BANDEAU « À LA HAUTEUR DE VOS SERVICES » (sans numéro) -->
  <section class="hp-block hp-sec" id="qualite">
    <div class="container">
      <div class="im-band" data-reveal="up">
        <div class="im-band__head">
          <p class="im-band__over">À la hauteur de vos services</p>
          <h2>Une image soignée justifie vos tarifs.</h2>
        </div>
        <div class="im-band__txt">
          <p>Vos patients, vos clients et vos candidats jugent la qualité de votre travail avant même de vous rencontrer. Une marque cohérente et soignée leur dit que chaque détail compte.</p>
          <a class="cta im-band__cta" href={`${base}/contact/`}>Réserver un appel découverte<CtaIcon /></a>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. 04 · L'ÉCOSYSTÈME (cycle des 5 services, l'image de marque au centre), puis le Test de visibilité -->
  <section class="hp-block hp-sec" id="ecosysteme" data-reveal-clip>
    <div class="container">
      <ServiceCycle current="marque" over="04 · L'écosystème" />

      <div class="im-teaser">
        <VisibilityTeaser />
      </div>
    </div>
  </section>

  <!-- 7. 05 · POURQUOI WOOP -->
  <section class="hp-block hp-sec" id="pourquoi" data-reveal-clip>
    <div class="container">
      <SectionHead over="05 · Pourquoi WOOP">Pensée par un <span class="gradient-accent">designer</span>.</SectionHead>

      <SpecialistCard member={team.kevin} badge="Marketing pensé selon les règles de votre ordre professionnel">
        <p class="md-spc__lead">Kevin est designer graphique de formation. Il pilote l'identité de marque de chaque projet WOOP, du logo jusqu'à la dernière déclinaison.</p>
        <p>Son passage dans le marketing d'un cabinet de recrutement en santé lui a appris une chose{NB}: une belle marque ne suffit pas, elle doit servir à attirer.</p>
        <Fragment slot="badge-icon"><Fragment set:html={icon('shield')} /></Fragment>
      </SpecialistCard>
    </div>
  </section>

  <!-- 8. 06 · SANTÉ OU RECRUTEMENT -->
