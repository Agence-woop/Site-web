    display: grid;
    grid-template-columns: 1fr 1fr;
    padding: 6px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
    box-shadow: inset 0 0 0 1px var(--hp-line);
  }

  .im-tg__btn {
    position: relative;
    z-index: 1;
    padding: 12px 24px;
    border: 0;
    border-radius: 999px;
    background: none;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 800;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--text-secondary);
    cursor: pointer;
    transition: color 450ms ease;
  }

  .im-tg__btn[aria-pressed='true'] { color: var(--text-primary); }

  .im-sw.is-on .im-tg__btn[aria-pressed='true'] { color: var(--hp-on-grad); }

  .im-tg__btn:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 2px;
  }

  .im-tg__knob {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 50%;
    right: 6px;
    border-radius: 999px;
    background: var(--woop-gradient);
    transition: left 450ms cubic-bezier(0.2, 0.8, 0.2, 1), right 450ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 450ms ease;
  }

  /* État « Sans système » : curseur gris, à gauche (le fond dégradé s'efface) */
  .im-tg__knob::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--im-g3);
    opacity: 0;
    transition: opacity 450ms ease;
  }

  .im-sw.is-off .im-tg__knob { left: 6px; right: 50%; }
  .im-sw.is-off .im-tg__knob::before { opacity: 1; }

  /* Les 4 supports */
  .im-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 18px;
    width: 100%;
  }

  @media (min-width: 600px) {
    .im-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .im-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 20px;
    }
  }

  .im-tile {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .im-tile__t {
    margin-top: 12px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .im-tile__s {
    font-size: 14px;
    line-height: 1.4;
    color: var(--text-secondary);
  }

  .im-mw {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 220px;
    padding: 22px;
    border-radius: 24px;
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--woop-pink) 8%, color-mix(in srgb, var(--bg-elevated) 80%, transparent)),
      color-mix(in srgb, var(--bg-elevated) 75%, transparent)
    );
    box-shadow: inset 0 0 0 1px var(--hp-line);
  }

  /* Maquette d'un support : même contenu dans les 2 états, seul le style change */
  .im-mk {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 7px;
    width: 100%;
    max-width: 240px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--hp-light);
    color: var(--bg-deep);
    font-family: var(--font-body);
    transition:
      background-color 600ms cubic-bezier(0.2, 0.8, 0.2, 1),
      border-radius 600ms cubic-bezier(0.2, 0.8, 0.2, 1),
      box-shadow 600ms ease,
      transform 600ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .im-mk small {
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-muted);
    transition: color 600ms ease;
  }

  .im-mk__k { text-transform: uppercase; letter-spacing: 0.06em; }

  .im-mk__row {
    display: flex;
    align-items: center;
    gap: 9px;
  }

  .im-mk__nm {
    font-size: 15px;
    line-height: 1.15;
    transition: color 600ms ease;
  }

  .im-mk__lg {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--text-primary);
    transition: background-color 600ms ease, border-radius 600ms ease, color 600ms ease;
  }

  .im-mk__lg b {
    font-family: var(--font-display);
    font-size: 10px;
    font-weight: 400;
    line-height: 1;
  }

  .im-mk--desk .im-mk__lg { width: 38px; height: 38px; }
  .im-mk--desk .im-mk__lg b { font-size: 13px; }

  .im-mk__ln {
    display: block;
    width: 70%;
    height: 6px;
    border-radius: 3px;
    background: var(--hp-skel-2);
  }

  .im-mk__ph {
    display: flex;
    gap: 4px;
    align-self: stretch;
  }

  .im-mk__ph i {
    flex: 1;
    height: 26px;
    border-radius: 6px;
    background: linear-gradient(135deg, var(--hp-blush), var(--hp-pinklight));
    transition: background-color 600ms ease, border-radius 600ms ease;
  }

  .im-mk__bar {
    display: flex;
    gap: 3px;
  }

  .im-mk__bar i {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--hp-skel);
  }

  .im-mk__cta {
    margin-top: 2px;
    padding: 6px 11px;
    border-radius: 999px;
    background: var(--woop-gradient);
    font-size: 10.5px;
    font-weight: 800;
    line-height: 1.2;
    color: var(--hp-on-grad);
    transition: background-color 600ms ease, border-radius 600ms ease, color 600ms ease;
  }

  /* Avec WOOP : la même marque « Votre marque » à nos couleurs, sur les 4 supports */
  .im-sw.is-on .im-mk {
    box-shadow: 0 0 0 2px rgba(230, 43, 127, 0.25), 0 14px 30px rgba(230, 43, 127, 0.18);
  }

  .im-sw.is-on .im-mk__nm {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 400;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .im-sw.is-on .im-mk--desk { align-items: center; text-align: center; }

  /* Sans système : uniquement des gris ; formes et typographies qui ne se répondent pas
     (empattements, machine à écrire, capitales serrées, coins carrés puis arrondis) */
  .im-sw.is-off .im-mk { box-shadow: none; }
  .im-sw.is-off .im-mk small { color: var(--im-g2); }
  .im-sw.is-off .im-mk__ln,
  .im-sw.is-off .im-mk__bar i { background: var(--im-g1); }

  .im-sw.is-off .im-mk__lg b { color: transparent; }

  .im-sw.is-off .im-mk--google { border-radius: 2px; transform: rotate(-1.5deg); }
  .im-sw.is-off .im-mk--google .im-mk__nm { font-family: Georgia, 'Times New Roman', serif; font-weight: 700; color: var(--im-g3); }
  .im-sw.is-off .im-mk--google .im-mk__lg { border-radius: 2px; background: var(--im-g2); }
  .im-sw.is-off .im-mk--google .im-mk__ph i { border-radius: 0; background: var(--im-g1); }

  .im-sw.is-off .im-mk--site { border-radius: 22px; background: var(--im-g1); transform: rotate(1.5deg); }
  .im-sw.is-off .im-mk--site .im-mk__nm { font-family: 'Courier New', Courier, monospace; font-weight: 700; color: var(--im-g3); }
  .im-sw.is-off .im-mk--site .im-mk__ln,
  .im-sw.is-off .im-mk--site .im-mk__bar i { background: var(--im-g2); }
  .im-sw.is-off .im-mk--site .im-mk__cta { border-radius: 2px; background: var(--im-g3); color: var(--im-g1); }

  .im-sw.is-off .im-mk--desk { border-radius: 4px; background: var(--im-g3); transform: rotate(-1.5deg); }
  .im-sw.is-off .im-mk--desk .im-mk__nm { font-family: Impact, 'Arial Narrow', 'Arial Black', sans-serif; font-weight: 400; letter-spacing: 0.04em; text-transform: uppercase; color: var(--im-g1); }
  .im-sw.is-off .im-mk--desk .im-mk__lg { border-radius: 8px; background: var(--im-g2); }
  .im-sw.is-off .im-mk--desk small { color: var(--im-g1); }

  .im-sw.is-off .im-mk--mail { border-radius: 0; transform: rotate(1.5deg); }
  .im-sw.is-off .im-mk--mail .im-mk__nm { font-family: Arial, Helvetica, sans-serif; font-weight: 400; font-style: italic; color: var(--im-g2); }
  .im-sw.is-off .im-mk--mail .im-mk__lg { border-radius: 50%; background: var(--im-g1); }
  .im-sw.is-off .im-mk--mail .im-mk__cta { border-radius: 0; background: var(--im-g2); color: var(--text-primary); }

  /* Phrase sous les cartes : change avec l'état (fondu court). Les 2 phrases, invisibles, sont
     empilées dans la même case de grille que la phrase affichée : la zone prend la hauteur de la
     plus longue, et rien ne saute au changement d'état. Une seule ligne sur ordinateur (dès
     1024 px), 2 lignes au plus sur tablette et cellulaire. */
  .im-cap-box {
    display: grid;
    width: 100%;
    max-width: 640px;
  }

  .im-cap-box > * { grid-area: 1 / 1; }

  .im-cap,
  .im-cap__size {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.5;
    text-align: center;
    text-wrap: balance;
  }

  .im-cap__size { visibility: hidden; }

  .im-cap {
    color: var(--text-secondary);
    transition: opacity 220ms ease;
  }

  /* Petits cellulaires : un peu plus petite, pour tenir en 2 lignes */
  @media (max-width: 419px) {
    .im-cap,
    .im-cap__size { font-size: 15px; }
  }

  @media (min-width: 1024px) {
    .im-cap-box { max-width: none; }

    .im-cap,
    .im-cap__size { white-space: nowrap; }
  }

  .im-cap.is-fading { opacity: 0; }

  .im-sw.is-on .im-cap span {
    background: var(--woop-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  @media (max-width: 599px) {
    .im-tg__btn { padding: 10px 16px; }
    .im-mw { height: 200px; }
  }

  /* ===== 4. LES LIVRABLES ===== */
  .im-bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 600px) {
    .im-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .md-sv--id,
    .md-sv--pos,
    .md-sv--decl { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .im-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
    .md-sv--id { grid-column: 1 / span 2; grid-row: 1 / span 2; }
    .md-sv--pos { grid-column: 3 / span 2; grid-row: 1; }
    .md-sv--tone { grid-column: 3; grid-row: 2; }
    .md-sv--ds { grid-column: 4; grid-row: 2; }
    .md-sv--decl { grid-column: 1 / span 4; grid-row: 3; }
  }

  /* Mini-illustrations des tuiles : boîte commune, puis dessin propre à chaque tuile */
  .md-mui {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  /* Identité visuelle (sur le dégradé, fiche blanche) */
  .im-mui--id {
    gap: 14px;
    padding: 18px;
    border-radius: 20px;
    background: var(--hp-light);
    color: var(--bg-deep);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--bg-deep) 25%, transparent);
  }

  @media (min-width: 1100px) {
    .md-sv--id .im-mui--id {
      flex: 1;
      justify-content: space-around;
    }
  }

  .im-id__lg {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .im-id__lg > b {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .im-id__row {
    display: flex;
    gap: 8px;
  }

  .im-id__row span {
    flex: 1;
    height: 44px;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px var(--hp-skel-2);
  }

  .im-id__row .o { background: var(--woop-orange); }
  .im-id__row .p { background: var(--woop-pink); }
  .im-id__row .pl { background: var(--hp-plum); }
  .im-id__row .b { background: var(--hp-blush); }
  .im-id__row .w { background: var(--hp-light); }

  .im-id__ty {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .im-id__ty > b {
    font-family: var(--font-display);
    font-size: 38px;
    font-weight: 400;
    line-height: 1;
    background: var(--woop-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .im-id__ty div {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 7px;
  }

  .im-id__ty i {
    display: block;
    width: 80%;
    height: 7px;
    border-radius: 4px;
    background: var(--hp-skel-2);
  }

  .im-id__ty i.s { width: 55%; }

  /* Positionnement : trois étapes reliées, la promesse en dégradé. Dès 600 px, les étiquettes se
     répartissent sur toute la largeur du cadre et les traits s'allongent d'autant (à parts égales).
     Cellulaire : les 3 étiquettes l'une sous l'autre, reliées par de courts traits verticaux. */
  .im-pos {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    list-style: none;
  }

  .im-pos li {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .im-pos li + li::before {
    content: '';
    display: block;
    flex: none;
    width: 2px;
    height: 12px;
    margin: 4px 0 4px 18px;
    background: linear-gradient(180deg, var(--woop-orange), var(--woop-pink));
  }

  @media (min-width: 600px) {
    .im-pos {
      flex-direction: row;
      align-items: center;
    }

    .im-pos li { flex-direction: row; align-items: center; }

    .im-pos li + li { flex: 1 1 auto; }

    .im-pos li + li::before {
      flex: 1 1 18px;
      width: auto;
      min-width: 18px;
      height: 2px;
      margin: 0 6px;
      background: var(--woop-gradient);
    }
  }

  .im-pos span {
    padding: 8px 12px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--text-primary);
  }

  .im-pos .is-on span {
    background: var(--woop-gradient);
    color: var(--text-primary);
  }

  /* Ton de marque : la formule creuse barrée, la formule WOOP en dégradé */
  .im-tone {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .im-tone span {
    padding: 8px 10px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
  }

  .im-tone__no {
    background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    color: var(--text-muted);
    text-decoration: line-through;
  }

  .im-tone__yes {
    background: var(--woop-gradient);
    color: var(--text-primary);
  }

  /* Système de design : grille de 4 blocs */
  .im-ds {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .im-ds i {
    display: block;
    height: 28px;
    border-radius: 8px;
    background: color-mix(in srgb, var(--text-primary) 10%, transparent);
  }

  .im-ds i.g { background: var(--woop-gradient); }

  /* Les déclinaisons : 5 mini maquettes à nos couleurs, alignées, avec leur nom dessous.
     À droite du texte dès 600 px (tuile large), dessous sur téléphone. */
  .md-sv--decl .md-mui.im-mui--decl {
    height: auto;
    padding: 18px 14px 14px;
  }

  /* Téléphone : 3 maquettes, puis 2 centrées dessous */
  .im-dc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 16px 10px;
  }

  .im-dc__it { width: calc((100% - 20px) / 3); }

  @media (min-width: 600px) {
    .im-dc {
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 10px;
    }

    .im-dc__it { width: auto; }
  }

  .im-dc__it {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .im-dc__stage {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 96px;
  }

  .im-dc__name :global(.im-nw) { white-space: nowrap; }

  .im-dc__name {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    color: var(--text-secondary);
  }

  .im-dc__mk {
    display: flex;
    flex-direction: column;
    gap: 5px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--hp-light);
    box-shadow: 0 10px 22px var(--hp-shadow);
  }

  .im-dc__mk i {
    display: block;
    height: 4px;
    border-radius: 2px;
    background: var(--hp-skel-2);
  }

  .im-dc__mk i.s { width: 60%; }

  /* Page de site */
  .im-dc__web {
    width: 100%;
    max-width: 104px;
    height: 84px;
    padding: 0 0 7px;
  }

  .im-dc__web-bar {
    display: flex;
    gap: 3px;
    padding: 5px 6px;
    background: var(--hp-skel-2);
  }

  .im-dc__web-bar i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--hp-skel);
  }

  .im-dc__web-hero {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 5px;
    margin: 0 6px;
    padding: 7px;
    border-radius: 6px;
    background: var(--woop-gradient);
  }

  .im-dc__web-hero i {
    width: 70%;
    background: color-mix(in srgb, var(--text-primary) 70%, transparent);
  }

  .im-dc__pill {
    width: 28px;
    height: 7px;
    border-radius: 4px;
    background: var(--hp-light);
  }

  .im-dc__web-row {
    display: flex;
    gap: 5px;
    margin: 0 6px;
  }

  .im-dc__web-row i { flex: 1; }

  /* Publication Instagram */
  .im-dc__post {
    width: 74px;
    height: 96px;
    padding: 6px;
  }

  .im-dc__post-top {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .im-dc__post-top i { flex: 1; }

  .im-dc__av {
    flex: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--woop-gradient);
  }

  .im-dc__post-img {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
    background: linear-gradient(150deg, var(--woop-pink), var(--hp-plum));
  }

  .im-dc__post-foot {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .im-dc__post-foot svg {
    flex: none;
    width: 10px;
    height: 10px;
    fill: var(--woop-pink);
  }

  .im-dc__post-foot i { flex: 1; }

  /* Document à en-tête */
  .im-dc__doc {
    width: 66px;
    height: 92px;
    padding: 0 7px 7px;
    border-radius: 4px;
  }

  .im-dc__doc-h {
    display: flex;
    align-items: center;
    gap: 5px;
    margin: 0 -7px 3px;
    padding: 5px 7px;
    border-bottom: 2px solid var(--woop-pink);
  }

  .im-dc__doc-h .im-vc { width: 16px; height: 16px; }
  .im-dc__doc-h .im-vc b { font-size: 6px; }
  .im-dc__doc-h i { flex: 1; background: var(--hp-blush); }

  /* Carte de visite */
  .im-dc__card {
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-between;
    width: 100%;
    max-width: 100px;
    height: 60px;
    padding: 8px;
    background: var(--woop-gradient);
  }

  .im-dc__card .im-vc { align-self: flex-start; }

  .im-dc__card div {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }

  .im-dc__card div b {
    font-size: 8px;
    line-height: 1;
    white-space: nowrap;
    color: var(--text-primary);
  }

  .im-dc__card i {
    width: 30px;
    background: color-mix(in srgb, var(--text-primary) 60%, transparent);
  }

  /* Panneau de l'accueil */
  .im-dc__sign {
    align-items: center;
    justify-content: center;
    gap: 6px;
    width: 100%;
    max-width: 100px;
    height: 70px;
    padding: 8px;
    background: var(--hp-plum);
    text-align: center;
  }

  .im-dc__sign small {
    font-size: 8.5px;
