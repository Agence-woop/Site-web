    23.5% { transform: translate(calc(var(--wb-x1, 0px) - 6px), calc(var(--wb-y1, 0px) - 3px)) scale(0.85); }
    25%, 28.3% { transform: translate(calc(var(--wb-x1, 0px) - 6px), calc(var(--wb-y1, 0px) - 3px)); }
    43.3% { transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)); }
    45% { transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)) scale(0.85); }
    46.7%, 88% { transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)); }
