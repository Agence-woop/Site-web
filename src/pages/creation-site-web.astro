<script>
  // Illustrations animées ([data-wb-anim]) : curseur du hero et de la section 02, roue de
  // chargement (01), jauge de vitesse (04).
  // - L'animation (CSS) ne tourne que si l'illustration est visible à l'écran (25 % au moins), que
  //   son bloc est apparu (ScrollReveal) et que l'onglet est affiché : classe is-playing. Sinon
  //   elle est en pause, là où elle en était.
  // - Sans JavaScript ou avec prefers-reduced-motion : pas de classe is-anim, donc aucune
  //   animation ; chaque illustration affiche son état final (créneau choisi, « Demande envoyée »,
  //   curseur sur le bouton, roue immobile, jauge au maximum).
  // - Curseurs ([data-wb-cursor]) : les points visés (créneau [data-wb-t1], bouton [data-wb-t2])
  //   sont mesurés dans l'illustration et passés au CSS (--wb-x1, --wb-y1, --wb-x2, --wb-y2), à
  //   chaque changement de taille. Le curseur n'est affiché qu'une fois placé (is-placed).
  (function () {
    const items = Array.from(document.querySelectorAll<HTMLElement>('[data-wb-anim]'));
    if (!items.length) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Position d'un élément dans l'illustration (sans les transformations : glissement d'apparition,
    // agrandissement au survol, bouton enfoncé)
    const offset = (el: HTMLElement, box: HTMLElement) => {
      let x = 0;
      let y = 0;
      for (let n: HTMLElement | null = el; n && n !== box; n = n.offsetParent as HTMLElement | null) {
        x += n.offsetLeft;
        y += n.offsetTop;
      }
      return { x, y };
    };

    const place = (box: HTMLElement) => {
      // Point de départ du curseur : en haut à droite de l'illustration
      box.style.setProperty('--wb-x0', `${Math.round(box.offsetWidth * 0.84)}px`);
      ['1', '2'].forEach((k) => {
        const t = box.querySelector<HTMLElement>(`[data-wb-t${k}]`);
        if (!t) return;
        const o = offset(t, box);
        box.style.setProperty(`--wb-x${k}`, `${Math.round(o.x + t.offsetWidth * 0.55)}px`);
        box.style.setProperty(`--wb-y${k}`, `${Math.round(o.y + t.offsetHeight * 0.6)}px`);
      });
      box.classList.add('is-placed');
    };

    items.filter((el) => el.hasAttribute('data-wb-cursor')).forEach((box) => {
      place(box);
      if ('ResizeObserver' in window) new ResizeObserver(() => place(box)).observe(box);
      else window.addEventListener('resize', () => place(box));
    });

    if (reduced || !('IntersectionObserver' in window)) return;

    items.forEach((el) => {
      const revealBox = el.closest<HTMLElement>('[data-reveal]');
      const unrevealed = () => document.documentElement.classList.contains('reveal-js') && !!revealBox && !revealBox.classList.contains('is-revealed');
      const state = { visible: false, unrevealed: unrevealed(), hidden: document.hidden };
      const update = () => el.classList.toggle('is-playing', state.visible && !state.unrevealed && !state.hidden);

      el.classList.add('is-anim');

      new IntersectionObserver((entries) => {
        entries.forEach((entry) => { state.visible = entry.isIntersecting; update(); });
      }, { threshold: 0.25 }).observe(el);

      if (state.unrevealed && revealBox) {
        const mo = new MutationObserver(() => {
          state.unrevealed = unrevealed();
          if (!state.unrevealed) { mo.disconnect(); update(); }
        });
        mo.observe(revealBox, { attributes: true, attributeFilter: ['class'] });
      }

      document.addEventListener('visibilitychange', () => { state.hidden = document.hidden; update(); });
    });
  })();
</script>

<style>
  /* =====================================================================
     PAGE CRÉATION DE SITE WEB : styles locaux (scopés).
     Même modèle que les pages Publicité, Gestion des réseaux sociaux et Image de marque : classes
     hp-* et md-* communes aux pages Services, classes wb-* (et ms-*, gd-* pour les 2 pages de la
     section 02) propres à cette page.
     Couleurs : uniquement les jetons de global.css, leurs mélanges (color-mix) et des rgba()
     dérivées de #FA6244 et #E62B7F. Seule exception, des gris (mélanges de --text-muted,
     --text-primary et --bg-deep) : le « site classique » de la section 02.
     Contraste hybride : sur le dégradé, petits textes en --hp-on-grad (--bg-deep), titres en blanc.
     Animations : seulement les illustrations [data-wb-anim] (voir le script), en pause hors de
     l'écran, absentes avec prefers-reduced-motion (état final).
     ===================================================================== */

  /* ===== ESPACEMENTS DE RÉFÉRENCE (mêmes valeurs que l'accueil) ===== */
  .hp-hero,
  .hp-block {
    --home-section-gap: 80px;
    --home-head-gap: 16px;
    --home-head-content: 36px;
  }

  @media (min-width: 768px) {
    .hp-hero,
    .hp-block { --home-section-gap: 100px; }
  }

  @media (min-width: 900px) {
    .hp-hero,
    .hp-block {
      --home-head-gap: 20px;
      --home-head-content: 46px;
    }
  }

  @media (min-width: 1024px) {
    .hp-hero,
    .hp-block { --home-section-gap: 120px; }
  }

  /* Pas de mot seul en fin de paragraphe */
  p { text-wrap: pretty; }

  .hp-hero + .hp-block,
  .hp-block + .hp-block { margin-top: var(--home-section-gap); }

  /* Bouton sous une section */
  .md-svc-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 34px;
  }

  @media (min-width: 900px) {
    .md-svc-cta { margin-top: 44px; }
  }

  /* Groupe insécable du H1 (« rendez-vous » ne se coupe pas au trait d'union) */
  .wb-nw { white-space: nowrap; }

  /* Dégradés des SVG (curseur, jauge) */
  .wb-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .wb-stop-o { stop-color: var(--woop-orange); }
  .wb-stop-p { stop-color: var(--woop-pink); }

  /* Couleurs des pages blanches des illustrations (fond, filets, lignes de texte), teintées de rose */
  .wb-hv,
  .hp-block {
    --wb-paper: var(--hp-light);
    --wb-tint: color-mix(in srgb, var(--woop-pink) 6%, var(--text-primary));
    --wb-tint-2: color-mix(in srgb, var(--woop-pink) 12%, var(--text-primary));
    --wb-line: color-mix(in srgb, var(--woop-pink) 16%, var(--text-primary));
    --wb-soft: color-mix(in srgb, var(--woop-pink) 40%, var(--text-primary));
  }

  /* Monogramme « VC » de la clinique fictive : rond en dégradé, lettres blanches */
  .wb-mk {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--text-primary);
    font-family: var(--font-display);
    font-size: 11px;
    line-height: 1;
  }

  .wb-mk--sm { width: 24px; height: 24px; font-size: 9px; }
  .wb-mk--xs { width: 20px; height: 20px; font-size: 7.5px; }

  /* Curseur : flèche en dégradé WOOP, filet blanc ; affiché une fois placé par le script.
     État final (sans animation) : sur le bouton visé (--wb-x2, --wb-y2). La pointe est en (6, 3)
     dans le carré de 28 px. */
  .wb-cur {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    width: 28px;
    height: 28px;
    opacity: 0;
    transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px));
    filter: drop-shadow(0 4px 8px color-mix(in srgb, var(--bg-deep) 45%, transparent));
    pointer-events: none;
  }

  .wb-cur path {
    fill: url(#wb-cur-g);
    stroke: var(--text-primary);
    stroke-width: 1.4;
    stroke-linejoin: round;
  }

  .is-placed > .wb-cur { opacity: 1; }

  /* Animations : en pause tant que l'illustration n'est pas à l'écran (is-playing). !important :
     la propriété animation de chaque élément animé (déclarée plus bas) remettrait l'état à
     « running ». */
  .is-anim:not(.is-playing),
  .is-anim:not(.is-playing) :global(*) { animation-play-state: paused !important; }

  /* ===== 1. HERO : la page de service et son curseur =====
