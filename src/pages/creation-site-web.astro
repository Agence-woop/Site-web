    display: block;
    height: 10px;
    margin-top: 6px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--text-primary) 30%, transparent);
  }

  .wb-a1 i.is-lo { background: var(--woop-gradient); }

  /* Annonce → accueil générique */
  .wb-a2 {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .wb-a2__ad {
    padding: 10px 12px;
    border-radius: 12px;
    background: var(--woop-gradient);
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 800;
    white-space: nowrap;
  }

  .wb-a2__go {
    display: inline-flex;
    color: var(--md-pink-soft);
  }

  .wb-a2__go :global(svg) { width: 20px; height: 20px; }

  .wb-a2__pg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 84px;
    height: 74px;
    border-radius: 10px;
    background: var(--wb-paper);
    color: var(--bg-deep);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.2;
  }

  .wb-a2__pg b {
    font-size: 22px;
    font-weight: 900;
    color: var(--woop-pink);
  }

  /* Roue de chargement (1,4 s par tour : maquette 1,1 s, ralentie) */
  .wb-a3 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .wb-a3__sp {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    border: 4px solid color-mix(in srgb, var(--text-primary) 15%, transparent);
    border-top-color: var(--woop-pink);
    rotate: 0deg;
  }

  .wb-a3.is-anim .wb-a3__sp { animation: wb-spin 1.4s linear infinite; }

  @keyframes wb-spin {
    to { rotate: 360deg; }
  }

  .wb-a3 small {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  /* ===== 3. LA MÉTHODE : site classique (gris) et page WOOP =====
     Ordinateur (dès 900 px) : côte à côte, chevron blanc au centre. Téléphone et tablette : l'une
     sous l'autre, chevron vers le bas. La page WOOP est affichée en entier (hauteur naturelle) ;
     le site classique prend la même hauteur. */
  .wb-cmp {
    display: grid;
    grid-template-columns: minmax(0, 440px);
    justify-content: center;
    justify-items: stretch;
    gap: 24px;
  }

  @media (min-width: 900px) {
    .wb-cmp {
      grid-template-columns: minmax(0, 440px) auto minmax(0, 440px);
      align-items: stretch;
      gap: 32px;
    }
  }

  @media (min-width: 1100px) {
    .wb-cmp { gap: 44px; }
  }

  .wb-col {
    display: flex;
    flex-direction: column;
    gap: 22px;
    min-width: 0;
  }

  .wb-frame {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    overflow: hidden;
    border-radius: 20px;
    background: var(--wb-paper);
    box-shadow: 0 30px 70px var(--hp-shadow);
  }

  .wb-col--on .wb-frame {
    box-shadow: 0 30px 80px rgba(230, 43, 127, 0.3), 0 0 0 2px rgba(230, 43, 127, 0.5);
  }

  .wb-fb { padding: 11px 14px; }

  .wb-fb span { width: 9px; height: 9px; }

  .wb-col--on .wb-fb span:first-child { background: var(--woop-orange); }
  .wb-col--on .wb-fb span:nth-child(2) { background: var(--woop-pink); }

  .wb-fb em { font-size: 10.5px; padding: 4px 10px; }

  .wb-col figcaption {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: center;
  }

  .wb-col figcaption small {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .wb-col--on figcaption small { color: var(--md-pink-soft); }

  .wb-col figcaption b {
    font-size: 19px;
    line-height: 1.3;
    color: var(--text-primary);
  }

  .wb-col figcaption span {
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Chevron blanc entre les deux pages (vers le bas sur téléphone et tablette) */
  .wb-vs {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    align-self: center;
    width: 44px;
    height: 44px;
    color: var(--text-primary);
    rotate: 90deg;
  }

  .wb-vs svg { width: 30px; height: 30px; }

  @media (min-width: 900px) {
    .wb-vs {
      rotate: none;
      /* Centré sur les pages, pas sur les légendes */
      margin-top: -60px;
    }
  }

  /* --- Site classique : gris, polices de bureau, tout au même niveau --- */
  .wb-col--off {
    --ms-ink: color-mix(in srgb, var(--text-muted) 55%, var(--bg-deep));
    --ms-txt: var(--text-muted);
    --ms-light: color-mix(in srgb, var(--text-muted) 55%, var(--text-primary));
    --ms-pale: color-mix(in srgb, var(--text-muted) 22%, var(--text-primary));
    --ms-paler: color-mix(in srgb, var(--text-muted) 10%, var(--text-primary));
    --ms-mid: color-mix(in srgb, var(--text-muted) 80%, var(--text-primary));
  }

  .wb-col--off .wb-frame { background: var(--text-primary); }
  .wb-col--off .wb-fb { background: var(--ms-paler); }
  .wb-col--off .wb-fb span { background: var(--ms-pale); }
  .wb-col--off .wb-fb em { background: var(--text-primary); color: var(--ms-mid); }

  .ms {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    padding: 16px;
    font-family: Arial, Helvetica, sans-serif;
    color: var(--ms-txt);
  }

  .ms-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 9px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--ms-pale);
    font-size: 10px;
    color: var(--ms-ink);
  }

  .ms-lg {
    margin-right: 6px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 14px;
    font-weight: 700;
    color: var(--ms-ink);
  }

  .ms-ban {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    height: 120px;
    padding: 14px;
    border-radius: 4px;
    background: linear-gradient(135deg, var(--ms-light), var(--ms-pale));
  }

  .ms-ban b {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    color: var(--ms-ink);
  }

  .ms-ban small {
    font-size: 10px;
    color: var(--ms-ink);
  }

  .ms-dots {
    position: absolute;
    left: 50%;
    bottom: 8px;
    display: flex;
    gap: 4px;
    transform: translateX(-50%);
  }

  .ms-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text-primary) 70%, transparent);
  }

  .ms-t {
    font-size: 11px;
    line-height: 1.5;
    color: var(--ms-txt);
  }

  .ms-t--sm {
    font-size: 9.5px;
    color: var(--ms-mid);
  }

  .ms-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .ms-cols div {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 10px;
    border: 1px solid var(--ms-pale);
    background: var(--ms-paler);
  }

  .ms-cols b {
    font-size: 11px;
    color: var(--ms-ink);
  }

  .ms-cols i {
    display: block;
    height: 5px;
    background: var(--ms-pale);
  }

  .ms-cols i.ms-x { width: 60%; }

  .ms-btns {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .ms-btns span {
    padding: 6px 10px;
    font-size: 10px;
  }

  .ms-b1 {
    border-radius: 3px;
    background: var(--ms-ink);
    color: var(--text-primary);
  }

  .ms-b2 {
    border-radius: 12px;
    background: var(--ms-mid);
    color: var(--text-primary);
  }

  .ms-b3 {
    border: 1px solid var(--ms-mid);
    color: var(--ms-txt);
  }

  .ms-gal {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .ms-gal span {
    height: 54px;
    background: var(--ms-pale);
  }

  .ms-gal span:nth-child(2) { background: var(--ms-light); }

  .ms-foot {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--ms-pale);
    font-size: 9.5px;
    color: var(--ms-ink);
  }

  /* --- Page WOOP : un seul chemin --- */
  .gd {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    color: var(--bg-deep);
  }

  .gd-nav {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--wb-tint-2);
  }

  @media (min-width: 400px) {
    .gd-nav { gap: 14px; padding: 14px 18px; }
  }

  .gd-ln {
    font-size: 10.5px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .gd-r {
    margin-left: auto;
    padding: 6px 12px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--woop-pink);
    color: var(--md-pink-deep);
    font-size: 10px;
    font-weight: 800;
  }

  .gd-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 12px;
    padding: 20px 16px;
    background: linear-gradient(180deg, var(--wb-tint), var(--wb-paper));
  }

  @media (min-width: 400px) {
    .gd-hero { padding: 20px 18px; }
  }

  .gd-ht {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .gd-k {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .gd-h {
    font-size: 21px;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  @media (min-width: 400px) {
    .gd-h { font-size: 23px; }
  }

  .gd-ht p {
    font-size: 11px;
    line-height: 1.45;
    color: var(--text-muted);
  }

  .gd-ht sup {
    font-size: 0.7em;
    line-height: 0;
  }

  .gd-cta {
    margin-top: 4px;
    padding: 10px 14px;
    border-radius: 999px;
    background: var(--woop-gradient);
    color: var(--text-primary);
    font-size: 11.5px;
    font-weight: 800;
    line-height: 1.2;
    box-shadow: 0 10px 22px rgba(230, 43, 127, 0.4);
  }

  /* Visuel plat de la page : formes abstraites et pictogramme, sans personnage */
  .gd-img {
    position: relative;
    min-height: 120px;
    overflow: hidden;
    border-radius: 16px;
    background: linear-gradient(150deg, var(--md-pink-soft), var(--woop-pink) 60%, var(--woop-orange));
  }

  .gd-img svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .gd-img__c1 { fill: color-mix(in srgb, var(--text-primary) 22%, transparent); }
  .gd-img__c2 { fill: color-mix(in srgb, var(--woop-orange) 70%, transparent); }

  .gd-img__arc,
  .gd-img__tip {
    fill: none;
    stroke: var(--text-primary);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gd-img__dot { fill: var(--text-primary); }

  .gd-sec {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 16px;
  }

  @media (min-width: 400px) {
    .gd-sec { padding: 16px 18px; }
  }

  .gd-st {
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .gd-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .gd-cards div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 10px 8px;
    border-radius: 12px;
    background: var(--wb-paper);
    box-shadow: 0 0 0 1px var(--wb-tint-2), 0 6px 14px rgba(230, 43, 127, 0.06);
  }

  @media (min-width: 400px) {
    .gd-cards div { padding: 10px; }
  }

  .gd-ic {
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--woop-gradient);
  }

  .gd-cards b {
    font-size: 10px;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  @media (min-width: 400px) {
    .gd-cards b { font-size: 10.5px; }
  }

  .gd-cards em {
    display: flex;
    align-items: center;
    gap: 3px;
    font-style: normal;
    font-size: 9.5px;
    font-weight: 800;
    color: var(--md-pink-deep);
  }

  .gd-cards em :global(svg) { width: 10px; height: 10px; flex: none; }

  .gd-why { background: var(--wb-tint); }

  .gd-why ul {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .gd-why li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--bg-deep);
  }

  .gd-why li::before {
    content: '✓';
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--wb-tint-2);
    color: var(--md-pink-deep);
    font-size: 9px;
    font-weight: 900;
  }

  .gd-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin: 14px 16px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--woop-gradient);
    color: var(--text-primary);
  }

  @media (min-width: 400px) {
    .gd-band { margin: 14px 18px; }
  }

  .gd-band b { font-size: 13px; line-height: 1.2; }

  .gd-band span {
    flex: none;
    padding: 7px 13px;
    border-radius: 999px;
    background: var(--wb-paper);
    color: var(--md-pink-deep);
    font-size: 10.5px;
    font-weight: 800;
  }

  .gd-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 10px;
    margin-top: auto;
    padding: 14px 16px;
    background: var(--bg-deep);
    color: var(--text-primary);
  }

  @media (min-width: 400px) {
    .gd-foot { padding: 14px 18px; }
  }

  .gd-foot div {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .gd-foot small {
    font-size: 9.5px;
    color: var(--text-secondary);
  }

  /* « Demande envoyée » : bulle en haut à droite de la page (état final : visible) */
  .gd-done {
    position: absolute;
    right: 14px;
    top: 56px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px 10px 10px;
    border-radius: 14px;
    background: var(--bg-deep);
    color: var(--text-primary);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.2;
    box-shadow: 0 16px 36px var(--hp-shadow);
  }

  .gd-done .wb-ok__ic { width: 24px; height: 24px; font-size: 12px; }

  /* Boucle de la page WOOP (7,5 s, maquette : 6 s ralentie) : le curseur entre en haut à droite,
     va droit au bouton, clique ; « Demande envoyée » apparaît, puis tout reprend. */
  .gd.is-anim .wb-cur { animation: wb-gd-cur 7.5s cubic-bezier(0.4, 0.1, 0.2, 1) infinite; }
  .gd.is-anim .gd-cta { animation: wb-gd-press 7.5s ease infinite; }
  .gd.is-anim .gd-done { animation: wb-gd-done 7.5s ease infinite; }

  @keyframes wb-gd-cur {
    0% { opacity: 0; transform: translate(var(--wb-x0, 0px), 30px); }
    5% { opacity: 1; transform: translate(var(--wb-x0, 0px), 30px); }
    35% { transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)); }
    37% { transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)) scale(0.85); }
    39%, 92% { opacity: 1; transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)); }
    100% { opacity: 0; transform: translate(calc(var(--wb-x2, 0px) - 6px), calc(var(--wb-y2, 0px) - 3px)); }
  }

  @keyframes wb-gd-press {
    0%, 35% { transform: none; }
    37% { transform: scale(0.94); }
    40%, 100% { transform: none; }
  }

  @keyframes wb-gd-done {
    0%, 40% { opacity: 0; transform: translateY(16px); }
    48%, 92% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: none; }
  }

  /* ===== 4. LES LIVRABLES =====
     Ordinateur (dès 1100 px), 4 colonnes : site complet (dégradé) et rédaction en haut ; photos,
     référencement et mesure en bas. Tablette : 2 colonnes. Téléphone : 1 colonne. */
  .wb-bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 600px) {
    .wb-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .wb-bento :global(.md-sv--pages),
    .wb-bento :global(.md-sv--copy),
    .wb-bento :global(.md-sv--measure) { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .wb-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
    .wb-bento :global(.md-sv--pages) { grid-column: 1 / span 2; grid-row: 1; }
    .wb-bento :global(.md-sv--copy) { grid-column: 3 / span 2; grid-row: 1; }
    .wb-bento :global(.md-sv--img) { grid-column: 1; grid-row: 2; }
    .wb-bento :global(.md-sv--seo) { grid-column: 2; grid-row: 2; }
    .wb-bento :global(.md-sv--measure) { grid-column: 3 / span 2; grid-row: 2; }
  }

  /* Mini-illustrations des tuiles : boîte commune, puis dessin propre à chaque tuile */
  .md-mui {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  /* Site complet ou pages de conversion (sur le dégradé) : 3 pages blanches */
  .wb-mui--pages {
    padding: 16px;
    background: color-mix(in srgb, var(--bg-deep) 10%, transparent);
    box-shadow: none;
  }

  .wb-pages {
    display: flex;
    gap: 10px;
    padding-top: 12px;
  }

  .wb-mini {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 12px;
    border-radius: 14px;
    background: var(--wb-paper);
    color: var(--bg-deep);
    box-shadow: 0 14px 30px color-mix(in srgb, var(--bg-deep) 20%, transparent);
  }

  .wb-mini:nth-child(2) { transform: translateY(-12px); }

  /* Téléphone : les 3 pages l'une sous l'autre (noms des services en entier) */
  @media (max-width: 599px) {
    .wb-pages {
      flex-direction: column;
      padding-top: 0;
    }

    .wb-mini:nth-child(2) { transform: none; }

    .wb-mini i { height: 28px; }
  }

  .wb-mini small {
    overflow: hidden;
    font-size: 9.5px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--md-pink-deep);
  }

  .wb-mini i {
    display: block;
    height: 40px;
    border-radius: 8px;
    background: linear-gradient(135deg, var(--wb-line), var(--wb-soft));
  }

  .wb-mini span {
    padding: 7px 4px;
    border-radius: 999px;
    background: var(--woop-gradient);
    color: var(--text-primary);
    font-size: 10.5px;
    font-weight: 800;
    text-align: center;
  }

  /* La rédaction : un extrait de page */
  .wb-txt {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    padding: 16px;
    border-radius: 14px;
    background: var(--wb-paper);
    color: var(--bg-deep);
  }

  .wb-txt b { font-size: 16px; line-height: 1.25; }

  .wb-txt i {
    display: block;
    align-self: stretch;
    height: 6px;
    border-radius: 3px;
    background: var(--wb-line);
  }

  .wb-txt i.s { align-self: flex-start; width: 60%; }

  .wb-txt span {
    margin-top: 2px;
    padding: 7px 12px;
    border-radius: 999px;
    background: var(--woop-gradient);
