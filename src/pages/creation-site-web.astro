---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SectionHead from '../components/SectionHead.astro';
import VisibilityTeaser from '../components/VisibilityTeaser.astro';
import FinalBand from '../components/FinalBand.astro';
import StickyBar from '../components/StickyBar.astro';
import CtaIcon from '../components/CtaIcon.astro';
import ServiceHero from '../components/services/ServiceHero.astro';
import AudienceCard from '../components/services/AudienceCard.astro';
import ServiceTile from '../components/services/ServiceTile.astro';
import SpecialistCard from '../components/services/SpecialistCard.astro';
import Faq from '../components/services/Faq.astro';
import FurtherReading from '../components/services/FurtherReading.astro';
import ServiceCycle from '../components/services/ServiceCycle.astro';
import { team } from '../data/team';
import { service } from '../data/services';
import { NB } from '../utils/typo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/creation-site-web/`;

// Vos questions (accordéon et données structurées FAQPage) : 3 questions par colonne
const faq = [
  {
    q: `Combien de temps faut-il pour un site, ou une page de conversion${NB}?`,
    a: "Comptez de 2 à 4 semaines pour une page de conversion, et jusqu'à 8 à 10 semaines pour un site complet, selon sa taille et sa complexité. Le délai dépend aussi de vos disponibilités, de vos temps de réponse et de ce qui existe déjà.",
  },
  {
    q: `Qu'est-ce qui est inclus${NB}?`,
    a: "La conception, la rédaction, les visuels, le développement, le référencement de base et la mesure des demandes. Pour les photos, l'idéal est d'utiliser les vôtres. Sinon, on peut se déplacer dans votre clinique ou votre cabinet à Montréal, à Laval ou sur la Rive-Sud, ou utiliser des images de banque avec votre accord écrit. On précise ensemble ce qui s'ajoute selon votre projet.",
  },
  {
    q: `Qui rédige les textes${NB}?`,
    a: 'Nous. Vous validez chaque texte avant la mise en ligne.',
  },
  {
    q: `Est-ce que je pourrai modifier mon site moi-même${NB}?`,
    a: `Oui. Nos sites sont construits sur WordPress${NB}: vous modifiez vous-même vos textes et vos informations de base, et on reste disponibles si vous préférez qu'on s'en occupe. Le site est hébergé chez un hébergeur externe, à vos frais.`,
  },
  {
    q: `WordPress ou site sur mesure${NB}?`,
    a: `WordPress vous laisse autonome pour vos modifications. Sur demande, on peut aussi coder votre site entièrement sur mesure${NB}: il est plus léger, plus rapide, et il vieillit mieux. En contrepartie, chaque modification passe par nous.`,
  },
  {
    q: `Mon site sera-t-il conforme à la Loi 25${NB}?`,
    a: `On le conçoit pour vous aider à respecter la Loi 25${NB}: consentement clair, formulaires sobres, données minimales. Vous restez responsable de la protection des renseignements de vos patients et de votre politique de confidentialité.`,
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Création de site web pour cliniques et cabinets',
    serviceType: 'Création de site web pour cliniques et cabinets',
    // Renvoie à la fiche de l'organisation publiée sur l'accueil
    provider: { '@id': `${SITE_URL}/#organization`, name: 'Agence WOOP' },
    areaServed: 'Québec',
    url: PAGE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: service('sites').label, item: PAGE_URL },
    ],
  },
];

// Icônes au trait (même style que le reste du site)
const ICONS = {
  bolt: '<path d="M13 3L5 13h6l-1 8 8-10h-6z"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
  screen: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8"/>',
  pen: '<path d="M4 20l4-1 10-10-3-3L5 16z"/><path d="M14 7l3 3"/>',
  image: '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5-8 8"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  chart: '<path d="M4 20V10M10 20V5M16 20v-7M22 20H2"/>',
  // Clinique : bâtiment, croix médicale (blanche dans sa pastille, jamais rouge) et porte
  clinic: '<path d="M5 21V7a1 1 0 011-1h12a1 1 0 011 1v14"/><path d="M3 21h18"/><path d="M10.5 8.5h3v2h2v3h-2v2h-3v-2h-2v-3h2z"/><path d="M10 21v-3.5h4V21"/>',
  case: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/>',
} as const;
type IconKey = keyof typeof ICONS;
const icon = (k: IconKey) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[k]}</svg>`;

// Flèche des petites illustrations (même tracé que les boutons)
const ARROW = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';

// Curseur des illustrations animées (pointe en haut à gauche), rempli du dégradé #wb-cur-g
const CURSOR = 'M5 3l14 8-6 1.5L10 19z';

// 01 · Pour qui ?
const profiles: { key: 'visits' | 'home' | 'slow'; title: string; lived: string; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'visits',
    title: 'Votre site est beau, mais il ne génère pas de demandes de rendez-vous.',
    lived: 'Des visites, oui. Des demandes, rarement. Le site montre, il ne fait pas agir.',
    reveal: 'left',
  },
  {
    key: 'home',
    title: "Vos publicités envoient tout le monde sur l'accueil.",
    lived: 'Le visiteur cherchait un service précis, il tombe sur une page générale et repart.',
    reveal: 'up',
    step: '1',
  },
  {
    key: 'slow',
    title: 'Votre site est lent, et vieillit mal.',
    lived: "Trop lourd sur mobile, difficile à modifier, et personne ne sait ce qu'il collecte comme données.",
    reveal: 'right',
    step: '2',
  },
];

// 03 · Les livrables (grille : 1 colonne sur téléphone, 2 sur tablette, 4 sur ordinateur)
const deliverables: { key: 'pages' | 'copy' | 'img' | 'seo' | 'measure'; ic: IconKey; title: string; text: string; accent?: boolean; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'pages',
    ic: 'screen',
    accent: true,
    title: 'Site complet ou pages de conversion',
    text: 'Un site entier, ou une page par service et par campagne. Chaque page a un objectif, et un seul.',
    reveal: 'left',
  },
  {
    key: 'copy',
    ic: 'pen',
    title: 'La rédaction',
    text: "Des textes clairs, écrits pour vos patients ou vos candidats, qui répondent à leurs questions et les mènent à passer à l'action.",
    reveal: 'right',
    step: '1',
  },
  {
    key: 'img',
    ic: 'image',
    title: 'Illustrations ou photos',
    text: `Des visuels qui ressemblent à votre clinique ou à votre cabinet${NB}: vos photos en priorité, une séance sur place à Montréal, à Laval ou sur la Rive-Sud, ou des images de banque avec votre accord écrit.`,
    reveal: 'up',
  },
  { key: 'seo', ic: 'search', title: 'Référencement de base', text: 'Une structure propre, pour être bien lu par Google.', reveal: 'up', step: '1' },
  {
    key: 'measure',
    ic: 'chart',
    title: 'La mesure des demandes',
    text: `On suit les demandes faites depuis chaque page${NB}: formulaires envoyés, clics vers votre outil de réservation, clics sur votre numéro. Vous savez quelle page génère le plus de demandes.`,
    reveal: 'up',
    step: '2',
  },
];

// Mini-pages de la tuile « Site complet ou pages de conversion »
const servicePages = ['Physiothérapie', 'Ostéopathie', 'Massothérapie'];

// Barres de la tuile « La mesure des demandes » (longueurs illustratives, sans chiffre)
const measures: { page: string; w: string }[] = [
  { page: 'Page physiothérapie', w: '82%' },
  { page: 'Page ostéopathie', w: '58%' },
  { page: 'Page massothérapie', w: '40%' },
];
---
<Layout
  title="Création de site web pour cliniques et cabinets | WOOP"
  description="Sites et pages de conversion pour cliniques et cabinets : rapides, clairs, respectueux des données. On mesure les demandes qu'ils génèrent."
  ogImage="/images/og-image.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé. -->
  <ScrollReveal />

  <!-- Dégradé du curseur des illustrations animées (hero et section 02) -->
  <svg class="wb-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="wb-cur-g" x1="0" y1="0" x2="1" y2="1"><stop class="wb-stop-o" offset="0" /><stop class="wb-stop-p" offset="1" /></linearGradient>
      <linearGradient id="wb-gauge-g" x1="0" y1="0" x2="1" y2="0"><stop class="wb-stop-o" offset="0" /><stop class="wb-stop-p" offset="1" /></linearGradient>
    </defs>
  </svg>

  <!-- 1. HERO (sans data-reveal ; texte immobile, seule l'illustration s'anime) -->
  <ServiceHero
    layout="split"
    pill="Sites web et pages de conversion"
    sub={`Pour les cliniques et les cabinets de recrutement${NB}: un site complet ou des pages de conversion pour mettre en avant vos services. Chaque page a un objectif, se charge vite et est pensée pour la Loi 25. On mesure les demandes qu'elle génère.`}
    strong="Votre publicité attire. Votre site convainc."
    primary={{ href: `${base}/contact/`, label: 'Réserver un appel découverte' }}
    secondary={{ href: `${base}/acquisition-client/`, label: 'Testez votre visibilité' }}
  >
    <Fragment slot="title">Création de site web{NB}: un site qui génère des <span class="gradient-accent hp-kw">demandes de <span class="wb-nw">rendez-vous</span></span>, pas seulement des visites.</Fragment>

    <Fragment slot="visual">
    <Fragment set:html={"<!-- Illustration : une page de service ; le curseur choisit un créneau, puis clique sur Réserver -->"} />
    <div class="wb-hv" aria-hidden="true">
      <div class="wb-hv__glow"></div>

      <div class="wb-br" data-wb-anim data-wb-cursor>
        <div class="wb-bar"><span></span><span></span><span></span><em>votreclinique.ca/physiotherapie</em></div>
        <div class="wb-pg">
          <div class="wb-nav"><span class="wb-mk">VC</span><i></i><i></i></div>
          <small class="wb-k">Physiothérapie</small>
          <b class="wb-h">Retrouvez votre mobilité.</b>
          <i class="wb-l"></i><i class="wb-l wb-l--s"></i>
          <div class="wb-slots">
            <span>Mar.{NB}9{NB}h</span>
            <span class="wb-pick" data-wb-t1>Mar.{NB}15{NB}h{NB}30</span>
            <span>Mer.{NB}10{NB}h</span>
          </div>
          <span class="wb-cta" data-wb-t2>Réserver</span>
        </div>
        <div class="wb-ok"><span class="wb-ok__ic">✓</span><b>Demande envoyée</b></div>
        <svg class="wb-cur" viewBox="0 0 24 24" focusable="false"><path d={CURSOR} /></svg>
      </div>

      <div class="wb-chip wb-chip--1"><span class="wb-chip__ic" set:html={icon('bolt')} /><div><b>Page légère</b><small>Chargement rapide</small></div></div>
      <div class="wb-chip wb-chip--2"><span class="wb-chip__ic" set:html={icon('shield')} /><div><b>Pensé pour la Loi 25</b></div></div>
    </div>
    </Fragment>
  </ServiceHero>

  <!-- 2. 01 · POUR QUI ? -->
  <section class="hp-block hp-sec" id="pour-qui" data-reveal-clip>
    <div class="container">
      <SectionHead over={`01 · Pour qui${NB}?`}>Vous vous <span class="gradient-accent">reconnaissez</span>{NB}?</SectionHead>

      <div class="wb-prs">
        {profiles.map((p) => (
          <AudienceCard kind={p.key} title={p.title} lived={p.lived} reveal={p.reveal} step={p.step}>
            {p.key === 'visits' && (
              <div class="wb-a1">
                <div><small>Visites</small><i style="width:90%"></i></div>
                <div><small>Demandes</small><i class="is-lo" style="width:14%"></i></div>
              </div>
            )}
            {p.key === 'home' && (
              <div class="wb-a2">
                <span class="wb-a2__ad">Annonce physio</span>
                <span class="wb-a2__go" set:html={ARROW} />
                <span class="wb-a2__pg">Accueil<b>?</b></span>
              </div>
            )}
            {p.key === 'slow' && (
              <div class="wb-a3" data-wb-anim>
                <span class="wb-a3__sp"></span>
                <small>Chargement…</small>
              </div>
            )}
          </AudienceCard>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 02 · LA MÉTHODE : un site classique (gris) face à une page WOOP (curseur animé) -->
  <section class="hp-block hp-sec" id="methode" data-reveal-clip>
    <div class="container">
      <SectionHead over="02 · La méthode" intro={`Une page qui veut tout dire ne fait rien faire. La nôtre mène à un seul geste${NB}: réserver.`}>Une page, <span class="gradient-accent">un objectif</span>.</SectionHead>

      <div class="wb-cmp">
        <!-- Un site classique : tout est là, rien ne guide (gris) -->
        <figure class="wb-col wb-col--off" data-reveal="left">
          <div class="wb-frame" aria-hidden="true">
            <div class="wb-fb"><span></span><span></span><span></span><em>votreclinique.ca</em></div>
            <div class="ms">
              <div class="ms-nav"><span class="ms-lg">Clinique</span><span>Accueil</span><span>Services</span><span>Équipe</span><span>Tarifs</span><span>Blogue</span><span>Carrières</span><span>Contact</span></div>
              <div class="ms-ban"><b>Bienvenue sur notre site{NB}!</b><small>Nouvelles heures d'ouverture cet été</small><div class="ms-dots"><i></i><i></i><i></i><i></i></div></div>
              <p class="ms-t">Notre clinique offre une gamme complète de services de santé pour toute la famille depuis plusieurs années, dans un environnement chaleureux.</p>
              <div class="ms-cols"><div><b>Nos services</b><i></i><i></i><i class="ms-x"></i></div><div><b>Actualités</b><i></i><i class="ms-x"></i><i></i></div></div>
              <div class="ms-btns"><span class="ms-b1">En savoir plus</span><span class="ms-b2">Nous joindre</span><span class="ms-b3">Infolettre</span></div>
              <div class="ms-gal"><span></span><span></span><span></span></div>
              <p class="ms-t">Découvrez notre équipe de professionnels passionnés et nos installations modernes. N'hésitez pas à consulter notre blogue pour des conseils santé.</p>
              <div class="ms-foot"><span>Suivez-nous sur Facebook</span><span>Politique de confidentialité</span></div>
              <p class="ms-t ms-t--sm">Pour prendre rendez-vous, appelez-nous ou remplissez le formulaire de la page Contact.</p>
            </div>
          </div>
          <figcaption><small>Un site classique</small><b>Tout est là, mais rien ne guide.</b><span>Le patient cherche comment réserver, et abandonne.</span></figcaption>
        </figure>

        <span class="wb-vs" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6" /></svg></span>

        <!-- Une page WOOP : un seul chemin, réserver (page affichée en entier) -->
        <figure class="wb-col wb-col--on" data-reveal="right" data-reveal-step="1">
          <div class="wb-frame" aria-hidden="true">
            <div class="wb-fb"><span></span><span></span><span></span><em>votreclinique.ca/physiotherapie</em></div>
            <div class="gd" data-wb-anim data-wb-cursor>
              <div class="gd-nav"><span class="wb-mk wb-mk--sm">VC</span><span class="gd-ln">Services</span><span class="gd-ln">Équipe</span><span class="gd-ln">Contact</span><span class="gd-r">Réserver</span></div>
              <div class="gd-hero">
                <div class="gd-ht">
                  <small class="gd-k">Physiothérapie à Montréal</small>
                  <b class="gd-h">Retrouvez votre mobilité.</b>
                  <p>Une évaluation complète dès la 1<sup>re</sup> visite.</p>
                  <span class="gd-cta" data-wb-t2>Réserver une évaluation</span>
                </div>
                <!-- Visuel plat, sans personnage : formes abstraites et pictogramme d'une articulation en mouvement -->
                <div class="gd-img">
                  <svg viewBox="0 0 120 120" preserveAspectRatio="xMidYMid slice" focusable="false">
                    <circle class="gd-img__c1" cx="96" cy="22" r="34" />
                    <circle class="gd-img__c2" cx="18" cy="106" r="30" />
                    <path class="gd-img__arc" d="M30 84a34 34 0 0 1 58-34" />
                    <path class="gd-img__tip" d="M80 40l9 9-12 3" />
                    <circle class="gd-img__dot" cx="58" cy="70" r="8" />
                  </svg>
                </div>
              </div>
              <div class="gd-sec">
                <small class="gd-st">Nos services</small>
                <div class="gd-cards">
                  {servicePages.map((s) => (
                    <div><span class="gd-ic"></span><b>{s}</b><em>Réserver<Fragment set:html={ARROW} /></em></div>
                  ))}
                </div>
              </div>
              <div class="gd-sec gd-why">
                <small class="gd-st">Pourquoi nous choisir</small>
                <ul><li>Rendez-vous dès demain</li><li>Équipe de professionnels agréés</li><li>Remboursable par la plupart des assurances</li></ul>
              </div>
              <div class="gd-band"><b>Prêt à bouger mieux{NB}?</b><span>Réserver</span></div>
              <div class="gd-foot"><div><span class="wb-mk wb-mk--xs">VC</span><small>123, rue Exemple, Montréal</small></div><small>Lun. au ven. · 8{NB}h à 19{NB}h</small></div>
              <span class="gd-done"><span class="wb-ok__ic">✓</span>Demande envoyée</span>
              <svg class="wb-cur" viewBox="0 0 24 24" focusable="false"><path d={CURSOR} /></svg>
            </div>
          </div>
          <figcaption><small>Une page WOOP</small><b>Un seul chemin{NB}: réserver.</b><span>Tout ce qui aide à décider, rien qui distrait.</span></figcaption>
        </figure>
      </div>

      <div class="md-svc-cta" data-reveal="up">
        <a class="cta" href={`${base}/contact/`}>Voir ce que votre site pourrait faire<CtaIcon /></a>
      </div>
    </div>
  </section>

  <!-- 4. 03 · LES LIVRABLES -->
  <section class="hp-block hp-sec" id="livrables" data-reveal-clip>
    <div class="container">
      <SectionHead over="03 · Les livrables">Ce que vous <span class="gradient-accent">recevez</span>.</SectionHead>

      <div class="wb-bento">
        {deliverables.map((t) => (
          <ServiceTile kind={t.key} shape="sq" title={t.title} text={t.text} accent={t.accent} reveal={t.reveal} step={t.step}>
            <Fragment slot="icon"><Fragment set:html={icon(t.ic)} /></Fragment>
            <Fragment slot="illustration">
              <div class:list={['md-mui', `wb-mui--${t.key}`]} aria-hidden="true">
                {t.key === 'pages' && (
                  <div class="wb-pages">
                    {servicePages.map((s) => (
                      <div class="wb-mini"><small>{s}</small><i></i><span>Réserver</span></div>
                    ))}
                  </div>
                )}
                {t.key === 'copy' && (
                  <div class="wb-txt"><b>Vous avez mal au dos{NB}?</b><i></i><i class="s"></i><span>Réserver une évaluation</span></div>
                )}
                {t.key === 'img' && (
                  <div class="wb-img"><span></span><span></span><span></span></div>
                )}
                {t.key === 'seo' && (
                  <ul class="wb-seo"><li>Titre</li><li>Description</li><li>Structure</li></ul>
                )}
                {t.key === 'measure' && (
                  <div class="wb-ms">
                    {measures.map((m) => (
                      <div><small>{m.page}</small><span><i style={`width:${m.w}`}></i></span><em>Demandes</em></div>
                    ))}
                  </div>
                )}
              </div>
            </Fragment>
          </ServiceTile>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. 04 · NOTRE FAÇON DE CONSTRUIRE -->
  <section class="hp-block hp-sec" id="construire" data-reveal-clip>
    <div class="container">
      <SectionHead over="04 · Notre façon de construire">Léger, rapide, <span class="gradient-accent">respectueux des données</span>.</SectionHead>

      <div class="wb-fast">
        <ServiceTile kind="fast" shape="sq" title="Léger et rapide" text={`Des sites construits avec une approche d'écoconception${NB}: moins de poids, un chargement rapide, même sur mobile. Votre score de vitesse est mesuré avant chaque mise en ligne.`} reveal="left">
          <Fragment slot="icon"><Fragment set:html={icon('bolt')} /></Fragment>
          <Fragment slot="illustration">
            <!-- Jauge de vitesse : arc entièrement rempli, aiguille au maximum (à droite) ; à l'apparition,
                 l'aiguille part de la gauche et l'arc se trace avec elle -->
            <div class="md-mui wb-mui--gauge" aria-hidden="true">
              <div class="wb-gauge" data-wb-anim>
                <svg viewBox="0 0 140 80" focusable="false">
                  <path class="wb-gauge__arc" d="M14 70 A56 56 0 0 1 126 70" pathLength="100" />
                  <g class="wb-gauge__needle">
                    <path d="M70 66.5 L118 70 L70 73.5 Z" />
                  </g>
                  <circle class="wb-gauge__hub" cx="70" cy="70" r="7" />
                </svg>
              </div>
              <small>Score mesuré avant publication</small>
            </div>
          </Fragment>
        </ServiceTile>
        <ServiceTile kind="data" shape="sq" accent title="Respectueux des données" text={`La protection des renseignements de vos patients est pensée dès la conception, en tenant compte de la Loi 25${NB}: consentement clair, formulaires sobres, aucune donnée collectée sans raison.`} reveal="right" step="1">
          <Fragment slot="icon"><Fragment set:html={icon('shield')} /></Fragment>
          <Fragment slot="illustration">
            <ul class="md-mui wb-law" aria-hidden="true"><li>✓ Consentement</li><li>✓ Formulaires sobres</li><li>✓ Données minimales</li></ul>
          </Fragment>
        </ServiceTile>
      </div>

      <div class="md-svc-cta" data-reveal="up">
