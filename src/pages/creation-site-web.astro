  .wb-br.is-anim .wb-cta { animation: wb-press 7.5s ease infinite; }
  .wb-br.is-anim .wb-ok { animation: wb-hero-ok 7.5s cubic-bezier(0.2, 0.9, 0.3, 1.2) infinite; }

  @keyframes wb-hero-cur {
    0%, 6.7% { transform: translate(calc(var(--wb-x0) - 6px), 40px); }
