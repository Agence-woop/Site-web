---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SectionHead from '../components/SectionHead.astro';
import VisibilityTeaser from '../components/VisibilityTeaser.astro';
import FinalBand from '../components/FinalBand.astro';
import StickyBar from '../components/StickyBar.astro';
import BrandLogo from '../components/BrandLogo.astro';
import ServiceHero from '../components/services/ServiceHero.astro';
import AudienceCard from '../components/services/AudienceCard.astro';
import ServiceTile from '../components/services/ServiceTile.astro';
import Steps from '../components/services/Steps.astro';
import SpecialistCard from '../components/services/SpecialistCard.astro';
import Faq from '../components/services/Faq.astro';
import FurtherReading from '../components/services/FurtherReading.astro';
import ServiceCycle from '../components/services/ServiceCycle.astro';
import { team } from '../data/team';
import { NB } from '../utils/typo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/publicite-google-meta/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Publicité Google et Meta pour cliniques et cabinets',
    serviceType: 'Publicité Google et Meta pour cliniques et cabinets',
    // Renvoie à la fiche de l'organisation publiée sur l'accueil
    provider: { '@id': `${SITE_URL}/#organization`, name: 'Agence WOOP' },
    areaServed: 'Québec',
    url: PAGE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Publicité Google et Meta', item: PAGE_URL },
    ],
  },
];

// Icônes au trait (même style que le reste du site)
const ICONS = {
  eye: '<path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="3"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  retarget: '<path d="M4 12a8 8 0 0114-5.3L20 9"/><path d="M20 4v5h-5"/><path d="M20 12a8 8 0 01-14 5.3L4 15"/><path d="M4 20v-5h5"/>',
  booked: '<rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M9 3v4M15 3v4"/><path d="M9 15l2 2 4-4"/>',
  page: '<rect x="3" y="4" width="18" height="13" rx="2"/><path d="M3 8h18"/><path d="M12 12l6 2.5-2.6 1-1 2.6z"/>',
  chart: '<path d="M4 20V10M10 20V5M16 20v-7M22 20H2"/>',
  report: '<rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h3"/>',
  // Clinique : bâtiment, croix médicale (blanche dans sa pastille, jamais rouge) et porte
  clinic: '<path d="M5 21V7a1 1 0 011-1h12a1 1 0 011 1v14"/><path d="M3 21h18"/><path d="M10.5 8.5h3v2h2v3h-2v2h-3v-2h-2v-3h2z"/><path d="M10 21v-3.5h4V21"/>',
  case: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 012-2h2a2 2 0 012 2v2"/>',
  route: '<path d="M12 2.5l9.5 9.5-9.5 9.5L2.5 12z"/><path d="M9.5 14.5v-2a1.5 1.5 0 011.5-1.5h3.5"/><path d="M12.5 8.5l2 2.5-2 2.5"/>',
  phone: '<path d="M5 4h4l2 5-2.5 1.5a11 11 0 005 5L15 13l5 2v4a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2"/>',
  tag: '<path d="M3 12V4a1 1 0 011-1h8l9 9-9 9z"/><circle cx="8" cy="8" r="1.5"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
} as const;
type IconKey = keyof typeof ICONS;
const icon = (k: IconKey) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[k]}</svg>`;

// Carte de la tuile Google : épingles grises (les autres cliniques), pointe de l'épingle en (x, y)
const otherPins = [
  [62, 96],
  [348, 74],
  [292, 196],
  [108, 170],
];
const PIN = 'M12 1.5a7.5 7.5 0 00-7.5 7.5c0 5.6 7.5 13.5 7.5 13.5s7.5-7.9 7.5-13.5A7.5 7.5 0 0012 1.5z';

// Entonnoir du hero
const funnel: { key: string; ic: IconKey; step: string; net: string; who: string }[] = [
  { key: '1', ic: 'eye', step: 'Découvrir', net: 'Meta', who: 'Il ne cherche pas encore' },
  { key: '2', ic: 'search', step: 'Chercher', net: 'Google', who: 'Il cherche maintenant' },
  { key: '3', ic: 'retarget', step: 'Revenir', net: 'Reciblage', who: 'Il a vu, il revient' },
];

// 01 · Pour qui ?
const profiles: { key: 'clicks' | 'new' | 'slots' | 'solo'; title: string; lived: string; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'clicks',
    title: "Vous payez des publicités, sans savoir ce qu'elles rapportent.",
    lived: `Des clics, des impressions, un rapport incompréhensible. Mais combien de demandes de rendez-vous${NB}?`,
    reveal: 'left',
  },
  {
    key: 'new',
    title: 'Un nouveau praticien arrive, son agenda doit se remplir.',
    lived: "Lancer un service ou un professionnel, c'est trouver ses premiers patients vite.",
    reveal: 'up',
    step: '1',
  },
  {
    key: 'slots',
    title: 'Vos plages creuses vous coûtent cher.',
    lived: 'Des créneaux vides le mardi matin, pleins le jeudi soir. Il faut viser les bons moments.',
    reveal: 'up',
    step: '2',
  },
  {
    key: 'solo',
    title: 'Vous avez essayé Google ou Meta seul, sans résultat.',
    lived: 'Un réseau seul ne fait pas tout. Chacun a un rôle, ils doivent travailler ensemble.',
    reveal: 'right',
    step: '3',
  },
];

// 02 · L'entonnoir
const roles: { key: string; n: string; ic: IconKey; title: string; where: string; net: string; goal: string; kpi: string; reveal: 'left' | 'up' | 'right'; step?: string; hot?: boolean }[] = [
  {
    key: 'discover',
    n: '01',
    ic: 'eye',
    title: 'Découvrir',
    where: "Il ne cherche pas encore, mais il en aura besoin.",
    net: 'Meta (Facebook, Instagram)',
    goal: 'Faire connaître la clinique dans son quartier.',
    kpi: `Portée dans votre quartier, visites du site, nouveaux abonnés,${NB}etc.`,
    reveal: 'left',
  },
  {
    key: 'search',
    n: '02',
    ic: 'search',
    title: 'Chercher',
    where: 'Il a un besoin et cherche maintenant.',
    net: 'Google (recherche et Maps)',
    goal: 'Être trouvé en premier, au moment où il cherche.',
    kpi: `Appels, demandes de rendez-vous, itinéraires vers la clinique,${NB}etc.`,
    reveal: 'up',
    step: '1',
  },
  {
    key: 'return',
    n: '03',
    ic: 'retarget',
    title: 'Revenir',
    where: "Il a vu la clinique, mais n'a pas encore réservé.",
    net: 'Meta et Google (reciblage)',
    goal: "Le faire revenir jusqu'à la réservation.",
    kpi: `Demandes de rendez-vous, coût par demande, retours sur le site,${NB}etc.`,
    reveal: 'right',
    step: '2',
    hot: true,
  },
];

// 03 · Les livrables (grille : 1 colonne sur téléphone, 2 sur tablette, 4 sur ordinateur)
const deliverables: { key: 'gads' | 'meta' | 'lp' | 'rt' | 'measure' | 'report'; shape: 'wide' | 'sq'; title: string; text: string; accent?: boolean; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'gads',
    shape: 'sq',
    accent: true,
    title: 'Campagnes Google, recherche et Maps',
    text: 'Vos annonces apparaissent quand un patient cherche votre service dans votre secteur, sur la recherche comme sur Maps.',
    reveal: 'left',
  },
  {
    key: 'meta',
    shape: 'sq',
    title: 'Campagnes Meta',
    text: 'Facebook et Instagram, pour faire connaître la clinique à ceux qui en auront besoin demain.',
    reveal: 'right',
    step: '1',
  },
  { key: 'lp', shape: 'sq', title: 'Pages de conversion', text: 'Une page par campagne, pensée pour réserver.', reveal: 'up', step: '1' },
  { key: 'rt', shape: 'sq', title: 'Reciblage', text: 'On fait revenir ceux qui ont hésité.', reveal: 'up', step: '2' },
  {
    key: 'measure',
    shape: 'wide',
    title: "Mesure jusqu'à la demande de rendez-vous",
    text: 'On suit chaque appel, formulaire ou réservation en ligne, pas seulement le clic.',
    reveal: 'up',
  },
  {
    key: 'report',
    shape: 'wide',
    title: 'Un rapport mensuel que vous comprenez',
    text: `Expliqué par la personne qui gère vos campagnes${NB}: Emma. En demandes de rendez-vous et en coût par demande, pas en clics.`,
    reveal: 'up',
    step: '1',
  },
];

// 05 · Comment on travaille
const steps = [
  {
    n: '1',
    when: 'Appel de lancement',
    title: 'On fixe vos objectifs',
    text: "Remplir l'agenda d'un nouveau praticien, lancer un service, combler les plages creuses. Une campagne par objectif, pas une campagne pour tout.",
    get: 'Vos objectifs, par ordre de priorité.',
    reveal: 'left' as const,
  },
  {
    n: '2',
    when: 'Semaine 1',
    title: "On analyse l'existant",
    text: `On ne repart pas de zéro${NB}: on garde ce qui marchait, on coupe ce qui coûtait sans rapporter.`,
    get: "L'état des lieux de vos campagnes et de votre fiche Google, votre plan de campagnes et le budget conseillé.",
    reveal: 'up' as const,
    step: '1',
  },
  {
    n: '3',
    when: 'Chaque jour',
    title: 'On lance et on suit',
    text: "Chaque dollar a un rôle dans l'entonnoir, et on le déplace quand il ne le joue plus.",
    get: 'Vos campagnes en ligne et vos pages de conversion.',
    reveal: 'up' as const,
    step: '2',
  },
  {
    n: '4',
    when: 'Chaque mois',
    title: 'On vous rend des comptes',
    text: "Un rapport clair, expliqué par Emma, avec ce qu'on garde et ce qu'on change.",
    get: 'Vos demandes de rendez-vous et votre coût par demande de rendez-vous.',
    reveal: 'right' as const,
    step: '3',
    hot: true,
  },
];

// 08 · Vos questions
const faq = [
  {
    q: `Quel budget publicitaire faut-il prévoir${NB}?`,
    a: "Il dépend de votre secteur, de votre quartier et de vos objectifs. On vous recommande un montant précis lors de l'appel découverte, après avoir regardé votre situation.",
  },
  {
    q: `Le budget publicitaire et vos honoraires, c'est la même chose${NB}?`,
    a: 'Non. Le budget publicitaire est versé directement à Google et à Meta pour diffuser vos annonces. Les honoraires de WOOP rémunèrent la stratégie, la création, le suivi et les rapports. Les deux sont toujours présentés séparément.',
  },
  {
    q: `Combien de temps avant les premiers résultats${NB}?`,
    a: 'Les premières demandes peuvent arriver dès le lancement des campagnes. Il faut ensuite quelques semaines de données pour réduire le coût par demande de rendez-vous.',
  },
  {
    q: `Est-ce que la publicité respecte les règles de mon ordre professionnel${NB}?`,
    a: 'Nos annonces et notre ciblage sont pensés selon les règles de votre ordre professionnel et celles de Google et de Meta. Vous approuvez chaque annonce avant sa diffusion et restez responsable de sa conformité.',
  },
  {
    q: `Qui s'occupe de mes campagnes${NB}?`,
    a: "Emma, spécialiste Paid Media chez WOOP. C'est elle qui gère vos campagnes au quotidien et qui vous présente le rapport chaque mois, avec un fondateur toujours dans la boucle.",
  },
  {
    q: `Y a-t-il un engagement${NB}?`,
    a: "Les modalités d'engagement vous sont présentées lors de l'appel découverte, selon le plan choisi.",
  },
];
---
<Layout
  title="Publicité Google et Meta pour cliniques et cabinets | WOOP"
  description="Google trouve ceux qui vous cherchent, Meta ceux qui ne vous cherchent pas encore. Des campagnes suivies chaque jour et mesurées en demandes de rendez-vous."
  ogImage="/images/og-image.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé. -->
  <ScrollReveal />

  <!-- 1. HERO (sans data-reveal) -->
  <ServiceHero
    layout="split"
    pill="Publicité Google et Meta"
    sub={`Google capte les patients qui vous cherchent déjà. Meta fait connaître votre clinique à ceux qui en auront besoin demain. On construit l'entonnoir complet, et on mesure ce qui compte${NB}: les demandes de rendez-vous.`}
    strong="La publicité qui se mesure en demandes de rendez-vous, pas en clics."
    primary={{ href: `${base}/contact/`, label: 'Réserver un appel découverte' }}
    secondary={{ href: `${base}/acquisition-client/`, label: 'Testez votre visibilité' }}
  >
    <Fragment slot="title">Publicité Google et Meta{NB}: Google trouve ceux qui vous cherchent, Meta ceux qui <span class="gradient-accent hp-kw">ne vous cherchent pas encore.</span></Fragment>

    <Fragment slot="visual">
    <Fragment set:html={"<!-- Illustration : l'entonnoir, de la découverte à la demande de rendez-vous -->"} />
    <div class="pu-hv" aria-hidden="true">
      <div class="pu-hv__glow"></div>
      <div class="pu-fun">
        {funnel.map((l) => (
          <div class:list={['pu-lv', `pu-lv--${l.key}`]}>
            <span class="pu-ic" set:html={icon(l.ic)} />
            <div><small>{l.step}</small><b>{l.net}</b><em>{l.who}</em></div>
          </div>
        ))}
        <div class="pu-out">
          <span class="pu-ic pu-ic--w" set:html={icon('booked')} />
          <div><b>Demande de rendez-vous reçue</b><small>Ce qu'on mesure</small></div>
        </div>
      </div>
      <div class="pu-chip"><span class="pu-chip__plus">+</span><div><b>Nouvelle demande de rendez-vous</b><small>Via Google Maps</small></div></div>
    </div>
    </Fragment>
  </ServiceHero>

  <!-- 2. POUR QUI ? -->
  <section class="hp-block hp-sec" id="pour-qui" data-reveal-clip>
    <div class="container">
      <SectionHead over={`01 · Pour qui${NB}?`}>Vous vous <span class="gradient-accent">reconnaissez</span>{NB}?</SectionHead>

      <div class="pu-prs">
        {profiles.map((p) => (
          <AudienceCard kind={p.key} title={p.title} lived={p.lived} reveal={p.reveal} step={p.step}>
            {p.key === 'clicks' && (
              <div class="pu-av1">
                <span class="pu-av1__q">?</span>
                <div class="pu-av1__bars"><i style="height:40%"></i><i style="height:70%"></i><i style="height:55%"></i><i style="height:90%"></i></div>
                <small>Clics… et ensuite{NB}?</small>
              </div>
            )}
            {p.key === 'new' && (
              <div class="pu-av2">
                <b>Nouveau praticien</b>
                <div class="pu-av2__grid">{[1, 1, 0, 1, 0, 0].map((on) => <i class:list={[{ 'is-on': on }]}></i>)}</div>
              </div>
            )}
            {p.key === 'slots' && (
              <div class="pu-av3">
                <div class="pu-av3__wk">
                  {[['L', 1], ['M', 0], ['M', 1], ['J', 1], ['V', 0]].map(([d, hi]) => <span class:list={[hi ? 'is-hi' : 'is-lo']}><small>{d}</small></span>)}
                </div>
                <small>Plages creuses ciblées</small>
              </div>
            )}
            {p.key === 'solo' && (
              <div class="pu-av4">
                <span class="pu-av4__nd"><BrandLogo name="google" /></span>
                <i></i>
                <span class="pu-av4__nd"><BrandLogo name="meta" /></span>
                <i></i>
                <span class="pu-av4__nd pu-av4__nd--ok">✓</span>
              </div>
            )}
          </AudienceCard>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. L'ENTONNOIR -->
  <section class="hp-block hp-sec" id="entonnoir" data-reveal-clip>
    <div class="container">
      <SectionHead over="02 · L'entonnoir" intro="Chaque réseau joue un rôle différent dans le parcours du patient. On les fait travailler ensemble, du premier contact à la demande de rendez-vous.">Un réseau, <span class="gradient-accent">un rôle</span>.</SectionHead>

      <ol class="pu-fns">
        {roles.map((r) => (
          <li class:list={['pu-fn', { 'md-glass': !r.hot, 'pu-fn--hot': r.hot }]} data-reveal={r.reveal} data-reveal-step={r.step}>
            <div class="pu-fn__head">
              <span class="pu-fn__n" aria-hidden="true">{r.n}</span>
              <span class="pu-ic" aria-hidden="true" set:html={icon(r.ic)} />
              <h3><span class="visually-hidden">{r.n} </span>{r.title}</h3>
            </div>
            <p class="pu-fn__where">{r.where}</p>
            <dl>
              <dt>Réseau</dt><dd>{r.net}</dd>
              <dt>Objectif</dt><dd>{r.goal}</dd>
              <dt>Ce qu'on mesure</dt><dd class="pu-fn__kpi">{r.kpi}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. LES LIVRABLES -->
  <section class="hp-block hp-sec" id="livrables" data-reveal-clip>
    <div class="container">
      <SectionHead over="03 · Les livrables" intro="Une campagne par objectif, pas une campagne pour tout.">Ce que vous <span class="gradient-accent">recevez</span>.</SectionHead>

      <div class="pu-bento">
        {deliverables.map((t) => (
          <ServiceTile kind={t.key} shape={t.shape} title={t.title} text={t.text} accent={t.accent} reveal={t.reveal} step={t.step}>
            <Fragment slot="icon">
              {t.key === 'gads' && <Fragment set:html={icon('search')} />}
              {t.key === 'meta' && <BrandLogo name="meta" class="pu-meta-ico" />}
              {t.key === 'lp' && <Fragment set:html={icon('page')} />}
              {t.key === 'rt' && <Fragment set:html={icon('retarget')} />}
              {t.key === 'measure' && <Fragment set:html={icon('chart')} />}
              {t.key === 'report' && <Fragment set:html={icon('report')} />}
            </Fragment>
            <Fragment slot="illustration">
              <div class:list={['md-mui', `pu-mui--${t.key}`]} aria-hidden="true">
                {t.key === 'gads' && (
                  <>
                    <div class="pu-g__sb"><Fragment set:html={icon('search')} /><span>physiothérapeute près de moi</span></div>
                    <div class="pu-gm">
                      <small class="pu-gm__tag">Commandité</small>
                      <b class="pu-gm__name">Votre clinique</b>
                      <div class="pu-gm__row"><span class="pu-gm__stars">★★★★★</span><span class="pu-gm__open">Ouvert</span></div>
                      <div class="pu-gm__btns">
                        <span class="pu-gm__btn pu-gm__btn--main"><Fragment set:html={icon('route')} />Itinéraire</span>
                        <span class="pu-gm__btn"><Fragment set:html={icon('phone')} />Appeler</span>
                      </div>
                    </div>
                    <div class="pu-g__map">
                      <svg class="pu-map" viewBox="0 0 400 240" preserveAspectRatio="xMidYMid slice" focusable="false">
                        <defs>
                          <linearGradient id="pu-pin-grad" x1="0" y1="0" x2="1" y2="1"><stop class="pu-stop-o" offset="0" /><stop class="pu-stop-p" offset="1" /></linearGradient>
                        </defs>
                        <rect class="pu-map__bg" width="400" height="240" />
                        <!-- Parc -->
                        <rect class="pu-map__park" x="196" y="16" width="106" height="80" rx="12" />
                        <circle class="pu-map__tree" cx="222" cy="42" r="9" />
                        <circle class="pu-map__tree" cx="252" cy="62" r="12" />
                        <circle class="pu-map__tree" cx="280" cy="38" r="8" />
                        <circle class="pu-map__tree" cx="228" cy="78" r="7" />
                        <!-- Rues : bordure, puis chaussée -->
                        <path class="pu-map__edge pu-map__edge--minor" d="M0 112H400M318 0V240M0 50H170M70 112V240" />
                        <path class="pu-map__edge pu-map__edge--major" d="M-10 212L410 128M170 -10V250" />
                        <path class="pu-map__street pu-map__street--minor" d="M0 112H400M318 0V240M0 50H170M70 112V240" />
                        <path class="pu-map__street pu-map__street--major" d="M-10 212L410 128M170 -10V250" />
                        <!-- Autres cliniques -->
                        {otherPins.map(([x, y]) => (
                          <g class="pu-map__pin" transform={`translate(${x - 12} ${y - 22})`}><path d={PIN} /><circle cx="12" cy="9" r="2.6" /></g>
                        ))}
                        <!-- Votre clinique -->
                        <ellipse class="pu-map__halo" cx="236" cy="152" rx="26" ry="9" />
                        <g class="pu-map__me" transform="translate(236 152) scale(1.9) translate(-12 -22)"><path d={PIN} fill="url(#pu-pin-grad)" /><circle cx="12" cy="9" r="3" /></g>
                      </svg>
                    </div>
                  </>
                )}
                {t.key === 'meta' && (
                  <div class="pu-m__ph">
                    <div class="pu-m__head"><span></span><b>Votre clinique</b><small>Commandité</small></div>
                    <div class="pu-m__img"></div>
                    <div class="pu-m__cta">Réserver</div>
                  </div>
                )}
                {t.key === 'lp' && (
                  <div class="pu-lp"><i class="pu-lp__h"></i><i></i><i class="pu-lp__s"></i><span>Réserver</span></div>
                )}
                {t.key === 'rt' && (
                  <div class="pu-flow pu-flow--col"><span>Vu</span><i></i><span>Revu</span><i></i><span class="is-ok">Demande</span></div>
                )}
                {t.key === 'measure' && (
                  <div class="pu-flow pu-flow--col"><span>Clic</span><i></i><span>Visite</span><i></i><span>Appel ou formulaire</span><i></i><span class="is-ok">Demande de rendez-vous</span></div>
                )}
                {t.key === 'report' && (
                  <div class="pu-rp">
                    <div><small>Demandes de rendez-vous</small><b>Votre chiffre</b></div>
                    <div><small>Coût par demande</small><b>Votre chiffre</b></div>
                  </div>
                )}
              </div>
            </Fragment>
          </ServiceTile>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. LA MESURE -->
  <section class="hp-block hp-sec" id="mesure" data-reveal-clip>
    <div class="container">
