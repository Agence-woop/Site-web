  />

  <!-- BANDEAU COLLANT (bas d'écran) : hors data-reveal, piloté par le script du composant StickyBar -->
  <StickyBar lead="Une publicité mesurée en demandes de rendez-vous," strong="pas en clics" />

</Layout>

<style>
  /* =====================================================================
     PAGE PUBLICITÉ GOOGLE ET META : styles locaux (scopés).
     Les classes hp-* et md-* reprennent celles des pages Santé et RH (mêmes noms, mêmes
     valeurs). Les classes pu-* sont propres à cette page.
     Couleurs : uniquement les jetons de global.css, leurs mélanges (color-mix) et des rgba()
     dérivées de #FA6244 et #E62B7F. Contraste hybride : sur le dégradé, petits textes en
     --hp-on-grad (--bg-deep), titres en blanc.
     ===================================================================== */

  /* ===== ESPACEMENTS DE RÉFÉRENCE (mêmes valeurs que l'accueil) ===== */
  .hp-hero,
  .hp-block {
    --home-section-gap: 80px;
    --home-head-gap: 16px;
    --home-head-content: 36px;
  }

  @media (min-width: 768px) {
    .hp-hero,
    .hp-block { --home-section-gap: 100px; }
  }

  @media (min-width: 900px) {
    .hp-hero,
    .hp-block {
      --home-head-gap: 20px;
      --home-head-content: 46px;
    }
  }

  @media (min-width: 1024px) {
    .hp-hero,
    .hp-block { --home-section-gap: 120px; }
  }

  /* Pas de mot seul en fin de paragraphe */
  p { text-wrap: pretty; }

  .hp-hero + .hp-block,
  .hp-block + .hp-block { margin-top: var(--home-section-gap); }

  .hp-block--last { padding-bottom: var(--home-section-gap); }

  /* Pastille d'icône (entonnoir du hero et de la section 02) */
  .pu-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 13px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 8px 20px rgba(230, 43, 127, 0.3);
  }

  .pu-ic :global(svg) { width: 22px; height: 22px; }

  .pu-ic--w {
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: none;
  }

  /* ===== 1. HERO : l'entonnoir ===== */
  /* Colonne de droite du hero (dès 1024 px), sous le texte sur téléphone et tablette */
  .pu-hv {
    position: relative;
    width: 100%;
    max-width: 560px;
    margin: 8px auto 0;
  }

  @media (min-width: 1024px) {
    .pu-hv { margin-top: 0; }
  }

  .pu-hv__glow {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 560px;
    max-width: 120%;
    height: 520px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(230, 43, 127, 0.32), rgba(250, 98, 68, 0.1) 45%, transparent 70%);
    pointer-events: none;
  }

  .pu-fun {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    width: 100%;
    max-width: 440px;
    margin: 0 auto;
  }

  .pu-lv {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 22px;
    background: var(--hp-light);
    color: var(--bg-deep);
    text-align: left;
    box-shadow: 0 18px 40px var(--hp-shadow);
  }

  @media (min-width: 621px) {
    .pu-lv { padding: 16px 20px; }
  }

  .pu-lv--1 { width: 100%; }
  .pu-lv--2 { width: 86%; }
  .pu-lv--3 { width: 72%; }

  .pu-lv small {
    display: block;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .pu-lv b {
    display: block;
    font-size: 17px;
    line-height: 1.25;
  }

  .pu-lv em {
    display: block;
    font-style: normal;
    font-size: 12.5px;
    line-height: 1.35;
    color: var(--text-muted);
  }

  .pu-out {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 78%;
    margin-top: 6px;
    padding: 14px 16px;
    border-radius: 22px;
    background: var(--woop-gradient);
    text-align: left;
    box-shadow: 0 24px 50px rgba(230, 43, 127, 0.45);
  }

  .pu-out b {
    display: block;
    font-size: 15px;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .pu-out small {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    font-weight: 600;
    color: var(--hp-on-grad);
  }

  @media (max-width: 520px) {
    .pu-lv--2 { width: 92%; }
    .pu-lv--3 { width: 84%; }
    .pu-out { width: 84%; }
  }

  /* Notification : en haut à droite de l'entonnoir, dès 900 px */
  .pu-chip { display: none; }

  @media (min-width: 900px) {
    .pu-chip {
      position: absolute;
      top: -22px;
      right: 0;
      display: flex;
      max-width: 100%;
      align-items: center;
      gap: 10px;
      padding: 9px 16px 9px 10px;
      border-radius: 16px;
      background: color-mix(in srgb, var(--bg-elevated) 90%, transparent);
      text-align: left;
      box-shadow: inset 0 0 0 1px var(--hp-line), 0 20px 44px var(--hp-shadow);
    }
  }

  .pu-chip__plus {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 9px;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-weight: 700;
  }

  /* Titre sur une seule ligne */
  .pu-chip b {
    display: block;
    font-size: 13px;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--text-primary);
  }

  .pu-chip small {
    display: block;
    margin-top: 1px;
    font-size: 11.5px;
    line-height: 1.25;
    color: var(--text-secondary);
  }

  /* ===== 2. POUR QUI ? ===== */
  .pu-prs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 600px) {
    .pu-prs { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1200px) {
    .pu-prs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .md-pr__vis--clicks,
  .md-pr__vis--new,
  .md-pr__vis--slots,
  .md-pr__vis--solo {
    background:
      radial-gradient(circle at 30% 20%, rgba(230, 43, 127, 0.3), transparent 65%),
      var(--hp-plum);
  }

  /* Clics… et ensuite ? */
  .pu-av1 {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .pu-av1__bars {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: 70px;
  }

  .pu-av1__bars i {
    display: block;
    width: 18px;
    border-radius: 5px;
    background: color-mix(in srgb, var(--text-primary) 25%, transparent);
  }

  .pu-av1__q {
    position: absolute;
    right: -30px;
    top: -12px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-weight: 700;
  }

  .pu-av1 small,
  .pu-av3 > small {
    font-size: 12px;
    color: var(--text-secondary);
  }

  /* Agenda du nouveau praticien */
  .pu-av2 {
    width: 190px;
    padding: 14px;
    border-radius: 16px;
    background: var(--hp-light);
    box-shadow: 0 18px 36px var(--hp-shadow);
  }

  .pu-av2 b {
    display: block;
    margin-bottom: 10px;
    font-size: 12px;
    line-height: 1.2;
    color: var(--bg-deep);
  }

  .pu-av2__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
  }

  .pu-av2__grid i {
    display: block;
    height: 16px;
    border-radius: 5px;
    background: var(--hp-skel-2);
  }

  .pu-av2__grid i.is-on { background: var(--woop-gradient); }

  /* Semaine : plages creuses ciblées */
  .pu-av3 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .pu-av3__wk {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: 78px;
  }

  .pu-av3__wk span {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 26px;
    padding-bottom: 4px;
    border-radius: 7px;
  }

  .pu-av3__wk .is-hi {
    height: 100%;
    background: color-mix(in srgb, var(--text-primary) 20%, transparent);
  }

  .pu-av3__wk .is-lo {
    height: 38%;
    background: var(--woop-gradient);
    box-shadow: 0 0 14px rgba(230, 43, 127, 0.6);
  }

  .pu-av3__wk small {
    font-size: 10px;
    font-weight: 700;
    line-height: 1;
    color: var(--text-primary);
  }

  .pu-av3__wk .is-lo small { color: var(--hp-on-grad); }

  /* Google + Meta → résultat */
  .pu-av4 {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .pu-av4 > i {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--woop-gradient);
  }

  .pu-av4__nd {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50px;
    height: 50px;
    border-radius: 15px;
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: 0 12px 26px var(--hp-shadow);
  }

  .pu-av4__nd :global(svg) { width: 24px; height: 24px; }

  .pu-av4__nd--ok {
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-weight: 700;
    font-size: 18px;
  }

  /* ===== 3. L'ENTONNOIR ===== */
  .pu-fns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    list-style: none;
  }

  @media (min-width: 1100px) {
    .pu-fns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .pu-fn {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 24px;
    border-radius: 26px;
  }

  @media (min-width: 1024px) {
    .pu-fn { padding: 30px; }
  }

  .pu-fn--hot {
    background: var(--woop-gradient);
    box-shadow: 0 24px 60px rgba(230, 43, 127, 0.28);
  }

  .pu-fn__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .pu-fn__n {
    font-size: 13px;
    font-weight: 700;
    color: var(--md-pink-soft);
  }

  .pu-fn h3 {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .pu-fn__where {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .pu-fn dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--hp-line);
  }

  .pu-fn dt {
    padding-top: 3px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .pu-fn dd {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-primary);
  }

  .pu-fn dd.pu-fn__kpi { color: var(--md-pink-soft); }

  /* Étape mise en avant, sur le dégradé : titre en blanc, petits textes en --hp-on-grad */
  .pu-fn--hot .pu-ic {
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: none;
  }

  .pu-fn--hot .pu-fn__n,
  .pu-fn--hot .pu-fn__where,
  .pu-fn--hot dt,
  .pu-fn--hot dd,
  .pu-fn--hot dd.pu-fn__kpi { color: var(--hp-on-grad); }

  .pu-fn--hot dl { border-top-color: color-mix(in srgb, var(--bg-deep) 22%, transparent); }

  /* ===== 4. LES LIVRABLES ===== */
  .pu-bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 600px) {
    .pu-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .md-sv--gads,
    .md-sv--meta,
    .md-sv--measure,
    .md-sv--report { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .pu-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
    .md-sv--gads { grid-column: 1 / span 2; grid-row: 1 / span 2; }
    .md-sv--meta { grid-column: 3 / span 2; grid-row: 1; }
    .md-sv--lp { grid-column: 3; grid-row: 2; }
    .md-sv--rt { grid-column: 4; grid-row: 2; }
    .md-sv--measure { grid-column: 1 / span 2; grid-row: 3; }
    .md-sv--report { grid-column: 3 / span 2; grid-row: 3; }
  }

  /* Symbole Meta officiel dans la pastille d'icône */
  .pu-meta-ico { width: 28px; height: 28px; }

  /* Mini-illustrations des tuiles : boîte commune, puis dessin propre à chaque tuile */
  .md-mui {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  /* Google : recherche, fiche de résultat et carte (sur le dégradé, fiche blanche) */
  .pu-mui--gads {
    gap: 10px;
    padding: 16px;
    border-radius: 20px;
    background: var(--hp-light);
    color: var(--bg-deep);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--bg-deep) 25%, transparent);
  }

  .pu-g__sb {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1.5px var(--hp-skel-2);
    font-size: 13px;
    color: var(--text-muted);
  }

  .pu-g__sb :global(svg) {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--md-pink-deep);
  }

  /* Fiche de résultat, comme dans Google Maps (sans note chiffrée ni nombre d'avis) */
  .pu-gm {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--woop-pink) 6%, var(--text-primary));
    box-shadow: inset 0 0 0 1px var(--hp-blush);
  }

  .pu-gm__tag {
    font-size: 10px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .pu-gm__name {
    font-size: 16px;
    line-height: 1.25;
  }

  .pu-gm__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pu-gm__stars {
    font-size: 13px;
    line-height: 1;
    letter-spacing: 2px;
    color: var(--woop-orange);
  }

  .pu-gm__open {
    padding: 3px 9px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--woop-pink) 12%, var(--text-primary));
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--md-pink-deep);
  }

  .pu-gm__btns {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }

  .pu-gm__btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px 6px 9px;
