      <div class="pu-srs">
        <ServiceTile kind="clinic" shape="sq" title="Pour une clinique" text={`Un entonnoir pour les patients${NB}: Meta fait connaître la clinique dans le quartier, Google capte ceux qui cherchent, le reciblage les ramène jusqu'à la réservation.`} reveal="left">
          <Fragment slot="icon"><Fragment set:html={icon('clinic')} /></Fragment>
        </ServiceTile>
        <ServiceTile kind="firm" shape="sq" title="Pour un cabinet de recrutement" text={`Un double entonnoir${NB}: Google pour les entreprises qui cherchent un cabinet, Meta pour les candidats qui ne cherchent pas encore.`} reveal="right" step="1">
