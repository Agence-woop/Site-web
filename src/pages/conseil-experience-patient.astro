---
import Layout from '../layouts/Layout.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import SectionHead from '../components/SectionHead.astro';
import VisibilityTeaser from '../components/VisibilityTeaser.astro';
import FinalBand from '../components/FinalBand.astro';
import StickyBar from '../components/StickyBar.astro';
import CtaIcon from '../components/CtaIcon.astro';
import ServiceHero from '../components/services/ServiceHero.astro';
import AudienceCard from '../components/services/AudienceCard.astro';
import ServiceTile from '../components/services/ServiceTile.astro';
import SpecialistCard from '../components/services/SpecialistCard.astro';
import Faq from '../components/services/Faq.astro';
import FurtherReading from '../components/services/FurtherReading.astro';
import ServiceCycle from '../components/services/ServiceCycle.astro';
import { team } from '../data/team';
import { service } from '../data/services';
import { NB } from '../utils/typo';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const SITE_URL = 'https://agence-woop.ca';
const PAGE_URL = `${SITE_URL}/conseil-experience-patient/`;

// Vos questions (accordéon et données structurées FAQPage) : 3 questions par colonne, toutes fermées
const faq = [
  {
    q: `Pourquoi une agence marketing s'occupe de l'expérience patient${NB}?`,
    a: "Parce que la publicité amène le patient, mais c'est l'expérience qui décide s'il revient et s'il vous recommande. Une bonne campagne ne compense pas un appel sans réponse.",
  },
  {
    q: `Est-ce que vous venez vraiment dans la clinique${NB}?`,
    a: `Oui. Après la fiche Google et le site, Kevin vient sur place et vit votre parcours comme un patient${NB}: l'accueil, l'attente, l'environnement, le paiement et ce qui se passe après. On se déplace à Montréal, à Laval et sur la Rive-Sud, et dans d'autres régions sur demande.`,
  },
  {
    q: `Mon équipe est-elle prévenue de la visite${NB}?`,
    a: "Oui. La visite est programmée avec vous et annoncée à votre équipe. On n'évalue jamais la consultation ni les soins donnés par vos praticiens.",
  },
  {
    q: `Avez-vous accès aux dossiers de nos patients${NB}?`,
    a: `Jamais. On observe le parcours, pas les dossiers${NB}: ce n'est pas le but de notre visite.`,
  },
  {
    q: `Combien de temps ça prend${NB}?`,
    a: 'La visite peut avoir lieu dans les 48 à 72 heures suivant notre appel découverte. Vous recevez ensuite votre rapport et nos recommandations dans les 48 à 72 heures.',
  },
  {
    q: `Qu'est-ce qui est inclus${NB}?`,
    a: "L'audit de votre fiche Google, de votre site et de votre clinique, et un rapport avec les irritants, le plan d'action par priorité et les indicateurs à suivre. La formation et l'accompagnement de votre équipe d'accueil, ainsi qu'un audit de suivi quelques mois plus tard, sont offerts en option.",
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'Conseil en expérience patient',
    serviceType: 'Conseil en expérience patient pour cliniques',
    // Renvoie à la fiche de l'organisation publiée sur l'accueil
    provider: { '@id': `${SITE_URL}/#organization`, name: 'Agence WOOP' },
    areaServed: 'Québec',
    url: PAGE_URL,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: service('experience').label, item: PAGE_URL },
    ],
  },
];

// Icônes au trait (même style que le reste du site)
const ICONS = {
  pin: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
  screen: '<rect x="3" y="4" width="18" height="14" rx="2"/><path d="M3 8h18M8 21h8"/>',
  // Clinique : bâtiment, croix médicale (blanche dans sa pastille, jamais rouge) et porte (même
  // pictogramme que les autres pages Services)
  clinic: '<path d="M5 21V7a1 1 0 011-1h12a1 1 0 011 1v14"/><path d="M3 21h18"/><path d="M10.5 8.5h3v2h2v3h-2v2h-3v-2h-2v-3h2z"/><path d="M10 21v-3.5h4V21"/>',
  phone: '<path d="M6.6 10.8a15 15 0 006.6 6.6l2.2-2.2a1 1 0 011-.25 11 11 0 003.6.57 1 1 0 011 1V20a1 1 0 01-1 1A17 17 0 013 4a1 1 0 011-1h3.5a1 1 0 011 1c0 1.25.2 2.45.57 3.57a1 1 0 01-.25 1z"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M20 20l-4.2-4.2"/>',
  route: '<path d="M4 6h4v4H4zM16 14h4v4h-4z"/><path d="M8 8h5a3 3 0 013 3v3"/>',
  list: '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4 6l1 1 2-2M4 12l1 1 2-2M4 18h2"/>',
  team: '<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20c.8-3.6 3.4-5.5 6.5-5.5s5.7 1.9 6.5 5.5"/><circle cx="17" cy="9" r="2.5"/><path d="M17 14.5c2.3.2 4 1.8 4.5 4.5"/>',
  chart: '<path d="M4 20V10M10 20V5M16 20v-7M22 20H2"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"/><path d="M8.5 12l2.5 2.5 4.5-5"/>',
} as const;
type IconKey = keyof typeof ICONS;
const icon = (k: IconKey) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${ICONS[k]}</svg>`;

// Flèche des illustrations et des moments (même tracé que les boutons)
const ARROW = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"/></svg>';

// Hero : les 3 étapes du parcours, et ce que la patiente rencontre à chacune (irritant, puis correction)
const steps: { k: string; ic: IconKey; over: string; title: string; what: string; irritant: string; fix: string }[] = [
  { k: '1', ic: 'pin', over: '1 · En ligne', title: 'Votre fiche Google', what: 'Avis, photos, horaires, réponses', irritant: 'Aucune réponse aux avis', fix: 'Une réponse à chaque avis' },
  { k: '2', ic: 'screen', over: '2 · En ligne', title: 'Votre site', what: "Trouver l'info, réserver", irritant: 'Réservation en 6 étapes', fix: 'Réservation en 3 clics' },
  { k: '3', ic: 'clinic', over: '3 · En personne', title: 'Votre clinique', what: 'Accueil, attente, environnement, paiement, suivi', irritant: 'Attente sans nouvelles', fix: 'Patient prévenu du retard' },
];
const last = steps[steps.length - 1];

// 01 · Pour qui ?
const profiles: { key: 'once' | 'reviews' | 'phone' | 'ads'; title: string; lived: string; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'once',
    title: 'Vos patients viennent une fois, puis ne reviennent pas.',
    lived: `Le soin était bon. Alors qu'est-ce qui les a fait partir${NB}?`,
    reveal: 'left',
  },
  {
    key: 'reviews',
    title: "Vos avis Google parlent plus de l'accueil que du soin.",
    lived: `«${NB}Personne ne répond au téléphone${NB}», «${NB}40 minutes d'attente sans nouvelles${NB}».`,
    reveal: 'up',
    step: '1',
  },
  {
    key: 'phone',
    title: 'Le téléphone sonne, et personne ne décroche.',
    lived: "Des appels perdus, des rendez-vous manqués, une équipe d'accueil débordée.",
    reveal: 'up',
    step: '2',
  },
  {
    key: 'ads',
    title: "Vous investissez en publicité, mais l'expérience ne suit pas.",
    lived: "La pub amène le patient. Si le parcours bloque, l'argent part avec lui.",
    reveal: 'right',
    step: '3',
  },
];

// 02 · L'audit
const audits: { n: string; ic: IconKey; title: string; where: string; look: string; goal: string; reveal: 'left' | 'up' | 'right'; step?: string; hot?: boolean }[] = [
  {
    n: '01',
    ic: 'pin',
    title: 'La fiche Google',
    where: 'Ce que le patient voit avant même de cliquer.',
    look: 'Avis, photos, horaires, réponses aux commentaires.',
    goal: 'Une première impression qui donne confiance',
    reveal: 'left',
  },
  {
    n: '02',
    ic: 'screen',
    title: 'Le site web',
    where: "La facilité à trouver l'information et à réserver.",
    look: "Clarté, rapidité, nombre d'étapes pour prendre rendez-vous.",
    goal: 'Une réservation sans effort',
    reveal: 'up',
    step: '1',
  },
  {
    n: '03',
    ic: 'clinic',
    title: 'La clinique, en personne',
    where: 'On vient sur place, comme un patient.',
    look: "L'accueil, l'attente, l'environnement, le paiement, et ce qui se passe après.",
    goal: 'Une expérience cohérente du début à la fin',
    reveal: 'right',
    step: '2',
    hot: true,
  },
];

// 03 · Les moments qui comptent
const moments: { name: string; lived: string; reco: string }[] = [
  { name: 'Trouver', lived: 'Il tombe sur une fiche Google sans photos, et des avis restés sans réponse.', reco: 'Une fiche complète, des photos récentes, une réponse à chaque avis.' },
  { name: 'Réserver', lived: 'Le formulaire demande dix informations. Il abandonne.', reco: 'Une réservation en quelques clics, ou un rappel rapide.' },
  { name: 'Arriver', lived: 'Personne ne lève les yeux à son arrivée.', reco: 'Un accueil qui le reconnaît et lui dit quoi faire.' },
  { name: 'Attendre', lived: 'Vingt minutes de retard, et personne ne le prévient.', reco: 'Il est prévenu, et sait combien de temps il attend.' },
  { name: 'Être soigné', lived: "Le soin est excellent. C'est votre cœur de métier.", reco: `On ne touche pas au soin${NB}: on s'assure que tout le reste est à sa hauteur.` },
  { name: 'Payer', lived: 'La facture est floue, il ne sait pas ce qui est couvert.', reco: 'Une facture claire, expliquée au comptoir.' },
  { name: 'Être relancé', lived: 'Après le soin, plus aucune nouvelle.', reco: 'Un message de suivi, et le prochain rendez-vous proposé.' },
  { name: 'Recommander', lived: 'Personne ne lui a demandé son avis.', reco: "Une demande d'avis au bon moment, et des patients qui vous recommandent." },
];

// 04 · Les livrables (grille : 1 colonne sur téléphone, 2 sur tablette, 4 sur ordinateur)
const deliverables: { key: 'diag' | 'map' | 'plan' | 'team' | 'kpi'; ic: IconKey; title: string; text: string; badge?: string; accent?: boolean; reveal: 'left' | 'up' | 'right'; step?: string }[] = [
  {
    key: 'diag',
    ic: 'search',
    accent: true,
    title: 'Le diagnostic',
    text: 'Votre fiche Google, votre site et votre clinique, parcourus comme un patient. Tout ce qui fonctionne, et tout ce qui bloque.',
    reveal: 'left',
  },
  {
    key: 'map',
    ic: 'route',
    title: 'La carte du parcours',
    text: "Chaque étape vécue par vos patients, de la recherche en ligne jusqu'au suivi, avec les irritants repérés.",
    reveal: 'right',
    step: '1',
  },
  { key: 'plan', ic: 'list', title: "Un plan d'action par priorité", text: "Ce qu'on change, et dans quel ordre.", reveal: 'up' },
  {
    key: 'team',
    ic: 'team',
    badge: 'En option',
    title: "L'équipe d'accueil",
    text: `On se déplace dans votre clinique pour former et accompagner l'équipe qui reçoit vos patients${NB}: l'accueil au téléphone, l'arrivée, l'attente et le suivi.`,
    reveal: 'up',
    step: '1',
  },
  {
    key: 'kpi',
    ic: 'chart',
    title: 'Les indicateurs à suivre',
    text: `Délai de réponse, rendez-vous manqués, avis Google, patients qui reviennent${NB}: des indicateurs que vous regardez déjà, listés dans votre rapport. Les chiffres viennent de votre clinique, jamais d'une estimation. Un audit de suivi, quelques mois plus tard, est possible en option.`,
    reveal: 'up',
    step: '2',
  },
];

// Lignes du diagnostic (illustration) : état et libellé, aux couleurs de la charte
const diagRows: { label: string; state: 'ok' | 'mid' | 'hi'; tag: string }[] = [
  { label: 'Fiche Google', state: 'ok', tag: 'Bien' },
  { label: 'Réservation en ligne', state: 'mid', tag: 'À améliorer' },
  { label: 'Accueil téléphonique', state: 'hi', tag: 'Prioritaire' },
  { label: 'Suivi après la visite', state: 'hi', tag: 'Prioritaire' },
];

// Carte du parcours (illustration) : étapes, irritants repérés (le soin reste neutre : on ne l'évalue pas)
const mapSteps: { label: string; state: 'ok' | 'bad' | 'neutral' }[] = [
  { label: 'Trouver', state: 'ok' },
  { label: 'Réserver', state: 'bad' },
  { label: 'Arriver', state: 'ok' },
  { label: 'Attendre', state: 'bad' },
  { label: 'Soin', state: 'neutral' },
  { label: 'Suivi', state: 'bad' },
];

// 05 · Le rapport : sommaire
const toc = ['Votre parcours en ligne', 'Votre parcours en clinique', 'Les irritants, par priorité', "Le plan d'action", 'Les indicateurs à suivre'];
---
<Layout
  title="Conseil en expérience patient à Montréal | WOOP"
  description="Fiche Google, site web, puis visite sur place : on vit votre parcours de A à Z et on vous remet un plan pour corriger chaque irritant."
  ogImage="/images/og-image.jpg"
  jsonLd={jsonLd}
>

  <!-- Apparition des blocs au défilement (avant le premier bloc animé). Le hero n'est jamais animé. -->
  <ScrollReveal />

  <!-- 1. HERO (sans data-reveal ; texte immobile, seule l'illustration s'anime) -->
  <ServiceHero
    layout="split"
    pill="Conseil en expérience patient"
    sub={`Votre fiche Google, votre site, puis votre clinique, sur place${NB}: on parcourt chaque étape comme un patient, on repère les irritants, et on vous remet un plan clair pour une expérience complète, avant, pendant et après le rendez-vous.`}
    strong="Le marketing amène vos patients. L'expérience les fait revenir."
    primary={{ href: `${base}/contact/`, label: 'Réserver un appel découverte' }}
    secondary={{ href: `${base}/acquisition-client/`, label: 'Testez votre visibilité' }}
  >
    <Fragment slot="title">Conseil en expérience patient{NB}: on vit votre parcours, <span class="gradient-accent hp-kw">en ligne, puis en personne</span>.</Fragment>

    <Fragment slot="visual">
    <Fragment set:html={"<!-- Illustration : le parcours de Sophie, de la fiche Google à la clinique ; à chaque étape, un irritant repéré puis corrigé -->"} />
    <div class="cx-hv" aria-hidden="true" data-cx-hero>
      <div class="cx-hv__glow"></div>
      <svg class="cx-path" viewBox="0 0 520 480" preserveAspectRatio="none" focusable="false">
        <defs><linearGradient id="cx-path-g" x1="0" x2="1"><stop class="cx-stop-o" offset="0" /><stop class="cx-stop-p" offset="1" /></linearGradient></defs>
        <path class="cx-dash" d="M110 90 C 300 90, 330 170, 260 230 S 160 330, 380 380" />
      </svg>
      <div class="cx-steps">
        {steps.map((s, i) => (
          <div class:list={['cx-st', `cx-st--${s.k}`, { 'is-on': i === steps.length - 1 }]} data-cx-step data-irritant={s.irritant} data-fix={s.fix}>
            <span class="cx-ic" set:html={icon(s.ic)} />
            <div><small>{s.over}</small><b>{s.title}</b><em>{s.what}</em></div>
          </div>
        ))}
      </div>
      <div class="cx-pat" data-cx-pat><span class="cx-av">S</span><div><b>Sophie</b><small>Nouvelle patiente</small></div></div>
      <div class="cx-chip is-fix" data-cx-chip><span class="cx-ci" data-cx-ci>✓</span><div><b data-cx-t>Corrigé</b><small data-cx-s>{last.fix}</small></div></div>
    </div>
    </Fragment>
  </ServiceHero>

  <!-- 2. 01 · POUR QUI ? -->
  <section class="hp-block hp-sec" id="pour-qui" data-reveal-clip>
    <div class="container">
      <SectionHead over={`01 · Pour qui${NB}?`}>Vous vous <span class="gradient-accent">reconnaissez</span>{NB}?</SectionHead>

      <div class="cx-prs">
        {profiles.map((p) => (
          <AudienceCard kind={p.key} title={p.title} lived={p.lived} reveal={p.reveal} step={p.step}>
            {p.key === 'once' && (
              <div class="cx-a1">
                <div class="cx-a1__bars"><i style="height:95%"></i><i style="height:45%"></i><i style="height:25%"></i><i style="height:15%"></i></div>
                <small>1<sup>re</sup> visite, puis…</small>
              </div>
            )}
            {p.key === 'reviews' && (
              <div class="cx-a2">
                <span class="cx-a2__stars"><span>★★★</span><span class="cx-a2__off">★★</span></span>
                <b>«{NB}Accueil à revoir{NB}»</b>
              </div>
            )}
            {p.key === 'phone' && (
              <div class="cx-a3"><span set:html={icon('phone')} /><b>3 appels manqués</b></div>
            )}
            {p.key === 'ads' && (
              <div class="cx-a4"><span class="cx-a4__nd cx-a4__nd--w">Pub</span><i></i><span class="cx-a4__nd cx-a4__nd--p">?</span><i></i><span class="cx-a4__nd cx-a4__nd--g">✓</span></div>
            )}
          </AudienceCard>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. 02 · L'AUDIT -->
  <section class="hp-block hp-sec" id="audit" data-reveal-clip>
    <div class="container">
      <SectionHead over="02 · L'audit" intro="Votre clinique, vue par vos patients. Et on se déplace dans votre clinique.">En ligne, puis <span class="gradient-accent">en personne</span>.</SectionHead>

      <ol class="cx-fns">
        {audits.map((a) => (
          <li class:list={['cx-fn', { 'md-glass': !a.hot, 'cx-fn--hot': a.hot }]} data-reveal={a.reveal} data-reveal-step={a.step}>
            <div class="cx-fn__head">
              <span class="cx-fn__n" aria-hidden="true">{a.n}</span>
              <span class="cx-ic" aria-hidden="true" set:html={icon(a.ic)} />
              <h3><span class="visually-hidden">{a.n} </span>{a.title}</h3>
            </div>
            <p class="cx-fn__where">{a.where}</p>
            <dl>
              <dt>On regarde</dt><dd>{a.look}</dd>
              <dt>Objectif</dt><dd class="cx-fn__goal">{a.goal}</dd>
            </dl>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4. 03 · LES MOMENTS QUI COMPTENT : un moment après l'autre, toutes les 3,6 s (maquette) ;
       bouton Pause / Lecture ; un clic sur un moment l'affiche sans arrêter la rotation (sauf pause
       choisie) ; pause au focus clavier dans la section ; arrêt hors de l'écran ; mouvement réduit :
       aucune avancée automatique ; sans JavaScript : le 1er moment -->
  <section class="hp-block hp-sec" id="moments" data-reveal-clip>
    <div class="container">
      <SectionHead over="03 · Les moments qui comptent" intro="Huit moments, du premier clic à la recommandation. Un seul qui bloque, et le patient ne revient pas. Cliquez sur un moment.">Les irritants qu'on <span class="gradient-accent">traque</span>.</SectionHead>

      <div class="cx-mw" data-cx-mo data-reveal="up">
        <div class="cx-mw__bar">
          <button type="button" class="cx-play" data-cx-pause aria-pressed="false" aria-label="Mettre en pause l'animation" hidden>
            <svg class="cx-play__i-pause" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2"/><rect x="13.9" y="5" width="3.6" height="14" rx="1.2"/></svg>
            <svg class="cx-play__i-play" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.6v12.8a1 1 0 001.5.86l10.2-6.4a1 1 0 000-1.72L9.5 4.74A1 1 0 008 5.6z"/></svg>
          </button>
        </div>
        <ol class="cx-mos">
          {moments.map((m, i) => (
            <li class:list={['cx-mo', { 'is-act': i === 0 }]}>
              <button type="button" data-cx-moment={i} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`cx-pn-${i}`}><span class="cx-dot" aria-hidden="true">{i + 1}</span><b>{m.name}</b></button>
            </li>
          ))}
        </ol>
        <div class="cx-pns">
          {moments.map((m, i) => (
            <div class:list={['cx-pn', { 'is-act': i === 0 }]} id={`cx-pn-${i}`} aria-hidden={i === 0 ? undefined : 'true'}>
              <div class="cx-pa"><small>Ce que vit le patient</small><p>{m.lived}</p></div>
              <span class="cx-arr" aria-hidden="true" set:html={ARROW} />
              <div class="cx-pb"><small>Ce qu'on recommande</small><p>{m.reco}</p></div>
            </div>
          ))}
        </div>
      </div>

      <div class="md-svc-cta" data-reveal="up">
        <a class="cta" href={`${base}/contact/`}>Faire auditer votre parcours patient<CtaIcon /></a>
      </div>
    </div>
  </section>

  <!-- 5. 04 · LES LIVRABLES -->
  <section class="hp-block hp-sec" id="livrables" data-reveal-clip>
    <div class="container">
      <SectionHead over="04 · Les livrables" intro="Un constat clair, et un plan pour le corriger avec votre équipe.">Ce que vous <span class="gradient-accent">recevez</span>.</SectionHead>

      <div class="cx-bento">
        {deliverables.map((t) => (
          <ServiceTile kind={t.key} shape="sq" title={t.title} text={t.text} badge={t.badge} accent={t.accent} reveal={t.reveal} step={t.step}>
            <Fragment slot="icon"><Fragment set:html={icon(t.ic)} /></Fragment>
            <Fragment slot="illustration">
              <div class:list={['md-mui', `cx-mui--${t.key}`]} aria-hidden="true">
                {t.key === 'diag' && (
                  <div class="cx-dg">
                    <div class="cx-dg__h"><b>Diagnostic</b><span>Votre clinique</span></div>
                    {diagRows.map((r) => (
                      <div class:list={['cx-dg__row', `is-${r.state}`]}><span>{r.label}</span><i></i><em>{r.tag}</em></div>
                    ))}
                  </div>
                )}
                {t.key === 'map' && (
                  <div class="cx-map">
                    {mapSteps.map((s) => (
                      <div class:list={[`is-${s.state}`]}><i></i><span>{s.label}</span>{s.state === 'bad' && <em>Irritant</em>}</div>
                    ))}
                  </div>
