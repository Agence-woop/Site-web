      var(--hp-plum);
  }

  /* 1re visite, puis… : barres qui baissent */
  .cx-a1 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .cx-a1__bars {
    display: flex;
    align-items: flex-end;
    gap: 7px;
    height: 70px;
  }

  .cx-a1__bars i {
    display: block;
    width: 18px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--text-primary) 25%, transparent);
  }

  .cx-a1__bars i:first-child { background: var(--woop-gradient); }

  .cx-a1 small {
    font-size: 12px;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .cx-a1 sup { font-size: 0.7em; line-height: 0; }

  /* Avis à 3 étoiles (illustratif) */
  .cx-a2 {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 14px 18px;
    border-radius: 14px;
    background: var(--cx-paper);
    color: var(--bg-deep);
    text-align: center;
  }

  .cx-a2__stars {
    font-size: 16px;
    letter-spacing: 0.08em;
    color: var(--woop-orange);
  }

  .cx-a2__off { color: var(--cx-line); }

  .cx-a2 b { font-size: 13px; }

  /* 3 appels manqués */
  .cx-a3 {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    box-shadow: inset 0 0 0 1px rgba(230, 43, 127, 0.4);
  }

  .cx-a3 span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--hp-ink);
  }

  .cx-a3 span :global(svg) { width: 18px; height: 18px; }

  .cx-a3 b {
    font-size: 13px;
    color: var(--text-primary);
  }

  /* Pub → ? → ✓ */
  .cx-a4 {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .cx-a4__nd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    height: 44px;
    padding: 0 10px;
    border-radius: 14px;
    font-weight: 800;
  }

  .cx-a4__nd--w {
    background: var(--hp-light);
    color: var(--woop-orange);
  }

  .cx-a4__nd--p {
    background: var(--hp-light);
    color: var(--woop-pink);
  }

  .cx-a4__nd--g {
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
  }

  .cx-a4 i {
    width: 22px;
    height: 2px;
    background: var(--woop-gradient);
  }

  /* ===== 3. L'AUDIT ===== */
  .cx-fns {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    list-style: none;
  }

  @media (min-width: 1100px) {
    .cx-fns {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 22px;
    }
  }

  .cx-fn {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 28px 24px;
    border-radius: 26px;
  }

  @media (min-width: 1024px) {
    .cx-fn { padding: 30px; }
  }

  .cx-fn--hot {
    background: var(--woop-gradient);
    box-shadow: 0 24px 60px rgba(230, 43, 127, 0.28);
  }

  .cx-fn__head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .cx-fn__n {
    font-size: 13px;
    font-weight: 700;
    color: var(--md-pink-soft);
  }

  .cx-fn h3 {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 400;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .cx-fn__where {
    font-size: 16px;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .cx-fn dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 10px 16px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--hp-line);
  }

  .cx-fn dt {
    padding-top: 3px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cx-fn dd {
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-primary);
  }

  .cx-fn dd.cx-fn__goal { color: var(--md-pink-soft); }

  /* Tuile 03, sur le dégradé : intitulés (On regarde, Objectif) en blanc, textes en --bg-deep */
  .cx-fn--hot .cx-ic {
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: none;
  }

  .cx-fn--hot .cx-fn__n,
  .cx-fn--hot .cx-fn__where,
  .cx-fn--hot dd,
  .cx-fn--hot dd.cx-fn__goal { color: var(--hp-on-grad); }

  .cx-fn--hot dt { color: var(--text-primary); }

  .cx-fn--hot dl { border-top-color: color-mix(in srgb, var(--bg-deep) 22%, transparent); }

  /* ===== 4. LES MOMENTS QUI COMPTENT =====
     Ordinateur (dès 1180 px) : les 8 moments sur une ligne, reliés ; en dessous, 4 par ligne. */
  .cx-mw {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .cx-mw__bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: -10px;
  }

  /* Bouton Pause / Lecture (même style que la page Image de marque), toujours visible */
  .cx-play {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.3);
    cursor: pointer;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .cx-play[hidden] { display: none; }

  .cx-play:hover {
    transform: scale(1.06);
    box-shadow: 0 10px 28px rgba(230, 43, 127, 0.45);
  }

  .cx-play:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 3px;
  }

  .cx-play svg { width: 16px; height: 16px; }
  .cx-play__i-play { display: none; }
  .cx-mw.is-user-paused .cx-play__i-pause { display: none; }
  .cx-mw.is-user-paused .cx-play__i-play { display: block; margin-left: 2px; }

  .cx-mos {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 26px 4px;
    list-style: none;
  }

  @media (min-width: 600px) {
    .cx-mos { column-gap: 10px; }
  }

  @media (min-width: 1180px) {
    .cx-mos {
      grid-template-columns: repeat(8, minmax(0, 1fr));
    }

    /* Ligne qui relie les 8 moments */
    .cx-mos::before {
      content: '';
      position: absolute;
      left: calc(100% / 16);
      right: calc(100% / 16);
      top: 24px;
      height: 2px;
      background: var(--woop-gradient);
      opacity: 0.5;
    }
  }

  .cx-mo {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .cx-mo button {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 0;
    border: 0;
    border-radius: 14px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .cx-mo button:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 4px;
  }

  .cx-dot {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--bg-elevated);
    box-shadow: inset 0 0 0 2px rgba(230, 43, 127, 0.55), 0 0 0 6px var(--bg-deep);
    color: var(--md-pink-soft);
    font-weight: 800;
    transition: transform 0.35s, background 0.35s, box-shadow 0.35s, color 0.35s;
  }

  .cx-mo b {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text-secondary);
    transition: color 0.3s;
  }

  @media (max-width: 399px) {
    .cx-mo b { font-size: 11px; }
  }

  /* Très petits écrans (moins de 360 px) : libellés des moments et de la carte du parcours réduits */
  @media (max-width: 359px) {
    .cx-mo b { font-size: 10px; }

    .hp-block .cx-map span { font-size: 7.5px; }
  }

  @media (min-width: 600px) {
    .cx-mo b { font-size: 15px; }
  }

  .cx-mo.is-act b { color: var(--text-primary); }

  .cx-mo.is-act .cx-dot {
    transform: scale(1.12);
    background: var(--woop-gradient);
    box-shadow: 0 0 0 6px var(--bg-deep), 0 0 26px rgba(230, 43, 127, 0.6);
    color: var(--text-primary);
  }

  .cx-mo button:hover .cx-dot { box-shadow: inset 0 0 0 2px var(--woop-pink), 0 0 0 6px var(--bg-deep); }

  .cx-mo.is-act button:hover .cx-dot { box-shadow: 0 0 0 6px var(--bg-deep), 0 0 26px rgba(230, 43, 127, 0.6); }

  /* Panneaux : le moment actif ; les autres, superposés et invisibles (fondu de 0,45 s) */
  .cx-pns { position: relative; }

  .cx-pn {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 14px;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.45s, transform 0.45s;
    pointer-events: none;
  }

  .cx-pn.is-act {
    position: relative;
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }

  @media (min-width: 820px) {
    .cx-pn {
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      gap: 20px;
      align-items: stretch;
    }
  }

  .cx-pa,
  .cx-pb {
    padding: 22px 22px;
    border-radius: 24px;
  }

  @media (min-width: 768px) {
    .cx-pa,
    .cx-pb { padding: 24px 28px; }
  }

  .cx-pa {
    background: color-mix(in srgb, var(--text-primary) 3%, transparent);
    border: 1.5px dashed color-mix(in srgb, var(--text-primary) 18%, transparent);
  }

  .cx-pb {
    background: var(--woop-gradient);
    box-shadow: 0 24px 60px rgba(230, 43, 127, 0.28);
  }

  .cx-pa small,
  .cx-pb small {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .cx-pb small { color: var(--hp-on-grad); }

  .cx-pa p,
  .cx-pb p {
    margin-top: 8px;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.45;
  }

  @media (min-width: 768px) {
    .cx-pa p,
    .cx-pb p { font-size: 18px; }
  }

  .cx-pa p { color: var(--text-secondary); }
  .cx-pb p { color: var(--text-primary); }

  .cx-arr {
    display: inline-flex;
    align-self: center;
    justify-self: center;
    color: var(--md-pink-soft);
    rotate: 90deg;
  }

  .cx-arr :global(svg) { width: 26px; height: 26px; }

  @media (min-width: 820px) {
    .cx-arr { rotate: none; }
  }

  /* ===== 5. LES LIVRABLES =====
     Ordinateur (dès 1100 px), 4 colonnes : diagnostic (dégradé) et carte du parcours en haut ;
     plan d'action, équipe d'accueil et indicateurs en bas. Tablette : 2 colonnes. Téléphone : 1. */
  .cx-bento {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  @media (min-width: 600px) {
    .cx-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cx-bento :global(.md-sv--diag),
    .cx-bento :global(.md-sv--map),
    .cx-bento :global(.md-sv--kpi) { grid-column: span 2; }
  }

  @media (min-width: 1100px) {
    .cx-bento {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 22px;
    }
    .cx-bento :global(.md-sv--diag) { grid-column: 1 / span 2; grid-row: 1; }
    .cx-bento :global(.md-sv--map) { grid-column: 3 / span 2; grid-row: 1; }
    .cx-bento :global(.md-sv--plan) { grid-column: 1; grid-row: 2; }
    .cx-bento :global(.md-sv--team) { grid-column: 2; grid-row: 2; }
    .cx-bento :global(.md-sv--kpi) { grid-column: 3 / span 2; grid-row: 2; }
  }

  /* Titres des tuiles : toujours dans leur tuile (même réglage que la page Création de sites web :
     taille selon la largeur de la tuile, 21 px au plus ; « L'équipe d'accueil » et « Un plan
     d'action par priorité » passent à la ligne entre les mots) */
  .cx-bento :global(.md-sv--sq) { container-type: inline-size; }

  .cx-bento :global(.md-sv--sq h3) { font-size: min(21px, calc((100cqi - 68px) / 5.6)); }

  /* Mini-illustrations des tuiles : boîte commune */
  .md-mui {
    display: flex;
    flex: none;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    margin-top: auto;
    padding: 14px;
    border-radius: 16px;
    background: color-mix(in srgb, var(--text-primary) 4%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text-primary) 7%, transparent);
  }

  /* Diagnostic (sur le dégradé) : fiche blanche, état de chaque point aux couleurs de la charte */
  .cx-mui--diag {
    padding: 0;
    background: none;
    box-shadow: none;
  }

  .cx-dg {
    display: flex;
    flex-direction: column;
    gap: 9px;
    padding: 16px;
    border-radius: 20px;
    background: var(--cx-paper);
    color: var(--bg-deep);
    box-shadow: 0 18px 40px color-mix(in srgb, var(--bg-deep) 20%, transparent);
  }

  .cx-dg__h {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 2px;
  }

  .cx-dg__h b {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    color: var(--md-pink-deep);
  }

  .cx-dg__h span {
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
  }

  .cx-dg__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 46px auto;
    align-items: center;
    gap: 10px;
    padding: 9px 12px;
    border-radius: 12px;
    background: var(--cx-tint);
    font-size: 13px;
    font-weight: 700;
  }

  @media (min-width: 400px) {
    .cx-dg__row { grid-template-columns: minmax(0, 1fr) 60px auto; }
  }

  .cx-dg__row i {
    height: 6px;
    border-radius: 3px;
  }

  .cx-dg__row em {
    padding: 4px 8px;
    border-radius: 999px;
    font-style: normal;
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .cx-dg__row.is-ok i { background: var(--text-muted); }
  .cx-dg__row.is-ok em { background: var(--cx-tint-2); color: var(--text-muted); }
  .cx-dg__row.is-mid i { background: var(--woop-orange); }
  .cx-dg__row.is-mid em { background: color-mix(in srgb, var(--woop-orange) 16%, var(--text-primary)); color: color-mix(in srgb, var(--woop-orange) 70%, var(--bg-deep)); }
  .cx-dg__row.is-hi i { background: var(--woop-gradient); }
  .cx-dg__row.is-hi em { background: var(--woop-gradient); color: var(--text-primary); }

  /* Carte du parcours : 6 étapes reliées, irritants en dégradé (le soin reste neutre) */
  .cx-map {
    display: flex;
    align-items: flex-start;
    padding-top: 6px;
  }

  .cx-map > div {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: center;
    gap: 7px;
    min-width: 0;
    text-align: center;
  }

  .cx-map > div::before {
    content: '';
    position: absolute;
    top: 10px;
    left: -50%;
    width: 100%;
    height: 2px;
    background: color-mix(in srgb, var(--text-primary) 18%, transparent);
  }

  .cx-map > div:first-child::before { display: none; }

  .cx-map i {
    position: relative;
    z-index: 1;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--hp-light);
  }

  .cx-map .is-bad i {
    background: var(--woop-gradient);
    box-shadow: 0 0 0 5px rgba(230, 43, 127, 0.22);
  }

  .cx-map .is-neutral i {
    background: var(--bg-elevated);
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--text-primary) 35%, transparent);
  }

  .cx-map span {
    font-size: 11px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-secondary);
  }

  .cx-map em {
    padding: 3px 7px;
    border-radius: 999px;
    background: rgba(230, 43, 127, 0.18);
    color: var(--md-pink-soft);
    font-style: normal;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Téléphone : libellés plus petits, pour que les 6 étapes ne se chevauchent pas */
  @media (max-width: 599px) {
    .cx-mui--map { padding: 12px 6px; }

    .cx-map span { font-size: 8.5px; }

    .cx-map em { font-size: 7.5px; padding: 3px 4px; letter-spacing: 0.02em; }
  }

  /* Plan d'action : 2 priorités */
  .cx-pl {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cx-pl span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--text-primary) 6%, transparent);
    font-size: 12px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .cx-pl b {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    font-size: 10px;
  }

  /* Équipe d'accueil : 3 personnes, l'une en dégradé */
  .cx-mui--team { align-items: flex-start; }

  .cx-team { display: flex; }

  .cx-team span {
    width: 40px;
    height: 40px;
    margin-left: -10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--text-primary) 20%, var(--bg-elevated));
    box-shadow: 0 0 0 3px var(--bg-elevated);
  }

  .cx-team span:first-child { margin-left: 0; }
  .cx-team span.is-on { background: var(--woop-gradient); }

  /* Indicateurs à suivre : 4 étiquettes */
  .cx-kpi {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .cx-kpi span {
    padding: 8px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text-primary) 8%, transparent);
    color: var(--text-primary);
    font-size: 12px;
    font-weight: 700;
  }

  .cx-kpi span.is-ok {
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
  }

  /* ===== 6. LE RAPPORT : texte à gauche, le rapport à droite (dès 980 px) ===== */
  .cx-rp {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
    padding: 34px 22px;
    border-radius: 34px;
    overflow: hidden;
  }

  @media (min-width: 768px) {
    .cx-rp { padding: 44px 40px; }
  }

  @media (min-width: 980px) {
    .cx-rp {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 60px;
      padding: 56px;
    }
  }

  .cx-rp__txt {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .cx-rp__txt :global(.cx-rp__head) {
    display: flex;
    flex-direction: column;
    gap: var(--home-head-gap);
    margin-bottom: 18px;
  }

  .cx-rp__txt :global(.cx-rp__head .hp-title) { margin-bottom: 0; }

  .cx-rp__txt > p {
    font-size: 17px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .cx-toc {
    display: flex;
    flex-direction: column;
    align-self: stretch;
    margin: 22px 0 30px;
    list-style: none;
  }

  .cx-toc li {
    display: flex;
    align-items: baseline;
    gap: 16px;
    padding: 13px 0;
    border-bottom: 1px solid var(--hp-line);
    font-weight: 700;
    color: var(--text-primary);
  }

  .cx-toc b {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--md-pink-soft);
  }

  /* Le rapport : 3 pages superposées, la première lisible */
  .cx-docs {
    position: relative;
    height: 450px;
