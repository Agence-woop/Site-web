<script>
  // Conditions communes aux deux animations : à l'écran (part visible), bloc apparu (ScrollReveal),
  // onglet affiché. prefers-reduced-motion : aucune animation, état final.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const revealedOf = (el: HTMLElement) => {
    const box = el.closest<HTMLElement>('[data-reveal]') ?? (el.hasAttribute('data-reveal') ? el : null);
    return () => !document.documentElement.classList.contains('reveal-js') || !box || box.classList.contains('is-revealed');
  };

  // ===== HERO : le parcours de Sophie (maquette, mêmes durées) =====
  // À chaque étape : la carte s'allume, Sophie et la pastille la rejoignent (0,8 s), « Irritant
  // repéré » (1,7 s), puis « Corrigé » (1,9 s), puis l'étape suivante ; les pointillés défilent
  // (1,6 s par motif). Aucune pause au survol ni bouton. Arrêt hors de l'écran, reprise au retour.
  // Mouvement réduit : 3e étape allumée, « Corrigé », immobile. Téléphone (moins de 600 px) : les
  // 3 cartes l'une sous l'autre, la pastille sous les cartes (pas de déplacement).
  (function () {
    const hv = document.querySelector<HTMLElement>('[data-cx-hero]');
    if (!hv) return;
    const cards = Array.from(hv.querySelectorAll<HTMLElement>('[data-cx-step]'));
    const pat = hv.querySelector<HTMLElement>('[data-cx-pat]')!;
    const chip = hv.querySelector<HTMLElement>('[data-cx-chip]')!;
    const ci = chip.querySelector<HTMLElement>('[data-cx-ci]')!;
    const T = chip.querySelector<HTMLElement>('[data-cx-t]')!;
    const S = chip.querySelector<HTMLElement>('[data-cx-s]')!;
    const phone = window.matchMedia('(max-width: 599px)');
    let k = reduced ? cards.length - 1 : 0;
    let phase = reduced ? 1 : 0;

    // Place Sophie au-dessus de la carte active et la pastille en bas à droite (maquette)
    const place = () => {
      if (phone.matches) {
        [pat, chip].forEach((el) => { el.style.left = ''; el.style.top = ''; });
        return;
      }
      const c = cards[k];
      pat.style.left = `${c.offsetLeft - 20}px`;
      pat.style.top = `${c.offsetTop - 44}px`;
      chip.style.left = `${c.offsetLeft + c.offsetWidth - 150}px`;
      chip.style.top = `${c.offsetTop + c.offsetHeight - 6}px`;
    };
    const show = () => {
      cards.forEach((c, i) => c.classList.toggle('is-on', i === k));
      const fixed = phase === 1;
      chip.classList.toggle('is-fix', fixed);
      ci.textContent = fixed ? '✓' : '!';
      T.textContent = fixed ? 'Corrigé' : 'Irritant repéré';
      S.textContent = (fixed ? cards[k].dataset.fix : cards[k].dataset.irritant) || '';
      place();
    };
    show();
    hv.classList.add('is-placed');
    if ('ResizeObserver' in window) new ResizeObserver(place).observe(hv);
    else window.addEventListener('resize', place);
    if (reduced || !('IntersectionObserver' in window)) return;

    // Étape suivante : « Irritant repéré » 1,7 s, puis « Corrigé » 1,9 s
    phase = 0;
    show();
    hv.classList.add('is-anim');
    const revealed = revealedOf(hv);
    const state = { visible: false, hidden: document.hidden };
    let timer = 0;
    const tick = () => {
      timer = 0;
      if (phase === 0) phase = 1;
      else { phase = 0; k = (k + 1) % cards.length; }
      show();
      schedule();
    };
    const running = () => state.visible && !state.hidden && revealed();
    function schedule() {
      if (!running() || timer) return;
      timer = window.setTimeout(tick, phase === 0 ? 1700 : 1900);
    }
    const update = () => {
      hv.classList.toggle('is-playing', running());
      if (running()) schedule();
      else if (timer) { window.clearTimeout(timer); timer = 0; }
    };
    new IntersectionObserver((entries) => entries.forEach((e) => { state.visible = e.isIntersecting; update(); }), { threshold: 0.25 }).observe(hv);
    document.addEventListener('visibilitychange', () => { state.hidden = document.hidden; update(); });
  })();

  // ===== 03 · LES MOMENTS QUI COMPTENT =====
  // Un moment toutes les 3,6 s (maquette). Démarrage quand le bloc est visible à 35 % et apparu.
  // - Aucune pause au survol (comme la page Image de marque).
  // - Bouton Pause / Lecture : la pause choisie reste active jusqu'à un nouvel appui.
  // - Clic sur un moment : il s'affiche ; si la rotation tourne, le minuteur repart (3,6 s) et la
  //   rotation continue ; en pause, la pause est maintenue.
  // - Pause au focus clavier dans la section (pas sur le bouton Pause / Lecture, ni pour un focus posé
  //   par un clic) ; arrêt hors de l'écran ou onglet masqué, reprise au retour.
  // - prefers-reduced-motion : aucune avancée automatique (bouton en position Lecture).
  // - Sans JavaScript : le 1er moment, bouton caché.
  (function () {
    const zone = document.querySelector<HTMLElement>('#moments');
    const mw = document.querySelector<HTMLElement>('[data-cx-mo]');
    const pauseBtn = mw?.querySelector<HTMLButtonElement>('[data-cx-pause]');
    if (!zone || !mw || !pauseBtn) return;
    const btns = Array.from(mw.querySelectorAll<HTMLButtonElement>('[data-cx-moment]'));
    const items = btns.map((b) => b.closest('li')!);
    const panels = Array.from(mw.querySelectorAll<HTMLElement>('.cx-pn'));
    const DUR = 3600;
    let cur = 0;

    const go = (n: number) => {
      cur = n;
      items.forEach((li, i) => li.classList.toggle('is-act', i === n));
      btns.forEach((b, i) => b.setAttribute('aria-pressed', String(i === n)));
      panels.forEach((p, i) => {
        p.classList.toggle('is-act', i === n);
        if (i === n) p.removeAttribute('aria-hidden');
        else p.setAttribute('aria-hidden', 'true');
      });
      mw.dataset.cxCurrent = String(n);
    };

    const revealed = revealedOf(mw);
    const reasons = { offscreen: true, unrevealed: !revealed(), focus: false, hidden: document.hidden, user: reduced };
    let remaining = DUR;
    let startedAt = 0;
    let timer = 0;
    const running = () => !Object.values(reasons).some(Boolean);
    const update = () => {
      mw.classList.toggle('is-paused', !running());
      if (running() && !timer) {
        startedAt = performance.now();
        timer = window.setTimeout(tick, remaining);
      } else if (!running() && timer) {
        window.clearTimeout(timer);
        timer = 0;
        remaining = Math.max(0, remaining - (performance.now() - startedAt));
      }
    };
    function tick() {
      timer = 0;
      remaining = DUR;
      go((cur + 1) % btns.length);
      update();
    }

    const setUser = (on: boolean) => {
      reasons.user = on;
      mw.classList.toggle('is-user-paused', on);
      pauseBtn.setAttribute('aria-pressed', String(on));
      pauseBtn.setAttribute('aria-label', on ? "Reprendre l'animation" : "Mettre en pause l'animation");
      update();
    };
    pauseBtn.hidden = false;
    pauseBtn.addEventListener('click', () => setUser(!reasons.user));

    btns.forEach((b, i) => b.addEventListener('click', () => {
      go(i);
      window.clearTimeout(timer);
      timer = 0;
      remaining = DUR;
      update();
    }));

    const keyboardFocus = (el: Element) => {
      try { return el.matches(':focus-visible'); } catch { return true; }
    };
    zone.addEventListener('focusin', (e) => {
      reasons.focus = e.target instanceof Element && e.target !== pauseBtn && keyboardFocus(e.target);
      update();
    });
    zone.addEventListener('focusout', (e) => {
      if (e.relatedTarget instanceof Node && zone.contains(e.relatedTarget)) return;
      reasons.focus = false;
      update();
    });

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => entries.forEach((entry) => { reasons.offscreen = !entry.isIntersecting; update(); }), { threshold: 0.35 }).observe(mw);
    } else {
      reasons.offscreen = false;
    }
    if (reasons.unrevealed) {
      const mo = new MutationObserver(() => {
        reasons.unrevealed = !revealed();
        if (!reasons.unrevealed) { mo.disconnect(); update(); }
      });
      mo.observe(mw, { attributes: true, attributeFilter: ['class'] });
    }
    document.addEventListener('visibilitychange', () => { reasons.hidden = document.hidden; update(); });
    setUser(reasons.user);
  })();
</script>

