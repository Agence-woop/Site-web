---
import '../styles/global.css';
import AuroraBackground from '../components/AuroraBackground.astro';
import CursorAurora from '../components/CursorAurora.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleAuthor?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  ogImage,
  ogType = 'website',
  articlePublishedTime,
  articleAuthor,
  jsonLd,
} = Astro.props;

// Canonical domain — used for og:url and og:image absolute URLs across all pages.
const SITE_CANONICAL_BASE = 'https://agence-woop.ca';
const OG_IMAGE_ALT = 'WOOP, agence marketing santé et recrutement à Montréal';

// Strip any Astro base path from the URL pathname so canonical URLs reflect the domain root.
const baseUrl = import.meta.env.BASE_URL;
const normalizedBase = baseUrl.endsWith('/') ? baseUrl.slice(0, -1) : baseUrl;
const stripBase = (path: string): string => {
  if (normalizedBase && path.startsWith(normalizedBase)) {
    const stripped = path.slice(normalizedBase.length);
    return stripped || '/';
  }
  return path || '/';
};

const canonicalUrl = `${SITE_CANONICAL_BASE}${stripBase(Astro.url.pathname)}`;
const ogImageUrl = ogImage ? `${SITE_CANONICAL_BASE}${stripBase(ogImage)}` : undefined;
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <!-- Google Consent Mode v2 : refus par défaut, à placer avant CookieYes et avant gtag -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag("consent", "default", {
      ad_storage: "denied",
      ad_user_data: "denied",
      ad_personalization: "denied",
      analytics_storage: "denied",
      functionality_storage: "denied",
      personalization_storage: "denied",
      security_storage: "granted",
      wait_for_update: 2000
    });
    gtag("set", "ads_data_redaction", true);
    gtag("set", "url_passthrough", true);
  </script>
  <!-- Start cookieyes banner -->
  <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/27ced4974c9e6000d869b57d/script.js" is:inline></script>
  <!-- End cookieyes banner -->
  <!-- Google tag (gtag.js) : GA4 + Google Ads -->
  <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-3ZL6X395CS"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){ dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', 'G-3ZL6X395CS');
    gtag('config', 'AW-18125380928');
  </script>
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href={canonicalUrl} />

  <link rel="icon" type="image/png" href="/favicon-96x96.png?v=1" sizes="96x96" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=1" />
  <link rel="shortcut icon" href="/favicon.ico?v=1" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=1" />
  <meta name="apple-mobile-web-app-title" content="WOOP" />
  <link rel="manifest" href="/site.webmanifest?v=1" />

  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="fr_CA" />
  <meta property="og:site_name" content="Agence WOOP" />
  {ogType === 'article' && articlePublishedTime && (
    <meta property="article:published_time" content={articlePublishedTime} />
  )}
  {ogType === 'article' && articleAuthor && (
    <meta property="article:author" content={articleAuthor} />
  )}
  {ogImageUrl && (
    <>
      <meta property="og:image" content={ogImageUrl} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:type" content="image/jpeg" />
      <meta property="og:image:alt" content={OG_IMAGE_ALT} />
    </>
  )}

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  {ogImageUrl && (
    <>
      <meta name="twitter:image" content={ogImageUrl} />
      <meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
    </>
  )}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  {jsonLd && jsonLd.map((obj) => (
    <script type="application/ld+json" set:html={JSON.stringify(obj)} />
  ))}
</head>
<body>
  <AuroraBackground />
  <CursorAurora />
  <Header />
  <main class="main" id="main">
    <slot />
  </main>
  <Footer />
</body>
</html>

<style>
  .main {
    position: relative;
    z-index: 1;
    padding-top: 80px;
  }
</style>
