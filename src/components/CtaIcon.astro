---
// Icône flèche des boutons .cta (styles globaux : .cta__ico dans global.css).
// Le composant n'a pas de style propre : il repose l'attribut de portée de la page (ou du
// composant) qui l'utilise, pour un HTML identique à celui écrit auparavant dans les pages.
import { parentScope } from '../utils/scope';

interface Props {
  /** up-right : flèche en diagonale (prise de contact, téléphone) ; right : flèche vers la droite (lien vers une page) */
  dir?: 'up-right' | 'right';
  [key: string]: unknown;
}

const { dir = 'up-right', ...rest } = Astro.props;
const scope = parentScope(rest);
const PATHS = {
  'up-right': 'M5 11l6-6M6 5h5v5',
  right: 'M3 8h10M9 4l4 4-4 4',
};
---
<span class="cta__ico" aria-hidden="true" {...scope}><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" {...scope}><path d={PATHS[dir]} {...scope} /></svg></span>
