---
// Pool size for trail particles. To tune, change this number AND ensure
// throttle × pool_size ≥ duration (currently 40ms × 25 = 1000ms = fade duration).
const POOL_SIZE = 25;
---
<div class="cursor-aurora" aria-hidden="true">
  {Array.from({ length: POOL_SIZE }).map(() => (
    <div class="cursor-aurora__particle"></div>
  ))}
</div>

<style>
  .cursor-aurora {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .cursor-aurora__particle {
    position: absolute;
    top: 0;
    left: 0;
    width: var(--cursor-trail-particle-size, 100px);
    height: var(--cursor-trail-particle-size, 100px);
    border-radius: 50%;
    background: radial-gradient(
      circle,
      #FA6244 0%,
      #E62B7F 50%,
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
    will-change: transform, opacity;
    transform: translate3d(var(--p-x, -9999px), var(--p-y, -9999px), 0) translate(-50%, -50%) scale(1);
  }

  @keyframes cursor-particle-fade {
    0% {
      opacity: var(--cursor-trail-opacity, 0.18);
      transform: translate3d(var(--p-x, 0px), var(--p-y, 0px), 0) translate(-50%, -50%) scale(1);
    }
    100% {
      opacity: 0;
      transform: translate3d(var(--p-x, 0px), var(--p-y, 0px), 0) translate(-50%, -50%) scale(0.6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-aurora {
      display: none;
    }
  }
</style>

<script>
  const container = document.querySelector<HTMLDivElement>('.cursor-aurora');
  if (container) {
    const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const isDesktop = window.matchMedia('(min-width: 1024px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (supportsHover.matches && isDesktop.matches && !reducedMotion.matches) {
      const particles = Array.from(
        container.querySelectorAll<HTMLDivElement>('.cursor-aurora__particle')
      );
      const POOL_SIZE = particles.length;
      const THROTTLE_MS = 40;
      let poolIndex = 0;
      let lastBirth = 0;

      const birthParticle = (x: number, y: number) => {
        const p = particles[poolIndex];
        poolIndex = (poolIndex + 1) % POOL_SIZE;
        p.style.setProperty('--p-x', x + 'px');
        p.style.setProperty('--p-y', y + 'px');
        p.style.animation = 'none';
        // Force reflow to restart the animation
        void p.offsetWidth;
        p.style.animation = 'cursor-particle-fade var(--cursor-trail-duration, 1000ms) linear forwards';
      };

      const onMove = (e: MouseEvent) => {
        const now = performance.now();
        if (now - lastBirth < THROTTLE_MS) return;
        lastBirth = now;
        birthParticle(e.clientX, e.clientY);
      };

      window.addEventListener('mousemove', onMove, { passive: true });

      window.addEventListener('beforeunload', () => {
        window.removeEventListener('mousemove', onMove);
      });
    }
  }
</script>
