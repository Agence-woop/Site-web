---
---
<canvas class="cursor-aurora" aria-hidden="true"></canvas>

<style>
  .cursor-aurora {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-aurora {
      display: none;
    }
  }
</style>

<script>
  // ===== Tuning constants (modify here for post-merge adjustments) =====
  const BRUSH_RADIUS = 90;        // brush size in CSS px
  const BRUSH_OPACITY = 0.35;     // alpha of each brush stroke
  const FADE_AMOUNT = 0.09;       // alpha of fade per frame (higher = shorter trail)
  const COLOR_INNER = '#FA6244';  // WOOP orange (brush center)
  const COLOR_OUTER = '#E62B7F';  // WOOP rose (brush mid)
  const COMPOSITE: GlobalCompositeOperation = 'lighter';
  const TRAIL_IDLE_MS = 600;      // stop drawing brush after this much idle time
  // =====================================================================

  const canvas = document.querySelector<HTMLCanvasElement>('.cursor-aurora');
  if (canvas) {
    const supportsHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    const isDesktop = window.matchMedia('(min-width: 1024px)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    if (supportsHover.matches && isDesktop.matches && !reducedMotion.matches) {
      const ctx = canvas.getContext('2d');
      if (ctx) {
        let mouseX = -9999;
        let mouseY = -9999;
        let lastMoveTime = 0;
        let raf = 0;

        const setupCanvas = () => {
          const dpr = window.devicePixelRatio || 1;
          canvas.width = Math.floor(window.innerWidth * dpr);
          canvas.height = Math.floor(window.innerHeight * dpr);
          // Reset + scale in one operation, CSS pixel coordinate system from now on
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        };

        const draw = () => {
          const w = window.innerWidth;
          const h = window.innerHeight;

          // Fade: destination-out + any color × FADE_AMOUNT alpha removes
          // that fraction of existing pixels. Keeps canvas transparent at rest.
          ctx.globalCompositeOperation = 'destination-out';
          ctx.globalAlpha = 1;
          ctx.fillStyle = `rgba(0,0,0,${FADE_AMOUNT})`;
          ctx.fillRect(0, 0, w, h);

          // Brush: only when mouse moved recently
          const now = performance.now();
          if (now - lastMoveTime < TRAIL_IDLE_MS) {
            ctx.globalCompositeOperation = COMPOSITE;
            ctx.globalAlpha = BRUSH_OPACITY;

            const gradient = ctx.createRadialGradient(
              mouseX, mouseY, 0,
              mouseX, mouseY, BRUSH_RADIUS
            );
            gradient.addColorStop(0, COLOR_INNER);
            gradient.addColorStop(0.5, COLOR_OUTER);
            gradient.addColorStop(1, 'rgba(230, 43, 127, 0)');

            ctx.fillStyle = gradient;
            ctx.beginPath();
            ctx.arc(mouseX, mouseY, BRUSH_RADIUS, 0, Math.PI * 2);
            ctx.fill();
          }

          raf = requestAnimationFrame(draw);
        };

        const onMove = (e: MouseEvent) => {
          mouseX = e.clientX;
          mouseY = e.clientY;
          lastMoveTime = performance.now();
        };

        const onResize = () => {
          setupCanvas();
        };

        const onVisibility = () => {
          if (document.hidden) {
            if (raf) {
              cancelAnimationFrame(raf);
              raf = 0;
            }
          } else if (raf === 0) {
            raf = requestAnimationFrame(draw);
          }
        };

        setupCanvas();
        window.addEventListener('mousemove', onMove, { passive: true });
        window.addEventListener('resize', onResize, { passive: true });
        document.addEventListener('visibilitychange', onVisibility);
        raf = requestAnimationFrame(draw);
      }
    }
  }
</script>
