---
---
<div class="aurora" aria-hidden="true">
  <div class="aurora__orb aurora__orb--pink"></div>
  <div class="aurora__orb aurora__orb--orange"></div>
  <div class="aurora__orb aurora__orb--pink-2"></div>
  <div class="aurora__orb aurora__orb--orange-2"></div>
  <div class="aurora__orb aurora__orb--pink-3"></div>
  <div class="aurora__orb aurora__orb--orange-3"></div>
</div>

<style>
  .aurora {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .aurora__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    will-change: transform;
  }

  .aurora__orb--pink {
    width: 700px;
    height: 500px;
    background: rgba(230, 43, 127, 0.22);
    top: -8%;
    right: -5%;
    animation: aurora-drift-1 30s ease-in-out infinite alternate;
  }

  .aurora__orb--orange {
    width: 650px;
    height: 450px;
    background: rgba(250, 98, 68, 0.18);
    bottom: 5%;
    left: -10%;
    animation: aurora-drift-2 35s ease-in-out infinite alternate;
  }

  .aurora__orb--pink-2 {
    width: 550px;
    height: 400px;
    background: rgba(230, 43, 127, 0.15);
    top: 45%;
    left: 25%;
    animation: aurora-drift-3 28s ease-in-out infinite alternate;
  }

  .aurora__orb--orange-2 {
    width: 500px;
    height: 350px;
    background: rgba(250, 98, 68, 0.14);
    top: 15%;
    right: 15%;
    animation: aurora-drift-4 32s ease-in-out infinite alternate;
  }

  .aurora__orb--pink-3 {
    width: 400px;
    height: 300px;
    background: rgba(230, 43, 127, 0.12);
    bottom: 30%;
    right: 5%;
    animation: aurora-drift-5 26s ease-in-out infinite alternate;
  }

  .aurora__orb--orange-3 {
    width: 450px;
    height: 350px;
    background: rgba(250, 98, 68, 0.10);
    top: 70%;
    left: 5%;
    animation: aurora-drift-6 33s ease-in-out infinite alternate;
  }

  @keyframes aurora-drift-1 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-80px, 50px) scale(1.15); }
    100% { transform: translate(40px, -40px) scale(0.95); }
  }

  @keyframes aurora-drift-2 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(70px, -40px) scale(1.1); }
    100% { transform: translate(-50px, 30px) scale(1.15); }
  }

  @keyframes aurora-drift-3 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(50px, 60px) scale(1.12); }
    100% { transform: translate(-40px, -30px) scale(0.92); }
  }

  @keyframes aurora-drift-4 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-60px, 40px) scale(1.18); }
    100% { transform: translate(30px, -50px) scale(0.98); }
  }

  @keyframes aurora-drift-5 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(40px, -30px) scale(1.1); }
    100% { transform: translate(-30px, 50px) scale(1.05); }
  }

  @keyframes aurora-drift-6 {
    0% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(-50px, -40px) scale(1.08); }
    100% { transform: translate(60px, 20px) scale(0.95); }
  }

  @media (max-width: 899px) {
    .aurora__orb {
      filter: blur(50px);
      animation: none;
      will-change: auto;
    }

    .aurora__orb--pink-2,
    .aurora__orb--orange-2,
    .aurora__orb--pink-3,
    .aurora__orb--orange-3 {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora__orb {
      animation: none;
    }
  }
</style>
