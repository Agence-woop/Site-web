---
import { liveServices } from '../data/services';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Rubrique « Services » : les pages Services en ligne, dans l'ordre du menu de l'en-tête
const services = liveServices();
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src={`${base}/images/logo-woop.png`} alt="WOOP" class="footer__logo-img" width="150" height="36" />
        <p class="footer__desc">
          L'agence d'acquisition et d'identit&eacute; de marque d&eacute;di&eacute;e &agrave; la sant&eacute;, au bien-&ecirc;tre et au recrutement sp&eacute;cialis&eacute; au Qu&eacute;bec.
        </p>
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Pages</h5>
        <a href={`${base}/`} class="footer__link">Accueil</a>
        <a href={`${base}/acquisition-client/`} class="footer__link">Test de visibilit&eacute;</a>
        <a href={`${base}/equipe/`} class="footer__link">&Eacute;quipe</a>
        <a href={`${base}/blog/`} class="footer__link">Blog</a>
        <a href={`${base}/contact/`} class="footer__link">Contact</a>
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Secteurs d'activit&eacute;</h5>
        <a href={`${base}/services-medical/`} class="footer__link">Sant&eacute; & M&eacute;dical</a>
        <a href={`${base}/services-recrutement/`} class="footer__link">RH & Recrutement</a>
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Services</h5>
        {services.map((s) => (
          <a href={`${base}${s.href}`} class="footer__link">{s.label}</a>
        ))}
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Contact</h5>
        <a href="mailto:contact@agence-woop.ca" class="footer__link">contact@agence-woop.ca</a>
        <a href="tel:+14388152295" class="footer__link">(438) 815-2295</a>
        <span class="footer__link">Montr&eacute;al, Qu&eacute;bec</span>
        <div class="footer__socials">
          <a href="https://www.linkedin.com/company/agence-woop/" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="WOOP sur LinkedIn">
            <span class="footer__social-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
            </span>
          </a>
          <a href="https://www.facebook.com/agencewoop" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="WOOP sur Facebook">
            <span class="footer__social-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M13.6 22v-8.4h2.8l.45-3.3H13.6V8.2c0-.95.27-1.6 1.63-1.6h1.74V3.65a23 23 0 0 0-2.54-.13c-2.51 0-4.23 1.53-4.23 4.35v2.43H7.37v3.3h2.83V22z"/>
              </svg>
            </span>
          </a>
          <a href="https://www.instagram.com/agencewoop/" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="WOOP sur Instagram">
            <span class="footer__social-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor" />
              </svg>
            </span>
          </a>
        </div>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; 2026 Agence WOOP &middot; <a href={`${base}/confidentialite-et-conditions/`} class="footer__bottom-link">Politique de confidentialit&eacute;</a> &middot; <a href="#" class="footer__bottom-link cky-banner-element">G&eacute;rer les t&eacute;moins</a></span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 64px 0 32px;
    border-top: 1px solid var(--border-subtle);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  /* Tablette : présentation sur toute la largeur, puis les 4 rubriques côte à côte */
  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 32px;
    }

    .footer__brand { grid-column: 1 / -1; }
  }

  /* Ordinateur : présentation et 4 rubriques sur une ligne */
  @media (min-width: 1200px) {
    .footer__grid { grid-template-columns: 1.6fr repeat(4, minmax(0, 1fr)); }

    .footer__brand { grid-column: auto; }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__logo-img {
    height: 36px;
    width: auto;
    max-width: 150px;
    display: block;
  }

  .footer__desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 320px;
  }

  .footer__heading {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--woop-pink);
    font-weight: 700;
    margin-bottom: 16px;
  }

  .footer__link {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-secondary);
    display: block;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer__link:hover {
    color: var(--text-primary);
  }

  .footer__link--disabled {
    opacity: 0.5;
    cursor: default;
  }

  .footer__link--disabled:hover {
    color: var(--text-secondary);
  }

  .footer__socials {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 12px;
  }

  .footer__social {
    display: inline-flex;
    border-radius: 50%;
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease;
  }

  .footer__social:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(230, 43, 127, 0.35);
  }

  .footer__social:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__social { transition: none; }
    .footer__social:hover { transform: none; }
  }

  .footer__social-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--woop-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .footer__bottom-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer__bottom-link:hover {
    color: var(--text-primary);
  }
</style>
