---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <img src={`${base}/images/logo-woop.png`} alt="WOOP" class="footer__logo-img" width="150" height="36" />
        <p class="footer__desc">
          L'agence d'acquisition et d'identit&eacute; de marque d&eacute;di&eacute;e &agrave; la sant&eacute;, au bien-&ecirc;tre et au recrutement sp&eacute;cialis&eacute; au Qu&eacute;bec.
        </p>
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Pages</h5>
        <a href={`${base}/`} class="footer__link">Accueil</a>
        <a href={`${base}/services-medical`} class="footer__link">Sant&eacute; & M&eacute;dical</a>
        <a href={`${base}/services-recrutement`} class="footer__link">RH & Recrutement</a>
        <a href={`${base}/equipe`} class="footer__link">&Eacute;quipe</a>
        <a href={`${base}/blog`} class="footer__link">Blog</a>
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Services</h5>
        <a href={`${base}/services-medical`} class="footer__link">M&eacute;dical & bien-&ecirc;tre</a>
        <a href={`${base}/services-recrutement`} class="footer__link">Recrutement</a>
      </div>
      <div class="footer__col">
        <h5 class="footer__heading">Contact</h5>
        <a href="mailto:contact@agence-woop.ca" class="footer__link">contact@agence-woop.ca</a>
        <a href="tel:+14388152295" class="footer__link">(438) 815-2295</a>
        <span class="footer__link">Montr&eacute;al, Qu&eacute;bec</span>
        <a href="https://www.linkedin.com/company/agence-woop/" target="_blank" rel="noopener noreferrer" class="footer__social" aria-label="LinkedIn de l'Agence WOOP">
          <span class="footer__social-icon">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </span>
          LinkedIn
        </a>
      </div>
    </div>
    <div class="footer__bottom">
      <span>&copy; 2026 Agence WOOP &middot; <a href={`${base}/confidentialite-et-conditions`} class="footer__bottom-link">Politique de confidentialit&eacute;</a></span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    z-index: 1;
    padding: 64px 0 32px;
    border-top: 1px solid var(--border-subtle);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 40px;
    margin-bottom: 48px;
  }

  @media (min-width: 768px) {
    .footer__grid {
      grid-template-columns: 1.8fr 1fr 1fr 1fr;
      gap: 32px;
    }
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .footer__logo-img {
    height: 36px;
    width: auto;
    max-width: 150px;
    display: block;
  }

  .footer__desc {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 320px;
  }

  .footer__heading {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--woop-pink);
    font-weight: 700;
    margin-bottom: 16px;
  }

  .footer__link {
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-secondary);
    display: block;
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer__link:hover {
    color: var(--text-primary);
  }

  .footer__link--disabled {
    opacity: 0.5;
    cursor: default;
  }

  .footer__link--disabled:hover {
    color: var(--text-secondary);
  }

  .footer__social {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms ease;
    margin-top: 8px;
  }

  .footer__social:hover {
    color: var(--text-primary);
  }

  .footer__social-icon {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--woop-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    flex-shrink: 0;
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--border-subtle);
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--text-muted);
  }

  .footer__bottom-link {
    color: var(--text-muted);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .footer__bottom-link:hover {
    color: var(--text-primary);
  }
</style>
