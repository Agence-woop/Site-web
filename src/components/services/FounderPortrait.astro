---
// Bloc « Notre différence » d'une page Services : photo ronde d'un fondateur (Gauthier, Kevin…) et
// son texte, avec un badge et le bouton « Parler à … ». La photo ronde a le même traitement que
// celle de SpecialistCard (pages Services) : TeamAvatar, cadrage rond de src/data/team.ts, anneau
// et halo roses, 168 px puis 200 px dès 1024 px.
//
// Props
// - member : la personne (src/data/team.ts) : photo, prénom et lien de contact
// - badge : texte du badge (texte simple, les apostrophes et NB restent tels quels dans le HTML)
// Emplacements
// - par défaut : les paragraphes ; le premier porte la classe md-gau__lead (chapeau)
// - badge-icon : le SVG de l'icône du badge
// Le bloc porte aussi l'attribut de portée de la page (voir src/utils/scope.ts).
import CtaIcon from '../CtaIcon.astro';
import TeamAvatar from '../team/TeamAvatar.astro';
import PortraitBadge from './PortraitBadge.astro';
import { parentScope } from '../../utils/scope';
import type { TeamMember } from '../../data/team';

interface Props {
  member: TeamMember;
  badge: string;
  [key: string]: unknown;
}

const { member, badge, ...rest } = Astro.props;
const scope = parentScope(rest);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="md-gau md-glass" {...scope}>
  <div class="md-gau__id" data-reveal="left">
    <TeamAvatar member={member} class="md-gau__ph" alt={member.firstName} />
  </div>
  <div class="md-gau__txt" data-reveal="right" data-reveal-step="1">
    <slot />
    <div class="md-gau__foot">
      <PortraitBadge text={badge}><slot name="badge-icon" /></PortraitBadge>
      <a class="cta" href={`${base}${member.contact}`}>Parler à {member.firstName}<CtaIcon /></a>
    </div>
  </div>
</div>

<style>
  .md-gau {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    overflow: hidden;
    border-radius: 30px;
  }

  @media (min-width: 768px) {
    .md-gau { grid-template-columns: 300px minmax(0, 1fr); }
  }

  @media (min-width: 1024px) {
    .md-gau { grid-template-columns: 360px minmax(0, 1fr); }
  }

  /* Photo ronde, centrée dans sa colonne (au-dessus du texte sur téléphone) : même forme, même
     anneau, même halo et même cadrage que la photo de SpecialistCard */
  .md-gau__id {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 36px 24px 0;
  }

  @media (min-width: 768px) {
    .md-gau__id { padding: 44px 0 44px 40px; }
  }

  @media (min-width: 900px) {
    .md-gau__id { padding-left: 50px; }
  }

  .md-gau__id :global(.md-gau__ph) {
    position: relative;
    display: block;
    overflow: hidden;
    flex: none;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    background: var(--woop-gradient);
    box-shadow: 0 0 0 4px var(--bg-elevated), 0 0 0 6px rgba(230, 43, 127, 0.55), 0 24px 50px rgba(230, 43, 127, 0.22);
  }

  @media (min-width: 1024px) {
    .md-gau__id :global(.md-gau__ph) { width: 200px; height: 200px; }
  }

  .md-gau__id :global(.md-gau__ph img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 0;
    transform: scale(1.55);
    transform-origin: var(--fx, 50%) var(--fy, 30%);
  }

  .md-gau__id :global(.md-gau__ph.is-framed img) {
    object-position: var(--obj-pos, center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--obj-pos, center);
  }

  .md-gau__txt {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    padding: 32px 24px;
  }

  @media (min-width: 900px) {
    .md-gau__txt { padding: 46px 50px; }
  }

  /* Paragraphes (emplacement par défaut) et badge */
  .md-gau__txt :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .md-gau__txt :global(.md-gau__lead) {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-primary);
  }

  /* Passage en gras (« on les a déjà résolus. ») : rose et gras */
  .md-gau__txt :global(p strong) {
    font-weight: 700;
    color: var(--md-pink-soft);
  }

  /* Badge : composant PortraitBadge (même style sur les 3 pages) */

  /* Badge à gauche, bouton « Parler à … » à droite, centrés verticalement.
     Téléphone : empilés, alignés à gauche. Le badge peut passer sur 2 lignes pour rester
     à côté du bouton ; si la colonne de texte est trop étroite même ainsi (tablette),
     le bouton passe sous le badge, aligné à gauche. */
  .md-gau__foot {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
    margin-top: 8px;
  }

  .md-gau__foot .cta { flex: none; }

  @media (min-width: 600px) {
    .md-gau__foot {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    /* Base de 308 px (2 lignes) pour le calcul du retour à la ligne, puis le badge
       s'élargit jusqu'à sa largeur naturelle (1 ligne) quand la place le permet. */
    .md-gau__foot :global(.md-badge) {
      flex: 1 1 308px;
      max-width: max-content;
    }
  }
</style>
