---
// « L'écosystème » : les 5 services WOOP dans l'ordre réel d'un patient, en cycle.
// Réseaux sociaux (fait connaître) → Publicité Google et Meta (amène) → Sites web (fait réserver)
// → Expérience client (fait revenir et recommander), puis les avis relancent le cycle.
// L'image de marque, au centre, est la fondation de chaque étape (sans ligne vers les cartes).
//
// - Ordinateur (dès 900 px) : cycle compact (900 px de large au plus, centré), 4 cartes aux coins
//   reliées par des flèches dans le sens du cycle, flèche de retour à gauche avec son étiquette.
// - Téléphone et tablette : version verticale, l'image de marque en haut, les 4 services l'un sous
//   l'autre reliés par des flèches, et la flèche de retour sur le côté avec son étiquette.
// - La carte du service de la page (current) est en dégradé WOOP, avec « Vous êtes ici » ; les
//   autres, et le centre, sont en version neutre.
// - Liens : seules les cartes des pages en ligne (href défini dans src/data/services.ts) sont
//   cliquables ; elles deviennent des liens d'elles-mêmes dès que leur page est publiée.
// - « Service suivant » : affiché seulement quand la page du service suivant est en ligne.
// - Flèches animées : au repos, flèches et ligne de retour grises. Quand le cycle est à l'écran,
//   un remplissage en dégradé WOOP parcourt le cycle dans son sens, flèche après flèche : chaque
//   segment se remplit pendant que le précédent se vide, et la pointe d'une flèche prend la
//   couleur quand le remplissage l'atteint. Un tour complet dure --sc-loop (7,2 s).
//   SVG (lignes tracées en pourcentage de leur boîte, pathLength 100) et stroke-dashoffset, sans
//   bibliothèque. L'animation démarre quand le cycle est visible (IntersectionObserver), se met en
//   pause hors de l'écran ; sans JavaScript ou avec prefers-reduced-motion, flèches grises
//   statiques. Les dégradés ont des id fixes (sc-g-*) : un seul cycle par page.
//
// Props
// - current : le service de la page
// - over : surtitre (« L'écosystème » par défaut, par ex. « 08 · L'écosystème »)
import SectionHead from '../SectionHead.astro';
import CtaIcon from '../CtaIcon.astro';
import { CYCLE, CYCLE_CORE, service, type ServiceKey, type Service } from '../../data/services';
import { NB } from '../../utils/typo';

interface Props {
  current: ServiceKey;
  over?: string;
}

const { current, over = "L'écosystème" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const core = service(CYCLE_CORE);
const ring = CYCLE.map((key, i) => ({ ...service(key), area: `s${i + 1}` }));
const at = CYCLE.indexOf(current);
const next = at >= 0 ? service(CYCLE[(at + 1) % CYCLE.length]) : undefined;

// Carte : lien si la page est en ligne (et n'est pas la page en cours), sinon simple bloc.
const linkOf = (s: Service) => (s.href && s.key !== current ? `${base}${s.href}` : undefined);
---
<SectionHead over={over} intro={`L'ordre réel d'un patient${NB}: il vous découvre, il cherche, il réserve, il revient et il recommande. Votre image de marque nourrit chaque étape, et les avis relancent le cycle.`}>
  Cinq services, <span class="gradient-accent">un seul cycle</span>.
</SectionHead>

<div class="sc" data-sc data-reveal="up">
  <!-- Dégradés WOOP dans le sens de chaque flèche (vers la droite, la gauche, le bas, le haut) -->
  <svg class="sc-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sc-g-r" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="100%" y2="0"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
      <linearGradient id="sc-g-l" gradientUnits="userSpaceOnUse" x1="100%" y1="0" x2="0" y2="0"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
      <linearGradient id="sc-g-d" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100%"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
      <linearGradient id="sc-g-u" gradientUnits="userSpaceOnUse" x1="0" y1="100%" x2="0" y2="0"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
    </defs>
  </svg>

  {[core].map((s) => {
    const href = linkOf(s);
    const Tag = href ? 'a' : 'div';
    return (
      <Tag class:list={['sc-card', 'sc-core', { 'is-current': s.key === current, 'is-link': href }]} href={href} aria-current={s.key === current ? 'page' : undefined}>
        <b class="sc-card__name">{s.label}</b>
        <span class="sc-card__foot">
          <span class="sc-card__role">{s.role}</span>
          {s.key === current && <span class="sc-card__here">Vous êtes ici</span>}
        </span>
      </Tag>
    );
  })}

  <ol class="sc-ring">
    {ring.map((s, i) => {
      const href = linkOf(s);
      const Tag = href ? 'a' : 'div';
      return (
        <>
          <li class:list={['sc-cell', `sc-${s.area}`]}>
            <Tag class:list={['sc-card', { 'is-current': s.key === current, 'is-link': href }]} href={href} aria-current={s.key === current ? 'page' : undefined}>
              <b class="sc-card__name">{s.label}</b>
              <span class="sc-card__foot">
                <span class="sc-card__role">{s.role}</span>
                {s.key === current && <span class="sc-card__here">Vous êtes ici</span>}
              </span>
            </Tag>
          </li>
          {i < ring.length - 1 && (
            <li class:list={['sc-arrow', `sc-a${i + 1}`]} aria-hidden="true">
              <span class="sc-ln">
                <svg class="sc-svg" focusable="false">
                  {/* Horizontale (ordinateur, flèches du haut et du bas) : vers la droite en haut, vers la gauche en bas */}
                  {i !== 1 && (
                    <g class="sc-h">
                      <line class="sc-base" x1={i === 0 ? '0' : '100%'} y1="50%" x2={i === 0 ? '100%' : '0'} y2="50%" />
                      <line class="sc-fill" x1={i === 0 ? '0' : '100%'} y1="50%" x2={i === 0 ? '100%' : '0'} y2="50%" pathLength="100" stroke={i === 0 ? 'url(#sc-g-r)' : 'url(#sc-g-l)'} />
                    </g>
                  )}
                  {/* Verticale vers le bas (téléphone et tablette ; flèche de droite sur ordinateur) */}
                  <g class="sc-v">
                    <line class="sc-base" x1="50%" y1="0" x2="50%" y2="100%" />
                    <line class="sc-fill" x1="50%" y1="0" x2="50%" y2="100%" pathLength="100" stroke="url(#sc-g-d)" />
                  </g>
                </svg>
                <i class="sc-head"></i>
              </span>
            </li>
          )}
        </>
      );
    })}
    <li class="sc-back">
      <span class="sc-ln" aria-hidden="true">
        <svg class="sc-svg" focusable="false">
          {/* Téléphone et tablette : crochet sur le côté, du dernier service (en bas) au premier (en haut) */}
          <g class="sc-br">
            <line class="sc-base" x1="100%" y1="100%" x2="0" y2="100%" />
            <line class="sc-base" x1="0" y1="100%" x2="0" y2="0" />
            <line class="sc-base" x1="0" y1="0" x2="100%" y2="0" />
            <line class="sc-fill sc-fill--b" x1="100%" y1="100%" x2="0" y2="100%" pathLength="100" stroke="url(#sc-g-l)" />
            <line class="sc-fill sc-fill--v" x1="0" y1="100%" x2="0" y2="0" pathLength="100" stroke="url(#sc-g-u)" />
            <line class="sc-fill sc-fill--t" x1="0" y1="0" x2="100%" y2="0" pathLength="100" stroke="url(#sc-g-r)" />
          </g>
          {/* Ordinateur : verticale vers le haut, à gauche */}
          <g class="sc-v">
            <line class="sc-base" x1="50%" y1="100%" x2="50%" y2="0" />
            <line class="sc-fill" x1="50%" y1="100%" x2="50%" y2="0" pathLength="100" stroke="url(#sc-g-u)" />
          </g>
        </svg>
        <i class="sc-head"></i>
      </span>
      <span class="sc-back__lbl">Les avis relancent le cycle</span>
    </li>
  </ol>
</div>

{next?.href && (
  <p class="sc-next" data-reveal="up">
    <a class="cta cta--line" href={`${base}${next.href}`}>Service suivant{NB}: {next.label}<CtaIcon dir="right" /></a>
  </p>
)}

<script>
  // Flèches animées : démarrent quand le cycle est à l'écran, en pause hors de l'écran.
  // Rien avec prefers-reduced-motion (flèches grises statiques), ni sans IntersectionObserver.
  document.querySelectorAll<HTMLElement>('[data-sc]').forEach((sc) => {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    sc.classList.add('is-live');
    new IntersectionObserver((entries) => {
      entries.forEach((e) => sc.classList.toggle('is-playing', e.isIntersecting));
    }, { threshold: 0.25 }).observe(sc);
  });
</script>

<style>
  /* ===== Téléphone et tablette : version verticale =====
     Colonne de gauche : la flèche de retour (et son étiquette) ; à droite : les cartes. */
  .sc {
    --sc-card-h: 76px;
    --sc-rail: 44px;
    position: relative;
    display: grid;
    grid-template-columns: var(--sc-rail) minmax(0, 1fr);
    grid-template-areas:
      'core core'
      'back s1'
      'back a1'
      'back s2'
      'back a2'
      'back s3'
      'back a3'
      'back s4';
    max-width: 560px;
    margin: 0 auto;
  }

  /* La liste ne crée pas de boîte : ses éléments se placent dans la grille du cycle */
  .sc-ring { display: contents; list-style: none; }

  .sc-s1 { grid-area: s1; }
  .sc-s2 { grid-area: s2; }
  .sc-s3 { grid-area: s3; }
  .sc-s4 { grid-area: s4; }
  .sc-a1 { grid-area: a1; }
  .sc-a2 { grid-area: a2; }
  .sc-a3 { grid-area: a3; }
  .sc-back { grid-area: back; }
  .sc-cell { display: flex; }

  /* ----- Cartes ----- */
  .sc-card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-height: var(--sc-card-h);
    padding: 14px 18px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
    color: var(--text-primary);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 300ms ease;
  }

  .sc-card__name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .sc-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 10px;
  }

  .sc-card__role {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--md-pink-soft);
  }

  /* Carte du service de la page : dégradé WOOP, titre blanc, petits textes en --bg-deep */
  .sc-card.is-current {
    background: var(--woop-gradient);
    box-shadow: 0 18px 40px rgba(230, 43, 127, 0.35);
  }

  .sc-card.is-current .sc-card__role { color: var(--hp-on-grad); }

  .sc-card__here {
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hp-on-grad);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bg-deep) 45%, transparent);
  }

  /* Carte d'une page en ligne : lien (survol et clavier) */
  .sc-card.is-link:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.6);
  }

  .sc-card.is-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 3px;
  }

  /* Centre : l'image de marque, la fondation, avec un léger halo */
  .sc-core {
    grid-area: core;
    z-index: 0;
    margin-bottom: 26px;
    text-align: center;
    align-items: center;
    box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.4);
  }

  .sc-core .sc-card__foot { justify-content: center; }

  .sc-core::before {
    content: '';
    position: absolute;
    inset: -28px -10px;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(230, 43, 127, 0.28), rgba(250, 98, 68, 0.08) 60%, transparent);
    pointer-events: none;
  }

  /* ----- Flèches (SVG) : base grise, remplissage en dégradé, pointe en chevron ----- */
  .sc {
    --sc-loop: 7.2s;
    --sc-grey: color-mix(in srgb, var(--text-primary) 22%, transparent);
  }

  .sc-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .sc-stop-o { stop-color: var(--woop-orange); }
  .sc-stop-p { stop-color: var(--woop-pink); }

  .sc-arrow,
  .sc-back {
    position: relative;
    list-style: none;
  }

  /* Boîte de tracé : les lignes du SVG y sont placées en pourcentage */
  .sc-ln {
    position: absolute;
    display: block;
  }

  .sc-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .sc-base,
  .sc-fill {
    fill: none;
    stroke-width: 2;
    stroke-linecap: butt;
  }

  .sc-base { stroke: var(--sc-grey); }

  /* Remplissage : invisible au repos (pointillé décalé d'une longueur entière) */
  .sc-fill {
    stroke-width: 2.5;
    stroke-dasharray: 100 100;
    stroke-dashoffset: 100;
  }

  /* Pointe de flèche : chevron, gris au repos */
  .sc-head {
    position: absolute;
    width: 8px;
    height: 8px;
    border-top: 2px solid var(--sc-grey);
    border-right: 2px solid var(--sc-grey);
  }

  /* Téléphone et tablette : flèches verticales vers le bas entre deux cartes */
  .sc-arrow { height: 30px; }

  .sc-arrow .sc-ln {
    top: 5px;
    bottom: 5px;
    left: 0;
    right: 0;
  }

  .sc-arrow .sc-h { display: none; }

  .sc-arrow .sc-head {
    left: 50%;
    bottom: 0;
    transform: translate(-50%, 0) rotate(135deg);
  }

  /* Téléphone et tablette : flèche de retour en crochet, sur le côté */
  .sc-back { margin: calc(var(--sc-card-h) / 2) 0; }

  .sc-back .sc-ln {
    top: 0;
    bottom: 0;
    right: 8px;
    width: 16px;
  }

  .sc-back .sc-v { display: none; }

  .sc-back .sc-head {
    top: 0;
    right: -2px;
    transform: translateY(-50%) rotate(45deg);
  }

  /* Étiquette le long de la flèche, lue de bas en haut (sens de la flèche) */
  .sc-back__lbl {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 0.04em;
    color: var(--md-pink-soft);
  }

  /* ----- Animation : un tour = --sc-loop, un quart par segment (a1, a2, a3, retour) -----
     Chaque segment se remplit pendant son quart (0 → 25 %), puis se vide pendant le quart
     suivant (25 → 50 %), pendant que le segment d'après se remplit. */
  .sc-a1 { --sc-i: 0; }
  .sc-a2 { --sc-i: 1; }
  .sc-a3 { --sc-i: 2; }
  .sc-back { --sc-i: 3; }

  .sc.is-live .sc-fill,
  .sc.is-live .sc-head {
    animation-duration: var(--sc-loop);
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-fill-mode: both;
    animation-delay: calc(var(--sc-i) * var(--sc-loop) / 4);
    animation-play-state: paused;
  }

  .sc.is-live .sc-fill { animation-name: sc-seg; }
  .sc.is-live .sc-head { animation-name: sc-head; animation-timing-function: linear; }

  /* Crochet du retour (téléphone et tablette) : bas, montant, haut, l'un après l'autre */
  .sc.is-live .sc-fill--b { animation-name: sc-seg-b; }
  .sc.is-live .sc-fill--v { animation-name: sc-seg-v; }
  .sc.is-live .sc-fill--t { animation-name: sc-seg-t; }

  .sc.is-live.is-playing .sc-fill,
  .sc.is-live.is-playing .sc-head { animation-play-state: running; }

  @keyframes sc-seg {
    0% { stroke-dashoffset: 100; }
    25% { stroke-dashoffset: 0; }
    50%, 100% { stroke-dashoffset: -100; }
  }

  @keyframes sc-seg-b {
    0% { stroke-dashoffset: 100; }
    2.5%, 25% { stroke-dashoffset: 0; }
    27.5%, 100% { stroke-dashoffset: -100; }
  }

  @keyframes sc-seg-v {
    0%, 2.5% { stroke-dashoffset: 100; }
    22.5%, 27.5% { stroke-dashoffset: 0; }
    47.5%, 100% { stroke-dashoffset: -100; }
  }

  @keyframes sc-seg-t {
    0%, 22.5% { stroke-dashoffset: 100; }
    25%, 47.5% { stroke-dashoffset: 0; }
    50%, 100% { stroke-dashoffset: -100; }
  }

  /* La pointe prend la couleur quand le remplissage l'atteint, et la perd quand il est passé */
  @keyframes sc-head {
    0%, 22% { border-color: var(--sc-grey); }
    25%, 47% { border-color: var(--woop-pink); }
    50%, 100% { border-color: var(--sc-grey); }
  }

  /* ===== Ordinateur : cycle compact =====
     Cartes aux 4 coins, image de marque au centre, flèches dans le sens du cycle :
     s1 → s2 (en haut), s2 → s3 (à droite), s3 → s4 (en bas), s4 → s1 (à gauche, retour). */
  @media (min-width: 900px) {
    .sc {
      --sc-card-h: 92px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto 150px auto;
      grid-template-areas:
        's1 a1 s2'
        'back core a2'
        's4 a3 s3';
      max-width: 900px;
    }

    .sc-card {
      padding: 18px 20px;
      border-radius: 22px;
    }

    .sc-card__name { font-size: 18px; }

    .sc-core {
      align-self: center;
      justify-self: center;
      width: 100%;
      max-width: 260px;
      margin: 0;
      padding: 22px 20px;
    }

    .sc-core::before { inset: -46px -36px; }

    /* Flèches horizontales : en haut vers la droite, en bas vers la gauche */
    .sc-a1,
    .sc-a3 {
      align-self: center;
      height: 12px;
    }

    .sc-a1 .sc-ln,
    .sc-a3 .sc-ln {
      top: 0;
      bottom: 0;
      left: 18px;
      right: 18px;
    }

    .sc-a1 .sc-h,
    .sc-a3 .sc-h { display: inline; }

    .sc-a1 .sc-v,
    .sc-a3 .sc-v { display: none; }

    .sc-a1 .sc-head {
      left: auto;
      right: 0;
      bottom: auto;
      top: 50%;
      transform: translate(0, -50%) rotate(45deg);
    }

    .sc-a3 .sc-head {
      left: 0;
      bottom: auto;
      top: 50%;
      transform: translate(0, -50%) rotate(-135deg);
    }

    /* Flèche verticale à droite (vers le bas), sous la carte du haut */
    .sc-a2 { height: auto; }

    .sc-a2 .sc-ln {
      top: 14px;
      bottom: 14px;
    }

    /* Flèche de retour à gauche (vers le haut), avec son étiquette à côté */
    .sc-back { margin: 14px 0; }

    .sc-back .sc-ln {
      right: auto;
      left: calc(50% - 6px);
      width: 12px;
    }

    .sc-back .sc-br { display: none; }

    .sc-back .sc-v { display: inline; }

    .sc-back .sc-head {
      right: auto;
      left: 50%;
      transform: translate(-50%, 0) rotate(-45deg);
    }

    .sc-back__lbl {
      top: 50%;
      left: auto;
      right: calc(50% + 14px);
      width: auto;
      max-width: 130px;
      transform: translateY(-50%);
      writing-mode: horizontal-tb;
      white-space: normal;
      text-align: right;
      font-size: 13px;
      line-height: 1.35;
    }
  }

  /* ----- Service suivant ----- */
  .sc-next {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-card { transition: none; }
    .sc-card.is-link:hover { transform: none; }

    /* Flèches grises statiques */
    .sc .sc-fill,
    .sc .sc-head { animation: none !important; }
  }
</style>
