---
// « L'écosystème » : les 5 services WOOP dans l'ordre réel d'un patient, en cycle.
// Réseaux sociaux (fait connaître) → Publicité Google et Meta (amène) → Sites web (fait réserver)
// → Expérience client (fait revenir et recommander), puis les avis relancent le cycle.
// L'image de marque, au centre, est la fondation de chaque étape.
//
// Style repris de la section « L'écosystème » de la maquette d'Emma
// (docs/maquettes/service-reseaux-sociaux.html), sur le fond de la page (sans cadre) :
// - Ordinateur (dès 900 px) : cycle sur toute la largeur du contenu, 460 px de haut, en carré :
//   Réseaux sociaux en haut à gauche, Publicité en haut à droite, Sites web en bas à droite,
//   Expérience client en bas à gauche, Image de marque au centre (reliée à aucune carte).
//   Les liaisons suivent les 4 côtés d'un rectangle arrondi (SVG 1000 × 460), dans le sens des
//   aiguilles d'une montre : pointillés roses en dégradé (épaisseur 2,5, tirets 7 / 6) qui
//   défilent en continu (décalage de -26 en 1,4 s, linéaire), le côté gauche étant la ligne de
//   retour. Cartes assez larges pour que chaque titre tienne sur une ligne.
// - Cartes : fond foncé, titre blanc, libellé court en rose. Centre : carte blanche, titre foncé,
//   « La fondation de tout le reste » en rose. Carte du service de la page : dégradé WOOP et halo
//   lumineux, signalée par aria-current="page" et « Vous êtes ici » pour les lecteurs d'écran
//   seulement (pas de texte visible).
// Gardé de la version précédente (différent de la maquette) :
// - pas d'encadré flottant : la petite étiquette « Les avis relancent le cycle » est posée sur la
//   ligne de retour (côté gauche de la boucle) ;
// - contraste hybride sur la carte en dégradé : petits textes en --hp-on-grad (--bg-deep), titre
//   en blanc ;
// - une icône par carte (src/data/services.ts), à gauche du titre (au-dessus au centre) : carré en
//   dégradé (aussi sur la carte blanche du centre), version claire sur la carte en dégradé ;
// - téléphone et tablette : version verticale (image de marque en haut, puis les 4 services l'un
//   sous l'autre), avec les mêmes pointillés qui défilent entre les cartes et sur la ligne de
//   retour, courbe, sur le côté ;
// - l'animation démarre quand le cycle est à l'écran (IntersectionObserver) et se met en pause
//   hors de l'écran ; sans JavaScript ou avec prefers-reduced-motion, pointillés fixes ;
// - liens : seules les cartes des pages en ligne (href dans src/data/services.ts) sont
//   cliquables ; « Service suivant » (sur chaque page, y compris l'image de marque, qui mène au
//   1er service du cycle) n'apparaît que si la page du service suivant est en ligne.
// Le dégradé a un id fixe (sc-g) : un seul cycle par page.
//
// Props
// - current : le service de la page
// - over : surtitre (« L'écosystème » par défaut, par ex. « 06 · L'écosystème »)
import SectionHead from '../SectionHead.astro';
import CtaIcon from '../CtaIcon.astro';
import { CYCLE, CYCLE_CORE, service, serviceIconSvg, type ServiceKey, type Service } from '../../data/services';
import { NB } from '../../utils/typo';

interface Props {
  current: ServiceKey;
  over?: string;
}

const { current, over = "L'écosystème" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const core = service(CYCLE_CORE);
const ring = CYCLE.map((key, i) => ({ ...service(key), area: `s${i + 1}` }));
// Service suivant : le suivant dans l'ordre du cycle (le dernier mène au premier) ; depuis l'image de
// marque, au centre (hors de l'anneau), le premier service du cycle
const at = CYCLE.indexOf(current);
const next = service(at >= 0 ? CYCLE[(at + 1) % CYCLE.length] : CYCLE[0]);

// Boucle (repère 1000 × 460) passant par le centre des 4 cartes, aux points (18 %, 18 %),
// (82 %, 18 %), (82 %, 82 %) et (18 %, 82 %), coins arrondis comme chez Emma (sous les cartes).
// Parcourue dans le sens des aiguilles d'une montre : côté haut (Réseaux → Publicité), côté droit
// (Publicité → Sites web), côté bas (Sites web → Expérience client), côté gauche (retour).
const LOOP = 'M240 83 H760 Q820 83 820 143 V317 Q820 377 760 377 H240 Q180 377 180 317 V143 Q180 83 240 83 Z';

// Carte : lien si la page est en ligne (et n'est pas la page en cours), sinon simple bloc.
const linkOf = (s: Service) => (s.href && s.key !== current ? `${base}${s.href}` : undefined);
---
<SectionHead over={over} intro={`L'ordre réel d'un patient${NB}: il vous découvre, il cherche, il réserve, il revient et il recommande. Votre image de marque nourrit chaque étape, et les avis relancent le cycle.`}>
  Cinq services, <span class="gradient-accent">un seul cycle</span>.
</SectionHead>

<div class="sc-wrap" data-reveal="up">
  <div class="sc" data-sc>
    <!-- Dégradés des pointillés : horizontal pour la boucle (maquette), vertical pour les lignes
         du mobile (une ligne droite n'a pas de largeur : dégradé en coordonnées de la ligne) -->
    <svg class="sc-defs" width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        <linearGradient id="sc-g" x1="0" x2="1"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
        <linearGradient id="sc-gv" gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="0" y2="100%"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
      </defs>
    </svg>

    <!-- Ordinateur : la boucle des liaisons (le centre n'est relié à aucune carte) -->
    <svg class="sc-map" viewBox="0 0 1000 460" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <path class="sc-dash sc-loop" d={LOOP} />
    </svg>

    {[core].map((s) => {
      const href = linkOf(s);
      const Tag = href ? 'a' : 'div';
      return (
        <Tag class:list={['sc-card', 'sc-core', { 'is-current': s.key === current, 'is-link': href }]} href={href} aria-current={s.key === current ? 'page' : undefined}>
          <span class="sc-ico" set:html={serviceIconSvg(s)} />
          <span class="sc-card__txt">
            <b class="sc-card__name">{s.label}</b>
            <span class="sc-card__role">{s.role}</span>
            {s.key === current && <span class="visually-hidden">Vous êtes ici</span>}
          </span>
        </Tag>
      );
    })}

    <ol class="sc-ring">
      {ring.map((s, i) => {
        const href = linkOf(s);
        const Tag = href ? 'a' : 'div';
        return (
          <>
            <li class:list={['sc-cell', `sc-${s.area}`]}>
              <Tag class:list={['sc-card', { 'is-current': s.key === current, 'is-link': href }]} href={href} aria-current={s.key === current ? 'page' : undefined}>
                <span class="sc-ico" set:html={serviceIconSvg(s)} />
                <span class="sc-card__txt">
                  <b class="sc-card__name">{s.label}</b>
                  <span class="sc-card__role">{s.role}</span>
                  {s.key === current && <span class="visually-hidden">Vous êtes ici</span>}
                </span>
              </Tag>
            </li>
            {/* Téléphone et tablette : liaison pointillée vers la carte suivante */}
            {i < ring.length - 1 && (
              <li class:list={['sc-arrow', `sc-a${i + 1}`]} aria-hidden="true">
                <svg class="sc-ln" focusable="false"><line class="sc-dash" x1="50%" y1="0" x2="50%" y2="100%" /></svg>
              </li>
            )}
          </>
        );
      })}
      <li class="sc-back">
        {/* Téléphone et tablette : ligne de retour courbe sur le côté, du dernier service (en bas)
            au premier (en haut) : coin du bas, montant, coin du haut */}
        <span class="sc-curve" aria-hidden="true">
          <svg class="sc-curve__bot" width="18" height="16" viewBox="0 0 18 16" focusable="false"><path class="sc-dash" d="M18 15 H15 A14 14 0 0 1 1 1" /></svg>
          <svg class="sc-curve__mid" focusable="false"><line class="sc-dash" x1="1" y1="100%" x2="1" y2="0" /></svg>
          <svg class="sc-curve__top" width="18" height="16" viewBox="0 0 18 16" focusable="false"><path class="sc-dash" d="M1 15 A14 14 0 0 1 15 1 H18" /></svg>
        </span>
        <span class="sc-back__lbl">Les avis relancent le cycle</span>
      </li>
    </ol>
  </div>

  {next?.href && (
    <p class="sc-next">
      <a class="cta cta--line" href={`${base}${next.href}`}>Service suivant{NB}: {next.label}<CtaIcon dir="right" /></a>
    </p>
  )}
</div>

<script>
  // Pointillés qui défilent : démarrent quand le cycle est à l'écran, en pause hors de l'écran.
  // Rien avec prefers-reduced-motion (pointillés fixes), ni sans IntersectionObserver.
  document.querySelectorAll<HTMLElement>('[data-sc]').forEach((sc) => {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    sc.classList.add('is-live');
    new IntersectionObserver((entries) => {
      entries.forEach((e) => sc.classList.toggle('is-playing', e.isIntersecting));
    }, { threshold: 0.25 }).observe(sc);
  });
</script>

<style>
  /* ===== Pointillés (maquette : 2,5 d'épaisseur, tirets 7 / 6, dégradé WOOP) ===== */
  .sc {
    --sc-card-h: 76px;
    --sc-rail: 44px;
    position: relative;
    display: grid;
    grid-template-columns: var(--sc-rail) minmax(0, 1fr);
    grid-template-areas:
      'core core'
      'back s1'
      'back a1'
      'back s2'
      'back a2'
      'back s3'
      'back a3'
      'back s4';
  }

  .sc-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .sc-stop-o { stop-color: var(--woop-orange); }
  .sc-stop-p { stop-color: var(--woop-pink); }

  .sc-dash {
    fill: none;
    stroke: url(#sc-g);
    stroke-width: 2.5;
    stroke-dasharray: 7 6;
    stroke-dashoffset: 0;
    /* Épaisseur et tirets en pixels, même si le SVG est étiré */
    vector-effect: non-scaling-stroke;
  }

  /* Défilement dans le sens du tracé (maquette : -26 en 1,4 s, linéaire, en continu) */
  .sc.is-live .sc-dash {
    animation: sc-dash 1.4s linear infinite;
    animation-play-state: paused;
  }

  .sc.is-live.is-playing .sc-dash { animation-play-state: running; }

  @keyframes sc-dash {
    to { stroke-dashoffset: -26; }
  }

  /* La boucle : ordinateur seulement */
  .sc-map { display: none; }

  /* La liste ne crée pas de boîte : ses éléments se placent dans la grille du cycle */
  .sc-ring { display: contents; list-style: none; }

  .sc-s1 { grid-area: s1; }
  .sc-s2 { grid-area: s2; }
  .sc-s3 { grid-area: s3; }
  .sc-s4 { grid-area: s4; }
  .sc-a1 { grid-area: a1; }
  .sc-a2 { grid-area: a2; }
  .sc-a3 { grid-area: a3; }
  .sc-back { grid-area: back; }
  .sc-cell { display: flex; list-style: none; }

  /* ===== Cartes (maquette : fond foncé, rayon 20 px, titre blanc, libellé rose) ===== */
  .sc-card {
    position: relative;
    z-index: 2;
    display: flex;
    flex: 1;
    align-items: center;
    gap: 12px;
    min-height: var(--sc-card-h);
    padding: 14px 18px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--woop-pink) 8%, var(--bg-elevated));
    box-shadow: inset 0 0 0 1px var(--hp-line), 0 16px 36px color-mix(in srgb, var(--bg-deep) 40%, transparent);
    color: var(--text-primary);
    transition: transform 300ms ease, box-shadow 300ms ease;
  }

  .sc-card__txt {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .sc-card__name {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .sc-card__role {
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--md-pink-soft);
  }

  /* Icône du service : carré en dégradé, trait blanc, comme les tuiles du site */
  .sc-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 10px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 6px 16px rgba(230, 43, 127, 0.3);
  }

  .sc-ico :global(svg) { width: 17px; height: 17px; }

  /* Carte du service de la page : dégradé et halo (maquette), contraste hybride : titre blanc,
     petits textes en --hp-on-grad ; icône en version claire */
  .sc-card.is-current {
    background: var(--woop-gradient);
    box-shadow: 0 20px 44px rgba(230, 43, 127, 0.4);
  }

  .sc-card.is-current .sc-card__role { color: var(--hp-on-grad); }

  .sc-card.is-current .sc-ico {
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: none;
  }

  /* Centre : carte blanche (maquette), titre foncé, libellé en rose ; icône en dégradé */
  .sc-core {
    grid-area: core;
    flex-direction: column;
    gap: 10px;
    margin-bottom: 22px;
    padding: 20px 22px;
    border-radius: 26px;
    background: var(--hp-light);
    box-shadow: 0 16px 36px color-mix(in srgb, var(--bg-deep) 40%, transparent);
    text-align: center;
    color: var(--bg-deep);
  }

  .sc-core .sc-card__txt { align-items: center; }

  .sc-core .sc-card__name {
    font-size: 19px;
    color: var(--bg-deep);
  }

  .sc-core .sc-card__role { color: var(--md-pink-deep); }

  .sc-core.is-current { background: var(--woop-gradient); }

  .sc-core.is-current .sc-card__name { color: var(--text-primary); }

  /* Carte d'une page en ligne : lien (survol et clavier) */
  .sc-card.is-link:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px rgba(230, 43, 127, 0.6), 0 18px 40px color-mix(in srgb, var(--bg-deep) 45%, transparent);
  }

  .sc-card.is-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 3px;
  }

  /* ===== Téléphone et tablette : liaisons verticales entre deux cartes ===== */
  .sc-arrow,
  .sc-back {
    position: relative;
    list-style: none;
  }

  .sc-arrow { height: 36px; }

  /* Lignes du mobile : dégradé vertical */
  .sc-arrow .sc-dash,
  .sc-curve .sc-dash { stroke: url(#sc-gv); }

  /* Tracé à 6 px des cartes */
  .sc-ln {
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 0;
    width: 100%;
    height: calc(100% - 12px);
    overflow: visible;
  }

  /* Ligne de retour courbe : coin du bas, montant, coin du haut (rayon 14 px) */
  .sc-back { margin: calc(var(--sc-card-h) / 2) 0; }

  .sc-curve {
    position: absolute;
    top: -1px;
    bottom: -1px;
    right: 8px;
    width: 18px;
  }

  .sc-curve svg {
    position: absolute;
    left: 0;
    overflow: visible;
  }

  .sc-curve__top { top: 0; }

  .sc-curve__bot { bottom: 0; }

  .sc-curve__mid {
    top: 16px;
    bottom: 16px;
    width: 2px;
    height: calc(100% - 32px);
  }

  /* Étiquette sur la ligne de retour, lue de bas en haut (sens du cycle) */
  .sc-back__lbl {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 0.04em;
    color: var(--md-pink-soft);
  }

  /* ===== Ordinateur : cycle en carré sur toute la largeur du contenu (460 px de haut) =====
     Cartes centrées sur leurs points : Réseaux (18 %, 18 %), Publicité (82 %, 18 %),
     Sites web (82 %, 82 %), Expérience client (18 %, 82 %), Image de marque (50 %, 50 %). */
  @media (min-width: 900px) {
    .sc {
      display: block;
      height: 460px;
    }

    .sc-map {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
    }

    .sc-cell,
    .sc-core {
      position: absolute;
      transform: translate(-50%, -50%);
    }

    .sc-s1 { left: 18%; top: 18%; }
    .sc-s2 { left: 82%; top: 18%; }
    .sc-s3 { left: 82%; top: 82%; }
    .sc-s4 { left: 18%; top: 82%; }

    .sc-card {
      gap: 12px;
      min-width: 200px;
      min-height: 0;
      padding: 16px 20px 16px 16px;
    }

    /* Chaque titre tient sur une ligne (la carte s'élargit à son titre) */
    .sc-card__name { white-space: nowrap; }

    /* Centre : icône au-dessus, texte centré */
    .sc-core { flex-direction: column; gap: 10px; max-width: none; }

    .sc-core .sc-card__txt { align-items: center; }

    .sc-core {
      left: 50%;
      top: 50%;
      width: auto;
      min-width: 240px;
      margin: 0;
      padding: 22px 26px;
      border-radius: 26px;
    }

    .sc-ico {
      width: 34px;
      height: 34px;
    }

    /* Centre cliquable (page Image de marque en ligne) : le survol garde le centrage */
    .sc-core.is-link:hover { transform: translate(-50%, calc(-50% - 3px)); }

    .sc-core .sc-ico {
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }

    .sc-core .sc-ico :global(svg) { width: 21px; height: 21px; }

    /* Liaisons et ligne courbe du mobile : remplacées par la boucle */
    .sc-arrow,
    .sc-curve { display: none; }

    /* Étiquette posée sur le côté gauche de la boucle (la ligne de retour) */
    .sc-back {
      position: absolute;
      left: 18%;
      top: 50%;
      margin: 0;
      transform: translate(-50%, -50%);
      z-index: 2;
    }

    .sc-back__lbl {
      position: static;
      display: block;
      width: max-content;
      max-width: 112px;
      padding: 6px 8px;
      border-radius: 10px;
      transform: none;
      writing-mode: horizontal-tb;
      white-space: normal;
      text-align: center;
      font-size: 12px;
      line-height: 1.3;
      /* Fond de la page : le pointillé passe derrière l'étiquette */
      background: var(--bg-deep);
    }
  }

  /* ----- Service suivant ----- */
  .sc-next {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-card { transition: none; }
    .sc-card.is-link:hover { transform: none; }

    /* Pointillés fixes */
    .sc .sc-dash { animation: none !important; }
  }
</style>
