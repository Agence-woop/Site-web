---
// « L'écosystème » : les 5 services WOOP dans l'ordre réel d'un patient, en cycle.
// Réseaux sociaux (fait connaître) → Publicité Google et Meta (amène) → Sites web (fait réserver)
// → Expérience client (fait revenir et recommander), puis les avis relancent le cycle.
// L'image de marque, au centre, est la fondation de chaque étape (sans ligne vers les cartes).
//
// - Ordinateur (dès 900 px) : cycle compact (900 px de large au plus, centré), 4 cartes aux coins
//   reliées par des flèches dans le sens du cycle, flèche de retour à gauche avec son étiquette.
// - Téléphone et tablette : version verticale, l'image de marque en haut, les 4 services l'un sous
//   l'autre reliés par des flèches, et la flèche de retour sur le côté avec son étiquette.
// - La carte du service de la page (current) est en dégradé WOOP, avec « Vous êtes ici » ; les
//   autres, et le centre, sont en version neutre.
// - Liens : seules les cartes des pages en ligne (href défini dans src/data/services.ts) sont
//   cliquables ; elles deviennent des liens d'elles-mêmes dès que leur page est publiée.
// - « Service suivant » : affiché seulement quand la page du service suivant est en ligne.
// - Icônes : chaque carte porte l'icône de son service (src/data/services.ts), dans le carré en
//   dégradé des icônes du site, à gauche du titre (au-dessus pour l'image de marque, au centre) ;
//   version claire sur la carte en dégradé (contraste hybride), plus petite sur mobile.
// - Liaisons animées : sur chaque liaison et sur la ligne de retour, 6 chevrons (››››››) dans le
//   sens du cycle, gris et discrets au repos. Quand le cycle est à l'écran, chaque chevron
//   s'allume en dégradé WOOP puis s'éteint, l'un après l'autre (24 chevrons sur le tour, un tour
//   complet = --sc-loop, 5 s) : un mouvement continu qui passe d'une liaison à la suivante,
//   retour compris. Les chevrons sont placés en pourcentage de la longueur de leur liaison (ils ne
//   se chevauchent jamais). Sur téléphone et tablette, la ligne de retour est une courbe sur le
//   côté et ses chevrons suivent la courbe en s'orientant dans son sens.
//   SVG et CSS, sans bibliothèque. L'animation démarre quand le cycle est visible
//   (IntersectionObserver) et se met en pause hors de l'écran ; sans JavaScript ou avec
//   prefers-reduced-motion, chevrons gris fixes. Le dégradé a un id fixe (sc-cv-g) : un seul
//   cycle par page.
//
// Props
// - current : le service de la page
// - over : surtitre (« L'écosystème » par défaut, par ex. « 08 · L'écosystème »)
import SectionHead from '../SectionHead.astro';
import CtaIcon from '../CtaIcon.astro';
import { CYCLE, CYCLE_CORE, service, serviceIconSvg, type ServiceKey, type Service } from '../../data/services';
import { NB } from '../../utils/typo';

interface Props {
  current: ServiceKey;
  over?: string;
}

const { current, over = "L'écosystème" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const core = service(CYCLE_CORE);
const ring = CYCLE.map((key, i) => ({ ...service(key), area: `s${i + 1}` }));
const at = CYCLE.indexOf(current);
const next = at >= 0 ? service(CYCLE[(at + 1) % CYCLE.length]) : undefined;

// Chevron (pointe vers la droite ; orienté par le CSS selon la liaison). 6 par liaison : le rang
// k (0 à 23) fixe l'ordre d'allumage sur le tour, j (0 à 5) la place sur la liaison.
const CHEV = 'M6 3.5L10.5 8 6 12.5';
const PER_LINK = 6;
const chevrons = (link: number) => Array.from({ length: PER_LINK }, (_, j) => link * PER_LINK + j);

// Carte : lien si la page est en ligne (et n'est pas la page en cours), sinon simple bloc.
const linkOf = (s: Service) => (s.href && s.key !== current ? `${base}${s.href}` : undefined);
---
<SectionHead over={over} intro={`L'ordre réel d'un patient${NB}: il vous découvre, il cherche, il réserve, il revient et il recommande. Votre image de marque nourrit chaque étape, et les avis relancent le cycle.`}>
  Cinq services, <span class="gradient-accent">un seul cycle</span>.
</SectionHead>

<div class="sc" data-sc data-reveal="up">
  <!-- Dégradé WOOP des chevrons allumés -->
  <svg class="sc-defs" width="0" height="0" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="sc-cv-g" x1="0" y1="0" x2="1" y2="1"><stop class="sc-stop-o" offset="0" /><stop class="sc-stop-p" offset="1" /></linearGradient>
    </defs>
  </svg>

  {[core].map((s) => {
    const href = linkOf(s);
    const Tag = href ? 'a' : 'div';
    return (
      <Tag class:list={['sc-card', 'sc-core', { 'is-current': s.key === current, 'is-link': href }]} href={href} aria-current={s.key === current ? 'page' : undefined}>
        <span class="sc-ico" set:html={serviceIconSvg(s)} />
        <span class="sc-card__txt">
          <b class="sc-card__name">{s.label}</b>
          <span class="sc-card__foot">
            <span class="sc-card__role">{s.role}</span>
            {s.key === current && <span class="sc-card__here">Vous êtes ici</span>}
          </span>
        </span>
      </Tag>
    );
  })}

  <ol class="sc-ring">
    {ring.map((s, i) => {
      const href = linkOf(s);
      const Tag = href ? 'a' : 'div';
      return (
        <>
          <li class:list={['sc-cell', `sc-${s.area}`]}>
            <Tag class:list={['sc-card', { 'is-current': s.key === current, 'is-link': href }]} href={href} aria-current={s.key === current ? 'page' : undefined}>
              <span class="sc-ico" set:html={serviceIconSvg(s)} />
              <span class="sc-card__txt">
                <b class="sc-card__name">{s.label}</b>
                <span class="sc-card__foot">
                  <span class="sc-card__role">{s.role}</span>
                  {s.key === current && <span class="sc-card__here">Vous êtes ici</span>}
                </span>
              </span>
            </Tag>
          </li>
          {i < ring.length - 1 && (
            <li class:list={['sc-arrow', `sc-a${i + 1}`]} aria-hidden="true">
              <span class="sc-chevs">
                {chevrons(i).map((k, j) => (
                  <svg class="sc-cv" viewBox="0 0 16 16" style={`--k: ${k}; --j: ${j}`} focusable="false"><path class="sc-cv__base" d={CHEV} /><path class="sc-cv__lit" d={CHEV} /></svg>
                ))}
              </span>
            </li>
          )}
        </>
      );
    })}
    <li class="sc-back">
      <span class="sc-back__curve" aria-hidden="true"></span>
      <span class="sc-chevs" aria-hidden="true">
        {chevrons(3).map((k, j) => (
          <svg class:list={['sc-cv', `sc-cv--${j + 1}`]} viewBox="0 0 16 16" style={`--k: ${k}; --j: ${j}`} focusable="false"><path class="sc-cv__base" d={CHEV} /><path class="sc-cv__lit" d={CHEV} /></svg>
        ))}
      </span>
      <span class="sc-back__lbl">Les avis relancent le cycle</span>
    </li>
  </ol>
</div>

{next?.href && (
  <p class="sc-next" data-reveal="up">
    <a class="cta cta--line" href={`${base}${next.href}`}>Service suivant{NB}: {next.label}<CtaIcon dir="right" /></a>
  </p>
)}

<script>
  // Chevrons animés : démarrent quand le cycle est à l'écran, en pause hors de l'écran.
  // Rien avec prefers-reduced-motion (chevrons gris fixes), ni sans IntersectionObserver.
  document.querySelectorAll<HTMLElement>('[data-sc]').forEach((sc) => {
    if (!('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    sc.classList.add('is-live');
    new IntersectionObserver((entries) => {
      entries.forEach((e) => sc.classList.toggle('is-playing', e.isIntersecting));
    }, { threshold: 0.25 }).observe(sc);
  });
</script>

<style>
  /* ===== Téléphone et tablette : version verticale =====
     Colonne de gauche : la flèche de retour (et son étiquette) ; à droite : les cartes. */
  .sc {
    --sc-card-h: 76px;
    --sc-rail: 44px;
    position: relative;
    display: grid;
    grid-template-columns: var(--sc-rail) minmax(0, 1fr);
    grid-template-areas:
      'core core'
      'back s1'
      'back a1'
      'back s2'
      'back a2'
      'back s3'
      'back a3'
      'back s4';
    max-width: 560px;
    margin: 0 auto;
  }

  /* La liste ne crée pas de boîte : ses éléments se placent dans la grille du cycle */
  .sc-ring { display: contents; list-style: none; }

  .sc-s1 { grid-area: s1; }
  .sc-s2 { grid-area: s2; }
  .sc-s3 { grid-area: s3; }
  .sc-s4 { grid-area: s4; }
  .sc-a1 { grid-area: a1; }
  .sc-a2 { grid-area: a2; }
  .sc-a3 { grid-area: a3; }
  .sc-back { grid-area: back; }
  .sc-cell { display: flex; }

  /* ----- Cartes ----- */
  .sc-card {
    position: relative;
    display: flex;
    flex: 1;
    align-items: center;
    gap: 12px;
    min-height: var(--sc-card-h);
    padding: 14px 18px;
    border-radius: 20px;
    background: color-mix(in srgb, var(--bg-elevated) 80%, transparent);
    box-shadow: inset 0 0 0 1.5px var(--hp-line);
    color: var(--text-primary);
    transition: transform 300ms cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 300ms ease;
  }

  .sc-card__txt {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
  }

  /* Icône du service : carré en dégradé, trait blanc (comme les tuiles du site) ; plus petite
     sur téléphone et tablette */
  .sc-ico {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: var(--woop-gradient);
    color: var(--hp-ink);
    box-shadow: 0 6px 16px rgba(230, 43, 127, 0.3);
  }

  .sc-ico :global(svg) { width: 18px; height: 18px; }

  /* Carte en dégradé (service de la page) : version claire, icône en rose foncé */
  .sc-card.is-current .sc-ico {
    background: var(--hp-light);
    color: var(--md-pink-deep);
    box-shadow: none;
  }

  .sc-card__name {
    font-size: 17px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .sc-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 10px;
  }

  .sc-card__role {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.35;
    color: var(--md-pink-soft);
  }

  /* Carte du service de la page : dégradé WOOP, titre blanc, petits textes en --bg-deep */
  .sc-card.is-current {
    background: var(--woop-gradient);
    box-shadow: 0 18px 40px rgba(230, 43, 127, 0.35);
  }

  .sc-card.is-current .sc-card__role { color: var(--hp-on-grad); }

  .sc-card__here {
    padding: 3px 9px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--hp-on-grad);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--bg-deep) 45%, transparent);
  }

  /* Carte d'une page en ligne : lien (survol et clavier) */
  .sc-card.is-link:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.6);
  }

  .sc-card.is-link:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 3px;
  }

  /* Centre : l'image de marque, la fondation, avec un léger halo */
  .sc-core {
    grid-area: core;
    z-index: 0;
    margin-bottom: 26px;
    text-align: center;
    align-items: center;
    box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.4);
  }

  .sc-core { flex-direction: column; gap: 8px; }

  .sc-core .sc-card__txt { align-items: center; }

  .sc-core .sc-card__foot { justify-content: center; }

  .sc-core::before {
    content: '';
    position: absolute;
    inset: -28px -10px;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(230, 43, 127, 0.28), rgba(250, 98, 68, 0.08) 60%, transparent);
    pointer-events: none;
  }

  /* ----- Liaisons : 6 chevrons gris au repos, allumés l'un après l'autre en dégradé ----- */
  .sc {
    --sc-loop: 5s;
    --sc-grey: color-mix(in srgb, var(--text-primary) 22%, transparent);
    /* Taille d'un chevron : 16 px sur téléphone et tablette (espace entre les cartes),
       27 px sur ordinateur (× 1,5) */
    --cv: 16px;
  }

  .sc-defs {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .sc-stop-o { stop-color: var(--woop-orange); }
  .sc-stop-p { stop-color: var(--woop-pink); }

  .sc-arrow,
  .sc-back {
    position: relative;
    list-style: none;
  }

  /* Boîte de la liaison ; chaque chevron y est centré à (j + 0,5) / 6 de sa longueur */
  .sc-chevs {
    position: absolute;
    display: block;
  }

  .sc-cv {
    position: absolute;
    width: var(--cv);
    height: var(--cv);
    margin: calc(var(--cv) / -2) 0 0 calc(var(--cv) / -2);
    overflow: visible;
  }

  .sc-cv path {
    fill: none;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .sc-cv__base { stroke: var(--sc-grey); }

  /* Copie en dégradé par-dessus, éteinte au repos */
  .sc-cv__lit {
    stroke: url(#sc-cv-g);
    opacity: 0;
  }

  /* Téléphone et tablette : liaisons verticales vers le bas entre deux cartes.
     6 chevrons tous les 11 px (trait visible ~7 px de haut) : 4 px entre deux chevrons et
     au moins 8 px avec les cartes. */
  .sc-arrow { height: 80px; }

  .sc-arrow .sc-chevs { inset: 7px 0; }

  .sc-arrow .sc-cv {
    left: 50%;
    top: calc((var(--j) + 0.5) * 100% / 6);
    transform: rotate(90deg);
  }

  /* Téléphone et tablette : ligne de retour courbe sur le côté, du dernier service (en bas)
     au premier (en haut) ; ses chevrons suivent la courbe et s'orientent dans son sens */
  .sc-back { margin: calc(var(--sc-card-h) / 2) 0; }

  .sc-back__curve {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 8px;
    width: 18px;
    border: 1.5px solid var(--sc-grey);
    border-right: 0;
    border-radius: 14px 0 0 14px;
  }

  .sc-back .sc-chevs {
    top: 0;
    bottom: 0;
    right: 8px;
    width: 18px;
  }

  /* Coin du bas (vers le haut à gauche), quatre sur le montant (vers le haut), coin du haut
     (vers le haut à droite) : centres posés sur la courbe (rayon 14 px, milieu du coin à ~4 px) */
  .sc-back .sc-cv--1 { left: 4.8px; top: calc(100% - 4.8px); transform: rotate(-135deg); }
  .sc-back .sc-cv--2 { left: 0.75px; top: 78%; transform: rotate(-90deg); }
  .sc-back .sc-cv--3 { left: 0.75px; top: 59%; transform: rotate(-90deg); }
  .sc-back .sc-cv--4 { left: 0.75px; top: 41%; transform: rotate(-90deg); }
  .sc-back .sc-cv--5 { left: 0.75px; top: 22%; transform: rotate(-90deg); }
  .sc-back .sc-cv--6 { left: 4.8px; top: 4.8px; transform: rotate(-45deg); }

  /* Étiquette le long de la ligne de retour, lue de bas en haut (sens du cycle) */
  .sc-back__lbl {
    position: absolute;
    top: 50%;
    left: 0;
    width: 18px;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
    white-space: nowrap;
    font-size: 11.5px;
    font-weight: 700;
    line-height: 18px;
    letter-spacing: 0.04em;
    color: var(--md-pink-soft);
  }

  /* ----- Animation : 24 chevrons sur le tour, un toutes les --sc-loop / 24 (~0,21 s).
     Chacun s'allume vite, reste un instant, puis s'éteint : 3 à 4 chevrons allumés à la fois,
     qui avancent dans le sens du cycle. */
  .sc.is-live .sc-cv__lit {
    animation: sc-cv var(--sc-loop) ease-in-out infinite both;
    animation-delay: calc(var(--k) * var(--sc-loop) / 24);
    animation-play-state: paused;
  }

  .sc.is-live.is-playing .sc-cv__lit { animation-play-state: running; }

  @keyframes sc-cv {
    0% { opacity: 0; }
    3%, 8% { opacity: 1; }
    17%, 100% { opacity: 0; }
  }

  /* ===== Ordinateur : cycle compact =====
     Cartes aux 4 coins, image de marque au centre, flèches dans le sens du cycle :
     s1 → s2 (en haut), s2 → s3 (à droite), s3 → s4 (en bas), s4 → s1 (à gauche, retour). */
  @media (min-width: 900px) {
    .sc {
      --sc-card-h: 92px;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-template-rows: auto 150px auto;
      grid-template-areas:
        's1 a1 s2'
        'back core a2'
        's4 a3 s3';
      max-width: 900px;
    }

    .sc-card {
      padding: 18px 20px;
      border-radius: 22px;
    }

    .sc-card__name { font-size: 18px; }

    .sc-core {
      align-self: center;
      justify-self: center;
      width: 100%;
      max-width: 260px;
      margin: 0;
      padding: 22px 20px;
    }

    .sc-core::before { inset: -46px -36px; }

    /* Chevrons × 1,5 et icônes plus grandes sur ordinateur */
    .sc { --cv: 27px; }

    .sc-ico {
      width: 42px;
      height: 42px;
      border-radius: 13px;
    }

    .sc-ico :global(svg) { width: 22px; height: 22px; }

    /* Liaisons horizontales : en haut vers la droite, en bas vers la gauche */
    .sc-a1,
    .sc-a3 {
      align-self: center;
      height: 28px;
    }

    .sc-a1 .sc-chevs,
    .sc-a3 .sc-chevs { inset: 0 18px; }

    .sc-a1 .sc-cv {
      top: 50%;
      left: calc((var(--j) + 0.5) * 100% / 6);
      transform: none;
    }

    /* En bas, de droite à gauche : le 1er chevron (allumé en premier) est à droite */
    .sc-a3 .sc-cv {
      top: 50%;
      left: calc((5.5 - var(--j)) * 100% / 6);
      transform: rotate(180deg);
    }

    /* Liaison verticale à droite (vers le bas), sous la carte du haut */
    .sc-a2 { height: auto; }

    .sc-a2 .sc-chevs { inset: 14px 0; }

    /* Retour à gauche, droit et vers le haut, avec son étiquette à côté */
    .sc-back { margin: 14px 0; }

    .sc-back__curve { display: none; }

    .sc-back .sc-chevs {
      inset: 0;
      width: auto;
    }

    .sc-back .sc-cv--1,
    .sc-back .sc-cv--2,
    .sc-back .sc-cv--3,
    .sc-back .sc-cv--4,
    .sc-back .sc-cv--5,
    .sc-back .sc-cv--6 {
      left: 50%;
      top: calc((5.5 - var(--j)) * 100% / 6);
      transform: rotate(-90deg);
    }

    .sc-back__lbl {
      top: 50%;
      left: auto;
      right: calc(50% + 22px);
      width: auto;
      max-width: 130px;
      transform: translateY(-50%);
      writing-mode: horizontal-tb;
      white-space: normal;
      text-align: right;
      font-size: 13px;
      line-height: 1.35;
    }
  }

  /* ----- Service suivant ----- */
  .sc-next {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-card { transition: none; }
    .sc-card.is-link:hover { transform: none; }

    /* Chevrons gris fixes */
    .sc .sc-cv__lit { animation: none !important; }
  }
</style>
