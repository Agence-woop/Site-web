---
// Bloc « Pourquoi WOOP » d'une page Services : la personne qui s'occupe du service, en photo
// ronde (TeamAvatar, même cadrage que les vignettes de l'accueil), avec son nom et son rôle, son
// texte, un badge et le bouton « Parler à … » (lien de contact de la personne).
// Différent de FounderPortrait (grand portrait des fondateurs, pages Santé et RH).
//
// Props
// - member : la personne (src/data/team.ts) : photo, cadrage, prénom, nom, rôle et contact
// - members : plusieurs personnes (page Réseaux sociaux : Emma et Kevin), en photos rondes côte à
//   côte, chacune avec son nom et son rôle ; remplace member
// - badge : texte du badge (texte simple, les apostrophes et NB restent tels quels dans le HTML)
// - cta : bouton { href, label } (href avec le préfixe base) ; par défaut « Parler à {prénom} »
//   vers le lien de contact de la personne (obligatoire avec members : le paramètre ?personne=
//   de la page Contact ne présélectionne qu'une seule personne)
// Emplacements
// - par défaut : les paragraphes ; le premier porte la classe md-spc__lead (chapeau)
// - badge-icon : le SVG de l'icône du badge
import TeamAvatar from '../team/TeamAvatar.astro';
import CtaIcon from '../CtaIcon.astro';
import PortraitBadge from './PortraitBadge.astro';
import type { TeamMember } from '../../data/team';

interface Link {
  href: string;
  label: string;
}

interface Props {
  member?: TeamMember;
  members?: TeamMember[];
  badge: string;
  cta?: Link;
}

const { member, members, badge, cta } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const duo = members && members.length > 1 ? members : undefined;
const solo = duo ? undefined : (member ?? members?.[0])!;
---
<div class:list={['md-spc', { 'md-spc--duo': duo }, 'md-glass']}>
  {duo ? (
    <div class="md-spc__id md-spc__id--duo" data-reveal="left">
      {duo.map((m) => (
        <div class="md-spc__person">
          <TeamAvatar member={m} class="md-spc__ph" alt={m.firstName} />
          <p class="md-spc__name"><b>{m.fullName}</b><span>{m.roles.card}</span></p>
        </div>
      ))}
    </div>
  ) : (
    <div class="md-spc__id" data-reveal="left">
      <TeamAvatar member={solo} class="md-spc__ph" alt={solo.firstName} />
      <p class="md-spc__name"><b>{solo.fullName}</b><span>{solo.roles.card}</span></p>
    </div>
  )}
  <div class="md-spc__txt" data-reveal="right" data-reveal-step="1">
    <slot />
    <div class="md-spc__foot">
      <PortraitBadge text={badge}><slot name="badge-icon" /></PortraitBadge>
      {cta ? (
        <a class="cta" href={cta.href}>{cta.label}<CtaIcon /></a>
      ) : (
        <a class="cta" href={`${base}${solo.contact}`}>Parler à {solo.firstName}<CtaIcon /></a>
      )}
    </div>
  </div>
</div>

<style>
  .md-spc {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    padding: 32px 22px;
    border-radius: 30px;
  }

  @media (min-width: 768px) {
    .md-spc {
      grid-template-columns: 240px minmax(0, 1fr);
      align-items: center;
      gap: 40px;
      padding: 44px 40px;
    }
  }

  @media (min-width: 1024px) {
    .md-spc {
      grid-template-columns: 280px minmax(0, 1fr);
      gap: 56px;
      padding: 52px 56px;
    }
  }

  /* Photo ronde et nom, centrés */
  .md-spc__id {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  /* Photo ronde : même forme, même anneau et même cadrage que les vignettes de l'accueil (.hp-m__ph) */
  .md-spc__id :global(.md-spc__ph) {
    position: relative;
    display: block;
    overflow: hidden;
    flex: none;
    width: 168px;
    height: 168px;
    border-radius: 50%;
    background: var(--woop-gradient);
    box-shadow: 0 0 0 4px var(--bg-elevated), 0 0 0 6px rgba(230, 43, 127, 0.55), 0 24px 50px rgba(230, 43, 127, 0.22);
  }

  @media (min-width: 1024px) {
    .md-spc__id :global(.md-spc__ph) { width: 200px; height: 200px; }
  }

  .md-spc__id :global(.md-spc__ph img) {
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 0;
    transform: scale(1.55);
    transform-origin: var(--fx, 50%) var(--fy, 30%);
  }

  .md-spc__id :global(.md-spc__ph.is-framed img) {
    object-position: var(--obj-pos, center);
    transform: scale(var(--zoom, 1));
    transform-origin: var(--obj-pos, center);
  }

  /* Plusieurs personnes (members) : photos côte à côte, chacune avec son nom et son rôle */
  @media (min-width: 768px) {
    .md-spc--duo { grid-template-columns: 340px minmax(0, 1fr); }
  }

  @media (min-width: 1024px) {
    .md-spc--duo { grid-template-columns: 420px minmax(0, 1fr); }
  }

  .md-spc__id--duo {
    flex-direction: row;
    justify-content: center;
    align-items: flex-start;
    gap: 20px;
  }

  @media (min-width: 1024px) {
    .md-spc__id--duo { gap: 28px; }
  }

  .md-spc__person {
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    min-width: 0;
  }

  .md-spc__id--duo :global(.md-spc__ph) { width: 132px; height: 132px; }

  /* Téléphone : noms et rôles un peu plus petits pour tenir sur une ligne côte à côte */
  @media (max-width: 599px) {
    .md-spc__id--duo { gap: 12px; }
    .md-spc__id--duo :global(.md-spc__ph) { width: 120px; height: 120px; }
    .md-spc__id--duo .md-spc__name b { font-size: 17px; }
    .md-spc__id--duo .md-spc__name span { font-size: 13px; }
  }

  @media (min-width: 1024px) {
    .md-spc__id--duo :global(.md-spc__ph) { width: 168px; height: 168px; }
  }

  .md-spc__name {
    display: flex;
    flex-direction: column;
    gap: 2px;
    line-height: 1.35;
  }

  .md-spc__name b {
    font-size: 20px;
    font-weight: 700;
    color: var(--text-primary);
  }

  .md-spc__name span {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .md-spc__txt {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }

  .md-spc__txt :global(p) {
    font-size: 16px;
    line-height: 1.7;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  .md-spc__txt :global(p.md-spc__lead) {
    font-size: 19px;
    font-weight: 600;
    line-height: 1.55;
    color: var(--text-primary);
  }

  @media (min-width: 1024px) {
    .md-spc__txt :global(p.md-spc__lead) { font-size: 21px; }
  }

  .md-spc__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    margin-top: 8px;
  }

  /* Badge : composant PortraitBadge (même style que sur les pages Santé et RH) */
</style>
