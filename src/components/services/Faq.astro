---
// Questions fréquentes (pages Services, Test de visibilité) : accordéon en 2 colonnes sur
// ordinateur (dès 900 px), 1 colonne sur téléphone et tablette. Chevron vers le bas quand la
// question est fermée, vers le haut quand elle est ouverte.
//
// - Chaque question est un <details> / <summary> natif : sans JavaScript, toutes les questions
//   s'ouvrent et se ferment au clic et au clavier (Entrée, Espace).
// - À l'arrivée sur la page, toutes les questions sont fermées : aucune ne s'ouvre par défaut. Les
//   réponses restent dans le HTML (<details> fermé), lues par les moteurs et les lecteurs d'écran.
// - Accordéon exclusif : ouvrir une question ferme celle qui était ouverte. La question ouverte peut
//   aussi être refermée (toutes fermées). Les <details> portent le même attribut name
//   (exclusivité native des navigateurs récents) et le script fait de même pour les autres
//   navigateurs.
// - Le script tient à jour aria-expanded sur chaque <summary> (posé seulement quand le script
//   tourne, pour ne jamais annoncer un état faux).
// - Colonnes : la 1re moitié des questions à gauche, la 2de à droite (ordre de lecture conservé
//   en 1 colonne). Chaque colonne est une pile indépendante : ouvrir une question ne décale pas
//   l'autre colonne.
// - Nombre impair de questions : avec `wide`, la dernière question occupe toute la largeur, sous les
//   2 colonnes (ordinateur), pour que les 2 colonnes aient le même nombre de questions et la même
//   hauteur, questions fermées. Ordre de lecture : colonne de gauche, colonne de droite, puis la
//   dernière question (ordre du HTML, identique en 1 colonne).
//
// Props
// - items : liste { q, a } (textes simples ; les apostrophes et NB restent tels quels) ; html,
//   facultatif : la réponse en HTML (par exemple avec un lien), affichée à la place de a (a reste
//   le texte simple, repris par les données structurées FAQPage)
// - name : nom du groupe (attribut name des <details>), unique dans la page
// - left : nombre de questions de la colonne de gauche (par défaut, la moitié arrondie au-dessus,
//   ou la moitié des questions hors la dernière avec `wide`), à régler pour que les 2 colonnes,
//   toutes questions fermées, soient de hauteur équivalente
// - wide : la dernière question sur toute la largeur, sous les 2 colonnes (voir plus haut)
import { text } from '../../utils/html';

interface Item {
  q: string;
  a: string;
  html?: string;
}

interface Props {
  items: Item[];
  name: string;
  left?: number;
  wide?: boolean;
}

const { items, name, left, wide = false } = Astro.props;
// Questions réparties dans les 2 colonnes (toutes sauf la dernière avec `wide`), puis la dernière
const inCols = wide ? items.slice(0, -1) : items;
const half = left ?? Math.ceil(inCols.length / 2);
const columns = [inCols.slice(0, half), inCols.slice(half)];
if (wide) columns.push(items.slice(-1));
---
<div class="md-faq" data-faq data-reveal="up">
  {columns.map((col, c) => (
    <div class:list={['md-faq__col', { 'md-faq__col--wide': c === 2 }]}>
      {col.map((item) => (
        <details class="md-faq__item md-glass" name={name}>
          <summary class="md-faq__q"><span set:html={text(item.q)} /><span class="md-faq__pl" aria-hidden="true"></span></summary>
          <div class="md-faq__a"><p set:html={item.html ?? text(item.a)} /></div>
        </details>
      ))}
    </div>
  ))}
</div>

<script>
  // Accordéon exclusif et aria-expanded (voir l'en-tête du composant).
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((faq) => {
    const items = Array.from(faq.querySelectorAll<HTMLDetailsElement>('details'));
    const sync = () => items.forEach((d) => d.querySelector('summary')?.setAttribute('aria-expanded', String(d.open)));
    items.forEach((d) => {
      d.addEventListener('toggle', () => {
        if (d.open) items.forEach((o) => { if (o !== d && o.open) o.open = false; });
        sync();
      });
    });
    sync();
  });
</script>

<style>
  .md-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .md-faq {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }
  }

  .md-faq__col {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (min-width: 900px) {
    .md-faq__col { gap: 16px; }

    /* Dernière question sur toute la largeur, sous les 2 colonnes (wide) */
    .md-faq__col--wide { grid-column: 1 / -1; }
  }

  .md-faq__item {
    border-radius: 22px;
    transition: box-shadow 300ms ease;
  }

  .md-faq__item[open] { box-shadow: inset 0 0 0 1px rgba(230, 43, 127, 0.45); }

  .md-faq__q {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 20px 22px;
    border-radius: 22px;
    list-style: none;
    cursor: pointer;
    font-size: 17px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .md-faq__q { padding: 22px 26px; }
  }

  .md-faq__q::-webkit-details-marker { display: none; }

  .md-faq__q:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--woop-pink) 55%, var(--text-primary));
    outline-offset: 3px;
  }

  /* Chevron dans un cercle : vers le bas quand la question est fermée, vers le haut quand elle
     est ouverte (petite rotation douce). Jetons --hp-* avec valeur de repli : le composant sert
     aussi sur des pages qui ne les définissent pas (Test de visibilité). */
  .md-faq__pl {
    position: relative;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px var(--hp-line, color-mix(in srgb, var(--text-primary) 14%, transparent));
    color: var(--text-primary);
    transition: background 300ms ease, box-shadow 300ms ease, color 300ms ease;
  }

  .md-faq__pl::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    /* Vers le bas, recentré optiquement */
    transform: translate(-50%, -70%) rotate(45deg);
    transition: transform 300ms ease;
  }

  .md-faq__item[open] .md-faq__pl {
    background: var(--woop-gradient);
    box-shadow: none;
    color: var(--hp-on-grad, var(--bg-deep));
  }

  /* Vers le haut */
  .md-faq__item[open] .md-faq__pl::before { transform: translate(-50%, -30%) rotate(225deg); }

  .md-faq__q:hover .md-faq__pl { box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.6); }

  .md-faq__item[open] .md-faq__q:hover .md-faq__pl { box-shadow: none; }

  .md-faq__a {
    position: relative;
    z-index: 1;
    padding: 0 22px 22px;
  }

  @media (min-width: 768px) {
    .md-faq__a { padding: 0 26px 24px; }
  }

  .md-faq__a p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-secondary);
    text-wrap: pretty;
  }

  @media (prefers-reduced-motion: reduce) {
    .md-faq__item,
    .md-faq__pl,
    .md-faq__pl::before { transition: none; }
  }
</style>
