---
// Étapes « Comment ça se passe » d'une page Services (3 étapes en ligne dès 768 px).
//
// Props
// - steps : liste d'étapes { n, title, text, when?, get?, reveal?, step?, hot? }
//   n : numéro affiché dans la pastille (et lu par les lecteurs d'écran avant le titre) ;
//   when : moment de l'étape (« Semaine 1 »), dans une pastille à droite du numéro ;
//   get : ce que vous recevez à cette étape, dans un encadré en bas de la carte ;
//   reveal, step : apparition au défilement (data-reveal, data-reveal-step) ;
//   hot : pastille pleine (dégradé) pour l'étape mise en avant.
// - columns : 3 (par défaut, en ligne dès 768 px) ou 4 (2 × 2 dès 768 px, en ligne dès 1200 px)
// Pas d'emplacement.
// La page Équipe garde sa propre version (4 étapes, avec icône et sous-texte).
interface Step {
  n: string;
  title: string;
  text: string;
  reveal?: 'left' | 'right' | 'up';
  step?: string;
  hot?: boolean;
  when?: string;
  get?: string;
}

interface Props {
  steps: Step[];
  columns?: 3 | 4;
}

const { steps, columns = 3 } = Astro.props;
---
<ol class:list={['md-steps', { 'md-steps--4': columns === 4 }]}>
  {steps.map((s) => (
    <li class="md-st md-glass" data-reveal={s.reveal} data-reveal-step={s.step}>
      {s.when ? (
        <div class="md-st__top">
          <span class:list={['md-st__d', { 'is-on': s.hot }]} aria-hidden="true">{s.n}</span>
          <span class="md-st__when">{s.when}</span>
        </div>
      ) : (
        <span class:list={['md-st__d', { 'is-on': s.hot }]} aria-hidden="true">{s.n}</span>
      )}
      <h3><span class="visually-hidden">{s.n} </span>{s.title}</h3>
      <p>{s.text}</p>
      {s.get && (
        <p class="md-st__get"><span class="md-st__get-lbl">Vous recevez</span><span>{s.get}</span></p>
      )}
    </li>
  ))}
</ol>

<style>
  .md-steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
    list-style: none;
  }

  @media (min-width: 768px) {
    .md-steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* 4 étapes : 2 × 2 sur tablette, en ligne sur ordinateur */
  @media (min-width: 768px) {
    .md-steps.md-steps--4 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1200px) {
    .md-steps.md-steps--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  .md-st {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px 24px;
    border-radius: 24px;
  }

  @media (min-width: 1024px) {
    .md-st { padding: 30px; }
  }

  .md-st__d {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-weight: 700;
    color: var(--md-pink-soft);
    box-shadow: inset 0 0 0 1.5px rgba(230, 43, 127, 0.55);
  }

  .md-st__d.is-on {
    background: var(--woop-gradient);
    color: var(--hp-on-grad);
    box-shadow: 0 8px 22px rgba(230, 43, 127, 0.35);
  }

  .md-st h3 {
    margin-top: 6px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    color: var(--text-primary);
  }

  .md-st p {
    line-height: 1.55;
    color: var(--text-secondary);
    /* Pas de mot seul en fin de paragraphe */
    text-wrap: pretty;
  }

  /* Numéro et moment de l'étape (« Semaine 1 ») sur la même ligne */
  .md-st__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .md-st__when {
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: right;
    color: var(--md-pink-soft);
    box-shadow: inset 0 0 0 1px rgba(230, 43, 127, 0.4);
  }

  /* Ce que vous recevez : encadré en bas de la carte */
  .md-st p.md-st__get {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
    padding: 14px 16px;
    border-radius: 14px;
    background: linear-gradient(120deg, rgba(250, 98, 68, 0.14), rgba(230, 43, 127, 0.16));
    font-size: 15px;
    font-weight: 600;
    line-height: 1.45;
    color: var(--text-primary);
  }

  .md-st__get-lbl {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--md-pink-soft);
  }

  /* L'encadré se cale en bas : un écart avant lui, même si les textes n'ont pas la même longueur */
  .md-steps--4 .md-st h3 + p { margin-bottom: 8px; }
</style>
