---
interface Props {
  size?: number;
}

const { size = 14 } = Astro.props;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class="icon-chevron"
>
  <path d="M9 18l6-6-6-6" />
</svg>

<style>
  .icon-chevron {
    display: inline-block;
    vertical-align: middle;
    flex-shrink: 0;
  }
</style>
