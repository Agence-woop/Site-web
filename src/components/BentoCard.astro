---
interface Props {
  variant: 'pink' | 'orange' | 'gradient' | 'outline';
  size?: 'default' | 'large' | 'wide';
  class?: string;
}

const { variant, size = 'default', class: className } = Astro.props;
---
<div class:list={['bento', `bento--${variant}`, `bento--${size}`, className]}>
  <slot />
</div>

<style>
  .bento {
    border-radius: var(--radius-bento);
    padding: 28px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    position: relative;
    overflow: hidden;
    min-height: 180px;
  }

  .bento--pink {
    background: var(--woop-pink);
    color: #fff;
  }

  .bento--orange {
    background: var(--woop-orange);
    color: #fff;
  }

  .bento--gradient {
    background: var(--woop-gradient);
    color: #fff;
  }

  .bento--outline {
    background: transparent;
    border: 1px solid var(--border-accent);
    color: var(--text-primary);
  }

  .bento--outline::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--woop-gradient);
  }

  .bento--large {
    min-height: 320px;
  }

  @media (min-width: 768px) {
    .bento--large {
      min-height: 380px;
    }
  }

  .bento :global(.bento__label) {
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 700;
    opacity: 0.82;
    margin-bottom: 8px;
  }

  .bento--outline :global(.bento__label) {
    color: var(--woop-pink);
    opacity: 1;
  }

  .bento :global(.bento__title) {
    font-family: var(--font-display);
    font-size: 28px;
    text-transform: uppercase;
    line-height: 0.95;
  }

  .bento :global(.bento__title-xl) {
    font-family: var(--font-display);
    font-size: 40px;
    text-transform: uppercase;
    line-height: 0.9;
  }

  @media (min-width: 768px) {
    .bento :global(.bento__title-xl) {
      font-size: 56px;
    }
  }

  @media (min-width: 1024px) {
    .bento :global(.bento__title-xl) {
      font-size: 72px;
    }
  }

  .bento :global(.bento__text) {
    font-size: 14px;
    line-height: 1.5;
    opacity: 0.92;
    margin-top: 12px;
  }

  @media (min-width: 1024px) {
    .bento :global(.bento__text) { font-size: 16px; }
  }

  .bento--outline :global(.bento__text) {
    color: var(--text-secondary);
    opacity: 1;
  }

  .bento :global(.bento__tag) {
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    margin-top: 16px;
    padding: 6px 14px;
    border-radius: 100px;
    align-self: flex-start;
  }

  .bento--pink :global(.bento__tag),
  .bento--orange :global(.bento__tag),
  .bento--gradient :global(.bento__tag) {
    background: rgba(10, 10, 15, 0.25);
    color: #fff;
  }

  .bento--outline :global(.bento__tag) {
    background: rgba(230, 43, 127, 0.12);
    color: var(--woop-pink);
  }
</style>
