---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ArticleCard from './ArticleCard.astro';
import {
  categoryLabels,
  categoryTaglines,
  getCtaForCategory,
  type CategoryKey,
} from '../../data/categories';

interface Props {
  category: CategoryKey;
}

const { category } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const label = categoryLabels[category];
const tagline = categoryTaglines[category];
const cta = getCtaForCategory(category, base);

const posts = await getCollection('blog', ({ data }) =>
  (import.meta.env.PROD ? !data.brouillon : true) && data.categoriePrincipale === category,
);

const sortedPosts = posts.sort(
  (a, b) => b.data.datePublication.getTime() - a.data.datePublication.getTime(),
);

const thematiquesSet = new Set<string>();
sortedPosts.forEach((post) => {
  (post.data.thematiques ?? []).forEach((t) => thematiquesSet.add(t));
});
const thematiques = Array.from(thematiquesSet).sort((a, b) => a.localeCompare(b, 'fr'));

const pageTitle = `${label} | Blog WOOP`;
const description = `${label}. ${tagline}`;
---
<Layout title={pageTitle} description={description}>

  <!-- Entête de catégorie -->
  <section class="hub-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Fil d'Ariane">
        <a href={`${base}/blog`} class="breadcrumb__link">Blog</a>
        <span class="breadcrumb__sep" aria-hidden="true">/</span>
        <span class="breadcrumb__current">{label}</span>
      </nav>
      <span class={`hub-category-badge hub-category-badge--${category}`}>{label}</span>
      <h1 class="hub-title">{label}</h1>
      <p class="hub-tagline">{tagline}</p>
    </div>
  </section>

  <!-- Filtre par thématique (côté client) -->
  {thematiques.length > 0 && (
    <section class="hub-filter">
      <div class="container">
        <span class="hub-filter__label">Thématiques</span>
        <div class="hub-filter__list" role="group" aria-label="Filtrer par thématique">
          <button type="button" class="hub-pill is-active" data-filter="all">Toutes</button>
          {thematiques.map((t) => (
            <button type="button" class="hub-pill" data-filter={t}>{t}</button>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Grille d'articles -->
  <section class="hub-list">
    <div class="container">
      {sortedPosts.length > 0 ? (
        <div class="hub-grid">
          {sortedPosts.map((post) => (
            <ArticleCard post={post} />
          ))}
        </div>
      ) : (
        <p class="hub-empty">Les premiers articles arrivent bientôt. Revenez nous voir.</p>
      )}
    </div>
  </section>

  <!-- Appel à l'action de pôle -->
  <section class="hub-cta-section">
    <div class="container">
      <div class="hub-cta-card">
        <div class="hub-cta-card__copy">
          <span class="hub-cta-card__eyebrow">Vous voulez en discuter ?</span>
          <p class="hub-cta-card__text">Réservez un appel découverte de 30 minutes, sans engagement.</p>
        </div>
        <a class="btn btn--cta-card" href={cta.href}>
          {cta.label}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-article-thematiques]');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter ?? 'all';
      filterButtons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      cards.forEach((card) => {
        if (filter === 'all') {
          card.removeAttribute('hidden');
          return;
        }
        const themes = (card.dataset.articleThematiques ?? '').split('|').filter(Boolean);
        if (themes.includes(filter)) {
          card.removeAttribute('hidden');
        } else {
          card.setAttribute('hidden', '');
        }
      });
    });
  });
</script>

<style>
  /* ===== Entête de catégorie ===== */
  .hub-header {
    padding: 32px 0 24px;
  }

  @media (min-width: 768px) {
    .hub-header { padding: 48px 0 32px; }
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 20px;
  }

  .breadcrumb__link {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 200ms ease;
  }

  .breadcrumb__link:hover { color: var(--text-primary); }
  .breadcrumb__sep { opacity: 0.5; }
  .breadcrumb__current { color: var(--woop-pink); }

  .hub-category-badge {
    display: inline-flex;
    align-items: center;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 700;
    padding: 6px 14px;
    border-radius: 100px;
    color: #fff;
    margin-bottom: 16px;
    background: var(--woop-gradient);
  }

  .hub-category-badge--sante { background: var(--woop-gradient); }
  .hub-category-badge--recrutement { background: var(--woop-gradient); }
  .hub-category-badge--strategie-marque { background: var(--woop-gradient); }

  .hub-title {
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 38px;
    line-height: 1;
    margin-bottom: 16px;
    background: var(--woop-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    max-width: 880px;
  }

  @media (min-width: 768px) {
    .hub-title { font-size: 56px; }
  }

  @media (min-width: 1024px) {
    .hub-title { font-size: 72px; }
  }

  .hub-tagline {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0;
  }

  @media (min-width: 768px) {
    .hub-tagline { font-size: 18px; }
  }

  @media (min-width: 1024px) {
    .hub-tagline { font-size: 20px; }
  }

  /* ===== Filtre par thématique ===== */
  .hub-filter {
    padding: 16px 0 8px;
  }

  .hub-filter__label {
    display: block;
    font-size: 11px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-weight: 700;
    margin-bottom: 12px;
  }

  .hub-filter__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .hub-pill {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 100px;
    padding: 8px 16px;
    cursor: pointer;
    transition: color 200ms ease, border-color 200ms ease, background 200ms ease;
  }

  .hub-pill:hover {
    color: var(--text-primary);
    border-color: var(--woop-pink);
  }

  .hub-pill:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 2px;
  }

  .hub-pill.is-active {
    background: var(--woop-pink);
    border-color: var(--woop-pink);
    color: #fff;
  }

  /* ===== Liste des articles ===== */
  .hub-list {
    padding: 24px 0 48px;
  }

  @media (min-width: 768px) {
    .hub-list { padding: 32px 0 64px; }
  }

  .hub-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (min-width: 640px) {
    .hub-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  @media (min-width: 1024px) {
    .hub-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .hub-empty {
    font-size: 16px;
    color: var(--text-secondary);
    background: var(--bg-card);
    border: 1px dashed var(--border-subtle);
    border-radius: var(--radius-bento);
    padding: 32px;
    text-align: center;
    margin: 0;
  }

  /* ===== Appel à l'action de pôle ===== */
  .hub-cta-section {
    padding: 16px 0 80px;
  }

  .hub-cta-card {
    background: var(--woop-gradient);
    border-radius: var(--radius-bento);
    padding: 28px 24px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    color: #fff;
  }

  @media (min-width: 768px) {
    .hub-cta-card {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 32px;
      gap: 32px;
    }
  }

  .hub-cta-card__copy { flex: 1; }

  .hub-cta-card__eyebrow {
    display: block;
    font-family: var(--font-display);
    text-transform: uppercase;
    font-size: 18px;
    line-height: 1;
    margin-bottom: 6px;
    color: #fff;
  }

  @media (min-width: 768px) {
    .hub-cta-card__eyebrow { font-size: 22px; }
  }

  .hub-cta-card__text {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.5;
    margin: 0;
  }

  .btn--cta-card {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #fff;
    color: var(--woop-pink);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    padding: 14px 24px;
    border-radius: 100px;
    text-decoration: none;
    transition: transform 200ms ease, box-shadow 200ms ease;
    flex-shrink: 0;
  }

  .btn--cta-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.2);
  }

  @media (prefers-reduced-motion: reduce) {
    .hub-pill,
    .btn--cta-card,
    .breadcrumb__link {
      transition: none;
    }
    .btn--cta-card:hover { transform: none; }
  }
</style>
