---
import ChevronRight from './ChevronRight.astro';

interface Props {
  variant?: 'primary' | 'secondary' | 'tertiary';
  href?: string;
  tag?: 'a' | 'button';
}

const { variant = 'primary', href, tag } = Astro.props;
const Tag = tag ?? (href ? 'a' : 'button');
---
<Tag
  class:list={['btn', `btn--${variant}`]}
  href={href}
  role={Tag === 'a' ? undefined : 'button'}
>
  <slot />
  <ChevronRight size={14} />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 14px;
    border: none;
    cursor: pointer;
    transition: transform 300ms ease, box-shadow 300ms ease;
    white-space: nowrap;
    text-decoration: none;
  }

  .btn:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 3px;
  }

  .btn--primary {
    background: var(--woop-gradient);
    color: #fff;
    padding: 14px 28px;
    border-radius: var(--radius-button);
  }

  .btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(230, 43, 127, 0.3);
  }

  .btn--secondary {
    position: relative;
    color: var(--text-primary);
    padding: 14px 28px;
    border-radius: var(--radius-button);
    background: linear-gradient(var(--bg-deep), var(--bg-deep)) padding-box,
                linear-gradient(90deg, #FA6244 0%, #E62B7F 100%) border-box;
    border: 1.5px solid transparent;
  }

  .btn--secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(230, 43, 127, 0.2);
  }

  .btn--tertiary {
    background: transparent;
    color: var(--woop-pink);
    padding: 0;
    font-weight: 600;
  }

  .btn--tertiary:hover {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn {
      transition: none;
    }
    .btn--primary:hover,
    .btn--secondary:hover,
    .btn--tertiary:hover {
      transform: none;
    }
  }
</style>
