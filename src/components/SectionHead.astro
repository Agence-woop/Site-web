---
// En-tête de section : surtitre numéroté (« 01 · Pour qui ? »), titre (emplacement par défaut,
// avec le mot en dégradé <span class="gradient-accent">) et intro.
// - reveal : apparition au défilement (surtitre et titre depuis la gauche, intro juste après) ;
//   false pour un en-tête sans animation (bloc déjà animé dans son ensemble).
// - plus : titre en deux mots reliés par un + dans un cercle (« Marque + performance »).
// - class : classe du conteneur (hp-head par défaut). Une autre classe reste stylée par la page :
//   l'attribut de portée de la page est alors reposé sur le conteneur (voir src/utils/scope.ts).
// - Le surtitre et l'intro sont des textes simples (les apostrophes restent telles quelles).
import { text } from '../utils/html';
import { parentScope } from '../utils/scope';

interface Props {
  over?: string;
  intro?: string;
  reveal?: boolean;
  plus?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { over, intro, reveal = true, plus = false, class: wrapperClass, ...rest } = Astro.props;
const scope = wrapperClass ? parentScope(rest) : {};
const side = reveal ? 'left' : undefined;
const step = reveal ? '1' : undefined;
---
<div class={wrapperClass ?? 'hp-head'} {...scope}>
  {over && <p class="md-over" data-reveal={side} set:html={text(over)} />}
  <h2 class:list={['section-title', 'hp-title', { 'hp-title--plus': plus }]} data-reveal={side}><slot /></h2>
  {intro && <p class="hp-head__intro" data-reveal={side} data-reveal-step={step} set:html={text(intro)} />}
</div>

<style>
  .hp-head {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--home-head-gap);
    margin-bottom: var(--home-head-content);
  }

  .hp-title {
    margin-bottom: 0;
    line-height: 1.02;
    color: var(--text-primary);
    text-wrap: balance;
    overflow-wrap: break-word;
    max-width: 100%;
  }

  /* « Marque + performance » : le + dans un cercle blanc plein, centré sur la hauteur du titre */
  .hp-title--plus {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.28em;
    row-gap: 0.08em;
  }

  .hp-head__intro {
    max-width: 760px;
    color: var(--text-secondary);
    font-size: 17px;
    line-height: 1.6;
  }

  @media (min-width: 1024px) {
    .hp-head__intro { font-size: 19px; }
  }

  /* Surtitre numéroté (01 · Pour qui ?) : rose éclairci, comme l'accroche du hero de l'accueil */
  .md-over {
    margin-bottom: -4px;
    font-family: var(--font-body);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--md-pink-soft);
  }

  /* Pas de mot seul en fin de paragraphe */
  p { text-wrap: pretty; }
</style>
