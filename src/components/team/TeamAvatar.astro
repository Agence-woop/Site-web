---
// Photo ronde d'un membre de l'équipe, avec son cadrage (src/data/team.ts).
// Le composant n'a pas de style propre : la forme et la taille viennent de la page (classes et
// sélecteurs existants : .hp-avs > span, .hp-m__ph, .eq-hub__ph…).
//
// HTML identique à celui écrit auparavant dans les pages :
// - portée CSS : Astro transmet au composant l'attribut data-astro-cid-… de la page qui l'utilise ;
//   il est reposé, sans valeur et en dernier, sur le conteneur ET sur l'image, comme avant ;
// - éléments statiques (pas de balise dynamique) pour garder l'ordre des attributs ;
// - alt vide écrit alt="" (une valeur vide dynamique donnerait un attribut alt sans valeur).
// - espaces : la version div (vignettes de l'accueil) avait une espace avant et après l'image dans
//   le HTML compilé, reproduite par {' '} ; la version span est écrite d'un seul tenant.
import { isFramed, framingStyle, type TeamMember } from '../../data/team';

interface Props {
  member: TeamMember;
  /** Élément conteneur (span par défaut) */
  as?: 'span' | 'div';
  class?: string;
  alt?: string;
  /** Chargement de l'image ; null pour ne pas poser l'attribut */
  loading?: 'lazy' | 'eager' | null;
  [key: string]: unknown;
}

const { member, as = 'span', class: className, alt = '', loading = 'lazy', ...rest } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const scope = Object.fromEntries(Object.keys(rest).filter((k) => k.startsWith('data-astro-cid-')).map((k) => [k, '']));
const src = `${base}/images/${member.img}.webp`;
const cls = [className, { 'is-framed': isFramed(member.round) }];
const style = framingStyle(member.round);
const lazy = loading ?? undefined;
---
{as === 'div' ? (
  <div class:list={cls} style={style} {...scope}>{' '}{alt ? <img src={src} alt={alt} width={member.width} height={member.height} loading={lazy} decoding="async" {...scope} /> : <img src={src} alt="" width={member.width} height={member.height} loading={lazy} decoding="async" {...scope} />}{' '}</div>
) : (
  <span class:list={cls} style={style} {...scope}>{alt ? <img src={src} alt={alt} width={member.width} height={member.height} loading={lazy} decoding="async" {...scope} /> : <img src={src} alt="" width={member.width} height={member.height} loading={lazy} decoding="async" {...scope} />}</span>
)}
