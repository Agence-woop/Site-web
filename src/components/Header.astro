---
import Logo from './Logo.astro';
import Button from './Button.astro';

const base = import.meta.env.BASE_URL;

const navItems = [
  { label: 'Marketing Santé & Médical', href: `${base}/services-medical` },
  { label: 'Marketing RH & Recrutement', href: `${base}/services-recrutement` },
  { label: 'Équipe', href: `${base}/equipe` },
  { label: 'Contact', href: `${base}/contact` },
  { label: 'Blog (Bientôt)', href: '#', disabled: true },
];
---
<header class="header" id="header">
  <nav class="header__nav container" aria-label="Navigation principale">
    <a href={`${base}/`} class="header__logo" aria-label="WOOP - Accueil">
      <Logo size="md" />
    </a>

    <button
      class="header__burger"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Ouvrir le menu"
    >
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>

    <div class="header__menu" id="nav-menu" role="dialog" aria-label="Menu de navigation">
      <ul class="header__links">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['header__link', { 'header__link--disabled': item.disabled }]}
              aria-disabled={item.disabled ? 'true' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <Button variant="primary" href={`${base}/contact`}>
        R&eacute;server un appel d&eacute;couverte
      </Button>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px 0;
    transition: background 300ms ease;
  }

  .header--scrolled {
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .header__logo {
    text-decoration: none;
    flex-shrink: 0;
    z-index: 101;
  }

  .header__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
  }

  .header__burger-line {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(2) {
    opacity: 0;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header__menu {
    display: none;
  }

  .header__menu--open {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 15, 0.97);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    padding: 100px 32px 48px;
    gap: 32px;
    align-items: flex-start;
    z-index: 99;
  }

  .header__links {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  .header__link {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 200ms ease;
    display: block;
    padding: 4px 0;
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--text-primary);
  }

  .header__link--disabled {
    opacity: 0.5;
    pointer-events: none;
  }

  @media (min-width: 1100px) {
    .header__burger {
      display: none;
    }

    .header__menu {
      display: flex;
      align-items: center;
      gap: 24px;
      flex: 1;
      justify-content: flex-end;
    }

    .header__links {
      flex-direction: row;
      gap: 28px;
      width: auto;
    }

    .header__link {
      font-size: 13px;
      padding: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__burger-line {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('header');
  const burger = header?.querySelector('.header__burger');
  const menu = header?.querySelector('.header__menu');

  function toggleMenu() {
    const expanded = burger?.getAttribute('aria-expanded') === 'true';
    burger?.setAttribute('aria-expanded', String(!expanded));
    burger?.setAttribute('aria-label', expanded ? 'Ouvrir le menu' : 'Fermer le menu');
    menu?.classList.toggle('header__menu--open', !expanded);
    document.body.style.overflow = expanded ? '' : 'hidden';
  }

  burger?.addEventListener('click', toggleMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
      burger?.focus();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (burger?.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  });

  let lastScroll = 0;
  window.addEventListener('scroll', () => {
    header?.classList.toggle('header--scrolled', window.scrollY > 40);
    lastScroll = window.scrollY;
  }, { passive: true });
</script>
