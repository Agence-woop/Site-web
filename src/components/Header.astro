---
import Button from './Button.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface NavChild {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href: string;
  children?: NavChild[];
}

const navItems: NavItem[] = [
  { label: 'Santé & Médical', href: `${base}/services-medical` },
  { label: 'RH & Recrutement', href: `${base}/services-recrutement` },
  { label: 'Équipe', href: `${base}/equipe` },
  { label: 'Contact', href: `${base}/contact` },
  {
    label: 'Blog',
    href: `${base}/blog`,
    children: [
      { label: 'Santé & Médical', href: `${base}/blog/sante` },
      { label: 'Recrutement & RH', href: `${base}/blog/recrutement` },
      { label: 'Stratégie & Marque', href: `${base}/blog/strategie-marque` },
    ],
  },
];
---
<header class="header" id="header">
  <nav class="header__nav container" aria-label="Navigation principale">
    <a href={`${base}/`} class="header__logo" aria-label="WOOP - Accueil">
      <img src={`${base}/images/logo-woop.png`} alt="WOOP" class="header__logo-img" width="181" height="44" />
    </a>

    <button
      class="header__burger"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Ouvrir le menu"
    >
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>

    <div class="header__menu" id="nav-menu" role="dialog" aria-label="Menu de navigation">
      <ul class="header__links">
        {navItems.map((item) => (
          <li class:list={['header__item', item.children && 'header__item--has-children']}>
            <a href={item.href} class="header__link">
              {item.label}
              {item.children && (
                <svg class="header__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M6 9l6 6 6-6" />
                </svg>
              )}
            </a>
            {item.children && (
              <ul class="header__submenu">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="header__sublink">{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="header__actions">
        <Button variant="primary" href={`${base}/contact`}>
          R&eacute;server un appel d&eacute;couverte
        </Button>
        <a href="https://www.linkedin.com/company/106509640" target="_blank" rel="noopener noreferrer" class="header__linkedin" aria-label="LinkedIn de l'Agence WOOP">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px 0;
    transition: background 300ms ease;
  }

  .header--scrolled {
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .header__logo {
    text-decoration: none;
    flex-shrink: 0;
    z-index: 101;
  }

  .header__logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  .header__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
  }

  .header__burger-line {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(2) {
    opacity: 0;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header__menu {
    display: none;
  }

  .header__menu--open {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 15, 0.97);
    padding: 100px 32px 48px;
    gap: 32px;
    align-items: flex-start;
    z-index: 99;
    overflow-y: auto;
  }

  .header__links {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .header__item {
    list-style: none;
  }

  .header__link {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 200ms ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    text-decoration: none;
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--text-primary);
  }

  .header__chevron {
    transition: transform 200ms ease;
    flex-shrink: 0;
  }

  /* Sous-menu : sur mobile, liste inline indentée sous le lien parent */
  .header__submenu {
    list-style: none;
    padding: 12px 0 0 16px;
    margin: 8px 0 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    border-left: 1px solid var(--border-subtle);
  }

  .header__submenu li {
    list-style: none;
  }

  .header__sublink {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 2px 0;
    transition: color 200ms ease;
  }

  .header__sublink:hover,
  .header__sublink:focus-visible {
    color: var(--text-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header__linkedin {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--woop-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: transform 300ms ease, box-shadow 300ms ease;
    flex-shrink: 0;
  }

  .header__linkedin:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(230, 43, 127, 0.35);
  }

  @media (min-width: 1100px) {
    .header__burger {
      display: none;
    }

    .header__menu {
      display: flex;
      align-items: center;
      gap: 24px;
      flex: 1;
      justify-content: flex-end;
    }

    .header__links {
      flex-direction: row;
      align-items: center;
      gap: 28px;
      width: auto;
    }

    .header__item {
      position: relative;
    }

    .header__link {
      font-size: 13px;
      padding: 8px 0;
    }

    /* Sous-menu desktop : panneau flottant révélé au survol et au focus */
    .header__submenu {
      position: absolute;
      top: calc(100% + 6px);
      left: -16px;
      background: rgba(10, 10, 15, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 12px;
      margin: 0;
      gap: 4px;
      min-width: 240px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 200ms ease, visibility 200ms ease, transform 200ms ease;
      z-index: 102;
    }

    .header__item--has-children:hover .header__submenu,
    .header__item--has-children:focus-within .header__submenu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .header__item--has-children:hover .header__chevron,
    .header__item--has-children:focus-within .header__chevron {
      transform: rotate(180deg);
    }

    .header__sublink {
      font-size: 14px;
      padding: 10px 14px;
      border-radius: 8px;
      width: 100%;
      transition: color 200ms ease, background 200ms ease;
    }

    .header__sublink:hover,
    .header__sublink:focus-visible {
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__burger-line,
    .header__linkedin,
    .header__chevron,
    .header__submenu {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('header');
  const burger = header?.querySelector('.header__burger') as HTMLButtonElement | null;
  const menu = header?.querySelector('.header__menu') as HTMLElement | null;

  function toggleMenu() {
    const expanded = burger?.getAttribute('aria-expanded') === 'true';
    burger?.setAttribute('aria-expanded', String(!expanded));
    burger?.setAttribute('aria-label', expanded ? 'Ouvrir le menu' : 'Fermer le menu');
    menu?.classList.toggle('header__menu--open', !expanded);
    document.body.style.overflow = expanded ? '' : 'hidden';
  }

  burger?.addEventListener('click', toggleMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
      burger?.focus();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (burger?.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  });

  window.addEventListener('scroll', () => {
    header?.classList.toggle('header--scrolled', window.scrollY > 40);
  }, { passive: true });
</script>
