---
import Button from './Button.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface NavChild {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  /* Sans href : l'entrée n'est pas une page, c'est un bouton qui ouvre son sous-menu. */
  href?: string;
  children?: NavChild[];
}

const navItems: NavItem[] = [
  {
    label: "Secteurs d'activité",
    children: [
      { label: 'Santé & Médical', href: `${base}/services-medical` },
      { label: 'RH & Recrutement', href: `${base}/services-recrutement` },
    ],
  },
  { label: 'Test de visibilité', href: `${base}/acquisition-client` },
  { label: 'Équipe', href: `${base}/equipe` },
  { label: 'Contact', href: `${base}/contact` },
  {
    label: 'Blog',
    href: `${base}/blog`,
    children: [
      { label: 'Santé & Médical', href: `${base}/blog/sante` },
      { label: 'Recrutement & RH', href: `${base}/blog/recrutement` },
      { label: 'Stratégie & Marque', href: `${base}/blog/strategie-marque` },
    ],
  },
];
---
<header class="header" id="header">
  <nav class="header__nav container" aria-label="Navigation principale">
    <a href={`${base}/`} class="header__logo" aria-label="WOOP - Accueil">
      <img src={`${base}/images/logo-woop.png`} alt="WOOP" class="header__logo-img" width="181" height="44" />
    </a>

    <button
      class="header__burger"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Ouvrir le menu"
    >
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
      <span class="header__burger-line"></span>
    </button>

    <div class="header__menu" id="nav-menu" role="dialog" aria-label="Menu de navigation">
      <ul class="header__links">
        {navItems.map((item, idx) => (
          <li class:list={['header__item', item.children && 'header__item--has-children', !item.href && 'header__item--trigger']}>
            <div class="header__item-head">
              {item.href ? (
                <a href={item.href} class="header__link">{item.label}</a>
              ) : (
                <button
                  type="button"
                  class="header__link header__trigger"
                  aria-expanded="false"
                  aria-controls={`header-submenu-${idx}`}
                >
                  {item.label}
                  <svg class="header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              )}
              {item.children && item.href && (
                <button
                  type="button"
                  class="header__toggle"
                  aria-expanded="false"
                  aria-controls={`header-submenu-${idx}`}
                  aria-label={`Dérouler le sous-menu ${item.label}`}
                >
                  <svg class="header__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
              )}
            </div>
            {item.children && (
              <ul class="header__submenu" id={`header-submenu-${idx}`}>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="header__sublink">{child.label}</a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="header__actions">
        <Button variant="primary" href={`${base}/contact`}>
          R&eacute;server un appel d&eacute;couverte
        </Button>
        <a href="tel:+14388152295" class="header__linkedin" aria-label="Nous appeler au 438 815 2295" title="Nous appeler au (438) 815-2295">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
          </svg>
        </a>
      </div>
    </div>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 16px 0;
    transition: background 300ms ease;
  }

  .header--scrolled {
    background: rgba(10, 10, 15, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .header__logo {
    text-decoration: none;
    flex-shrink: 0;
    z-index: 101;
  }

  .header__logo-img {
    height: 44px;
    width: auto;
    display: block;
  }

  .header__burger {
    display: flex;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    z-index: 101;
  }

  .header__burger-line {
    width: 24px;
    height: 2px;
    background: var(--text-primary);
    transition: transform 300ms ease, opacity 300ms ease;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(2) {
    opacity: 0;
  }

  .header__burger[aria-expanded="true"] .header__burger-line:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .header__menu {
    display: none;
  }

  .header__menu--open {
    display: flex;
    flex-direction: column;
    position: fixed;
    inset: 0;
    background: rgba(10, 10, 15, 0.97);
    padding: 100px 32px 48px;
    gap: 32px;
    align-items: flex-start;
    z-index: 99;
    overflow-y: auto;
  }

  .header__links {
    display: flex;
    flex-direction: column;
    gap: 20px;
    width: 100%;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .header__item {
    list-style: none;
  }

  .header__item-head {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .header__link {
    font-size: 18px;
    font-weight: 500;
    color: var(--text-secondary);
    transition: color 200ms ease;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    text-decoration: none;
  }

  .header__link:hover,
  .header__link:focus-visible {
    color: var(--text-primary);
  }

  /* « Secteurs d'activité » : bouton qui a l'apparence d'un lien du menu, avec son chevron */
  .header__trigger {
    background: none;
    border: none;
    font-family: inherit;
    line-height: inherit;
    cursor: pointer;
    border-radius: 6px;
  }

  .header__trigger:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 4px;
  }

  .header__trigger[aria-expanded="true"] {
    color: var(--text-primary);
  }

  .header__trigger[aria-expanded="true"] .header__chevron {
    transform: rotate(180deg);
  }

  /* Bouton de bascule du sous-menu (mobile : clic ; desktop : indicateur visuel + clavier) */
  .header__toggle {
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 8px;
    margin: -4px 0 -4px 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    transition: color 200ms ease, background 200ms ease;
  }

  .header__toggle:hover,
  .header__toggle:focus-visible {
    color: var(--text-primary);
  }

  .header__toggle:focus-visible {
    outline: 2px solid var(--woop-pink);
    outline-offset: 2px;
  }

  .header__chevron {
    transition: transform 200ms ease;
    flex-shrink: 0;
  }

  /* Chevron en position fermée par défaut, ouvert quand le bouton est expanded */
  .header__toggle[aria-expanded="true"] .header__chevron {
    transform: rotate(180deg);
  }

  /*
   * Sous-menu mobile : replié par défaut, déroulé quand l'item parent
   * porte la classe .header__item--open (gérée par le script de bascule).
   */
  .header__submenu {
    list-style: none;
    padding: 12px 0 0 16px;
    margin: 8px 0 0;
    display: none;
    flex-direction: column;
    gap: 14px;
    border-left: 1px solid var(--border-subtle);
  }

  .header__item--open > .header__submenu {
    display: flex;
  }

  .header__submenu li {
    list-style: none;
  }

  .header__sublink {
    font-size: 15px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 2px 0;
    transition: color 200ms ease;
  }

  .header__sublink:hover,
  .header__sublink:focus-visible {
    color: var(--text-primary);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header__linkedin {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--woop-gradient);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    transition: transform 300ms ease, box-shadow 300ms ease;
    flex-shrink: 0;
  }

  .header__linkedin:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(230, 43, 127, 0.35);
  }

  @media (min-width: 1100px) {
    .header__burger {
      display: none;
    }

    .header__menu {
      display: flex;
      align-items: center;
      gap: 24px;
      flex: 1;
      justify-content: flex-end;
    }

    .header__links {
      flex-direction: row;
      align-items: center;
      gap: 28px;
      width: auto;
    }

    .header__item {
      position: relative;
    }

    .header__link {
      font-size: 13px;
      padding: 8px 0;
    }

    /*
     * Sous-menu desktop : panneau flottant révélé au survol et au focus.
     * top: calc(100% + 24px) pour laisser un écart net avec la barre de
     * navigation (et le bouton « Réserver un appel découverte » qui est
     * plus haut que le texte des liens).
     */
    .header__submenu {
      position: absolute;
      top: calc(100% + 24px);
      left: -16px;
      background: rgba(10, 10, 15, 0.97);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: 14px;
      padding: 12px;
      margin: 0;
      gap: 4px;
      min-width: 240px;
      opacity: 0;
      visibility: hidden;
      transform: translateY(8px);
      transition: opacity 200ms ease, visibility 200ms ease, transform 200ms ease;
      z-index: 102;
      /* Sur desktop on garde display: flex pour que le hover puisse animer */
      display: flex;
    }

    /* Blog : sous-menu révélé au survol et au focus (CSS pur, inchangé). */
    .header__item--has-children:not(.header__item--trigger):hover .header__submenu,
    .header__item--has-children:not(.header__item--trigger):focus-within .header__submenu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }

    .header__item--has-children:not(.header__item--trigger):hover .header__chevron,
    .header__item--has-children:not(.header__item--trigger):focus-within .header__chevron {
      transform: rotate(180deg);
    }

    /*
     * « Secteurs d'activité » : ouvert quand son bouton est déplié (survol, clic, clavier).
     * La visibilité bascule tout de suite à l'ouverture (liens atteignables au clavier sans attendre
     * la fin du fondu) et seulement après le fondu à la fermeture.
     */
    .header__item--trigger .header__submenu {
      transition: opacity 200ms ease, transform 200ms ease, visibility 0s linear 200ms;
    }

    .header__item--trigger.header__item--open .header__submenu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-delay: 0s;
    }

    /* Pont invisible entre le bouton et le panneau, pour ne pas le refermer en descendant la souris */
    .header__item--trigger .header__submenu::before {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 100%;
      height: 26px;
    }

    .header__sublink {
      font-size: 14px;
      padding: 10px 14px;
      border-radius: 8px;
      width: 100%;
      transition: color 200ms ease, background 200ms ease;
    }

    /* Au survol et au focus, fond en dégradé WOOP + texte blanc */
    .header__sublink:hover,
    .header__sublink:focus-visible {
      background: var(--woop-gradient);
      color: #fff;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .header,
    .header__burger-line,
    .header__linkedin,
    .header__chevron,
    .header__submenu {
      transition: none;
    }
  }
</style>

<script>
  const header = document.getElementById('header');
  const burger = header?.querySelector('.header__burger') as HTMLButtonElement | null;
  const menu = header?.querySelector('.header__menu') as HTMLElement | null;

  function toggleMenu() {
    const expanded = burger?.getAttribute('aria-expanded') === 'true';
    burger?.setAttribute('aria-expanded', String(!expanded));
    burger?.setAttribute('aria-label', expanded ? 'Ouvrir le menu' : 'Fermer le menu');
    menu?.classList.toggle('header__menu--open', !expanded);
    document.body.style.overflow = expanded ? '' : 'hidden';
  }

  burger?.addEventListener('click', toggleMenu);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') {
      toggleMenu();
      burger?.focus();
    }
  });

  menu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      if (burger?.getAttribute('aria-expanded') === 'true') {
        toggleMenu();
      }
    });
  });

  // Bouton chevron : bascule l'état déroulé/replié du sous-menu (mobile).
  // Sur desktop, le sous-menu est piloté par hover/focus-within (CSS pur)
  // et cette bascule reste sans effet visible.
  menu?.querySelectorAll<HTMLButtonElement>('.header__toggle').forEach((btn) => {
    btn.addEventListener('click', (event) => {
      event.preventDefault();
      const expanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!expanded));
      btn.setAttribute('aria-label', expanded ? `Dérouler le sous-menu ${btn.textContent?.trim() ?? ''}` : `Replier le sous-menu`);
      btn.closest('.header__item')?.classList.toggle('header__item--open', !expanded);
    });
  });

  // « Secteurs d'activité » : bouton sans lien qui ouvre son sous-menu.
  // Ordinateur : survol (souris), clic et clavier (Entrée / Espace ouvrent, Échap ferme).
  // Menu mobile : accordéon (même classe .header__item--open que le sous-menu Blog).
  const canHover = window.matchMedia('(hover: hover) and (min-width: 1100px)');
  menu?.querySelectorAll<HTMLElement>('.header__item--trigger').forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.header__trigger');
    if (!trigger) return;
    let closeTimer = 0;
    // Ouvert par le survol de la souris : un clic à ce moment-là garde le panneau ouvert
    // au lieu de le refermer (sinon survol puis clic donnerait un menu fermé).
    let openedByHover = false;
    const setOpen = (open: boolean) => {
      window.clearTimeout(closeTimer);
      if (!open) openedByHover = false;
      trigger.setAttribute('aria-expanded', String(open));
      item.classList.toggle('header__item--open', open);
    };
    const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';

    trigger.addEventListener('click', () => {
      if (isOpen() && openedByHover) {
        openedByHover = false;
        return;
      }
      setOpen(!isOpen());
    });

    item.addEventListener('mouseenter', () => {
      if (!canHover.matches) return;
      window.clearTimeout(closeTimer);
      if (!isOpen()) {
        setOpen(true);
        openedByHover = true;
      }
    });
    item.addEventListener('mouseleave', () => {
      if (!canHover.matches || (!openedByHover && item.contains(document.activeElement))) return;
      closeTimer = window.setTimeout(() => setOpen(false), 200);
    });

    item.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        event.stopPropagation();
        setOpen(false);
        trigger.focus();
      }
    });

    // Sur ordinateur, le panneau se referme quand le focus ou un clic sort de l'entrée.
    item.addEventListener('focusout', (event) => {
      const next = event.relatedTarget as Node | null;
      if (window.innerWidth >= 1100 && (!next || !item.contains(next))) setOpen(false);
    });
    document.addEventListener('click', (event) => {
      if (window.innerWidth >= 1100 && isOpen() && !item.contains(event.target as Node)) setOpen(false);
    });
  });

  window.addEventListener('scroll', () => {
    header?.classList.toggle('header--scrolled', window.scrollY > 40);
  }, { passive: true });
</script>
